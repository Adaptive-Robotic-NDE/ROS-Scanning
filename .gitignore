# colcon build products. Nothing under build/, install/ or log/ is source, and
# the generated packaging metadata is not either. build/lib/ and
# dgpfiles.egg-info/ were tracked for a while; they are not any more, so there
# is no longer an exception to carve out here.
/build/
/install/
/log/
*.egg-info/

# Python bytecode.
__pycache__/
*.pyc
