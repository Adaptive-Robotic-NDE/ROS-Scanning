def reconstruct(div,ang,length=1.0,width=0.5,x_pos=1.0,y_pos=0.5,z_pos=1.2):

    try:
        pa = ros.reconPoseArray(div,ang,length,width,x_pos,y_pos,z_pos)

        move_response = ros.Move(pa.poses[0],0.2,0.2)

        # move_response = ros.Move('over_cal_plate',0.2,0.2)

        while not move_response.result.success:
            print(f"{Colors.MAGENTA}Moving into position...")
            time.sleep(1)

        print(f"{Colors.GREEN}Done Moving")

        ###START RECONSTRUCTION###

        from geometry_msgs.msg import Vector3
        min_box_values = Vector3(x=0.0, y=0.0, z=0.0)
        max_box_values = Vector3(x=0.0, y=0.0, z=0.0)
        normal_direction = Vector3(x=0.0, y=0.0, z=1.0)
        normal_filter = NormalFilterParams(normal_direction=normal_direction, angle=paramdb.angle.magnitude)
        normal_filters = [normal_filter]

        tsdf_params = TSDFVolumeParams(voxel_length=paramdb.voxel_length.magnitude,
                                       sdf_trunc=paramdb.sdf_trunc.magnitude,
                                       min_box_values=min_box_values,
                                       max_box_values=max_box_values)
        rgbd_params = RGBDImageParams(depth_scale=paramdb.depth_scale.magnitude,
                                      depth_trunc=paramdb.depth_trunc.magnitude,
                                      convert_rgb_to_intensity=paramdb.convert_rgb_to_intensity)
    

        print(f"{Colors.CYAN}Starting Reconstruction!")

        print(f"{Colors.GREEN}Archive directory: {archive_directory.name}")
        print(f"{Colors.GREEN}Output filename: {output_filename.name}")
        print(f"{Colors.GREEN}Mesh filepath: {mesh_filepath.name}")

        
        start_reconstruction.sendRequest('StartReconstruction',
                                                           { 'tracking_frame':paramdb.tracking_frame,
                                                             'relative_frame':paramdb.relative_frame,
                                                             'translation_distance':paramdb.translation_distance.magnitude,
                                                             'rotational_distance':paramdb.rotational_distance.magnitude,
                                                             'live':paramdb.live,
                                                             'tsdf_params':tsdf_params,
                                                             'rgbd_params':rgbd_params})
        
        move_response = ros.Move(pa.poses[1:],0.05,0.05)

        while not move_response.result.success:
            print(f"{Colors.MAGENTA}Reconstructing...")
            time.sleep(1)

        ros.Move("over_cal_plate",0.2,0.2)

        time.sleep(20)

        print(f"{Colors.CYAN}Stoping Reconstruction")
#        stop_res = stop_reconstruction.sendRequest('StopReconstruction',
#                                                    {'archive_directory':archive_directory.name,
#                                                     'mesh_filepath':"/home/labuser/Desktop/test.ply",
#                                                     'normal_filters':normal_filters})
            
        if move_response.result.success : stop_res = stop_reconstruction.sendRequest('StopReconstruction',
                                                    {'archive_directory':archive_directory.name,
                                                     'mesh_filepath':"/home/labuser/Desktop/test.ply",
                                                     'normal_filters':normal_filters})
            
        if stop_res.success : print(f"{Colors.GREEN}Reconstruction Complete!")

    except Exception as e:

        print(f"{Colors.RED}{e}")

    finally:
        tempdir.cleanup()
        print(f"{Colors.RESET}Exiting...")
            

