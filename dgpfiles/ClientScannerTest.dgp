def registerMesh(id,matrix=None,location=(0.0,0.0,0.0)):

    print(f"{Colors.YELLOW}Registering Mesh")

    matrix = calculateRegistration(id)

    if id == 6:
        print("Performing Calibration Plate Registration")
        full_mesh_filepath = '/home/labuser/iron_tari/src/tari-ros-staging/tari_ur_launch/meshes/calPlate.dae'
        full_mesh_output_filepath = '/home/labuser/iron_tari/src/tari-ros-staging/tari_ur_launch/meshes/calPlate.ply'
        sample_mesh_filepath = '/home/labuser/iron_tari/src/tari-ros-staging/tari_ur_launch/meshes/calPlateSample.dae'
        sample_mesh_output_filepath = '/home/labuser/iron_tari/src/tari-ros-staging/tari_ur_launch/meshes/calPlateSample.ply'

    elif id == 7:
        print("Performing Cylinder Registration")
        full_mesh_filepath = '/home/labuser/iron_tari/src/tari-ros-staging/tari_ur_launch/meshes/FullFiducialCylinder.dae'
        full_mesh_output_filepath = '/home/labuser/iron_tari/src/tari-ros-staging/tari_ur_launch/meshes/FullFiducialCylinder.ply'
        sample_mesh_filepath = '/home/labuser/iron_tari/src/tari-ros-staging/tari_ur_launch/meshes/SampleFiducialCylinder.dae'
        sample_mesh_output_filepath = '/home/labuser/iron_tari/src/tari-ros-staging/tari_ur_launch/meshes/SampleFiducialCylinder.ply'

