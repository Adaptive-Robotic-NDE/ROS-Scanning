    print(f"{Colors.BLUE}Keyence Noether TPP")
    
    q = transforms3d.euler.euler2quat(paramdb.keyence_orientation.magnitude[0],paramdb.keyence_orientation.magnitude[1],paramdb.keyence_orientation.magnitude[2])

