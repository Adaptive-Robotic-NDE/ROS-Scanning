def center(detection=0):

    print(f"{Colors.GREEN}Centering detection")
    print(f"{Colors.GREEN}Intial Positions")

    pixel_x = ros.tracked_detection.detections[detection].bbox.center.position.x
    pixel_y = ros.tracked_detection.detections[detection].bbox.center.position.y

    detection_coordinates = azureConvert(pixel_x, pixel_y)

    while detection_coordinates is None:
        pixel_y += 5.0
        detection_coordinates = azureConvert(pixel_x, pixel_y)
    
    point_detection = PointStamped()
    point_detection.point.x = detection_coordinates[0]
    point_detection.point.y = detection_coordinates[1]
    point_detection.point.z = detection_coordinates[2]
    point_detection.header.frame_id = "azure_rgb"

    point_probe = do_transform_point(point_detection, ros.azure_t)

    pose = Pose()
    pose.position.x = point_probe.point.x
    pose.position.y = point_probe.point.y
    # pose.position.z = point_probe.point.z
    pose.position.z = ros.t.transform.translation.z

    print(f"Pose after transform: {pose}")
    
    ros.Move(pose)

def moveAround():

    try:

        pinSwitch(pin=0,state=True)
        
        ros.Move("over_table")

        yoloEnable(False)

        for i in range(len(ros.tracked_detection.detections)):
            center(i)

        ros.Move(ros.pose_array)

    except Exception as e:

        print(f"Error in execution: {e}")

    finally:

        pinSwitch(pin=0,state=False)

        ros.Move("over_table")

def yoloEnable(enable):

    if enable:
        print(f"{Colors.CYAN}Enabling YOLO!")
    else:
        print(f"{Colors.CYAN}Disabling YOLO!")

    return yolo_enable_client.sendRequest('SetBool',{'enable':enable})

def azureConvert(pixel_x, pixel_y):

    depth_value = ros.depth_image[int(pixel_y),
                            int(pixel_x)]/1000
    
    print(f"depth_value: {depth_value}")
    print(f"pixel_x: {pixel_x}")
    print(f"pixel_y: {pixel_y}")
    
    if depth_value != 0.0:
                  
        x = (pixel_x - Azure.cx) * depth_value / Azure.fx
        y = (pixel_y - Azure.cy) * depth_value / Azure.fy
        z = depth_value

        print(f"x: {x}\ny: {y}\nz: {z}\n")
        return x, y, z
    
    else:

        return

def yoloCrop(detection = 0):

    bbox_coordinates = [[0]*2 for _ in range(4)]
    azure_coordinates = [[0]*3 for _ in range(4)]

    # azure_scale = azure_client.sendRequest('AzureFovScaler', { 'distance': depth_value})

    pixel_x = ros.tracked_detection.detections[detection].bbox.center.position.x
    pixel_y = ros.tracked_detection.detections[detection].bbox.center.position.y

    detection_coordinates = azureConvert(pixel_x, pixel_y)
    
    while detection_coordinates is None:
        pixel_y += 5.0
        detection_coordinates = azureConvert(pixel_x, pixel_y)


    point_detection = PointStamped()
    point_detection.point.x = detection_coordinates[0]
    point_detection.point.y = detection_coordinates[1]
    point_detection.point.z = detection_coordinates[2]
    point_detection.header.frame_id = "azure_rgb"

    point_probe = do_transform_point(point_detection, ros.azure_t)

    pose = Pose()
    pose.position.x = point_probe.point.x
    pose.position.y = point_probe.point.y
    pose.position.z = point_probe.point.z
    # pose.position.z = ros.t.transform.translation.z
    
    ros.addPose(pose)

    # input("You ready?")
    # ros.Move(pose)

    # input("New detection section")

    # if len(ros.detected.detections) == 1:
    # 
    #     detection = 0

    pixel_x = ros.detected.detections[detection].bbox.center.position.x
    pixel_y = ros.detected.detections[detection].bbox.center.position.y

    bbox_x = ros.detected.detections[detection].bbox.size.x/2
    bbox_y = ros.detected.detections[detection].bbox.size.y/2

    # Point 1 Upper Left
    bbox_coordinates[0][0] = pixel_x - bbox_x
    bbox_coordinates[0][1] = pixel_y - bbox_y

    # Point 2 Upper Right
    bbox_coordinates[1][0] = pixel_x + bbox_x
    bbox_coordinates[1][1] = pixel_y - bbox_y

    # Point 3 Lower Left
    bbox_coordinates[2][0] = pixel_x - bbox_x
    bbox_coordinates[2][1] = pixel_y + bbox_y

    # Point 4 Lower Right
    bbox_coordinates[3][0] = pixel_x + bbox_x
    bbox_coordinates[3][1] = pixel_y + bbox_y

    print(f"{bbox_coordinates}")

    points = [[PointStamped()]*2 for _ in range(4)]

    for i in range(len(bbox_coordinates)):
        print(f"i: {i}")
        azure_coordinates[i]=azureConvert(bbox_coordinates[i][0], bbox_coordinates[i][1])
        point = PointStamped()
        if azure_coordinates[i] is not None:
            point.point.x = azure_coordinates[i][0]
            point.point.y = azure_coordinates[i][1]
            point.point.z = azure_coordinates[i][2]
            point.header.frame_id = "azure_rgb"
            points[i][0] = point
            points[i][1] = do_transform_point(points[i][0], ros.azure_t)

    
    print(f"{azure_coordinates}")

    options = []

    for i in range(len(azure_coordinates)):
        if azure_coordinates[i]:
            options.append(i)

    print(f"options: {options}")

    if (1 in options) and (2 in options) :
        print("Points 2 and 3 chosen")
        maxx = points[1][1].point.x
        minx = points[2][1].point.x
        maxy = points[2][1].point.y
        miny = points[1][1].point.y
        if points[1][1].point.z > points[2][1].point.z:
            maxz = points[1][1].point.z + 0.05
            minz = points[2][1].point.z - 0.05
        elif points[1][1].point.z < points[2][1].point.z:
            maxz = points[2][1].point.z + 0.05
            minz = points[1][1].point.z - 0.05

    elif (0 in options) and (3 in options) :
        print(f"Points 1 and 4 chosen")
        maxx = points[0][1].point.x
        minx = points[3][1].point.x
        maxy = points[3][1].point.y
        miny = points[0][1].point.y
        if points[0][1].point.z > points[3][1].point.z:
            maxz = points[0][1].point.z + 0.05
            minz = points[3][1].point.z - 0.05
        elif points[0][1].point.z < points[3][1].point.z:
            maxz = points[3][1].point.z + 0.05
            minz = points[0][1].point.z - 0.05
    
    elif not (((1 in options) and (2 in options)) or ((0 in options) and (3 in options))):

        print(f"Points {options[0]} and {options[1]} chosen")

        if options[1] - options[0] > 1:
            maxx = points[options[0]][1].point.x
            minx = points[options[1]][1].point.x
            if options[1] + options[0] > 2:
                print("Options added together > 2")
                miny = statistics.mean([points[options[1]][1].point.y,points[options[0]][1].point.y])
                xdis = points[options[0]][1].point.x - points[options[1]][1].point.x
                ratio = xdis/bbox_x
                ydis = ratio*bbox_y
                maxy = miny + ydis
            else:
                print("Options added together =< 2")
                maxy = statistics.mean([points[options[1]][1].point.y,points[options[0]][1].point.y])
                xdis = points[options[0]][1].point.x - points[options[1]][1].point.x
                ratio = xdis/bbox_x
                ydis = ratio*bbox_y
                miny = maxy - ydis

            maxz = points[options[1]][1].point.z + 0.05
            minz = points[options[1]][1].point.z - 0.05

            
        else:
            print("Options substracted = 1")
            maxy = points[options[1]][1].point.y
            miny = points[options[0]][1].point.y
            maxx = statistics.mean([points[options[1]-1][1].point.x,points[options[0]][1].point.x])
            ydis = points[options[1]][1].point.y - points[options[0]][1].point.y
            ratio = ydis/bbox_y
            xdis = ratio*bbox_x
            minx = maxx - xdis
            maxz = points[options[1]][1].point.z + 0.05
            minz = points[options[1]][1].point.z - 0.05
    else:

        # return "we tried (y)"
        print("lol give up")


    print(f"maxx = {maxx}")
    print(f"minx = {minx}")
    print(f"maxy = {maxy}")
    print(f"miny = {miny}")
    print(f"maxz = {maxz}")
    print(f"minz = {minz}")

    # return maxx, minx, maxy, miny, maxz, minz

    startReconstruction(maxx=maxx,maxy=maxy,maxz=maxz,minx=minx,miny=miny,minz=minz)
            
def startReconstruction(maxx=0.0,maxy=0.0,maxz=0.0,minx=0.0,miny=0.0,minz=0.0):

    min_box_values = Vector3(x=minx, y=miny, z=minz)
    max_box_values = Vector3(x=maxx, y=maxy, z=maxz)

    tsdf_params = TSDFVolumeParams(voxel_length=paramdb.voxel_length.magnitude,
                                   sdf_trunc=paramdb.sdf_trunc.magnitude,
                                   min_box_values=min_box_values,
                                   max_box_values=max_box_values)
    
    rgbd_params = RGBDImageParams(depth_scale=paramdb.depth_scale.magnitude,
                                  depth_trunc=paramdb.depth_trunc.magnitude,
                                  convert_rgb_to_intensity=paramdb.convert_rgb_to_intensity)

    print(f"{Colors.CYAN}Starting Reconstruction!")
    print(f"Archive directory: {archive_directory.name}")
    print(f"Output filename: {output_filename.name}")
    print(f"Mesh filepath: {mesh_filepath.name}")
    
    return start_reconstruction.sendRequest('StartReconstruction',
                                   { 'tracking_frame':paramdb.tracking_frame,
                                     'relative_frame':paramdb.relative_frame,
                                     'translation_distance':paramdb.translation_distance.magnitude,
                                     'rotational_distance':paramdb.rotational_distance.magnitude,
                                     'live':paramdb.live,
                                     'tsdf_params':tsdf_params,
                                     'rgbd_params':rgbd_params})

def stopReconstruction():

    normal_direction = Vector3(x=0.0, y=0.0, z=1.0)
    normal_filter = NormalFilterParams(normal_direction=normal_direction, angle=paramdb.angle.magnitude)
    normal_filters = [normal_filter]

    print(f"{Colors.GREEN}Stoping Reconstruction")
        
    return stop_reconstruction.sendRequest('StopReconstruction',
                                   {'archive_directory':paramdb.archive_directory,
                                    'mesh_filepath':paramdb.mesh_filepath,
                                    'normal_filters':normal_filters})

def noether(input=paramdb.input_file, set_o=paramdb.set_orientation, line_spacing=paramdb.line_spacing.magnitude, point_spacing=paramdb.point_spacing.magnitude, z_offset=paramdb.z_offset.magnitude):

    print(f"{Colors.BLUE}Noether TPP")
    
    q = transforms3d.euler.euler2quat(paramdb.orientation.magnitude[0],paramdb.orientation.magnitude[1],paramdb.orientation.magnitude[2])

    quat = Quaternion(w=q[0],x=q[1],y=q[2],z=q[3])

    return noether_client.sendRequest('TariNoether', 
                                     {'mesh_filename': input,
                                      'line_spacing': line_spacing,
                                      'point_spacing': point_spacing,
                                      'z_offset': z_offset,
                                      'distance_threshold': paramdb.distance_threshold.magnitude,
                                      'plane_proj': paramdb.plane_proj,
                                      'max_planes': paramdb.max_planes.magnitude,
                                      'set_orientation': set_o,
                                      'orientation': quat}).noether_pose_array.poses

def noetherDownsample(percentage):

    x = []
    y = []
    z = []

    pa=noether()
    e=[]
    j = PoseArray()

    lower = 1 - percentage
    upper = 1 + percentage

    print(f"{Colors.CYAN}Noether output size {len(pa)}")

    for i in range(len(pa)):
        e.append(list(transforms3d.euler.quat2euler([pa[i].orientation.w,
                                      pa[i].orientation.x,
                                      pa[i].orientation.y,
                                      pa[i].orientation.z])))
        
    for i in range(len(e)):
        for l in range(3):
            if e[i][l] < 0 or e[i][l] < 0.01:
                e[i][l] = e[i][l] + 2 * math.pi
            if l == 0:
                x.append(e[i][l])
            if l == 1:
                y.append(e[i][l])
            if l == 2:
                z.append(e[i][l])

    x_mean = statistics.mean(x)
    y_mean = statistics.mean(y)
    z_mean = statistics.mean(z)

    print(f"{Colors.MAGENTA}x mean: {x_mean}\ny mean: {y_mean}\nz mean: {z_mean}")

    for i in range(len(e)):
        if x_mean*lower < e[i][0] < x_mean*upper or y_mean*lower < e[i][1] < y_mean*upper or z_mean*lower < e[i][2] < z_mean*upper:
            j.poses.append(pa[i])

    q=transforms3d.euler.euler2quat(x_mean,y_mean,z_mean)



    try:
        m = j.poses[0]

        j.poses.append(m)

        j.poses[-1].orientation = Quaternion(w=q[0], x=q[1], y=q[2], z=q[3])
        j.poses[-1].position.z += 0.5

        j.header.frame_id = ros.pose_array.header.frame_id

        ros.pose_pub.publish(j)

    except Exception as e:

        print(e)

    print(f"{Colors.GREEN}Filtered noether output size {len(j.poses)}")
    
    return j

