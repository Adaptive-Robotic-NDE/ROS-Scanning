def noetherDownsample(percentage):

    x = []
    y = []
    z = []

    pa=noether()
    e=[]
    j = PoseArray()

    lower = 1 - percentage
    upper = 1 + percentage

    print(f"{Colors.CYAN}Noether output size {len(pa)}")

    for i in range(len(pa)):
        e.append(list(transforms3d.euler.quat2euler([pa[i].orientation.w,
                                      pa[i].orientation.x,
                                      pa[i].orientation.y,
                                      pa[i].orientation.z])))
        
    for i in range(len(e)):
        for l in range(3):
            if e[i][l] < 0 or e[i][l] < 0.01:
                e[i][l] = e[i][l] + 2 * math.pi
            if l == 0:
                x.append(e[i][l])
            if l == 1:
                y.append(e[i][l])
            if l == 2:
                z.append(e[i][l])

    x_mean = statistics.mean(x)
    y_mean = statistics.mean(y)
    z_mean = statistics.mean(z)

    print(f"{Colors.MAGENTA}x mean: {x_mean}\ny mean: {y_mean}\nz mean: {z_mean}")

    for i in range(len(e)):
        if x_mean*lower < e[i][0] < x_mean*upper or y_mean*lower < e[i][1] < y_mean*upper or z_mean*lower < e[i][2] < z_mean*upper:
            j.poses.append(pa[i])

    q=transforms3d.euler.euler2quat(x_mean,y_mean,z_mean)



    try:
        m = j.poses[0]

        j.poses.append(m)

        j.poses[-1].orientation = Quaternion(w=q[0], x=q[1], y=q[2], z=q[3])
        j.poses[-1].position.z += 0.5

        j.header.frame_id = ros.pose_array.header.frame_id

        ros.pose_pub.publish(j)

    except Exception as e:

        print(e)

    print(f"{Colors.GREEN}Filtered noether output size {len(j.poses)}")
    
    return j

