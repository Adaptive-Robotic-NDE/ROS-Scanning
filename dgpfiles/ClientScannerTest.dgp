def collectSpringData(sec=0.001, samples=100):

    global point_data, forces, positions

    point_data = {
        'force' : [],
        'position' : []
    }

    forces = {
        'x':[],
        'y':[],
        'z':[]
    }

    positions = {
        'translation' : {
            'x':[],
            'y':[],
            'z':[]
        },
        'orientation' : { 
            'w':[],
            'x':[],
            'y':[],
            'z':[]
        }
    }



    for _ in range(samples):
        point_data['force'].append(ros.sync_force_msg.wrench.force)
        point_data['position'].append(ros.sync_pos_msg)
        time.sleep(sec)

    for msg in range(len(point_data['force'])):
        positions['translation']['x'].append(point_data['position'][msg].transform.translation.x)
        positions['translation']['y'].append(point_data['position'][msg].transform.translation.y)
        positions['translation']['z'].append(point_data['position'][msg].transform.translation.z)
        positions['orientation']['w'].append(point_data['position'][msg].transform.rotation.w)
        positions['orientation']['x'].append(point_data['position'][msg].transform.rotation.x)
        positions['orientation']['y'].append(point_data['position'][msg].transform.rotation.y)
        positions['orientation']['z'].append(point_data['position'][msg].transform.rotation.z)
        forces['x'].append(point_data['force'][msg].x)
        forces['y'].append(point_data['force'][msg].y)
        forces['z'].append(point_data['force'][msg].z)

    forces_np = np.array([forces['x'],
                       forces['y'],
                       forces['z']])
    positions_np = np.array([positions['translation']['x'],
                          positions['translation']['y'],
                          positions['translation']['z']])
    orientations_np = np.array([positions['orientation']['w'],
                             positions['orientation']['x'],
                             positions['orientation']['y'],
                             positions['orientation']['z']])
    
    orientations_np = orientations_np.T
    
    M = np.dot(orientations_np.T, orientations_np)
    
    eigenvalues, eigenvectors = np.linalg.eigh(M)

    avg_quat = eigenvectors[:, np.argmax(eigenvalues)]
    avg_quat /= np.linalg.norm(avg_quat)

    rot = Rotation.from_quat(np.roll(avg_quat, -1))
    rot_matrix = rot.as_matrix()

    init_normal = rot_matrix[:, 2]

    init_avg_force = [np.mean(forces_np[0]), np.mean(forces_np[1]), np.mean(forces_np[2])]

    init_avg_pos = [np.mean(positions_np[0]), np.mean(positions_np[1]), np.mean(positions_np[2])]

    input("Press enter to continue...")

    point_data = {
        'force' : [],
        'position' : []
    }

    forces = {
        'x':[],
        'y':[],
        'z':[]
    }

    positions = {
        'translation' : {
            'x':[],
            'y':[],
            'z':[]
        },
        'orientation' : { 
            'w':[],
            'x':[],
            'y':[],
            'z':[]
        }
    }

    for _ in range(samples):
        point_data['force'].append(ros.sync_force_msg.wrench.force)
        point_data['position'].append(ros.sync_pos_msg)
        time.sleep(sec)

    for msg in range(len(point_data['force'])):
        positions['translation']['x'].append(point_data['position'][msg].transform.translation.x)
        positions['translation']['y'].append(point_data['position'][msg].transform.translation.y)
        positions['translation']['z'].append(point_data['position'][msg].transform.translation.z)
        positions['orientation']['w'].append(point_data['position'][msg].transform.rotation.w)
        positions['orientation']['x'].append(point_data['position'][msg].transform.rotation.x)
        positions['orientation']['y'].append(point_data['position'][msg].transform.rotation.y)
        positions['orientation']['z'].append(point_data['position'][msg].transform.rotation.z)
        forces['x'].append(point_data['force'][msg].x)
        forces['y'].append(point_data['force'][msg].y)
        forces['z'].append(point_data['force'][msg].z)

    forces_np = np.array([forces['x'],
                       forces['y'],
                       forces['z']])
    positions_np = np.array([positions['translation']['x'],
                          positions['translation']['y'],
                          positions['translation']['z']])
    orientations_np = np.array([positions['orientation']['w'],
                             positions['orientation']['x'],
                             positions['orientation']['y'],
                             positions['orientation']['z']])
    
    orientations_np = orientations_np.T
    
    M = np.dot(orientations_np.T, orientations_np)
    
    eigenvalues, eigenvectors = np.linalg.eigh(M)

    avg_quat = eigenvectors[:, np.argmax(eigenvalues)]
    avg_quat /= np.linalg.norm(avg_quat)

    rot = Rotation.from_quat(np.roll(avg_quat, -1))
    rot_matrix = rot.as_matrix()

    normal = rot_matrix[:, 2]

    avg_force = [np.mean(forces_np[0]), np.mean(forces_np[1]), np.mean(forces_np[2])]

    avg_pos = [np.mean(positions_np[0]), np.mean(positions_np[1]), np.mean(positions_np[2])]

    init_f_n = np.dot(init_avg_force, init_normal)

    f_n = np.dot(avg_force, normal)

    print(f"Initial F N: {init_f_n}")
    print(f"Final F N: {f_n}")

    delta_f_n = f_n - init_f_n

    print(f"Delta F N: {delta_f_n}")

    avg_normal_vector = (init_normal + normal) / np.linalg.norm(init_normal + normal)

    print(f"Average Normal: {avg_normal_vector}")

    print(f"Average Position: {avg_pos}")

    print(f"Initial Average Position: {init_avg_pos}")

    np_avg_pos = np.array(avg_pos)
    np_init_avg_pos = np.array(init_avg_pos)

    displacement = np_avg_pos - np_init_avg_pos

    delta_n = np.dot(displacement, avg_normal_vector)

    print(f"Delta N: {delta_n}")
    delta_x_n = np.linalg.norm(delta_n)
    print(f"Delta X N: {delta_x_n}")

    if abs(delta_x_n) > 1e-6:

        k = abs(delta_f_n / delta_x_n)
        k_list.append(k)

        print(f"Spring Constant (k): {k_list[-1]:.4f} N/m")

        return k
    
    else:
        print("Zero displacement, skipping.")

