def keyenceStart():

    print(f"{Colors.GREEN}Keyence Reconstruction Starting")

    return keyence_start.sendRequest('StartKeyRec', {'distance': paramdb.distance.magnitude})

def keyenceStop():

    print(f"{Colors.MAGENTA}Keyence Reconstruction Stopping")

    return keyence_stop.sendRequest('StopKeyRec',
                            {'mean_k': paramdb.mean_k.magnitude,
