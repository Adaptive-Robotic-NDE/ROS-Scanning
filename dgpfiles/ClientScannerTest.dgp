def keyenceStop():

    print(f"{Colors.MAGENTA}Keyence Reconstruction Stopping")

    pinSwitch(pin=1,state=False)

    io_stuff = {'output_filepath': paramdb.output_filepath,
                'output_filename': paramdb.output_filename}
    
    passthrough_filter = {'min': paramdb.min.magnitude,
                            'max': paramdb.max.magnitude}
    
    outlier_removal = {'perform_outlier_filtering': paramdb.perform_outlier_filtering,
                       'mean_k': paramdb.mean_k.magnitude,
                       'dev_thresh': paramdb.dev_thresh.magnitude}
    
    mini_voxel_filter = {'mini_leaf_size': paramdb.mini_leaf_size.magnitude}

    voxel_filter = {'leaf_size': paramdb.leaf_size.magnitude}

    poisson_surface = {'depth': paramdb.poisson_depth.magnitude,
                        'solver_divide': paramdb.solver_divide.magnitude,
                        'iso_divide': paramdb.iso_divide.magnitude,
                        'point_weight': paramdb.point_weight.magnitude}
    
    normal_estimation = {'k_search': paramdb.k_search.magnitude,
                         'radius_search': paramdb.radius_search.magnitude}
    
    euclidean_cluster = {'cluster_tolerance': paramdb.cluster_tolerance.magnitude,
                            'max_cluster_size': paramdb.max_cluster_size.magnitude,
                            'min_cluster_size': paramdb.min_cluster_size.magnitude}
    
    triangulation = {'search_radius': paramdb.search_radius.magnitude,
                     'set_mu': paramdb.set_mu.magnitude,
                     'max_nearest': paramdb.max_nearest.magnitude,
                     'max_surface_angle': paramdb.max_surface_angle.magnitude,
                     'min_angle': paramdb.min_angle.magnitude,
                     'max_angle': paramdb.max_angle.magnitude,
                     'normal_consistency': paramdb.normal_consistency}

    return keyence_stop.sendRequest('StopKeyRec',
                            {
                                **io_stuff,
                                **passthrough_filter,
                                **outlier_removal,
                                **mini_voxel_filter,
                                **voxel_filter,
                                **poisson_surface,
                                **normal_estimation,
                                **euclidean_cluster,
                                **triangulation
                             }).success

