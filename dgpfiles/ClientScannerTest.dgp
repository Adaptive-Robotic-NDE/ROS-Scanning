def curvedGeometry():
    q = Quaternion(w=0.7012773070207925, x=0.008745344456110877, y=0.008990798433617032, z=0.7127782426193544)
    x = [0.7715144379308916, 0.7715144379308916, 0.8039578138008607, 0.8049177683617961, 0.8365381260424909, 0.8352284137278279, 0.8651641037694109, 0.866395849201294]
    y = [0.5426997091743002, 0.6173871068702568]
    z = 0.9547216477958038
    for i in range(8):
        p = Pose()
        p.orientation = q
        p.position.z = z
        if i%4 > 1:
            p.position.y = y[(i+1)%2]
        else:
            p.position.y = y[i%2]
        p.position.x = x[i]
        ros.addPose(p)

def pinSwitch(pin=0,state=None):

    if state is not None:

        if isinstance(pin, int) and 0 <= pin <= 7:

            if ros.svd_msg.digital_out_states[pin].state and state:
                
                return ros.get_logger().info(f"Pin {pin} is already {Colors.GREEN}ON{Colors.RESET}")

            elif state and not ros.svd_msg.digital_out_states[pin].state:

                ros.get_logger().info(f"Switching pin {pin} {Colors.GREEN}ON{Colors.RESET}")

                return gpio_client.sendRequest('SetIO',
                                        {'fun': 1,
                                         'pin': pin,
                                         'state': 1.0})
            elif not ros.svd_msg.digital_out_states[pin].state and not state:

                return ros.get_logger().info(f"Pin {pin} is already {Colors.RED}OFF{Colors.RESET}")
            
            else:
                ros.get_logger().info(f"Switching pin {pin} {Colors.RED}OFF{Colors.RESET}")

                return gpio_client.sendRequest('SetIO',
                                        {'fun': 1,
                                         'pin': pin,
                                         'state': 0.0})
    else:

        return ros.get_logger().info(f"Set True/False state for ON/OFF pin selection")

