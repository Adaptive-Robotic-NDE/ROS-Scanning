                                                 1,
                                                 len(noether_result.noether_pose_array.poses),
                                                 paramdb.point_spacing.magnitude,
                                                 paramdb.line_spacing.magnitude)
            
        ros.Move("over_cal_plate",0.2,0.2)

    finally:
        tempdir.cleanup()
        print(f"{Colors.RESET}Exiting...")
        




def capturedata():
    monitor = recdb.start_monitoring_globalrevs()
    g = monitor.wait_next(recdb)
    monitor.close(recdb)
    rec = g.get_ndarray_ref('/PXI1Slot2/ai1')
    ch2data = np.mean(rec.data())
    rec = g.get_ndarray_ref('/PXI1Slot2/ai0')
    ch1data = np.mean(rec.data())
    transact = recdb.start_transaction()
    rec1 = snde.create_ndarray_ref(recdb, avgrealchan, recdb.raw(), snde.SNDE_RTN_FLOAT64)
    rec2 = snde.create_ndarray_ref(recdb, avgimagchan, recdb.raw(), snde.SNDE_RTN_FLOAT64)
    g = transact.end_transaction()
    rec1.rec.metadata = rec.rec.metadata
    rec2.rec.metadata = rec.rec.metadata
    rec1.rec.mark_metadata_done()
    rec2.rec.mark_metadata_done()
    rec1.allocate_storage(ch1data.shape, True)
    rec2.allocate_storage(ch2data.shape, True)
    rec1.assign_double(0, ch1data)
    rec2.assign_double(0, ch2data)
    rec1.rec.mark_data_ready()
    rec2.rec.mark_data_ready()
    g.wait_complete()

def SimpleScan_PlotData(dx, dy, inix, iniy, n, m):
    g = recdb.latest_globalrev()
    recreal = g.get_ndarray_ref('/accum_real')
    realdata = recreal.data().reshape([n,m])
    recimag = g.get_ndarray_ref('/accum_imag')
    imagdata = recimag.data().reshape([n,m])
    print(f'{n},{m}')
    transact = recdb.start_transaction()
    rec1 = snde.create_ndarray_ref(recdb, scanrealchan, recdb.raw(), snde.SNDE_RTN_FLOAT64)
    rec2 = snde.create_ndarray_ref(recdb, scanimagchan, recdb.raw(), snde.SNDE_RTN_FLOAT64)
    g = transact.end_transaction()
    metadata = snde.constructible_metadata()
    metadata.AddMetaDatum(snde.metadatum('ande_array-axis0_scale', dx, 'meters'))
    metadata.AddMetaDatum(snde.metadatum('ande_array-axis0_offset', inix, 'meters'))
    metadata.AddMetaDatum(snde.metadatum('ande_array-axis0_units', 'meters'))
    metadata.AddMetaDatum(snde.metadatum('ande_array-axis0_coord', 'X Position'))
    metadata.AddMetaDatum(snde.metadatum('ande_array-axis1_scale', dy, 'meters'))
    metadata.AddMetaDatum(snde.metadatum('ande_array-axis1_offset', iniy, 'meters'))
    metadata.AddMetaDatum(snde.metadatum('ande_array-axis1_units', 'meters'))
    metadata.AddMetaDatum(snde.metadatum('ande_array-axis1_coord', 'Y Position'))
    metadata.AddMetaDatum(snde.metadatum('ande_array-ampl_units', 'V'))
    metadata.AddMetaDatum(snde.metadatum('ande_array-ampl_coord', 'Voltage'))
    rec1.rec.metadata = metadata
    rec2.rec.metadata = metadata
    rec1.rec.mark_metadata_done()
    rec2.rec.mark_metadata_done()
    rec1.allocate_storage(realdata.shape, True)
    rec2.allocate_storage(imagdata.shape, True)
    rec1.data()[:] = realdata
    rec2.data()[:] = imagdata
    rec1.rec.mark_data_ready()
    rec2.rec.mark_data_ready()

def Sliced2DScan_PlotData(dx, dy, inix, iniy, n, m, nslice):
    g = recdb.latest_globalrev()
    recreal = g.get_ndarray_ref('/accum_real')
    realdata = recreal.data().reshape([n,m])
    mapdata = np.array([j for k in range(nslice) for j in range(k, n , nslice)])
    mapdata = [(x,y) for (x,y) in zip(mapdata, range(n))]
    mapdata.sort()
    mapdata = [i[1] for i in mapdata]
    realdataout = realdata[:,mapdata]
    recimag = g.get_ndarray_ref('/accum_imag')
    imagdata = recimag.data().reshape([n,m])
    imagdataout = imagdata[:,mapdata]
    transact = recdb.start_transaction()
    rec1 = snde.create_ndarray_ref(recdb, scanrealchan, recdb.raw(), snde.SNDE_RTN_FLOAT64)
    rec2 = snde.create_ndarray_ref(recdb, scanimagchan, recdb.raw(), snde.SNDE_RTN_FLOAT64)
    g = transact.end_transaction()
    metadata = snde.constructible_metadata()
    metadata.AddMetaDatum(snde.metadatum('ande_array-axis0_scale', dx, 'meters'))
    metadata.AddMetaDatum(snde.metadatum('ande_array-axis0_offset', inix, 'meters'))
    metadata.AddMetaDatum(snde.metadatum('ande_array-axis0_units', 'meters'))
    metadata.AddMetaDatum(snde.metadatum('ande_array-axis0_coord', 'X Position'))
    metadata.AddMetaDatum(snde.metadatum('ande_array-axis1_scale', dy, 'meters'))
    metadata.AddMetaDatum(snde.metadatum('ande_array-axis1_offset', iniy, 'meters'))
    metadata.AddMetaDatum(snde.metadatum('ande_array-axis1_units', 'meters'))
    metadata.AddMetaDatum(snde.metadatum('ande_array-axis1_coord', 'Y Position'))
    metadata.AddMetaDatum(snde.metadatum('ande_array-ampl_units', 'V'))
    metadata.AddMetaDatum(snde.metadatum('ande_array-ampl_coord', 'Voltage'))
    rec1.rec.metadata = metadata
    rec2.rec.metadata = metadata
    rec1.rec.mark_metadata_done()
    rec2.rec.mark_metadata_done()
    rec1.allocate_storage(realdataout.shape, True)
    rec2.allocate_storage(imagdataout.shape, True)
    rec1.data()[:] = realdataout
    rec2.data()[:] = imagdataout
    rec1.rec.mark_data_ready()
    rec2.rec.mark_data_ready()

   

def SimpleXYScan(t1, t2, n, m):

    x = np.linspace(t1.transform.translation.x, t2.transform.translation.x, n)
    y = np.linspace(t1.transform.translation.y, t2.transform.translation.y, m)

    global accumulator_real, accumulator_imag
    transact = recdb.start_transaction()
    if accumulator_real is not None:
        recdb.delete_math_function(accumulator_real)
    if accumulator_imag is not None:
        recdb.delete_math_function(accumulator_imag)

    accumulator_real = snde.accumulate_once.instantiate([ snde.math_parameter_recording("/avgreal"),
                                                          snde.math_parameter_unsigned_const(n*m),
                                                          snde.math_parameter_int_const(-1),
                                                          snde.math_parameter_bool_const(False),
                                                          snde.math_parameter_bool_const(False)],
                                                        [ snde.shared_string("/accum_real") ],
                                                        "/",
                                                        False,
                                                        False,
                                                        False,
                                                        snde.math_definition("accumulator real definition"),
                                                        None)
    recdb.add_math_function(accumulator_real ,False)
    accumulator_imag = snde.accumulate_once.instantiate([ snde.math_parameter_recording("/avgimag"),
                                                          snde.math_parameter_unsigned_const(n*m),
                                                          snde.math_parameter_int_const(-1),
                                                          snde.math_parameter_bool_const(False),
                                                          snde.math_parameter_bool_const(False)],
                                                        [ snde.shared_string("/accum_imag") ],
                                                        "/",
                                                        False,
                                                        False,
                                                        False,
                                                        snde.math_definition("accumulator imag definition"),
                                                        None)
    recdb.add_math_function(accumulator_imag ,False)
    transact.end_transaction()
    
    for i in range(n):
        for j in range(m):
            print("Moving to (x = %.6f, y = %.6f)" % (x[i], y[j]))
            t2.transform.translation.x = x[i]
            t2.transform.translation.y = y[j]
            ros.Move(t2,0.1,0.1)           
            capturedata()

    SimpleScan_PlotData(x[1]-x[0], y[1]-y[0], x[0], y[0], n, m)
    return (x[1]-x[0], y[1]-y[0], x[0], y[0], n, m)
    
        
def Scan2DPlane(t1, t2, t3, m, n):
	
    p1 = np.array([t1.transform.translation.x, t1.transform.translation.y, t1.transform.translation.z])
    p2 = np.array([t2.transform.translation.x, t2.transform.translation.y, t2.transform.translation.z])
    p3 = np.array([t3.transform.translation.x, t3.transform.translation.y, t3.transform.translation.z])

    global accumulator_real, accumulator_imag
    transact = recdb.start_transaction()
    if accumulator_real is not None:
        recdb.delete_math_function(accumulator_real)
    if accumulator_imag is not None:
        recdb.delete_math_function(accumulator_imag)

    accumulator_real = snde.accumulate_once.instantiate([ snde.math_parameter_recording("/avgreal"),
                                                          snde.math_parameter_unsigned_const(n*m),
                                                          snde.math_parameter_int_const(-1),
                                                          snde.math_parameter_bool_const(False),
                                                          snde.math_parameter_bool_const(False)],
                                                        [ snde.shared_string("/accum_real") ],
                                                        "/",
                                                        False,
                                                        False,
                                                        False,
                                                        snde.math_definition("accumulator real definition"),
                                                        None)
    recdb.add_math_function(accumulator_real ,False)
    accumulator_imag = snde.accumulate_once.instantiate([ snde.math_parameter_recording("/avgimag"),
                                                          snde.math_parameter_unsigned_const(n*m),
                                                          snde.math_parameter_int_const(-1),
                                                          snde.math_parameter_bool_const(False),
                                                          snde.math_parameter_bool_const(False)],
                                                        [ snde.shared_string("/accum_imag") ],
                                                        "/",
                                                        False,
                                                        False,
                                                        False,
                                                        snde.math_definition("accumulator imag definition"),
                                                        None)
    recdb.add_math_function(accumulator_imag ,False)
    transact.end_transaction()


    ux, uy, uz = u = p2-p1 
    vx, vy, vz = v = p3-p1

    w = np.array([uy*vz-uz*vy, uz*vx-ux*vz, ux*vy-uy*vx])
    #Normalize the cross product to get the magnitude of 1 
    w = w/np.linalg.norm(w) 
    v = np.cross(w, u)
    v = v/np.linalg.norm(v)
    
    d = -np.sum(v*p1)
    #minumum distance 
    r = np.abs(np.sum(v * p3) + d)/np.sqrt(np.sum(v*v))
    
    maguprime = np.linalg.norm(u) 
    magvprime = r 
    
    uprime = np.linspace(0 , maguprime, m) 
    vprime = np.linspace(0, magvprime, n)
    u = u / maguprime 
    uu, vv = np.meshgrid(uprime, vprime) 
    uu = uu.T
    vv = vv.T
    

    # Creating array of zeros 
    ww = np.zeros(uu.shape) 
    
    rot = np.dstack([u, v, w])[0,:,:]
    
    uu, vv, ww = np.einsum( 'ji, mni -> jmn', rot, np.dstack([uu, vv, ww]))
    uu += p1[0] 
    vv += p1[1]
    ww += p1[2]
    
    for j in range(n):
        for i in range (m):
            print("Moving to (x = %.6f, y = %.6f, z = %.6f)" % (uu[i,j], vv[i, j], ww[i,j]))
            t3.transform.translation.x = uu[i,j]
            t3.transform.translation.y = vv[i,j]
            t3.transform.translation.z = ww[i,j]
            ros.Move(t3,0.1,0.1)           
            capturedata()

    SimpleScan_PlotData(uprime[1]-uprime[0], vprime[1]-vprime[0], uu[0,0], vv[0,0], m, n)
    return (uprime[1]-uprime[0], vprime[1]-vprime[0], uu[0,0], vv[0,0], m, n)


def Scan2DPlaneSliced(t1, t2, t3, m, n, raster):


    p1 = np.array([t1.transform.translation.x, t1.transform.translation.y, t1.transform.translation.z])
    p2 = np.array([t2.transform.translation.x, t2.transform.translation.y, t2.transform.translation.z])
    p3 = np.array([t3.transform.translation.x, t3.transform.translation.y, t3.transform.translation.z]) 
  
    ux, uy, uz = u = p2-p1
    vx, vy, vz = v = p3-p1
    w = np.array([uy*vz-uz*vy, uz*vx-ux*vz, ux*vy-uy*vx])
    #Normalize the cross product to get the magnitude of 1 
    w = w/np.linalg.norm(w)
    v = np.cross(w, u)
    v = v/np.linalg.norm(v)
     
    d = -np.sum(v*p1)
    #minumum distance 
    r = np.abs(np.sum(v * p3) + d)/np.sqrt(np.sum(v*v))
    
    maguprime = np.linalg.norm(u)
    magvprime = r
  
    uprime = np.linspace(0 , maguprime, m)
    vprime = np.linspace(0, magvprime, n)
    u = u / maguprime
    uu, vv = np.meshgrid(uprime, vprime)
    uu = uu.T
    vv = vv.T
    
    
    # Creating array of zeros 
    ww = np.zeros(uu.shape)

    rot = np.dstack([u, v, w])[0,:,:]
    
    uu, vv, ww = np.einsum( 'ji, mni -> jmn', rot, np.dstack([uu, vv, ww]))
    uu += p1[0]
    vv += p1[1]
    ww += p1[2]
        
    ustep = uprime[1]-uprime[0]
    if ustep <= .0008:
        nslice = int(np.ceil(.0008/ustep))
    else:
        nslice = 1


    tout = TransformStamped()
    tout.transform.rotation.x = t3.transform.rotation.x
    tout.transform.rotation.y = t3.transform.rotation.y
    tout.transform.rotation.z = t3.transform.rotation.z
    tout.transform.rotation.w = t3.transform.rotation.w

    # Calculate mapping for math channel
    mapdata = np.array([j for k in range(nslice) for j in range(k, m , nslice)])

    # This isn't needed here -- it reverses the process
    #mapdata = [(x,y) for (x,y) in zip(mapdata, range(m))]
    #mapdata.sort()
    #mapdata = [i[1] for i in mapdata]

    accummap = [int(i) for i in (np.repeat(np.array(mapdata).reshape([m,1]), n, axis=1) + np.repeat(np.arange(n).reshape(1,n), m, axis=0)*m).T.flatten()]


    # Reset Math Channels
    global accumulator_real, accumulator_imag, ndaccumulator_real, ndaccumulator_imag
    transact = recdb.start_transaction()
    if accumulator_real is not None:
        recdb.delete_math_function(accumulator_real)
    if accumulator_imag is not None:
        recdb.delete_math_function(accumulator_imag)
    if ndaccumulator_real is not None:
        recdb.delete_math_function(ndaccumulator_real)
    if ndaccumulator_imag is not None:
        recdb.delete_math_function(ndaccumulator_imag)

    chanmetadata = snde.constructible_metadata()
    chanmetadata.AddMetaDatum(snde.metadatum("ande_array-axis0_coord","X Axis"))
    chanmetadata.AddMetaDatum(snde.metadatum("ande_array-axis0_units","mm"))
    chanmetadata.AddMetaDatum(snde.metadatum("ande_array-axis0_offset",uu[0,0], "mm"))
    chanmetadata.AddMetaDatum(snde.metadatum("ande_array-axis0_scale",uprime[1] - uprime[0], "mm"))
    chanmetadata.AddMetaDatum(snde.metadatum("ande_array-axis1_coord","Y Axis"))
    chanmetadata.AddMetaDatum(snde.metadatum("ande_array-axis1_units","mm"))
    chanmetadata.AddMetaDatum(snde.metadatum("ande_array-axis1_offset",vv[0,0], "mm"))
    chanmetadata.AddMetaDatum(snde.metadatum("ande_array-axis1_scale", vprime[1] - vprime[0], "mm"))
    chanmetadata.AddMetaDatum(snde.metadatum("ande_array-ampl_coord","Amplitude"))
    chanmetadata.AddMetaDatum(snde.metadatum("ande_array-ampl_units","Volts"))
    
    accumulator_real = snde.accumulate_once.instantiate([ snde.math_parameter_recording("/avgreal"),
                                                          snde.math_parameter_unsigned_const(n*m),
                                                          snde.math_parameter_int_const(-1),
                                                          snde.math_parameter_bool_const(False),
                                                          snde.math_parameter_bool_const(False)],
                                                        [ snde.shared_string("/accum_real") ],
                                                        "/",
                                                        False,
                                                        False,
                                                        False,
                                                        snde.math_definition("accumulator real definition"),
                                                        None)
    recdb.add_math_function(accumulator_real ,False)
    accumulator_imag = snde.accumulate_once.instantiate([ snde.math_parameter_recording("/avgimag"),
                                                          snde.math_parameter_unsigned_const(n*m),
                                                          snde.math_parameter_int_const(-1),
                                                          snde.math_parameter_bool_const(False),
                                                          snde.math_parameter_bool_const(False)],
                                                        [ snde.shared_string("/accum_imag") ],
                                                        "/",
                                                        False,
                                                        False,
                                                        False,
                                                        snde.math_definition("accumulator imag definition"),
                                                        None)
    recdb.add_math_function(accumulator_imag ,False)

    ndaccumulator_real = snde.nd_accumulate_once.instantiate([ snde.math_parameter_recording("/avgreal"),
                                                               snde.math_parameter_indexvec_const([n,m]),
                                                               snde.math_parameter_indexvec_const(accummap),
                                                               snde.math_parameter_sndeindex_const(int(m*n)),
                                                               snde.math_parameter_bool_const(False),
                                                               snde.math_parameter_bool_const(False),
                                                               snde.math_parameter_bool_const(False),
                                                               snde.math_parameter_metadata_const(chanmetadata)],
                                                             [ snde.shared_string("/ndaccum_real") ],
                                                             "/",
                                                             False,
                                                             False,
                                                             False,
                                                             snde.math_definition("nd accumulator real definition"),
                                                             None)
    recdb.add_math_function(ndaccumulator_real ,False)
    ndaccumulator_imag = snde.nd_accumulate_once.instantiate([ snde.math_parameter_recording("/avgimag"),
                                                               snde.math_parameter_indexvec_const([n,m]),
                                                               snde.math_parameter_indexvec_const(accummap),
                                                               snde.math_parameter_sndeindex_const(int(m*n)),
                                                               snde.math_parameter_bool_const(False),
                                                               snde.math_parameter_bool_const(False),
                                                               snde.math_parameter_bool_const(False),
                                                               snde.math_parameter_metadata_const(chanmetadata)],
                                                             [ snde.shared_string("/ndaccum_imag") ],
                                                             "/",
                                                             False,
                                                             False,
                                                             False,
                                                             snde.math_definition("ndaccumulator imag definition"),
                                                             None)
    recdb.add_math_function(ndaccumulator_imag ,False)


    transact.end_transaction()

    
    try:
        # We don't need ros.t while scanning -- disable for performance
        ros.WaitPauseAcquisition() 

        rate = ros.create_rate(4)
        
        with IncrementalBar("Scanning...", max=m*n, suffix='%(index)d/%(max)d [Elapsed: %(elapsed_td)s -- Remaining: %(eta_td)s -- Avg: %(avg).2f s]') as bar:
            for j in range(n):
                for k in range(nslice):
                    if raster:
                        if j % 2 == 0:
                            for i in range (k, m, nslice):
                                #print("Moving to (x = %.6f, y = %.6f, z = %.6f)" % (uu[i,j], vv[i, j], ww[i,j]))
                                tout.transform.translation.x = uu[i,j]
                                tout.transform.translation.y = vv[i,j]
                                tout.transform.translation.z = ww[i,j]
                                res = ros.Move(tout,0.1,0.1)
                                if res.result.success != True:
                                    raise Exception("Move Failed")
                                capturedata()
                                bar.next()
                                rate.sleep()
                                #if bar.avg > 0.4:
                                #    time.sleep(5)
                                #    bar._xput = deque(maxlen=bar.sma_window)
                                #    bar.avg = 0.0
                                #    bar._avg_update_ts = time.time()
                                #    bar._ts = time.time()
                        else:
                            for i in range (m-k-1, -1, -nslice):
                                #print("Moving to (x = %.6f, y = %.6f, z = %.6f)" % (uu[i,j], vv[i, j], ww[i,j]))
                                tout.transform.translation.x = uu[i,j]
                                tout.transform.translation.y = vv[i,j]
                                tout.transform.translation.z = ww[i,j]
                                res = ros.Move(tout,0.1,0.1)
                                if res.result.success != True:
                                    raise Exception("Move Failed")
                                capturedata()
                                bar.next()
                                rate.sleep()
                                #if bar.avg > 0.4:
                                #    time.sleep(5)
                                #    bar._xput = deque(maxlen=bar.sma_window)
                                #    bar.avg = 0.0
                                #    bar._avg_update_ts = time.time()
                                #    bar._ts = time.time()
                    else:
                        for i in range (k, m, nslice):
                            #print("Moving to (x = %.6f, y = %.6f, z = %.6f)" % (uu[i,j], vv[i, j], ww[i,j]))
                            tout.transform.translation.x = uu[i,j]
                            tout.transform.translation.y = vv[i,j]
                            tout.transform.translation.z = ww[i,j]
                            res = ros.Move(tout,0.1,0.1)
                            if res.result.success != True:
                                raise Exception("Move Failed")
                            capturedata()
                            bar.next()
                            rate.sleep()
                            #if bar.avg > 0.4:
                            #    time.sleep(5)
                            #    bar._xput = deque(maxlen=bar.sma_window)
                            #    bar.avg = 0.0
                            #    bar._avg_update_ts = time.time()
                            #    bar._ts = time.time()
                        

    finally:
        # Restarting ros.t
        ros.WaitUnPauseAcquisition()
    
    Sliced2DScan_PlotData(uprime[1]-uprime[0], vprime[1]-vprime[0], uu[0,0], vv[0,0], m, n, nslice)
    args = (uprime[1]-uprime[0], vprime[1]-vprime[0], uu[0,0], vv[0,0], m, n, nslice)
    return args

def keyScan(full_dome=False, vel=0.05,acc=0.05,slice=9,angle=12,length=0.35,width=0.15,x_pos=0.69, y_pos=-0.09, z_pos=0.946, x_offset=1, output_filepath='/home/labuser/iron_tari/', output_filename='pc.ply'):

    ros.Move('over_curved_geometry',0.1,0.1)
    slice = 9
    pa = ros.reconPoseArray(full_dome, slice,angle,length,width,x_pos, y_pos, z_pos, x_offset)
    pals = list(pa.poses)
    for i in range(slice):
        if i % 2 == 1:
            pals[i*slice:i*slice+slice] = list(reversed(pals[i*slice:i*slice+slice]))
            ros.get_logger().info(f"Reversing slice [{i*slice}:{i*slice+slice}]")

    ros.Move(pals[0],0.1,0.1)
    keyence_start.sendRequest('StartKeyRec', {'distance': 0.0005})
    move1_response = ros.Move(pals[1:],vel,acc)
    while not move1_response.result.success :
        ros.get_logger().info("Waiting for move to finish...", throttle_duration_sec=2.0)
    if move1_response.result.success : move2_response = ros.Move(list(reversed(pals[:-1])),vel,acc)
    while not move2_response.result.success :
        ros.get_logger().info("Waiting for move to finish...", throttle_duration_sec=2.0)
    if move2_response.result.success : stop_response = keyence_stop.sendRequest('StopKeyRec', {'output_filepath': output_filepath, 'output_filename': output_filename})
    if stop_response.success : ros.Move('over_curved_geometry',0.1,0.1)


def NoetherScan(pose_array, n, m, point_spacing, line_spacing):


    tout = TransformStamped()
    approach = TransformStamped()
    retract = TransformStamped()

    accummap = m-1
    
    try:
        # We don't need ros.t while scanning -- disable for performance
        ros.WaitPauseAcquisition()

        rate = ros.create_rate(4)
        
    # Move to start position
        print("Moving to start position")
        approach.transform.translation.x = pose_array.poses[0].position.x
        approach.transform.translation.y = pose_array.poses[0].position.y
        approach.transform.translation.z = pose_array.poses[0].position.z + 0.05
        approach.transform.rotation.x = pose_array.poses[0].orientation.x
        approach.transform.rotation.y = pose_array.poses[0].orientation.y
        approach.transform.rotation.z = pose_array.poses[0].orientation.z
        approach.transform.rotation.w = pose_array.poses[0].orientation.w

        res = ros.Move(approach,0.2,0.2)
        if res.result.success != True:
            raise Exception("Move Failed")
        print("Success")
        with IncrementalBar("Scanning...", max=m*n, suffix='%(index)d/%(max)d [Elapsed: %(elapsed_td)s -- Remaining: %(eta_td)s -- Avg: %(avg).2f s]') as bar:
            for e in range(m):
            
                tout.transform.translation.x = pose_array.poses[e].position.x
                tout.transform.translation.y = pose_array.poses[e].position.y
                tout.transform.translation.z = pose_array.poses[e].position.z
                tout.transform.rotation.x = pose_array.poses[e].orientation.x
                tout.transform.rotation.y = pose_array.poses[e].orientation.y
                tout.transform.rotation.z = pose_array.poses[e].orientation.z
                tout.transform.rotation.w = pose_array.poses[e].orientation.w
    
                res = ros.Move(tout,0.1,0.1)
                if res.result.success != True:
                    raise Exception("Move Failed")
                capturedata()
                bar.next()
                rate.sleep()
        
        retract.transform.translation.x = pose_array.poses[-1].position.x
        retract.transform.translation.y = pose_array.poses[-1].position.y
        retract.transform.translation.z = pose_array.poses[-1].position.z + 0.05
        retract.transform.rotation.x = 0.0
        retract.transform.rotation.y = 0.0
        retract.transform.rotation.z = 1.0
        retract.transform.rotation.w = 0.0

        res = ros.Move(retract,0.2,0.2)
        if res.result.success != True:
            raise Exception("Move Failed")


    finally:
        # Restarting ros.t
        ros.WaitUnPauseAcquisition()
    
    #Sliced2DScan_PlotData(uprime[1]-uprime[0], vprime[1]-vprime[0], uu[0,0], vv[0,0], m, n, nslice)
    args = "Happy Birthday" #(uprime[1]-uprime[0], vprime[1]-vprime[0], uu[0,0], vv[0,0], m, n, nslice)
    return args


def runscansets(scanlist, waypoints):
    for i, step in enumerate(scanlist):
        Scan2DPlane(*step)
        for waypoint in waypoints[i]:
            ros.Move(waypoint,0.1,0.1)

def runscansets2(scanlist, waypoints, loop):
    e=1
    if loop:
        print('You chose to loop!')
    else:
        print('No loop :(')
    while True:
        for i, step in enumerate(scanlist):
            Scan2DPlaneSliced(*step)
            for waypoint in waypoints[i]:
                ros.Move(waypoint,0.1,0.1)
        if not loop:
            print('breaking..')
            break
#        elif keyboard.is_pressed('q'):
#            break
        else:
            print(f'Routine ran {e} time(s)')
            e+=1
            i=0


