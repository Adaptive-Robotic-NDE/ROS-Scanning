                             'k_search': paramdb.k_search.magnitude})

def pinSwitch(pin=0):

    if isinstance(pin, int) and 0 <= pin <= 7:

        if ros.svd_msg.digital_out_states[pin].state:

            ros.get_logger().info(f"Pin {pin} is {Colors.GREEN}ON{Colors.RESET}")
            ros.get_logger().info(f"Switching pin {pin} {Colors.RED}OFF{Colors.RESET}")

            return gpio_client.sendRequest('SetIO',
                                    {'fun': 1,
                                     'pin': pin,
                                     'state': 0.0})
        
        else:

            ros.get_logger().info(f"Pin {pin} is {Colors.RED}OFF{Colors.RESET}")
            ros.get_logger().info(f"Switching pin {pin} {Colors.GREEN}ON{Colors.RESET}")

            return gpio_client.sendRequest('SetIO',
                                    {'fun': 1,
                                     'pin': pin,
                                     'state': 1.0})

def x3dConvert(file="/home/labuser/iron_tari/triangulated_cloud.ply"):

    for obj in bpy.context.scene.objects:
        bpy.data.objects.remove(obj, do_unlink=True)

    if file[-3:] == "ply":
        bpy.ops.wm.ply_import(filepath=file)  # Update with path to ply
    elif file[-3:] == "stl":
        bpy.ops.import_mesh.stl(filepath=file)
    elif file[-3:] == "obj":
        bpy.ops.import_scene.obj(filepath=file)
    else:
        ros.get_logger().error("Wrong file type")
        return
    
    bpy.ops.object.editmode_toggle()
    bpy.ops.mesh.select_all(action='SELECT')
    bpy.ops.mesh.remove_doubles(threshold=0.002, use_unselected=True)
    bpy.ops.mesh.delete_loose(use_faces=True)
    bpy.ops.mesh.dissolve_degenerate(threshold=0.001)
    bpy.ops.mesh.select_mode(use_extend=False, use_expand=False, type='EDGE')
    bpy.ops.mesh.select_all(action='DESELECT')
    bpy.ops.mesh.edges_select_sharp()
    bpy.ops.mesh.mark_seam(clear=False)
    bpy.ops.mesh.select_mode(use_extend=False, use_expand=False, type='FACE')
    bpy.ops.mesh.select_all(action='SELECT')
    bpy.ops.uv.unwrap(method='ANGLE_BASED', margin=0.001)
    bpy.ops.export_scene.x3d(filepath='test.x3d', **{"use_selection": False, 'use_mesh_modifiers':True, 'use_normals': False, 'global_scale':0.001})

