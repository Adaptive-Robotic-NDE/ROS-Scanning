def center(detection=0):

    """Create center pose from yolo pixel coordinates and depth camera data"""

    print(f"{Colors.GREEN}Centering detection")
    # print(f"{Colors.GREEN}Intial Positions")

    pixel_x = detections[detection].bbox.center.position.x
    pixel_y = detections[detection].bbox.center.position.y

    print(pixel_x)
    print(pixel_y)

    if pixel_x > 2048 or pixel_y > 1536:

        print(f"{Colors.RED}Center out of frame")
        return
    
    depth = depthCheck(pixel_x, pixel_y)

    while depth is None:

        if pixel_y < 768:
            pixel_y += 5.0

        elif pixel_y > 768:
            pixel_y -= 5.0

        depth = depthCheck(pixel_x, pixel_y)

    detection_coordinates = azureConvert(pixel_x, pixel_y, depth)

    
    point_detection = PointStamped()
    point_detection.point.x = detection_coordinates[0]
    point_detection.point.y = detection_coordinates[1]
    point_detection.point.z = detection_coordinates[2]
    point_detection.header.frame_id = "azure_rgb"

    point_probe = do_transform_point(point_detection, ros.azure_t)

    pose = Pose()
    pose.position.x = point_probe.point.x - 0.04
    pose.position.y = point_probe.point.y
    pose.position.z = point_probe.point.z + 0.25
    # pose.position.z = ros.t.transform.translation.z
    # print(f"Pose after transform: {pose}")

    ros.addDetection(pose)

    return pose

def cross(detection=0):

    """Create cross section of poses within yolo bounding box for industrial reconstruction"""
    
    try:

        ros.coarse_array.poses = []
        verticle = []
        horizontal = []

        division = 2

        x_upper_unit = abs((ros.coordinate_array.poses[1].position.x - ros.yolo_array.poses[detection].position.x)/(2*division))
        x_lower_unit = abs((ros.yolo_array.poses[detection].position.x - ros.coordinate_array.poses[0].position.x)/(2*division))

        y_upper_unit = abs((ros.coordinate_array.poses[1].position.y - ros.yolo_array.poses[detection].position.y)/(2*division))
        y_lower_unit = abs((ros.yolo_array.poses[detection].position.y - ros.coordinate_array.poses[0].position.y)/(2*division))

        for i in range(division,0,-1):
            x_pose = Pose()
            y_pose = Pose()
            x_pose = copy.deepcopy(ros.yolo_array.poses[detection])
            y_pose = copy.deepcopy(ros.yolo_array.poses[detection])
            x_pose.position.x = x_pose.position.x + x_upper_unit * i
            y_pose.position.y = y_pose.position.y + y_upper_unit * i
            verticle.append(x_pose)
            horizontal.append(y_pose)

        ros.addCross(ros.yolo_array.poses[detection])

        for i in range(division):
            x_pose = Pose()
            y_pose = Pose()
            x_pose = copy.deepcopy(ros.yolo_array.poses[detection])
            y_pose = copy.deepcopy(ros.yolo_array.poses[detection])
            x_pose.position.x = x_pose.position.x - x_lower_unit * (i + 1)
            y_pose.position.y = y_pose.position.y - y_lower_unit * (i + 1)
            verticle.append(x_pose)
            horizontal.append(y_pose)

        for i in range(len(verticle)):
            ros.addCross(verticle[i])

        for i in range(len(horizontal)):
            ros.addCross(horizontal[i])

    except Exception as e:
        print(f"{Colors.RED}Error: {e}{Colors.RESET}")

def corners(detection=0):
    
    """Create coordinates for bounding box dimensions for mesh reconstruction cropping"""

    print(f"{Colors.MAGENTA}Calculating bounding box coordinates")
    # print(f"{Colors.GREEN}Intial Positions")

    center_x = detections[detection].bbox.center.position.x
    center_y = detections[detection].bbox.center.position.y

    corner = []
    orientation = []
    x_orientation = -0.71/2
    y_orientation = 0.71/2
    neg = -1

    half_x = detections[detection].bbox.size.x/2 * neg
    half_y = detections[detection].bbox.size.y/2 * neg

    for j in range(4):
        if j % 2 == 0:
            half_x *= neg
            x_orientation *= neg
        half_y *= neg
        y_orientation *= neg
        orientation.append(transforms3d.euler.euler2quat(x_orientation,y_orientation,0))
        corner.append([center_x + half_x, center_y + half_y]) 

    detection_corner_coordinates = []
    # coord = []
    bad_coord = []
    avg_depth = 0.0
    corners = 0
    depths = []

    # Check for depth value

    for e in range(4):
        depths.append(depthCheck(corner[e][0], corner[e][1]))
        if depths[e]:
            corners += 1

    avg_depth = sum(depths)/corners

    # Convert 2D bounding box point to 3D point in space

    for e in range(4):
        if depths[e]:
            detection_corner_coordinates.append(azureConvert(corner[e][0], corner[e][1], depths[e]))
        else:
            detection_corner_coordinates.append(azureConvert(corner[e][0], corner[e][1], avg_depth))

    # Convert xyz coordinate to PointStamped format to calculate transform from camera

    corner_point = [PointStamped()] * 4
    corner_point_transformed = []
    print("Before add transform")
    for k in range(len(corner_point)):
        corner_point[k].point.x = detection_corner_coordinates[k][0]
        corner_point[k].point.y = detection_corner_coordinates[k][1]
        corner_point[k].point.z = detection_corner_coordinates[k][2]
        corner_point[k].header.frame_id = "azure_rgb"
        corner_point_transformed.append(do_transform_point(corner_point[k], ros.azure_t))

    pa = PoseArray()
    y_offset = 0.1
    print("Before add coordinate")
    for l in range(len(corner_point_transformed)):
        pose = Pose()
        if l % 2 == 0:
            y_offset *= neg
        pose.position.x = corner_point_transformed[l].point.x - 0.04
        pose.position.y = corner_point_transformed[l].point.y + y_offset
        pose.position.z = corner_point_transformed[l].point.z + 0.2
        pose.orientation = Quaternion(w=orientation[l][0], x=orientation[l][1], y=orientation[l][2], z=orientation[l][3])
        ros.addCoordinate(pose)
        # pa.poses.append(pose)
    last_pos = ros.coordinate_array.poses[-1].position
    last_ori = ros.coordinate_array.poses[-1].orientation
    ros.coordinate_array.poses[-1].position = ros.coordinate_array.poses[-2].position
    ros.coordinate_array.poses[-2].position = last_pos
    ros.coordinate_array.poses[-1].orientation = ros.coordinate_array.poses[-2].orientation
    ros.coordinate_array.poses[-2].orientation = last_ori

    return avg_depth

def azureConvert(pixel_x, pixel_y, depth):

                  
    x = (pixel_x - Azure.cx) * depth / Azure.fx
    y = (pixel_y - Azure.cy) * depth / Azure.fy
    z = depth


    return [x, y, z]

def keyScan(vel,accel,detection=0):

    ros.pose_array.poses = []
    n = None
        
    n = noetherKeyence()
    for e in range(len(n)):
        n[e].position.x += -round(ros.keyence_t.transform.translation.x,5)
        n[e].position.y += -round(ros.keyence_t.transform.translation.y,5)
    pinSwitch(pin=0,state=True)
    ros.addPose(n)
    decision = int(input("Does this look right? (1=yes/0=no):  "))
    if not decision:
        print("Quitting")
        return False
    approach = copy.deepcopy(n[0])
    approach.position.z += 0.1

    try:
        ros.Move(ros.yolo_array.poses[detection],vel,accel)
        decision = int(input("Set point for cropping (use publish point in RViz now if yes)? (1=yes/0=no):  "))
        if decision:
            selected_point_x = ros.click_msg.point.x
            selected_point_y = ros.click_msg.point.y
            print(f"Point for cropping\nX: {selected_point_x}\nY: {selected_point_y}\n")
            x = float(input("X dimension: "))/2
            y = float(input("Y dimension: "))/2
            paramdb.crop_min_x = selected_point_x - x
            paramdb.crop_max_x = selected_point_x + x
            paramdb.crop_min_y = selected_point_y - y
            paramdb.crop_max_y = selected_point_y + y
        ros.Move(approach,vel,accel)
        ros.Move(n[0],vel,accel)
        keyenceStart()
        ros.Move(n[1:],0.01,0.01)
        keyenceStop()

    except Exception as e:
        print(f"{Colors.RED}Error: {e}{Colors.RESET}")
        return False

    ros.Move(ros.yolo_array.poses[detection],0.03,0.03)
    pinSwitch(pin=0,state=False)
    return True

def newKeyScan(vel,accel,detection=0):

    ros.pose_array.poses = []
    n = None
    picking_point = True
        
    n = noetherKeyence()
    for e in range(len(n)):
        n[e].position.x += -round(ros.keyence_t.transform.translation.x,5)
        n[e].position.y += -round(ros.keyence_t.transform.translation.y,5)
    pinSwitch(pin=0,state=True)
    ros.addPose(n)
    decision = int(input("Does this look right? (1=yes/0=no):  "))
    if not decision:
        print("Quitting")
        return False
    approach = copy.deepcopy(n[0])
    approach.position.z += 0.1

    try:
        ros.Move(ros.yolo_array.poses[detection],vel,accel)
        while picking_point:
            decision = int(input("Set point for cropping (use publish point in RViz now if yes)? (1=yes/0=no):  "))
            if decision:
                selected_point_x = ros.click_msg.point.x
                selected_point_y = ros.click_msg.point.y
            else:
                selected_point_x = 0.824
                selected_point_y = -0.246
                picking_point = False
            print(f"Point for cropping\nX: {selected_point_x}\nY: {selected_point_y}\n")
            picking_point = not bool(int(input("Does this look right? (1=yes/0=no): ")))

        x = float(input("X dimension: "))/2
        y = float(input("Y dimension: "))/2
        paramdb.crop_min_x = selected_point_x - x
        paramdb.crop_max_x = selected_point_x + x
        paramdb.crop_min_y = selected_point_y - y
        paramdb.crop_max_y = selected_point_y + y
        ros.Move(approach,vel,accel)
        ros.Move(n[0],vel,accel)
        newKeyenceStart()
        ros.Move(n[1:],0.01,0.01)
        newKeyenceStop()

    except Exception as e:
        print(f"{Colors.RED}Error: {e}{Colors.RESET}")
        return False

    ros.Move(ros.yolo_array.poses[detection],0.03,0.03)
    pinSwitch(pin=0,state=False)
    return True

def routine(detection=0, avg_depth=0):
    try:

        print("in routine")

        maxx, maxy, maxz, minx, miny, minz = yoloCrop(detection, avg_depth)

        pause = 3.0
        accel = 0.1
        vel = 0.1

        ros.Move(ros.yolo_array.poses[detection])

        skip = int(input("Skip depth scan? (1=yes/0=no): "))

        if not skip:

            startReconstruction(maxx=maxx,maxy=maxy,maxz=maxz,minx=minx,miny=miny,minz=minz)

            cross(detection)

            for i in range(len(ros.coarse_array.poses)):
                ros.Move(ros.coarse_array.poses[i],vel,accel)
                time.sleep(pause)

            ros.Move(ros.yolo_array.poses[detection],vel,accel)
            time.sleep(pause)

            stopReconstruction()

            paramdb.mesh_filter_input_filepath = paramdb.mesh_filepath
            paramdb.vert_filter = True

            meshFilter()

    except Exception as e:

        print(f"Error: {e}")
        ros.Move("over_table")

    skip = int(input("Skip laser scan? (1=yes/0=no): "))

    if not skip:

        # cont = keyScan(vel,accel,detection)

        cont = newKeyScan(0.05,0.05,detection)

        if not cont:
            return
        
    redo = 1

    latest_modified_folder = max(
        (d for d in pathlib.Path(paramdb.output_filepath).iterdir() if d.is_dir()),
        key=os.path.getmtime # Using modification time
    )
            
    paramdb.x3d_input_filepath =  str(latest_modified_folder) + "/reconstructed_mesh_ball_pivot.ply"
    paramdb.x3d_flip_normals = False # bool(int(input("Flip normals? (1=yes/0=no): ")))
        
    while redo:

        paramdb.eddy_snake = 0 # bool(int(input("Snake raster? (1=yes/0=no): ")))
        # paramdb.eddy_direction = (-1,0,0)
        reso = 0 # int(input("Higher resolution? (1=yes/0=no): "))
        if reso:
            paramdb.eddy_line_spacing = 0.0001

        else:
           paramdb.eddy_line_spacing = 0.0003

        global n

        input_file = str(input("Input file: "))

        if input_file:
            paramdb.eddy_input_file = input_file
            paramdb.x3d_input_filepath = input_file
            latest_modified_folder = os.path.dirname(input_file)

        else:
            paramdb.eddy_input_file = paramdb.x3d_input_filepath

        planning_type = 0 # int(input("Planning type (1=Principal Axis/0=Fixed Axis): "))

        if planning_type:

            n = noetherEddy(fixed=False)

            decision = int(input("Does this look right? (1=yes/0=no): "))

            if not decision:

                return
            
            else:

                redo = 0

        else:

            direction = 1 # int(input("X or Y direction? (1=X/0=Y): "))

            if direction:
                n = noetherEddy(fixed=True,direction=[-1,0,0],origin=[1,0,0])

            else:
                n = noetherEddy(fixed=True,direction=[0,-1,0],origin=[0,1,0])

            decision = int(input("Does this look right? (1=yes/0=no): "))
            if not decision:
                if direction:
                    n = noetherEddy(fixed=True,direction=[1,0,0],origin=[1,0,0])
                else:
                    n = noetherEddy(fixed=True,direction=[0,1,0],origin=[0,1,0])
                question = int(input("Does this look better? (1=yes/0=no): "))
                if not question:
                    redo = int(input("Redo? (1=yes/0=no): "))
                    if not redo:
                        ros.Move('over_table')
                        return
                else:
                    redo = 0
            else:
                redo = 0
    try:
        x3d = x3dConvert()

        print("X3D conversion complete")

        # meshFilter(input=paramdb.output_filename, delete_loose_parts=False)

        print(f"x3d x position: {x3d.position[0]}")
        print(f"x3d y position: {x3d.position[1]}")
        print(f"x3d z position: {x3d.position[2]}")

        ros.specimenMesh(specimen_mesh=paramdb.x3d_output_filepath,x=x3d.position[0],y=x3d.position[1],z=x3d.position[2])
        print(f"{Colors.GREEN}Specimen pose channel: {ros.specimen_pose_channel}{Colors.RESET}")

        time.sleep(3)
        probeProjectChan()
        print(f"{Colors.YELLOW}Probe Projection Complete{Colors.RESET}")

        time.sleep(3)
        mapScan()
        recdb.latest_defined_globalrev().get_ndarray_ref('/specimen_pose_copy').data
        recdb.latest_defined_globalrev().get_ndarray_ref('/probe_pose_copy').data
        print(f"{Colors.CYAN}Map Scan Complete{Colors.RESET}")

        time.sleep(3)

    except Exception as e:
        print(f"Encountered error: {e}")

    reverse = int(input("Reverse array? (1=yes/0=no): "))
    if reverse:
        n.reverse()

    approach = [0]*2
    approach[0] = copy.deepcopy(n[0])
    approach[0].position.z += 0.1
    approach[0].orientation = Quaternion(w=1.0, x=0.0, y=0.0, z=0.0)
    approach[1] = copy.deepcopy(n[0])
    approach[1].position.z += 0.05

    retract = [0]*2
    retract[0] = copy.deepcopy(n[-1])
    retract[0].position.z += 0.05
    retract[1] = copy.deepcopy(n[-1])
    retract[1].position.z += 0.1
    retract[1].orientation = Quaternion(w=1.0, x=0.0, y=0.0, z=0.0)

    accel = 0.05
    vel = 0.05
    global timestamp
    timestamp = time.strftime("%Y-%m-%d_%H-%M-%S")

    eddy_line_spacing = paramdb.eddy_line_spacing.to(ureg.millimeter)


    global eddy_points
    eddy_points = {
        'force_x': [],
        'force_y': [],
        'force_z': [],
        'complex_real': [],
        'complex_imag': [],
        'n': [],
        'x': [],
        'y': [],
        'z': [],
        'elapsed_time': 0.0,
        'line_spacing': str(eddy_line_spacing)}

    try:
        ros.Move(ros.yolo_array.poses[detection],vel,accel)
        ros.Move(approach[0],vel,accel)
        ros.Move(approach[1],vel,accel)
        ros.Move(n[0],0.05,0.01)
        null_uni = int(input("Null Uniwest? (yes=1/n=0): "))
        if not null_uni:
            print("Quitting")
            ros.Move(approach[1],vel,accel)
            ros.Move(approach[0],vel,accel)
            ros.Move(ros.yolo_array.poses[detection],vel,accel)
            ros.Move('over_table')
            return
        mapScan()
        eddy_points['force_x'].append(float(ros.sync_force_msg.wrench.force.x))
        eddy_points['force_y'].append(float(ros.sync_force_msg.wrench.force.y))
        eddy_points['force_z'].append(float(ros.sync_force_msg.wrench.force.z))
        eddy_points['complex_real'].append(float(complexdata.real))
        eddy_points['complex_imag'].append(float(complexdata.imag))
        eddy_points['n'].append(0)
        eddy_points['x'].append(float(ros.t.transform.translation.x))
        eddy_points['y'].append(float(ros.t.transform.translation.y))
        eddy_points['z'].append(float(ros.t.transform.translation.z))
        # eddy_points['x'].append(float(n[0].position.x))
        # eddy_points['y'].append(float(n[0].position.y))
        # eddy_points['z'].append(float(n[0].position.z))
        global bar
        bar = IncrementalBar("Scanning...", max=len(n)-1, suffix='%(index)d/%(max)d [Elapsed: %(elapsed_td)s -- Remaining: %(eta_td)s -- Avg: %(avg).2f s]')
        with bar:
            for i in range(1,len(n)):
                ros.Move(n[i],0.05,0.01)
                mapScan()
                eddy_points['force_x'].append(float(ros.sync_force_msg.wrench.force.x))
                eddy_points['force_y'].append(float(ros.sync_force_msg.wrench.force.y))
                eddy_points['force_z'].append(float(ros.sync_force_msg.wrench.force.z))
                eddy_points['complex_real'].append(float(complexdata.real))
                eddy_points['complex_imag'].append(float(complexdata.imag))
                eddy_points['n'].append(int(i))
                eddy_points['x'].append(float(ros.t.transform.translation.x))
                eddy_points['y'].append(float(ros.t.transform.translation.y))
                eddy_points['z'].append(float(ros.t.transform.translation.z))
                # eddy_points['x'].append(float(n[i].position.x))
                # eddy_points['y'].append(float(n[i].position.y))
                # eddy_points['z'].append(float(n[i].position.z))
                bar.next()

        # ros.Move(retract[0],vel,accel)
        # ros.Move(retract[1],vel,accel)

    except Exception as e:
        print(f"{Colors.RED}Error: {e}{Colors.RESET}")

    finally:
        retract[0] = copy.deepcopy(n[i])
        retract[0].position.z += 0.05
        retract[1] = copy.deepcopy(n[i])
        retract[1].position.z += 0.1
        retract[1].orientation = Quaternion(w=1.0, x=0.0, y=0.0, z=0.0)
        ros.Move(retract)
        ros.Move('over_table')

        eddy_points['elapsed_time'] = bar.elapsed
        
        filename = ''

        specimen = int(input('What was scanned here? (Cylinder=1/Calibration Plate=0)'))

        flaws = int(input('How many flaws were scanned here? '))

        if specimen:


            first = [0]*flaws
            second = [0]*flaws
            third = [0]*flaws
            hyphen = '-'

            for flaw in range(flaws):
                first[flaw] = str(input(f'Is flaw {flaw} horizontal(0) or vertical(9)?'))
                second[flaw] = str(input('1mm(1) or 3mm(3)?'))
                third[flaw]= str(input('How many passes? 500(5) 650(6) 750(7)'))
                filename += str(first[flaw]+hyphen+second[flaw]+hyphen+third[flaw]+'_')

        else:

            for flaw in range(flaws):
                notch = str(input(f"What size is notch {flaw + 1}?"))
                filename += str(notch+'_')


        filename += 'eddy_data_' + timestamp +'.pkl'

        filepath = os.path.join(latest_modified_folder, filename)

        print(f"{Colors.GREEN}Saved pickles to: {filepath}{Colors.RESET}")
            
        with open(filepath, 'wb') as f:
            pickle.dump(eddy_points, f)

        # print(i)

def start():

    try:

        pinSwitch(pin=0,state=True)
        
        over_table = ros.Move("over_table")

        while not over_table.result.success:
            print("Moving over table...")
            time.sleep(1.0)

        ros.yolo_array.poses = []

        global detections

        detections = ros.tracked_detection.detections

        time.sleep(1.0)

        yoloEnable(False)

        for i in range(len(detections)):
            center(i)

        next = 1

        while next:
    
            det = int(input(f"Select detection 1-{len(detections)}: ")) - 1
            avg_depth = corners(det)
            routine(det, avg_depth)

            next = int(input("Keep going? (1=yes/0=no): "))

    except Exception as e:

        print(f"Error in execution: {e}")

    finally:

        pinSwitch(pin=0,state=False)
        pinSwitch(pin=1,state=False)

        ros.Move("over_table")

        yoloEnable(True)

def yoloEnable(enable):

    if enable:
        print(f"{Colors.CYAN}Enabling YOLO!")
    else:
        print(f"{Colors.CYAN}Disabling YOLO!")

    return yolo_enable_client.sendRequest('SetBool',{'data':enable})

def depthCheck(pixel_x, pixel_y):

    depth_value = ros.depth_image[int(pixel_y),
                            int(pixel_x)]/1000
    

    if depth_value != 0.0:

        return depth_value
    
    else:
        
        return 0.0

def yoloCrop(detection = 0, avg_depth = 0):

    print("in yolo crop")

    bbox_coordinates = [[0]*2 for _ in range(4)]
    azure_coordinates = [[0]*3 for _ in range(4)]

    # azure_scale = azure_client.sendRequest('AzureFovScaler', { 'distance': depth_value})

    pixel_x = detections[detection].bbox.center.position.x
    pixel_y = detections[detection].bbox.center.position.y

    print("depth check")

    depth = depthCheck(pixel_x, pixel_y)
    
    if not depth:

        depth = avg_depth

    print("successful depth check!")

    detection_coordinates = azureConvert(pixel_x, pixel_y, depth)


    point_detection = PointStamped()
    point_detection.point.x = detection_coordinates[0]
    point_detection.point.y = detection_coordinates[1]
    point_detection.point.z = detection_coordinates[2]
    point_detection.header.frame_id = "azure_rgb"

    point_probe = do_transform_point(point_detection, ros.azure_t)

    pose = Pose()
    pose.position.x = point_probe.point.x
    pose.position.y = point_probe.point.y
    pose.position.z = point_probe.point.z
    # pose.position.z = ros.t.transform.translation.z
    
    # ros.addPose(pose)

    # input("You ready?")
    # ros.Move(pose)

    # input("New detection section")

    # if len(ros.detected.detections) == 1:
    # 
    #     detection = 0

    pixel_x = detections[detection].bbox.center.position.x
    pixel_y = detections[detection].bbox.center.position.y

    bbox_x = detections[detection].bbox.size.x/2
    bbox_y = detections[detection].bbox.size.y/2

    # Point 1 Upper Left
    bbox_coordinates[0][0] = pixel_x - bbox_x
    bbox_coordinates[0][1] = pixel_y - bbox_y

    # Point 2 Upper Right
    bbox_coordinates[1][0] = pixel_x + bbox_x
    bbox_coordinates[1][1] = pixel_y - bbox_y

    # Point 3 Lower Left
    bbox_coordinates[2][0] = pixel_x - bbox_x
    bbox_coordinates[2][1] = pixel_y + bbox_y

    # Point 4 Lower Right
    bbox_coordinates[3][0] = pixel_x + bbox_x
    bbox_coordinates[3][1] = pixel_y + bbox_y

    points = [[PointStamped()]*2 for _ in range(4)]

    for i in range(len(bbox_coordinates)):
        azure_coordinates[i]=azureConvert(bbox_coordinates[i][0], bbox_coordinates[i][1], avg_depth)
        point = PointStamped()
        if azure_coordinates[i] is not None:
            point.point.x = azure_coordinates[i][0]
            point.point.y = azure_coordinates[i][1]
            point.point.z = azure_coordinates[i][2]
            point.header.frame_id = "azure_rgb"
            points[i][0] = point
            points[i][1] = do_transform_point(points[i][0], ros.azure_t)

    options = []

    for i in range(len(azure_coordinates)):
        if azure_coordinates[i]:
            options.append(i)

    print(f"options: {options}")

    if (1 in options) and (2 in options) :
        print("Points 2 and 3 chosen")
        maxx = points[1][1].point.x
        minx = points[2][1].point.x
        maxy = points[2][1].point.y
        miny = points[1][1].point.y
        if points[1][1].point.z > points[2][1].point.z:
            maxz = points[1][1].point.z + 0.1
            minz = points[2][1].point.z - 0.1
        elif points[1][1].point.z < points[2][1].point.z:
            maxz = points[2][1].point.z + 0.1
            minz = points[1][1].point.z - 0.1

    elif (0 in options) and (3 in options) :
        print(f"Points 1 and 4 chosen")
        maxx = points[0][1].point.x
        minx = points[3][1].point.x
        maxy = points[3][1].point.y
        miny = points[0][1].point.y
        if points[0][1].point.z > points[3][1].point.z:
            maxz = points[0][1].point.z + 0.1
            minz = points[3][1].point.z - 0.1
        elif points[0][1].point.z < points[3][1].point.z:
            maxz = points[3][1].point.z + 0.1
            minz = points[0][1].point.z - 0.1
    
    elif not (((1 in options) and (2 in options)) or ((0 in options) and (3 in options))):

        print(f"Points {options[0]} and {options[1]} chosen")

        if options[1] - options[0] > 1:
            maxx = points[options[0]][1].point.x
            minx = points[options[1]][1].point.x
            if options[1] + options[0] > 2:
                print("Options added together > 2")
                miny = statistics.mean([points[options[1]][1].point.y,points[options[0]][1].point.y])
                xdis = points[options[0]][1].point.x - points[options[1]][1].point.x
                ratio = xdis/bbox_x
                ydis = ratio*bbox_y
                maxy = miny + ydis
            else:
                print("Options added together =< 2")
                maxy = statistics.mean([points[options[1]][1].point.y,points[options[0]][1].point.y])
                xdis = points[options[0]][1].point.x - points[options[1]][1].point.x
                ratio = xdis/bbox_x
                ydis = ratio*bbox_y
                miny = maxy - ydis

            maxz = points[options[1]][1].point.z + 0.1
            minz = points[options[1]][1].point.z - 0.1

            
        else:
            print("Options substracted = 1")
            maxy = points[options[1]][1].point.y
            miny = points[options[0]][1].point.y
            maxx = statistics.mean([points[options[1]-1][1].point.x,points[options[0]][1].point.x])
            ydis = points[options[1]][1].point.y - points[options[0]][1].point.y
            ratio = ydis/bbox_y
            xdis = ratio*bbox_x
            minx = maxx - xdis
            maxz = points[options[1]][1].point.z + 0.1
            minz = points[options[1]][1].point.z - 0.1
    else:

        # return "we tried (y)"
        print("lol give up")


    print(f"maxx = {maxx}")
    print(f"minx = {minx}")
    print(f"maxy = {maxy}")
    print(f"miny = {miny}")
    print(f"maxz = {maxz}")
    print(f"minz = {minz}")

    return maxx, maxy, maxz, minx, miny, minz

def normalize(vect):
    norm = np.linalg.norm(vect)
    if norm == 0:
       return vect
    return vect / norm

def calculateRegistration(detection_id):

    print(f"{Colors.YELLOW}Calculating Registration")

    for detection in ros.tags.detections:
        if detection.id == detection_id:
            selected_detection = detection

    azure_transform = ros.azure_t

    pixel_x = selected_detection.centre.x
    pixel_y = selected_detection.centre.y

    depth = depthCheck(pixel_x, pixel_y)

    tag_coordinates = azureConvert(pixel_x, pixel_y, depth)

    transformed_detection = PointStamped()
    transformed_detection.point.x = tag_coordinates[0]
    transformed_detection.point.y = tag_coordinates[1]
    transformed_detection.point.z = tag_coordinates[2]
    transformed_detection.header.frame_id = "azure_rgb"

    tag_center = do_transform_point(transformed_detection, azure_transform)
    position = [tag_center.point.x, tag_center.point.y,tag_center.point.z]

    print(f"Position: {Colors.RESET}", position)

    corners = []

    for corner in selected_detection.corners:
         pixel_x = corner.x
         pixel_y = corner.y
         print(f"Pixel X: {pixel_x}, Pixel Y: {pixel_y}")
         depth = depthCheck(pixel_x, pixel_y)
         print(depth)
         corner_coordinate = azureConvert(pixel_x, pixel_y, depth)
         transformed_coordinate = PointStamped()
         transformed_coordinate.point.x = corner_coordinate[0]
         transformed_coordinate.point.y = corner_coordinate[1]
         transformed_coordinate.point.z = corner_coordinate[2]
         print(corner_coordinate[2])
         transformed_coordinate.header.frame_id = "azure_rgb"
         transformed_corner = do_transform_point(transformed_coordinate, azure_transform)
         transformed_corner_coords = [transformed_corner.point.x, transformed_corner.point.y, transformed_corner.point.z]
         corners.append(transformed_corner_coords)

    translation_vector = np.array(position)

    v_edge1 = np.array(corners[1]) - np.array(corners[0])

    v_edge2 = np.array(corners[3]) - np.array(corners[0])

    x_axis = normalize(v_edge1)

    y_axis = normalize(v_edge2)

    z_axis = normalize(np.cross(v_edge1, v_edge2))

    y_axis = normalize(np.cross(z_axis, x_axis))

    transformation_matrix = np.array([
        [y_axis[0], -x_axis[0], z_axis[0], translation_vector[0]],
        [y_axis[1], -x_axis[1], z_axis[1], translation_vector[1]],
        [y_axis[2], -x_axis[2], z_axis[2], translation_vector[2]],
        [0.0,       0.0,       0.0,       1.0]
    ])

    matrix_flat = transformation_matrix.flatten().tolist()

    return matrix_flat

