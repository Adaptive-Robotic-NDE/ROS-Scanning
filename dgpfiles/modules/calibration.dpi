class CalibrationRefused(Exception):
    """This calibration will not be attempted, or will not be believed."""


# ------------------------------------------------------------------------------
# The artifact
# ------------------------------------------------------------------------------

#: INNER CORNERS, not squares. A 10 x 7 square board has 9 x 6 inner corners,
#: and giving the square count is the classic way to get a detection that never
#: succeeds. Odd x even is deliberate: it is what lets a detector and a human
#: agree which way up the board is, and it makes the half-turn ambiguity a
#: single consistent choice rather than a per-image coin toss.
CAL_BOARD_COLS = 9
CAL_BOARD_ROWS = 6

#: NOMINAL square pitch, metres -- what you asked the printer for.
#:
#: 20 mm, NOT 25. 9 x 6 inner corners is 10 x 7 SQUARES, which at 25 mm is
#: 250 x 175 mm and does not clear the unprintable margin of a US Letter sheet;
#: at 20 mm it is 200 x 140 mm and clears it comfortably in landscape. The
#: ready-to-print sheet is docs/calibration/tari_calibration_board_20mm_letter.pdf
#: and docs/calibration/make_board.py generates it. A different sheet means a
#: different number here.
CAL_BOARD_SQUARE = 0.020

#: MEASURED square pitch, metres, or None. SET THIS. A consumer printer is
#: 1-2% off in scale, and it is off by different amounts along and across the
#: paper. 1.5% of a 20 mm square is 0.3 mm per square and 3 mm across the
#: board, and the hand-eye solve turns board scale error straight into camera
#: standoff error -- 1.5% of the 0.55 m working distance is 8 mm, which is most
#: of the 13.6 mm this whole procedure exists to remove, arriving through the
#: artifact instead of through the fixture.
#:
#: MEASURE THE WHOLE BOARD, NOT ONE SQUARE. The shipped sheet has border bars
#: whose INNER faces are exactly 200.00 x 140.00 mm apart -- a caliper's inside
#: jaws land on them, which is the only crisp physical edge a checkerboard has,
#: because half the nominal boundary is white paper with nothing printed on it.
#: set_board_square() records the result.
CAL_BOARD_MEASURED_SQUARE = None

#: Ceramic balls on the plate, if it has them. Radius in metres; centres in the
#: artifact frame, whose origin is on the plate's ground top face with +z out
#: of it. Empty is fine: calibration_test.py measures that a bare ground flat
#: determines the Keyence to 0.05 mm provided the STANDOFF is varied, and the
#: balls buy 0.02 mm and a range-error diagnostic rather than the difference
#: between working and not. See docs/calibration-procedure.md.
CAL_BALL_RADIUS = 0.0127
CAL_BALL_CENTRES = []

# ---- the 3D-printed artifact -------------------------------------------------
# WHICH ARTIFACT cal_artifact() DESCRIBES. "flat" is the ground calibration
# plate, which works and needs the pose set to fly three standoffs. "printed"
# is docs/calibration/tari_calibration_artifact.stl, whose features span
# 0..24 mm, so one pass at one height already sees seven different distances
# and the range variation stops depending on the pose set at all.
CAL_ARTIFACT = "flat"

#: The printed artifact's geometry, metres, in its own frame -- x and y from
#: the CHAMFERED corner, z = 0 the table it stands on. From
#: docs/calibration/make_artifact.py, which is the generator that produced the
#: STL and carries the design reasoning.
#:
#: THESE ARE THE DESIGN, NOT THE PART. A printer is good to a few tenths of a
#: millimetre and the answer being solved for is half a millimetre, so
#: characterise the printed part ONCE -- a height gauge, or a Keyence pass over
#: it with the current calibration -- and overwrite CAL_ARTIFACT_PAD_TOPS with
#: what it actually measures. After that the printer's tolerance is irrelevant,
#: which is what makes 3D printing legitimate here rather than a compromise.
CAL_ARTIFACT_SIZE = 0.160
CAL_ARTIFACT_CHAMFER = 0.025
CAL_ARTIFACT_BASE_TOP = 0.004
CAL_ARTIFACT_PAD_D = 0.022
CAL_ARTIFACT_PAD_PITCH = 0.045
CAL_ARTIFACT_PAD_0 = 0.035
#: Pad TOP heights above the table, row-major from the chamfered corner. No
#: rotation of the pattern maps this onto itself, which is what makes the
#: artifact's pose unambiguous from shape alone.
CAL_ARTIFACT_PAD_TOPS = [0.007, 0.014, 0.021,
                         0.024, 0.010, 0.017,
                         0.014, 0.007, 0.021]
CAL_ARTIFACT_CONE_XY = [(0.0575, 0.0575), (0.1025, 0.0575),
                        (0.0575, 0.1025), (0.1025, 0.1025)]
CAL_ARTIFACT_CONE_D = 0.026
CAL_ARTIFACT_CONE_APEX = 0.013
#: How much of the table around the artifact is believed to be flat and at
#: z = 0. It is a real, large feature the head sees at every pose, so it is
#: part of the model rather than data to be trimmed away.
CAL_ARTIFACT_TABLE_EXTENT = 0.30

#: The LJ-V7080's SPECIFIED reference distance, metres, and the same number as
#: keyence_ref_dist in lj_v7080_macro.xacro and KEYENCE_REF_DIST_M in
#: keyence_standoff.dpi. Used for exactly one thing -- reading the cell's
#: keyence_ref_dist_cal back out of live TF, since TF publishes only the sum.
#: A cell that has fitted a different head changes it in all three places.
CAL_KEYENCE_REF_DIST = 0.080

#: The window the LJ-V7080 can actually measure over, metres from the optical
#: frame: the reference distance +/- 23 mm. A calibration pose outside it is
#: refused rather than flown; a pose set that stands the head off 0 mm ends in
#: a collision.
global CAL_KEYENCE_RANGE_M
CAL_KEYENCE_RANGE_M = (0.057, 0.103)

#: THE ARTIFACT IS NOT A PLANE, and the datum is not its lowest point.
#:
#: The printed artifact (docs/calibration/make_artifact.py) is 160 x 160 mm
#: with nine cylindrical pads and four cones standing 3..20 mm above a 4 mm
#: base. The point an operator can most easily and repeatably touch a probe tip
#: to is THE CENTRE CYLINDER -- pad 4, at (80, 80) in artifact coordinates,
#: whose top is 10 mm above the bottom of the base.
#:
#: So the taught datum sits 10 mm up a 24 mm object, and the rest of the
#: artifact spans -10 mm (the bench around it) to +14 mm (the tallest pad)
#: RELATIVE TO THE DATUM. Every one of those heights eats into the head's
#: 46 mm measuring window, and a standoff that is fine for the datum can put
#: the tallest pad inside the near limit. Heights in metres, relative to the
#: taught point.
global CAL_ARTIFACT_HEIGHTS
CAL_ARTIFACT_HEIGHTS = {
    "the bench around it": -0.010,
    "the base top":        -0.006,
    "the lowest pads":     -0.003,
    "the datum pad":        0.000,
    "the cone apices":      0.003,
    "the tallest pads":     0.014,
}

#: Every Nth point handed to the recovery check. 60 stacked profiles at a
#: static pose are one line measured 60 times, so a tenth of them carries
#: essentially all of the information at a tenth of the cost.
global CAL_RECOVERY_STRIDE
CAL_RECOVERY_STRIDE = 12

#: Where to aim, relative to the taught datum, in metres. Each offset gets the
#: whole tilt/roll/standoff set, so this multiplies the pose count.
#:
#: NOT ALL AT THE CENTRE PAD, which is what (0, 0) alone gives. The artifact's
#: whole claim is that one profile line sees many heights at once -- but the
#: pads sit on a 45 mm grid and the laser line is 41 mm long, so a line centred
#: on the middle pad reaches 20 mm and touches nothing else. Such a set
#: measures exactly TWO surfaces, the centre pad and the base around it, both
#: horizontal planes at a fixed separation. Solved from that, the sensor's
#: standoff and the artifact's height are the same parameter: the fit trades
#: several millimetres of sensor height against the same amount of artifact
#: height and lands every point within 0.2 mm of where it started, so the
#: solve looks converged and has learned nothing.
#:
#: 22.5 mm is half the pad pitch. A line centred there runs from 2 mm to 43 mm
#: out, so it crosses the centre pad's rim at 11 mm AND the neighbouring pad's
#: rim at 34 mm, and returns three heights in one profile. The four offsets are
#: the four directions to the edge-centre pads, whose tops are 7.1, 14.1, 17.1
#: and 21.1 mm -- four different second heights.
global CAL_KEYENCE_AIM_OFFSETS
CAL_KEYENCE_AIM_OFFSETS = ((0.0, 0.0),
                           (+0.0225, 0.0), (-0.0225, 0.0),
                           (0.0, +0.0225), (0.0, -0.0225))

#: Tilts flown at the OFF-CENTRE aim points. The full CAL_KEYENCE_TILTS set at
#: all five aims is 130 poses and over an hour; the off-centre aims are not
#: there for incidence variety -- the centre aim already carries that -- they
#: are there so a profile crosses two pad heights instead of one. Untilted is
#: enough for that, and keeps the set at 26 + 4 x 6 = 50 poses.
global CAL_KEYENCE_OFFSET_TILTS
CAL_KEYENCE_OFFSET_TILTS = [(0, 0)]

#: How much of the measuring window to keep in hand at each end.
global CAL_KEYENCE_RANGE_MARGIN_M
CAL_KEYENCE_RANGE_MARGIN_M = 0.005


#: HOW BIG THE ARTIFACT IS IN PLAN, metres, centred on the taught datum. The
#: printed artifact is 160 x 160 mm and the datum is its centre cylinder, so
#: the box reaches 80 mm each way. A board bonded to a plate is whatever the
#: plate is; set this to match.
global CAL_ARTIFACT_FOOTPRINT_M
CAL_ARTIFACT_FOOTPRINT_M = (0.160, 0.160)

#: How close any part of the tooling may come to the artifact.
#:
#: FIVE MILLIMETRES, WHICH IS WHAT THE RASTER'S OWN CLEARANCE GATE USES
#: (TOOLING_CLEARANCE_M in tooling_clearance.dpi, 2 mm of it sampling pad), so
#: a calibration pose and a scan pose are held to one standard. Do not raise
#: it to 10 mm: that refuses the whole d-15 standoff, because the near rung
#: puts the probe tip 19 mm above the datum by geometry and the tall pads reach
#: 14 mm. Losing that rung loses the standoff spread, and the standoff spread
#: is the only thing that measures rotation of the head about its own laser
#: line.
global CAL_ARTIFACT_CLEARANCE_M
CAL_ARTIFACT_CLEARANCE_M = 0.005


global _cal_hits_artifact
def _cal_hits_artifact(xyz, quat, aim_xyz, envelope=None, artifact=None):
    """(worst penetration in metres, link) if this pose puts tooling in the
    artifact, else (None, None).

    The work-volume, IK and cable-envelope screens in _cal_candidate_poses()
    do not ask whether the tool ends up inside the thing it is measuring; this
    does, and without it a tilted pose can be flown into the artifact.

    It only matters once a pose is tilted. An untilted pose holds probe_end
    35 mm above the datum. Tilt the tool 25 degrees and probe_end -- which sits
    about 75 mm to the side of the optical frame -- swings through that offset:
    `keyence t+25,+0 r-90 d0` commands probe_end to z 0.9310 against a datum at
    0.9317, i.e. 0.7 mm INTO the surface and 15 mm below the tallest pad.

    THE SHAPE IS A RADIAL ENVELOPE OF THE REAL ARTIFACT when there is a model
    of it, and a flat box only when there is not. The operator teaches ONE
    point -- the top of the centre pad -- so the artifact's yaw is unknown at
    pose-generation time and a height field cannot be evaluated. The maximum
    height on each circle about the centre can, for every yaw at once. That
    matters: calling the whole 160 mm footprint as tall as its tallest pad
    refuses every near-standoff pose over the plate edge, which is most of the
    d-15 rung. See radial_clearance_profile() in calibration_solve.py.

    Either model can only refuse poses the true shape would allow, never allow
    one it would refuse.
    """
    env = tooling_envelope() if envelope is None else envelope
    # tooling_envelope() RETURNS A ToolingEnvelope OBJECT, not an array and not
    # a dict. Reading it as one raises `float() argument must be ... not
    # 'ToolingEnvelope'` on every candidate, and the caller's except-clause
    # turns that into one printed line and NO CLEARANCE CHECKING AT ALL. Any
    # test of this path must use the real class, not an array stand-in.
    #
    # Per-LINK rather than one flat point cloud, so the refusal can name the
    # part that is inside the artifact. That name is the whole value of the
    # message to somebody standing at the pendant: "ec_probe" says the tilt
    # swung the probe through, "azure_base" says something quite different.
    groups = []
    links = getattr(env, "links", None)
    if links is None and isinstance(env, dict):
        links = env.get("links")
    if links:
        groups = [(l["name"], np.asarray(l["points"], float).reshape(-1, 3))
                  for l in links]
    else:
        pts = getattr(env, "points", None)
        if pts is None:
            pts = env["points"] if isinstance(env, dict) else env
        groups = [(None, np.asarray(pts, float).reshape(-1, 3))]

    g = _cal_geom()
    R = g.quat_to_R(quat)
    aim = np.asarray(aim_xyz, float)
    c = CAL_ARTIFACT_CLEARANCE_M
    prof = _cal_clearance_profile(artifact)
    fx, fy = CAL_ARTIFACT_FOOTPRINT_M
    if prof is None:
        lo_rel = min(CAL_ARTIFACT_HEIGHTS.values())
        hi_rel = max(CAL_ARTIFACT_HEIGHTS.values())
    else:
        lo_rel = float(prof[1].min())

    worst, who = None, None
    for name, pts in groups:
        if not pts.size:
            continue
        world = pts.dot(R.T) + np.asarray(xyz, float)
        dx, dy = world[:, 0] - aim[0], world[:, 1] - aim[1]
        if prof is None:
            near = (np.abs(dx) <= fx/2.0 + c) & (np.abs(dy) <= fy/2.0 + c)
            top = np.full(world.shape[0], aim[2] + hi_rel + c)
        else:
            r = np.hypot(dx, dy)
            near = r <= prof[0][-1]
            top = aim[2] + np.interp(r, prof[0], prof[1]) + c
        inside = near & (world[:, 2] >= aim[2] + lo_rel) & (world[:, 2] <= top)
        if not inside.any():
            continue
        # Penetration measured DOWN FROM THE TOP of the forbidden region, which
        # is how far the pose would have to be lifted to clear it.
        depth = float((top[inside] - world[inside, 2]).max())
        if worst is None or depth > worst:
            worst, who = depth, name
    return worst, who


global _cal_clearance_profile
def _cal_clearance_profile(artifact=None):
    """(radii, height above the datum) for the artifact in use, or None.

    None means "no model" and the caller falls back to the flat box. Cached,
    because it is the same answer for every candidate in a set and there are
    hundreds of candidates.
    """
    art = artifact
    if art is None:
        try:
            art = cal_artifact()
        except Exception:                                     # noqa: BLE001
            return None
    key = id(art)
    hit = _CAL.get("clearance_profile")
    if hit is not None and hit[0] == key:
        return hit[1]
    prof = None
    try:
        r, h = _cal_geom().radial_clearance_profile(art)
        prof = (np.asarray(r, float), np.asarray(h, float))
    except Exception:                                         # noqa: BLE001
        prof = None                # a PlateArtifact, or a shape with no pads
    _CAL["clearance_profile"] = (key, prof)
    return prof


global cal_artifact_standoff_report
def cal_artifact_standoff_report(standoffs=None, heights=None, quiet=False):
    """Which parts of the artifact each standoff can actually measure.

    NOT keyence_standoff_report(), which is a DIFFERENT function in
    keyence_standoff.dpi that gates a planned raster against a mesh. Do not
    give this one that name: every .dpi shares one globals() and calibration.dpi
    is included last, so a duplicate name here silently replaces the other
    definition and the standoff gate inside every Keyence sweep calls this
    instead. dpi_exports_test.py fails on any name defined in two .dpi files.

    Returns {standoff: [names in range]}. Refuses nothing; SAYS everything.

    A standoff is not right or wrong on its own -- it is right or wrong for the
    SHAPE in front of it. With the centre cylinder as the datum, the default
    (-15, 0, +15) mm offsets put the tallest pads 51 mm from the head at the
    near end, inside its 57 mm minimum, so those pads return nothing; and the
    surrounding bench 105 mm away at the far end, past its 103 mm maximum.
    Neither is a collision and neither is a fault -- losing the bench costs
    nothing at all -- but an operator who does not know it will read the gaps
    as a broken sensor.
    """
    so = tuple(CAL_KEYENCE_STANDOFFS if standoffs is None else standoffs)
    h = dict(CAL_ARTIFACT_HEIGHTS if heights is None else heights)
    lo, hi = CAL_KEYENCE_RANGE_M
    m = CAL_KEYENCE_RANGE_MARGIN_M
    out = {}
    if not quiet:
        _cal_say("  what each standoff can see, with the datum %.0f mm up the "
                 "artifact (window %.0f..%.0f mm, %.0f mm margin):"
                 % (1e3*abs(min(h.values())), 1e3*lo, 1e3*hi, 1e3*m))
    for d in so:
        stand = CAL_KEYENCE_REF_DIST + float(d)
        seen, missed = [], []
        for name, height in sorted(h.items(), key=lambda kv: -kv[1]):
            r = stand - height
            (seen if (lo + m) <= r <= (hi - m) else missed).append((name, r))
        out[float(d)] = [n for n, _r in seen]
        if not quiet:
            _cal_say("    d%+05.1f mm (stand-off %.0f mm): %d of %d in range%s"
                     % (1e3*d, 1e3*stand, len(seen), len(h),
                        "" if not missed else
                        " -- MISSES " + ", ".join(
                            "%s at %.0f mm" % (n, 1e3*r) for n, r in missed)))
    return out

#: Where each sensor's 6 DOF correction joint lives in the robot description.
#:
#:   parent    the link the correction is expressed IN. It is the link above
#:             the correction joint, so it never moves when the correction
#:             changes.
#:   cal_link  the link below the correction joint. Everything from here down
#:             is nominal bracket geometry, whatever correction is deployed --
#:             which is what makes re-running a calibration produce the new
#:             TOTAL rather than compounding onto the old one.
#:
#: tari_ur_description owns both, identity by default; see its README.md. If
#: these links are missing from TF the description predates the mechanism and
#: write_calibration() says so rather than guessing.
CAL_MOUNTS = {
    "azure": {"parent": "mounting_plate", "cal_link": "azure_mount_cal"},
    "keyence": {"parent": "keyence_metal", "cal_link": "lj_v7080_mount_cal"},
}

#: How far a new calibration may move a sensor before write_calibration() says
#: so loudly. Two millimetres is the verification tolerance; more than that and
#: something has physically moved, which is the interesting case and the one
#: worth stopping to look at.
CAL_BIG_MOVE_MM = 2.0

#: How far the Azure stands off the board. Its depth mode works from ~0.5 m and
#: the colour camera resolves a 25 mm square comfortably at that range.
CAL_AZURE_DISTANCE = 0.55

#: WHICH DEPTH verify_calibration() compares against the Keyence.
#:
#: The cell feeds it REGISTERED depth -- /azure/depth_to_rgb/image_raw with
#: /azure/rgb/camera_info, which is depth resampled into the COLOUR camera's
#: frame through the K4A's factory depth-to-colour extrinsics. That resampling
#: has never been tested against the alternative, and it is a plausible place
#: for a systematic offset: the Azure has read 11.77 mm below the Keyence over
#: a sheet of white paper that the Keyence measured at 0.052 mm rms over
#: 127 200 points, with the Azure's own coverage healthy (about 86% of the
#: pixels the patch subtends, once stride=4 is accounted for).
#:
#: "raw" reads the depth camera's own image instead -- CAL_AZURE_RAW_TOPICS,
#: 640x576 in depth_camera_link, no resampling. "both" grabs both AT THE SAME
#: POSE and reports each, which is the experiment that tells them apart:
#:
#:    raw agrees with the Keyence and registered does not -> the registration
#:    both read the same -11.8 mm                         -> the depth itself
#:
#: The VERDICT is always taken from the configured (registered) source, so
#: "both" adds a measurement and changes no pass/fail.
CAL_VERIFY_DEPTH = "registered"

#: The depth camera's own topics, for CAL_VERIFY_DEPTH="raw"/"both". These are
#: the azure_kinect_ros_driver's standard names under this cell's /azure
#: namespace; the REGISTERED ones come from the manifest, via sensor_topics().
CAL_AZURE_RAW_TOPICS = {"depth": "/azure/depth/image_raw",
                        "camera_info": "/azure/depth/camera_info"}

#: Settling time after a move before anything is grabbed. The arm rings for a
#: while after a stop and a 0.1 mm ring is the Keyence's entire noise budget.
CAL_SETTLE_S = 1.0

#: Profiles averaged per static Keyence pose. At 216.8 Hz this is well under a
#: second and drops the 0.102 mm per-profile noise by an order.
CAL_PROFILES_PER_POSE = 60

#: Points per pose handed to the solve. The grab keeps every profile -- they are
#: what averages the noise down, and they are in the bag either way -- but the
#: FIT does not need sixty copies of one line, and paying for them makes the
#: solve look like a hang. 1500 is about two profiles' worth per pose and
#: roughly 1/25 of a full grab; see the measured table at the call site in
#: _cal_keyence_solve(). None disables the thinning.
CAL_SOLVE_POINTS_PER_POSE = 1500

#: (tx_deg, ty_deg) tool tilts to offer the Azure. ON THE MEASURED AXES of the
#: cable envelope wherever possible -- the envelope is a cross of five measured
#: samples and a diagonal tilt is interpolated, which is allowed but is not
#: data. The magnitudes are the envelope's own limits: +/-40 about x, +/-20
#: about y. Anything further is REFUSED by the model, not extrapolated.
CAL_AZURE_TILTS = [(0, 0), (40, 0), (-40, 0), (20, 0), (-20, 0),
                   (0, 20), (0, -20), (0, 10), (0, -10),
                   (25, 10), (-25, -10), (25, -10), (-25, 10)]

#: THE PARAMETER THAT DECIDES WHETHER THE KEYENCE SOLVE MEANS ANYTHING.
#: Profiles taken only at the reference distance leave rotation of the head
#: about its own laser line unmeasured -- at zero range that rotation moves no
#: measured point at first order, so the fit returns whatever the URDF said and
#: reports a residual at the noise floor. Three standoffs fixes it;
#: calibration_test.py has the before and after.
CAL_KEYENCE_STANDOFFS = (-0.015, 0.0, 0.015)

#: Five tilts and two rolls at each of three standoffs is 30 poses, which is
#: about twenty minutes. The profiler solve is a surface fit, not a hand-eye
#: solve: what it needs is varied INCIDENCE on the flat and varied RANGE, and
#: rolling the head about the tool axis adds much less than either.
CAL_KEYENCE_TILTS = [(0, 0), (25, 0), (-25, 0), (0, 15), (0, -15)]

CAL_KEYENCE_MAX_ROLLS = 2

#: Kept back from each end of the measured wrist_3 band when choosing rolls.
#: The band's ends are already the last step an operator CONFIRMED was slack,
#: so this is margin against IK putting the wrist a few degrees off the roll
#: that was asked for, not extra conservatism about the cables.
CAL_ROLL_MARGIN_DEG = 10.0

#: At most this many rolls per tilt, however wide the band is. More poses at
#: one tilt do not improve the conditioning; more TILTS do -- measured against
#: this cell's own envelope, with one distance and the tilts above:
#:
#:     13 tilts, 3 rolls    24 poses   amplification 1.6x   GOOD
#:      7 tilts, 2 rolls    14 poses   amplification 1.6x   GOOD
#:      5 tilts, 1 roll      5 poses   amplification 2.9x   INADEQUATE
#:      1 tilt,  4 rolls     4 poses   amplification inf    INADEQUATE
#:
#: So three is not a compromise: the conditioning is flat from about fourteen
#: poses and the extra ten are margin against poses that do not see the board.
CAL_MAX_ROLLS = 3

#: verify_calibration() fails above these. 2 mm is well inside the 23 mm of
#: Keyence range either side of the reference distance, and far below the
#: ~13 mm of mesh error that flies a raster into its near limit.
CAL_VERIFY_DZ_MM = 2.0

CAL_VERIFY_TILT_MRAD = 10.0

#: Half-width of the flat patch the verification compares over, metres.
CAL_VERIFY_PATCH = 0.045

# ------------------------------------------------------------------------------
# THE AZURE TILT CRITERION IS FITTED OVER A WIDER WINDOW THAN dz
# ------------------------------------------------------------------------------
# The Azure's tilt cannot be resolved over the +/-45 mm dz patch. Its residual
# about its own plane there is 0.64 mm rms, and that residual is not white
# noise -- it is a radial bowl plus local warp, correlated over tens of
# millimetres. Tilt is (height difference)/(baseline), so 0.5 mm of correlated
# structure across a 90 mm patch IS 6 mrad, and no number of pixels inside that
# patch averages it away. On a level optics table, by a delete-one-block
# spatial jackknife over the actual points:
#
#     window     n       rms      tilt        1 sigma (blocked)  1 sigma (iid)
#     +/- 45 mm   1 522  0.64 mm  8.70 mrad   5.56 mrad          0.90 mrad
#     +/-100 mm   7 481  0.72 mm  4.62 mrad   1.67 mrad          0.20 mrad
#     +/-150 mm  16 887  0.87 mm  1.66 mrad   1.26 mrad          0.11 mrad
#
# A patch-width fit against the 10 mrad tolerance is therefore a coin toss, and
# on a level table it reads anywhere from 4.7 to 48.3 mrad. TWO THINGS FOLLOW,
# and both are done below. The window is widened. And sigma is a blocked
# jackknife rather than the ordinary least-squares uncertainty, which
# understates it six-fold because it assumes independent points.
#
# THE HEIGHT IS STILL TAKEN FROM THE +/-45 mm PATCH. dz is what a raster's
# standoff depends on, it is what the Keyence measured, and it is stable
# anyway: -11.62 mm over the patch against -11.0 mm over the whole table.

#: Half-width, metres, of the window the AZURE TILT is fitted over -- as
#: opposed to CAL_VERIFY_PATCH, which still governs dz. Points are kept only if
#: they lie within CAL_VERIFY_TILT_BAND of the patch's own plane, so a wider
#: window cannot drag in the arm, a specimen, or the next surface down; if what
#: survives is not recognisably one flat, the patch is used and the output says
#: so, and the blocked sigma then lifts the gate so the fallback cannot raise a
#: false alarm either.
global CAL_VERIFY_TILT_PATCH
CAL_VERIFY_TILT_PATCH = 0.15

#: How far off the patch plane, metres, a point in that wider window may lie and
#: still be part of the same flat. 5 mm is eight times the Azure's own 0.64 mm
#: scatter and well above the 1.3 mm the patch plane's own tilt error
#: extrapolates to at 150 mm, while still rejecting any real step.
global CAL_VERIFY_TILT_BAND
CAL_VERIFY_TILT_BAND = 0.005

#: The tilt gate is max(tolerance, k*sigma), so a fit that cannot resolve the
#: tolerance cannot fail on it. 3 sigma, the same k the pose-set conditioning
#: check uses.
global CAL_VERIFY_TILT_SIGMA_K
CAL_VERIFY_TILT_SIGMA_K = 3.0

#: Blocks per axis for the jackknife. 4x4 is 16 blocks, each about a quarter of
#: the window across -- comfortably longer than the Azure's correlation length,
#: which is what makes the blocks behave as independent observations, and enough
#: of them for the sd of the deleted-block estimates to mean something.
global CAL_VERIFY_TILT_BLOCKS
CAL_VERIFY_TILT_BLOCKS = 4

#: The IR amplitude image. DELIBERATELY A CONSTANT AND NOT sensor_topic():
#: the cell manifest declares colour, depth, camera_info and points for the
#: Azure and has never needed the IR image, and sensor_topic() raises on
#: hardware for a key the manifest does not carry.
#:
#: WHAT IT IS FOR, and it is less than it looks. azure_kinect_ros_driver
#: publishes ir/image_raw and ir/camera_info in every depth mode, stamped
#: depth_camera_link with the DEPTH camera's intrinsics, and a printed
#: checkerboard is visible in it because laser toner is carbon black and
#: carbon black absorbs at 850 nm. But on hardware this cell's depth topic is
#: depth_to_rgb -- already registered into the COLOUR camera by the factory
#: extrinsic -- so the depth points and the colour checkerboard are in ONE
#: frame, and calibrating that frame from the colour image calibrates the depth
#: with it. The IR route solves nothing the colour route does not. It is here
#: as a CROSS-CHECK on the factory depth-to-colour extrinsic, which is the one
#: link in the chain this procedure otherwise takes on trust.
#:
#: LIKE points2, IT IS LAZY: the driver builds the IR frame only while
#: count_subscribers > 0, so a subscriber has to be up before anything is
#: published. _cal_one_message() waits, which is why its timeout is generous.
CAL_AZURE_IR_TOPIC = "/azure/ir/image_raw"

#: (near, far) of the LJ-V7080 measuring range, metres from the head. The
#: optical frame sits at the reference distance inside it, so a surface is
#: visible within about +/-23 mm of z = 0 in the sensor frame.
CAL_KEYENCE_RANGE = (0.057, 0.103)

# ------------------------------------------------------------------------------
# WHERE THE KEYENCE IS GRABBED, AND WHY IT IS A GRID AND NOT A LINE
# ------------------------------------------------------------------------------
# THE FIRST PROBLEM: one static profiler pose measures ONE LINE, 35 mm long and
# microns wide, and a plane fitted to a line has a normal chosen by nothing --
# see check_plane_support() in calibration_solve.py, which is what catches a
# single-line grab reporting a 90 degree "tilt". Panning the head ACROSS its
# own line turns the line into a patch.
#
# THE SECOND PROBLEM, and the reason three offsets on one axis is not enough.
# The two slopes of that patch are measured by completely different things:
#
#   ACROSS the line   from the height DIFFERENCES BETWEEN GRABS. Each grab is
#                     one arm pose, so this carries the pose-to-pose scatter,
#                     divided by the pan baseline.
#   ALONG the line    from the SHAPE OF ONE PROFILE, averaged over the grabs.
#                     Every grab is the same 35 mm of surface, so panning
#                     across the line does not lengthen this baseline AT ALL.
#
# Over six clean verification takes flown with three offsets 20 mm apart across
# the line, the along-line slope owns the spread: -17.6 to +8.5 mrad, sd
# 9.4 mrad over a 35.5 mm baseline, which is 0.33 mm of height. The across-line
# slope stays inside +/-9 mrad and the rms about the fit inside 0.08 mm.
# Widening the pan alone would only fix the smaller half.
#
# AND THE ALONG-LINE SLOPE IS NOT NOISE. Two takes of the same taught point
# 0.4 mm apart repeat it to 0.04 mrad. It is REPRODUCIBLE AT A POINT and
# different at different points, which is what a real 35 mm chord of a real
# surface looks like -- a sheet of paper on an optics table has 0.3 mm of
# waviness at exactly that scale -- while the Azure, fitted over 300 mm, reads
# the same table at 1.66 mrad. The two sensors are being asked about surfaces
# an order of magnitude apart in size.
#
# THE POSE-TO-POSE SCATTER IS ABOUT 0.10 mm, not the 0.3-0.9 mm the calibration
# runs show, and the difference matters. Those runs change TILT between poses
# and the head reads a flat 0.23 mm lower at 20 degrees; every grab here is at
# the SAME orientation and only translates. Two independent routes to it: the
# across-line slope repeats to 1.77 mrad over a 40 mm baseline (-> 0.035 mm),
# and the rms about the fitted plane, which for three equal groups carries
# s/sqrt(3) of the between-grab scatter, is at worst 0.077 mm (-> s <= 0.13 mm).
#
# SO THE GRABS ARE A GRID: four corners and the centre. Both slopes are then
# read from between-grab heights over a real baseline, and the profile's own
# 35 mm shape -- whatever mixture of surface and head it is -- is left with
# 3.5% of the leverage instead of all of it. Monte Carlo over 300 draws with
# the measured 0.10 mm scatter and a 9.4 mrad line shape:
#
#     grabs                       sd of the fitted tilt   the line shape leaks
#     3 across the line, +/-20     3.54 mrad              9.40 mrad
#     5 across the line, +/-60     0.98 mrad              9.40 mrad
#     5 as a cross,      +/-55     1.66 mrad              0.73 mrad
#     5 as corners,      +/-55     1.19 mrad              0.38 mrad   <- this
#
# The five-in-a-line row is the trap: its across-line number looks excellent
# and its answer is still wrong by the whole tolerance.
#
# +/-55 mm AND NOT MORE, because the footprint has to fit what an operator can
# put under the arm. Corners at +/-55 with a 35.5 mm line reach 110 mm across
# and 145.5 mm along, so the check needs A FLAT 150 mm ACROSS -- A4 or US
# Letter paper (210x297 / 216x279 mm) with room to spare, and the 160 mm
# calibration artifact. At +/-75 it would want 186 mm and the artifact would no
# longer do. With the measured scatter, +/-55 already puts 3 sigma under the
# 10 mrad tolerance, so the tolerance governs again and the extra reach would
# buy nothing that matters.

#: Where the Keyence is grabbed in verify_calibration(): (ACROSS, ALONG) the
#: head's own laser line, metres, relative to the taught point. A bare number
#: is read as (across, 0.0).
#:
#: FOUR OR MORE GRABS SPANNING BOTH AXES, or the tilt has no uncertainty: the
#: sigma is a delete-one-GRAB jackknife (see _cal_slope_sigma) and it needs
#: four estimates. Three offsets on one axis cannot produce one, and the tilt
#: then has to be judged against a bare tolerance.
global CAL_VERIFY_KEYENCE_OFFSETS
CAL_VERIFY_KEYENCE_OFFSETS = ((0.0, 0.0),
                              (-0.055, -0.055), (+0.055, -0.055),
                              (+0.055, +0.055), (-0.055, +0.055))

#: How far, metres, one grab's mean height may sit off the plane of the others
#: before that grab is declared not to be on the same flat. The grid now
#: reaches 73 mm from the taught point, so walking off the edge of the target
#: is a real way to be wrong, and it would present as a tilt. 2 mm is twenty
#: times the measured pose-to-pose scatter and is CAL_VERIFY_DZ_MM, the
#: disagreement this whole check exists to catch.
global CAL_VERIFY_KEYENCE_BAND
CAL_VERIFY_KEYENCE_BAND = 0.002

_CAL = {"geom": None, "result": None, "looked": False}


global _cal_thin_for_solve
def _cal_thin_for_solve(P, say=None, budget=None, seed=0):
    """At most `budget` points from each pose, spread over the whole grab.

    NOT THE FIRST N, AND NOT A STRIDE EITHER. A pose is CAL_PROFILES_PER_POSE
    profiles laid end to end, each 800 columns across a 31 mm line, so the array
    is one line repeated sixty times.

      - the first N takes the first two profiles: the same line twice, and none
        of the rest of the grab.
      - a stride ALIASES against the line length: 45 000 points thinned to 1500
        is every 30th, and 800 and 30 share a factor, so it samples the same
        handful of COLUMNS over and over -- 25 distinct x positions out of 800.
        The count looks right and most of the line is simply missing.

    So: a fixed-seed random sample without replacement. Deterministic for a
    given pose count, unbiased over both columns and profiles, and immune to any
    relationship between the budget and the line length.

    `budget=None` means CAL_SOLVE_POINTS_PER_POSE; set that constant falsy to
    disable thinning altogether.
    """
    budget = CAL_SOLVE_POINTS_PER_POSE if budget is None else budget
    if not budget:
        return P
    budget = int(budget)
    rng = np.random.default_rng(seed)
    out, thinned = [], 0
    for p in P:
        n = p.shape[0]
        if n <= budget:
            out.append(p)
            continue
        idx = np.sort(rng.choice(n, budget, replace=False))
        out.append(p[idx])
        thinned += 1
    if thinned and say is not None:
        before = sum(p.shape[0] for p in P)
        after = sum(q.shape[0] for q in out)
        say("  solving on %d of %d points, at most %d per pose (%d profiles at "
            "a static pose are one line %d times)"
            % (after, before, budget, CAL_PROFILES_PER_POSE,
               CAL_PROFILES_PER_POSE))
    return out


global _cal_solve_progress
def _cal_solve_progress(say, every=1.0):
    """A progress callback for solve_surface_fit(), printed no faster than
    `every` seconds so a fast solve does not spray thirty lines.

    THE POINT IS THAT SOMEBODY IS WATCHING. A silent solve can run for ten
    minutes or more on a full pose set, and a silent run looks like a hung one
    and gets interrupted with all its poses already collected.
    """
    state = {"t": 0.0}

    def _report(info):
        now = time.time()
        last = info["iteration"] >= info["max_iter"] or info["step"] < 1e-10
        if not last and now - state["t"] < every:
            return
        state["t"] = now
        extra = "" if info["fraction"] >= 1.0 else "  step x%.3f" % info["fraction"]
        say("    iteration %2d of %d: %.4f mm rms over %d points%s"
            % (info["iteration"], info["max_iter"], info["rms_mm"],
               info["points"], extra))
    return _report


def _cal_geom():
    """calibration_solve, imported from this directory.

    Deferred, and not a top-level import: a .dpi is a function body, so an
    import at its top happens when the config loads, and a config that only
    wants to scan should not fail to start because a calibration helper moved.
    """
    if _CAL.get("geom") is None:
        here = (globals().get("SCAN_MODULE_DIR")
                or os.path.dirname(os.path.abspath(__file__)))
        if here not in sys.path:
            sys.path.insert(0, here)
        import calibration_solve
        _CAL["geom"] = calibration_solve
    return _CAL["geom"]


def _cal_say(msg):
    """Print where the operator will see it, through the capture tool's own
    printer when there is one (a print() from a worker thread is swallowed)."""
    say = globals().get("_capture_say")
    if say is not None:
        say(msg)
    else:
        print(msg)


def cal_board():
    """{cols, rows, square, measured, object_points} -- the printed target.

    `square` is what the solve uses: the MEASURED pitch when one has been
    recorded, the nominal otherwise, and it says which.
    """
    g = _cal_geom()
    sq = CAL_BOARD_MEASURED_SQUARE or CAL_BOARD_SQUARE
    return {"cols": int(CAL_BOARD_COLS), "rows": int(CAL_BOARD_ROWS),
            "square": float(sq), "nominal": float(CAL_BOARD_SQUARE),
            "measured": CAL_BOARD_MEASURED_SQUARE is not None,
            "object_points": g.board_object_points(CAL_BOARD_COLS,
                                                   CAL_BOARD_ROWS, sq)}


def set_board_square(across_n_squares_m, n=None):
    """Record the board's real square pitch from a caliper measurement.

    Pass the distance across `n` SQUARES and this divides. The default is the
    long axis of the whole board, which for a 9 x 6 inner-corner board is TEN
    squares, not nine -- a 10 x 7 square board has 9 x 6 inner corners, and
    dividing the long axis by nine would record a 11% scale error that is not
    there. On the shipped sheet the long axis is the 200.00 mm between the
    inner faces of the border bars.

    MEASURE ACROSS THE WHOLE BOARD, not one square: a caliper is good to
    0.02 mm and one square is 20 mm, so measuring one square leaves 0.1% of
    scale error where measuring ten leaves 0.01%.

    A 1.5% scale error -- ordinary for a consumer printer -- moves the solved
    camera standoff by 1.5% of the working distance, which at 0.55 m is 8 mm.
    That is most of the error this whole procedure exists to remove, arriving
    through the artifact instead of through the fixture.
    """
    global CAL_BOARD_MEASURED_SQUARE
    n = int((CAL_BOARD_COLS + 1) if n is None else n)
    sq = float(across_n_squares_m)/n
    err = (sq/CAL_BOARD_SQUARE - 1.0)*100.0
    CAL_BOARD_MEASURED_SQUARE = sq
    _cal_say("  board square pitch measured %.4f mm over %d squares "
             "(nominal %.4f, %+.2f%%)"
             % (sq*1e3, n, CAL_BOARD_SQUARE*1e3, err))
    if abs(err) > 3.0:
        _cal_say("  THAT IS A LOT. %.1f%% is past what a printer's scale error "
                 "explains -- check that n=%d is the number of SQUARES you "
                 "actually measured across. A %d x %d inner-corner board has "
                 "%d x %d squares." % (err, n, CAL_BOARD_COLS, CAL_BOARD_ROWS,
                                       CAL_BOARD_COLS + 1, CAL_BOARD_ROWS + 1))
    return sq


def cal_artifact(kind=None):
    """What calibrate_keyence() fits against, as calibration_solve sees it.

    "flat"    the ground calibration plate -- a plane, plus any balls declared.
    "printed" the 3D-printed stepped artifact, whose own height variation
              supplies the range spread a flat can only get by flying the head
              at several heights.
    """
    g = _cal_geom()
    kind = CAL_ARTIFACT if kind is None else kind
    if kind == "printed":
        return g.SteppedArtifact(
            cal_artifact_pad_centres(), CAL_ARTIFACT_PAD_TOPS,
            CAL_ARTIFACT_PAD_D, CAL_ARTIFACT_CONE_XY, CAL_ARTIFACT_CONE_APEX,
            CAL_ARTIFACT_CONE_D, cal_artifact_base_polygon(),
            CAL_ARTIFACT_BASE_TOP, table_extent=CAL_ARTIFACT_TABLE_EXTENT,
            name="printed artifact")
    if kind != "flat":
        raise CalibrationRefused("unknown artifact kind %r (flat or printed)"
                                 % (kind,))
    centres = (np.asarray(CAL_BALL_CENTRES, float).reshape(-1, 3)
               if len(CAL_BALL_CENTRES) else np.zeros((0, 3)))
    return g.PlateArtifact(centres, CAL_BALL_RADIUS, plate_extent=(0.14, 0.11),
                           name="calibration plate")


def cal_artifact_pad_centres():
    """The nine pad centres, row-major from the chamfered corner."""
    return [(CAL_ARTIFACT_PAD_0 + c*CAL_ARTIFACT_PAD_PITCH,
             CAL_ARTIFACT_PAD_0 + r*CAL_ARTIFACT_PAD_PITCH)
            for r in range(3) for c in range(3)]


def cal_artifact_base_polygon():
    """The base outline, counter-clockwise, with the one chamfered corner.

    The chamfer is what makes the outline asymmetric, so a solve cannot settle
    into the artifact rotated by a quarter or a half turn and fit perfectly.
    """
    s, c = CAL_ARTIFACT_SIZE, CAL_ARTIFACT_CHAMFER
    return [(c, 0.0), (s, 0.0), (s, s), (0.0, s), (0.0, c)]


def use_printed_artifact(pad_tops=None):
    """Switch calibrate_keyence() to the 3D-printed stepped artifact.

    `pad_tops` is the nine MEASURED pad top heights in metres, from a height
    gauge or from a Keyence pass over the printed part. Pass them. The design
    heights are what the STL asked the printer for, and a printer is good to a
    few tenths of a millimetre against an answer worth half of one.
    """
    global CAL_ARTIFACT, CAL_ARTIFACT_PAD_TOPS
    if pad_tops is not None:
        if len(pad_tops) != len(CAL_ARTIFACT_PAD_TOPS):
            raise CalibrationRefused("the artifact has %d pads, not %d"
                                     % (len(CAL_ARTIFACT_PAD_TOPS),
                                        len(pad_tops)))
        CAL_ARTIFACT_PAD_TOPS = [float(v) for v in pad_tops]
    CAL_ARTIFACT = "printed"
    _cal_say(describe_calibration_artifact())
    return cal_artifact()


def describe_calibration_artifact():
    """One block of text about the target in use, for a banner or a report."""
    b = cal_board()
    L = ["calibration artifact:",
         "  checkerboard %d x %d inner corners at %.3f mm pitch (%s)"
         % (b["cols"], b["rows"], b["square"]*1e3,
            "MEASURED" if b["measured"] else "NOMINAL -- run set_board_square()"),
         # TWO SIZES, and confusing them is how a caliper measurement becomes
         # an 11% scale error. The PATTERN is (cols-1) x (rows-1) squares of
         # corner-to-corner span; the printed BOARD is (cols+1) x (rows+1)
         # squares, and that is what the sheet's border bars bracket and what
         # set_board_square() divides by default.
         "  corner grid spans %.1f x %.1f mm inside a printed board of "
         "%.1f x %.1f mm" % ((b["cols"] - 1)*b["square"]*1e3,
                             (b["rows"] - 1)*b["square"]*1e3,
                             (b["cols"] + 1)*b["square"]*1e3,
                             (b["rows"] + 1)*b["square"]*1e3)]
    art = cal_artifact()
    L.append("  keyence artifact: " + art.describe())
    if CAL_ARTIFACT == "printed":
        z = art.heights()
        ref = CAL_KEYENCE_REF_DIST
        # Where the head is when the MIDDLE of the artifact's range sits on the
        # reference plane, and what one pass then sees, in head distance.
        mid = 0.5*(z[0] + z[-1])
        d = sorted(ref + (mid - v) for v in z)
        L.append("  one pass sees %d surface heights, %s mm from the head"
                 % (len(d), " ".join("%.0f" % (v*1e3) for v in d)))
        lo, hi = CAL_KEYENCE_RANGE
        L.append("  the head measures over %.0f..%.0f mm, so all of that is "
                 "inside one pass%s" % (lo*1e3, hi*1e3,
                                        "" if d[0] >= lo and d[-1] <= hi
                                        else " -- EXCEPT IT IS NOT, check the "
                                             "declared heights"))
    elif len(CAL_BALL_CENTRES):
        L.append("  %d ball(s) of radius %.4f m" % (len(CAL_BALL_CENTRES),
                                                    CAL_BALL_RADIUS))
    else:
        L.append("  no balls declared -- the Keyence is calibrated against the "
                 "plate's flat, which is enough provided the standoff is varied")
    if not b["measured"]:
        L.append("  WARNING: the printed pitch has not been measured. A 1.5% "
                 "printer scale error is 8 mm of camera standoff at 0.55 m.")
    return "\n".join(L)


# ------------------------------------------------------------------------------
# Getting one message out of ROS without wedging anything
# ------------------------------------------------------------------------------

def _cal_one_message(topic, msg_type, timeout=15.0, node_name="calibration_probe",
                     count=1, qos=None):
    """The last `count` messages on a topic, as a list. Own node, always destroyed.

    A SHORT-LIVED NODE ON PURPOSE. The standing rule in this tree is that a
    blocking wait must not happen while a dgpy module context is held, and the
    way every other probe here obeys it (_one_message, depth_topic_facts,
    profile_topic_facts) is to build a node, spin it, and destroy it in a
    finally. Doing it any other way is how this stack gets wedged.

    The timeout is generous because several of these topics are LAZY: the
    driver computes ir/image_raw and points2 only while something is
    subscribed, so the first message cannot arrive until after we are up.
    """
    import rclpy
    import rclpy.node
    from rclpy.qos import QoSProfile, ReliabilityPolicy, HistoryPolicy

    if qos is None:
        qos = QoSProfile(depth=max(int(count), 1),
                         history=HistoryPolicy.KEEP_LAST,
                         reliability=ReliabilityPolicy.BEST_EFFORT)
    got = []
    node = rclpy.node.Node(node_name + "_%d" % (int(time.time()*1e3) % 100000))
    try:
        node.create_subscription(msg_type, topic, lambda m: got.append(m), qos)
        deadline = time.monotonic() + float(timeout)
        while len(got) < count and time.monotonic() < deadline:
            rclpy.spin_once(node, timeout_sec=0.1)
    finally:
        node.destroy_node()
    return got


def _cal_decode_image(msg):
    """A numpy array from sensor_msgs/Image, whatever it is encoded as."""
    enc = msg.encoding.lower()
    buf = np.frombuffer(bytes(msg.data), dtype=np.uint8)
    if enc in ("mono8", "8uc1"):
        return buf.reshape(msg.height, msg.step)[:, :msg.width]
    if enc in ("mono16", "16uc1"):
        a = buf.view("<u2" if not msg.is_bigendian else ">u2")
        return a.reshape(msg.height, msg.step//2)[:, :msg.width]
    if enc == "32fc1":
        a = buf.view("<f4" if not msg.is_bigendian else ">f4")
        return a.reshape(msg.height, msg.step//4)[:, :msg.width]
    for name, n in (("bgra8", 4), ("rgba8", 4), ("bgr8", 3), ("rgb8", 3)):
        if enc == name:
            return buf.reshape(msg.height, msg.step//n, n)[:, :msg.width, :]
    raise CalibrationRefused("cannot decode image encoding %r (%d x %d, step %d)"
                             % (msg.encoding, msg.width, msg.height, msg.step))


def _cal_gray(msg):
    """A mono8 image for the detector, from colour, mono or IR.

    The IR amplitude image is 16 bit with an enormous dynamic range -- the
    board's white squares can be hundreds of times brighter than its black --
    so it is scaled by its own percentiles rather than by its full range, which
    would leave the whole board in the bottom few counts of an 8 bit image and
    no detector would find a corner in it.
    """
    a = _cal_decode_image(msg)
    if a.ndim == 3:
        rgb = a[:, :, :3]
        if msg.encoding.lower().startswith("bgr") or msg.encoding.lower().startswith("bgra"):
            rgb = rgb[:, :, ::-1]
        g = (0.299*rgb[:, :, 0] + 0.587*rgb[:, :, 1] + 0.114*rgb[:, :, 2])
        return g.astype(np.uint8)
    a = a.astype(np.float64)
    lo, hi = np.percentile(a, 1.0), np.percentile(a, 99.0)
    if hi - lo < 1e-9:
        raise CalibrationRefused("the image on this topic is blank")
    return np.clip((a - lo)*(255.0/(hi - lo)), 0, 255).astype(np.uint8)


def _cal_intrinsics(info_topic, timeout=15.0):
    """(K 3x3, D, width, height, frame_id) from a camera_info topic.

    camera_facts() already exists and is exported, but it drops msg.d -- and
    the Azure's colour camera is a rational_polynomial with eight distortion
    coefficients and real barrel at the edges of a 2048 x 1536 frame, which is
    exactly where the outer checkerboard corners are. Undistorting with zeros
    puts those corners a pixel or two out and biases every pose.
    """
    from sensor_msgs.msg import CameraInfo
    got = _cal_one_message(info_topic, CameraInfo, timeout=timeout,
                           node_name="cal_info")
    if not got:
        raise CalibrationRefused(
            "no camera_info on %s in %.0f s. Is the Azure driver up?"
            % (info_topic, timeout))
    m = got[-1]
    K = np.asarray(m.k, float).reshape(3, 3)
    D = np.asarray(m.d, float).reshape(1, -1)
    if not np.isfinite(K).all() or K[0, 0] <= 0.0:
        raise CalibrationRefused("camera_info on %s has no usable intrinsics "
                                 "(fx = %s)" % (info_topic, K[0, 0]))
    return K, D, int(m.width), int(m.height), m.header.frame_id


def _cal_depth_points(depth_topic, K, stride=4, max_range=2.0, keep=None):
    """(N x 3 points in the depth image's own frame, frame_id).

    16UC1 is millimetres and 32FC1 is metres, and confusing them empties a
    reconstruction silently. Zero means no return and must be dropped, not
    integrated as a surface at the origin.

    STRIDE IS NOT A DETAIL. It samples every `stride`th pixel in BOTH axes, so
    one in stride**2 -- one in sixteen by default. Any statement about how many
    points "should" have come back has to divide by that, and the image's OWN
    size has to come from the image rather than from the depth mode: this cell
    feeds registered depth at colour resolution, not the 640x576 the depth mode
    implies. Getting either wrong understates the Azure's coverage by about a
    factor of three.

    Pass `keep` a dict to receive the grab itself -- the decoded array, the
    encoding, the image size, the stride and the stamp -- so a verification can
    write it next to the take and be re-examined without the arm.
    """
    from sensor_msgs.msg import Image
    got = _cal_one_message(depth_topic, Image, timeout=15.0, node_name="cal_depth")
    if not got:
        raise CalibrationRefused("no depth on %s. Is the Azure driver up?"
                                 % depth_topic)
    m = got[-1]
    a = _cal_decode_image(m).astype(np.float64)
    if m.encoding.lower() in ("16uc1", "mono16"):
        a = a/1000.0
    v, u = np.mgrid[0:a.shape[0]:stride, 0:a.shape[1]:stride]
    z = a[::stride, ::stride]
    ok = np.isfinite(z) & (z > 0.05) & (z < float(max_range))
    u, v, z = u[ok].astype(float), v[ok].astype(float), z[ok]
    x = (u - K[0, 2])*z/K[0, 0]
    y = (v - K[1, 2])*z/K[1, 1]
    if keep is not None:
        keep.update(depth=a, encoding=m.encoding, height=int(a.shape[0]),
                    width=int(a.shape[1]), stride=int(stride),
                    frame=m.header.frame_id, topic=depth_topic,
                    K=np.asarray(K, float), n_valid=int(z.size),
                    n_sampled=int(ok.size),
                    stamp_ns=int(m.header.stamp.sec)*10**9
                              + int(m.header.stamp.nanosec))
    return np.column_stack([x, y, z]), m.header.frame_id


def _cal_profile_points(topic, count=None, timeout=15.0, check=True):
    """(N x 3 profile points in the sensor's own frame, frame_id, n_messages).

    `count` messages are concatenated. The head is static while this runs, so
    they may simply be stacked -- averaging down the 0.102 mm per-profile noise
    without any pose bookkeeping. Do NOT use this while the arm is moving.

    THE SINGLE PLACE KEYENCE DATA ENTERS A CALIBRATION, which is why the
    validity check lives here and not in its two callers. It refuses, before
    anything is solved or any verdict is reached, a grab that is not a
    measurement: no scatter, a standoff outside the head's window, or one
    height repeated across the whole line. calibration_solve.check_profile()
    does the deciding and writes the message; see its section comment.

    OUT-OF-RANGE COLUMNS ARE DROPPED HERE. keyence_driver_node emits them as
    +Inf (REP-117) and pc2's skip_nans does not remove an infinity -- it tests
    isnan. fit_plane() happens to filter them, solve_surface_fit() does not, and
    one infinity in a least-squares residual poisons every parameter in it.
    """
    from sensor_msgs.msg import PointCloud2
    import sensor_msgs_py.point_cloud2 as pc2
    count = int(CAL_PROFILES_PER_POSE if count is None else count)
    got = _cal_one_message(topic, PointCloud2, timeout=timeout,
                           node_name="cal_profiles", count=count)
    if not got:
        raise CalibrationRefused(
            "no profiles on %s in %.0f s. Is the laser on (capture_laser(True)) "
            "and is the surface inside %.0f..%.0f mm of the head?"
            % (topic, timeout, 1e3*CAL_KEYENCE_RANGE_M[0],
               1e3*CAL_KEYENCE_RANGE_M[1]))
    P = []
    for m in got:
        xyz = np.asarray(pc2.read_points_numpy(
            m, field_names=("x", "y", "z"), skip_nans=True)).reshape(-1, 3)
        if xyz.size:
            P.append(xyz)
    if not P:
        raise CalibrationRefused(
            "%d profile messages on %s and not one point in them. The surface "
            "is outside the head's %.0f..%.0f mm range."
            % (len(got), topic, 1e3*CAL_KEYENCE_RANGE_M[0],
               1e3*CAL_KEYENCE_RANGE_M[1]))
    raw = np.vstack(P)
    ok = _cal_geom().check_profile(
        raw, ref_dist=CAL_KEYENCE_REF_DIST, range_m=CAL_KEYENCE_RANGE_M,
        source="the Keyence on %s" % topic, n_profiles=len(got))
    _CAL["last_profile_check"] = ok
    if check and not ok["ok"]:
        raise CalibrationRefused(ok["message"])
    pts = raw[np.isfinite(raw).all(axis=1)]
    return pts, got[-1].header.frame_id, len(got)


def _cal_tf(target, source, timeout=5.0):
    """The 4x4 target <- source, from the capture tool's own TF buffer."""
    import rclpy
    g = _cal_geom()
    node = globals().get("capture_node")
    buf = getattr(node, "tf_buffer", None) if node is not None else None
    if buf is None:
        ros = globals().get("ros")
        buf = getattr(ros, "_tf_buffer", None) if ros is not None else None
    if buf is None:
        raise CalibrationRefused("no TF buffer: neither capture_node nor the "
                                 "motion module is up")
    deadline = time.monotonic() + float(timeout)
    last = None
    while time.monotonic() < deadline:
        try:
            t = buf.lookup_transform(target, source, rclpy.time.Time())
            tr, q = t.transform.translation, t.transform.rotation
            return g.rt_to_T(g.quat_to_R((q.x, q.y, q.z, q.w)),
                             (tr.x, tr.y, tr.z))
        except Exception as e:                            # noqa: BLE001
            last = e
            time.sleep(0.05)
    raise CalibrationRefused("no transform %s <- %s after %.0f s (%s)"
                             % (target, source, timeout, last))


# ------------------------------------------------------------------------------
# Detection
# ------------------------------------------------------------------------------

def detect_board(gray, K, D, board=None, refine=True):
    """(T_camera_board 4x4, image points N x 2, object points N x 3) or None.

    findChessboardCornersSB is used in preference to the old
    findChessboardCorners + cornerSubPix pair: it is more accurate on blurred
    and obliquely-viewed boards, which is most of a calibration pose set, and
    it has been in OpenCV since 4.0 so it is safe on whatever Ubuntu 22.04
    ships as well as on a newer wheel.

    THE POSE COMES FROM solvePnP WITH THE DISTORTION COEFFICIENTS, not from a
    homography on undistorted points. The Azure's colour camera is a
    rational_polynomial with real barrel, and the outermost board corners --
    the ones that carry most of the orientation information -- are where it is
    worst.
    """
    try:
        import cv2
    except ImportError:
        raise CalibrationRefused(
            "OpenCV (cv2) is not importable here. The detection half of this "
            "module needs it; the solving half (calibration_solve.py) does not "
            "and is tested on the host without it.")
    b = cal_board() if board is None else board
    size = (int(b["cols"]), int(b["rows"]))
    flags = 0
    for name in ("CALIB_CB_NORMALIZE_IMAGE", "CALIB_CB_EXHAUSTIVE",
                 "CALIB_CB_ACCURACY"):
        flags |= getattr(cv2, name, 0)
    found, corners = cv2.findChessboardCornersSB(gray, size, flags)
    if not found or corners is None:
        return None
    img = np.asarray(corners, float).reshape(-1, 2)
    obj = np.asarray(b["object_points"], float).reshape(-1, 3)
    if img.shape[0] != obj.shape[0]:
        return None
    ok, rvec, tvec = cv2.solvePnP(
        obj.astype(np.float64).reshape(-1, 1, 3),
        img.astype(np.float64).reshape(-1, 1, 2),
        np.asarray(K, float), np.asarray(D, float),
        flags=getattr(cv2, "SOLVEPNP_ITERATIVE", 0))
    if not ok:
        return None
    if refine and hasattr(cv2, "solvePnPRefineLM"):
        rvec, tvec = cv2.solvePnPRefineLM(
            obj.astype(np.float64).reshape(-1, 1, 3),
            img.astype(np.float64).reshape(-1, 1, 2),
            np.asarray(K, float), np.asarray(D, float), rvec, tvec)
    g = _cal_geom()
    R, _j = cv2.Rodrigues(rvec)
    return g.rt_to_T(R, np.asarray(tvec, float).reshape(3)), img, obj


# ------------------------------------------------------------------------------
# Poses, generated against the measured cable envelope
# ------------------------------------------------------------------------------

def _cal_tool_quat(tx_deg, ty_deg, roll_deg):
    """A tool orientation: the working pose, tilted about world x and y, rolled.

    IDENTITY IS THE WORKING ORIENTATION ON THIS ARM, and it is worth saying
    because it reads backwards: probe_end's z is world +Z when the probe is
    looking DOWN at the bench. So there is no 180 degree flip here. Adding one
    -- the obvious thing to do for a tool that points down -- makes
    wrist3_tilt_of() read every pose as a 180 degree tilt, which is outside the
    measured hull, and the cable envelope then refuses the entire pose set with
    a message about extrapolation. The cell manifest's cable_envelope block
    states the convention and capture_cable_envelope() measures against it.

    Built the way capture_cable_envelope() builds its tilts -- WORLD-frame
    rotations applied on the left of the home orientation -- so wrist3_tilt_of()
    reads back exactly the tilt that was asked for and the band that comes back
    is the one measured at that tilt. The roll is about the tool's own z, which
    with an identity home is also world z.
    """
    q = _cap_q_axis((0.0, 0.0, 1.0), math.radians(roll_deg))
    q = quat_mul(_cap_q_axis((0.0, 1.0, 0.0), math.radians(ty_deg)), q)
    return quat_mul(_cap_q_axis((1.0, 0.0, 0.0), math.radians(tx_deg)), q)


def _cal_roll_budget(tx_deg, ty_deg, max_rolls=None):
    """[roll_deg] this tilt can afford, from the MEASURED wrist_3 band.

    The band at a tilt is how much the wrist may turn there, and it is 270 deg
    untilted against 75 deg at x -40. Offering the same four rolls at every
    tilt is how a pose set gets half of itself refused at the cell; offering
    the band's own width is how it does not.

    Returns rolls spread over the band less CAL_ROLL_MARGIN_DEG at each end,
    centred on the band, capped at 180 deg of spread (beyond that a roll comes
    back round to an orientation already covered) and at `max_rolls` poses.
    """
    max_rolls = int(CAL_MAX_ROLLS if max_rolls is None else max_rolls)
    try:
        lo, hi = wrist3_band_deg(tilt=(float(tx_deg), float(ty_deg)))
    except Exception:                                    # no measurement yet
        return [0.0, 90.0][:max_rolls]
    width = max((hi - lo) - 2.0*CAL_ROLL_MARGIN_DEG, 0.0)
    if width < 5.0:
        return [0.0]
    spread = min(width, 180.0)
    n = max(1, min(max_rolls, int(spread//30.0) + 1))
    if n == 1:
        return [0.0]
    return [float(v) for v in np.linspace(-spread/2.0, spread/2.0, n)]


def _cal_ik(xyz, quat, seed=None):
    """A joint solution for the probe tip here, or None. Local IK only."""
    ros = _CAP.get("real_ros") if "_CAP" in globals() else None
    if ros is None:
        return None
    if seed is None:
        seed = capture_node.current_joints()
    try:
        with _local_ik():
            return ros.SolveIK(_cap_pose(np.asarray(xyz, float), quat),
                               seed=seed, timeout=1.0)
    except Exception:                                     # noqa: BLE001
        return None


def _cal_pose_for_sensor(aim_xyz, quat, distance, sensor, kind=None):
    """Where probe_end goes so `sensor` stands off `aim_xyz` by `distance`.

    TWO THINGS THIS GETS RIGHT THAT THE OBVIOUS VERSION DOES NOT.

    A SENSOR IS NOT THE TOOL TIP. The Keyence's optical frame is about 75 mm
    to the side of probe_end and the Azure is further still. Commanding the TIP
    to a standoff above a target and expecting the SENSOR to be there puts a
    sweep of the order of 100 mm out of position.

    AND THE STANDOFF IS ALONG THE SENSOR'S OWN AXIS, NOT ALONG WORLD Z. This
    is the part that matters for a calibration and does not for a scan. Every
    useful pose in the set is TILTED -- that is the whole point of the pose set
    -- and a camera placed straight above the board while looking 40 degrees
    away from vertical is pointing 0.46 m to one side of it at 0.55 m. Every
    tilted pose would come back "no board in view", the set would collapse to
    the untilted poses, and the solve would then be under-constrained for
    exactly the reason check_calibration_poses() complains about.

    `kind` is "camera" or "profiler", guessed from the frame name:

      camera    the sensor is placed `distance` BACK along its own viewing
                axis, so it looks straight at aim_xyz however it is tilted.
                +z forward is the ROS optical convention, and which Azure frame
                actually carries it is settled in the cell manifest rather than
                by the frame's name -- two of this cell's three are 90 degrees
                off it.
      profiler  aim_xyz is THE SURFACE -- the point a probe tip was touched
                to. The optical frame is placed CAL_KEYENCE_REF_DIST + distance
                away from it, back along the head-to-optical direction read
                from live TF, so the surface lands at the head's reference
                distance and `distance` shifts it within the measuring window.

    AIM_XYZ IS THE SURFACE FOR BOTH KINDS. Every taught point in this cell
    (`cal_flat`, `flat`, `edge_a`, the work-volume corners) is a contact point
    ON a surface, so the profiler branch must add the reference distance
    itself. A profiler branch that instead places the optical frame ON aim_xyz
    and treats `distance` as the whole standoff drives the head into the
    artifact: CAL_KEYENCE_STANDOFFS of (-15, 0, +15) mm then command the sensor
    window to 15 mm BELOW the surface, onto it, and 15 mm above it. What comes
    back is a constant -- tens of thousands of points at 0.000 mm rms from a
    flat, which is not a measurement -- because with the window on the surface
    there is nothing inside the 57..103 mm range to see.
    """
    g = _cal_geom()
    if kind is None:
        kind = "profiler" if "lj_v7080" in sensor else "camera"
    T_ps = _cal_tf("probe_end", sensor)
    R_ws = g.quat_to_R(quat).dot(T_ps[:3, :3])
    if kind == "camera":
        local = np.array([0.0, 0.0, -float(distance)])
        want = np.asarray(aim_xyz, float) + R_ws.dot(local)
    else:
        head = _cal_tf("probe_end", "lj_v7080_frame")[:3, 3]
        v = T_ps[:3, 3] - head
        n = float(np.linalg.norm(v))
        if n < 1e-6:
            raise CalibrationRefused(
                "lj_v7080_frame and lj_v7080_optical_frame are at the same "
                "place, so the head's own axis cannot be read from TF")
        # THE OPTICAL FRAME IS ALREADY THE REFERENCE PLANE, so placing it ON
        # aim_xyz puts the HEAD at the reference distance and nothing has to be
        # added. lj_v7080_macro.xacro joins it to lj_v7080_frame at
        # z = -(keyence_ref_dist + keyence_ref_dist_cal) and says so: "the
        # optical frame sits this far in front of the head, on the plane a raw
        # reading of zero means". `distance` then moves within the window.
        #
        # DO NOT ADD THE REFERENCE DISTANCE AGAIN HERE. Doing so stands the
        # head off 160 mm -- outside the 57..103 mm it can measure over -- and
        # every grab comes back empty. The mistake is an easy one: "optical
        # frame" reads like the sensor's window, and it is not.
        stand = float(distance)
        lo, hi = CAL_KEYENCE_RANGE_M
        head = CAL_KEYENCE_REF_DIST + stand
        if not (lo <= head <= hi):
            raise CalibrationRefused(
                "a Keyence calibration pose would stand the HEAD off %.1f mm "
                "from the surface, outside the %.0f..%.0f mm the LJ-V7080 can "
                "measure over. `distance` is an offset from the %.0f mm "
                "reference distance the optical frame already carries, so "
                "%+.1f mm is out of the window by %.1f mm."
                % (1e3*head, 1e3*lo, 1e3*hi, 1e3*CAL_KEYENCE_REF_DIST,
                   1e3*distance,
                   1e3*(lo - head if head < lo else head - hi)))
        want = (np.asarray(aim_xyz, float)
                - g.quat_to_R(quat).dot(v/n)*stand)
    return want - g.quat_to_R(quat).dot(T_ps[:3, 3])


def _cal_candidate_poses(aim_xyz, sensor, distances, tilts, label,
                         max_rolls=None, artifact=None):
    """[{...}] poses that put `sensor` over `aim_xyz`, cable-legal and reachable.

    Every candidate is checked in this order and the reason it was dropped is
    recorded, because "23 of 60 poses survived" is useless and "37 dropped: 24
    outside the work volume, 13 refused by the cables" tells the operator to
    move the plate.
    """
    out, dropped = [], {}
    def drop(why):
        dropped[why] = dropped.get(why, 0) + 1

    #: The seed for the NEXT candidate's IK: the configuration the last
    #: accepted pose solved to. None means "wherever the arm is", which is
    #: right for the first pose and wrong for every one after it.
    seed = None

    # ONE envelope for the whole set, and whether there is one at all is
    # decided HERE, once. A cell whose robot_description is not up yet has no
    # envelope and must still be able to calibrate; a bug inside the check is
    # a different thing entirely and must not quietly disarm it.
    env = None
    try:
        env = tooling_envelope()
    except Exception as e:                                    # noqa: BLE001
        if not _CAL.get("said_no_envelope"):
            _CAL["said_no_envelope"] = True
            _cal_say("    NO TOOLING ENVELOPE (%s) -- calibration poses are "
                     "NOT clearance-checked against the artifact. A tilted "
                     "pose can put the tool inside it and collide." % (e,))

    # STANDOFF IS THE INNERMOST LOOP, AND THAT IS A RESILIENCE DECISION.
    #
    # Poses are flown in the order they come out of here. With distance
    # outermost the flight order is every tilt and roll at -15 mm, then every
    # one at 0, then every one at +15. A run that stops in its first third has
    # then flown ONE STANDOFF, and at one standoff rotation of the head about
    # its own laser line is unmeasured: _cal_keyence_solve() refuses it,
    # correctly, and the operator gets nothing. Surviving a failed move is not
    # enough on its own; the surviving poses have to be SOLVABLE.
    #
    # Innermost, every three consecutive poses span all three rungs, so any
    # prefix of the flight order carries the full standoff spread.
    #
    # It is also LESS motion, not more. Consecutive poses differ by 15 mm of
    # standoff rather than by a whole change of tilt and roll, and the set
    # makes one tour of the tilts instead of three: on a 34-pose set that is
    # 11 large reorientations instead of 34. Large reorientations -- a long
    # straight leg that also turns the wrist through 180 degrees -- are what
    # fails to plan, so this reduces the exposure as well as the cost of it.
    for tx, ty in tilts:
        for roll in _cal_roll_budget(tx, ty, max_rolls):
            for d in distances:
                q = _cal_tool_quat(tx, ty, roll)
                try:
                    xyz = _cal_pose_for_sensor(aim_xyz, q, d, sensor)
                except CalibrationRefused:
                    raise
                if not _cap_inside([xyz]):
                    drop("outside the work volume")
                    continue
                # SEEDED FROM THE POSE BEFORE IT, which is how the move will
                # be solved. capture_move() runs IK along a straight line from
                # WHERE THE ARM IS, so the configuration it lands on depends on
                # the pose it came from. Screening every candidate from the
                # arm's position at generation time picks a different wrist-3
                # branch from the one that flies, and the two then disagree --
                # the screen passes a pose that the cable guard refuses at move
                # time, by a couple of degrees. Poses are flown in the order
                # they come out of here, so chaining the seed makes the screen
                # predict the run instead of guessing at it.
                sol = _cal_ik(xyz, q, seed=seed)
                if sol is None:
                    drop("no IK solution")
                    continue
                try:
                    check_wrist3([sol], "%s pose" % label, quats=[q],
                                 tilt=(tx, ty))
                except CableRefused:
                    drop("refused by the cable envelope")
                    continue
                except KeyError:
                    pass          # nothing measured; check_wrist3 has said so
                # AND WHETHER THE TOOL IS IN THE ARTIFACT; see
                # _cal_hits_artifact.
                #
                # NOT WRAPPED IN try/except. An except clause here swallows a
                # bug in the check itself into one printed line, leaving every
                # pose unchecked while the run carries on looking normal. A
                # safety check that disables itself on its own failure is worse
                # than no check: it reports a guard that is not there.
                # If there is no envelope at all, `env` is None and the check
                # is skipped deliberately, having said so once above.
                if env is not None:
                    depth, who = _cal_hits_artifact(xyz, q, aim_xyz, env,
                                                    artifact=artifact)
                    if depth is not None:
                        drop("tooling inside the artifact (%s %.1f mm in)"
                             % (who or "tooling", depth*1e3))
                        continue
                out.append({"label": "%s t%+d,%+d r%+.0f d%.0f"
                                     % (label, tx, ty, roll, d*1e3),
                            "xyz": [float(v) for v in xyz],
                            "quat": tuple(float(v) for v in q),
                            "tilt": (float(tx), float(ty)), "roll": float(roll),
                            "distance": float(d), "joints": list(sol)})
                seed = list(sol)
    return out, dropped


def azure_calibration_poses(point="cal_board", distances=None, tilts=None):
    """The pose set for calibrate_azure(). No motion; safe to inspect first.

    `point` is a taught point at the CENTRE OF THE BOARD, or an (x, y, z).
    Teaching it is not a touch-off in the sense this procedure avoids --
    nothing downstream depends on it, it only says where to point the camera,
    and being 10 mm out costs nothing.
    """
    aim = (_cap_point(point) if isinstance(point, str)
           else np.asarray(point, float))
    # ONE distance by default. A second is worth having when the answer is in
    # doubt -- a board whose printed pitch is wrong biases the solved standoff
    # in proportion to the working distance, so two distances separate a bad
    # artifact from a bad fixture -- but it doubles the poses, and the
    # conditioning does not need it.
    d = (CAL_AZURE_DISTANCE,) if distances is None else tuple(distances)
    sensor = sensor_topics("azure").get("frame") if sensor_topics("azure") else None
    sensor = sensor or "rgb_camera_link"
    poses, dropped = _cal_candidate_poses(aim, sensor, d,
                                          list(CAL_AZURE_TILTS if tilts is None
                                               else tilts), "azure")
    _CAL["azure_dropped"] = dropped
    return poses


def keyence_calibration_poses(point="cal_flat", standoffs=None, tilts=None):
    """The pose set for calibrate_keyence().

    `standoffs` are offsets from the reference distance, and the DEFAULT HAS
    THREE OF THEM ON PURPOSE. One standoff leaves rotation of the head about
    its own laser line unmeasured; see CAL_KEYENCE_STANDOFFS.
    """
    aim = (_cap_point(point) if isinstance(point, str)
           else np.asarray(point, float))
    so = tuple(CAL_KEYENCE_STANDOFFS if standoffs is None else standoffs)
    if len(set(so)) < 2:
        raise CalibrationRefused(
            "every Keyence calibration pose at one standoff (%s). That leaves "
            "rotation of the head about its own laser line unmeasured -- the "
            "fit will converge, report a residual at the noise floor, and "
            "return whatever the URDF said. Pass at least two standoffs; the "
            "default is %s." % (so, CAL_KEYENCE_STANDOFFS))
    # WHAT EACH STANDOFF CAN SEE, said before anything flies. The default
    # (-15, 0, +15) is deliberately WIDE -- standoff variation is the only
    # thing that determines rotation of the head about its own laser line, and
    # 30 mm of it is worth more than a narrower set that sees every feature at
    # every station. What it costs is that the tallest pads fall inside the
    # near limit at -15 and the bench past the far limit at +15. Neither is a
    # collision and neither is a fault; an operator who is not told will read
    # the gaps as a broken sensor, which is what this report exists to prevent.
    seen = cal_artifact_standoff_report(so)
    blind = [d for d, names in seen.items() if not names]
    if blind:
        raise CalibrationRefused(
            "standoff%s %s put the WHOLE artifact outside the head's "
            "%.0f..%.0f mm window, so %s would return nothing. The taught "
            "point is the SURFACE and `standoffs` are offsets from the %.0f mm "
            "reference distance; the artifact then spans %.0f mm below it to "
            "%.0f mm above it."
            % ("" if len(blind) == 1 else "s",
               ", ".join("%+.0f mm" % (1e3*d) for d in sorted(blind)),
               1e3*CAL_KEYENCE_RANGE_M[0], 1e3*CAL_KEYENCE_RANGE_M[1],
               "it" if len(blind) == 1 else "they",
               1e3*CAL_KEYENCE_REF_DIST,
               1e3*abs(min(CAL_ARTIFACT_HEIGHTS.values())),
               1e3*max(CAL_ARTIFACT_HEIGHTS.values())))
    # AIMED ACROSS THE ARTIFACT, not all at its middle. See
    # CAL_KEYENCE_AIM_OFFSETS: this is what turns two measured surfaces into
    # four or five, and it is the difference between a standoff that is solved
    # and a standoff that is traded away against the artifact's own height.
    art = cal_artifact()
    tl = list(CAL_KEYENCE_TILTS if tilts is None else tilts)
    offs = (CAL_KEYENCE_AIM_OFFSETS
            if globals().get("CAL_KEYENCE_AIM_OFFSETS") else ((0.0, 0.0),))
    poses, dropped = [], {}
    for dx, dy in offs:
        at = np.asarray(aim, float) + np.array([float(dx), float(dy), 0.0])
        centred = (abs(dx) < 1e-9 and abs(dy) < 1e-9)
        use = tl if (centred or tilts is not None) else list(
            globals().get("CAL_KEYENCE_OFFSET_TILTS") or tl)
        got, drop = _cal_candidate_poses(
            at, "lj_v7080_optical_frame", so, use, "keyence",
            max_rolls=CAL_KEYENCE_MAX_ROLLS, artifact=art)
        for p in got:
            p["aim"] = [float(v) for v in at]
            p["aim_offset"] = (float(dx), float(dy))
        poses += got
        for k, v in drop.items():
            dropped[k] = dropped.get(k, 0) + v
    _CAL["keyence_dropped"] = dropped
    return poses


def check_calibration_poses(poses, what="this pose set", quiet=False):
    """Judge a pose set BEFORE flying it. Needs no sensor and no motion.

    The conditioning of a hand-eye solve depends only on the robot poses, so
    the question "can this pose set determine the answer" can be settled at the
    prompt in a second. A set found inadequate here costs nothing; the same set
    found inadequate after an hour of moving and grabbing costs the hour, and
    found never costs a scan.
    """
    g = _cal_geom()
    G = [g.rt_to_T(g.quat_to_R(p["quat"]), p["xyz"]) for p in poses]
    if len(G) < 3:
        raise CalibrationRefused(
            "%d pose(s) survived for %s. %s" % (len(G), what,
                                                _cal_dropped_line(what)))
    cond = g.pose_set_conditioning(G)
    if not quiet:
        _cal_say("  %s: %d poses, rotation %.1f / %.1f / %.1f deg rms about the "
                 "set's three axes, error amplified %s -- %s"
                 % (what, len(G),
                    *sorted(cond["rot_axis_rms_deg"], reverse=True),
                    ("infinitely" if not np.isfinite(cond["amplification"])
                     else "%.1fx" % cond["amplification"]),
                    cond["verdict"].upper()))
        for p in cond["problems"]:
            _cal_say("    - " + p)
        line = _cal_dropped_line(what)
        if line:
            _cal_say("    " + line)
    return cond


def _cal_dropped_line(what):
    d = _CAL.get("azure_dropped" if "azure" in what else "keyence_dropped") or {}
    if not d:
        return ""
    return ("dropped: " + ", ".join("%d %s" % (v, k) for k, v in sorted(d.items()))
            + ". Move the plate further inside the work volume, or nearer the "
              "middle of it, if most of them were.")


# ------------------------------------------------------------------------------
# RESILIENCE: reaching one pose, and keeping what it gave
# ------------------------------------------------------------------------------
# WHY THIS EXISTS. A calibration run is 26 to 34 poses and most of an hour, and
# a single pose that cannot be reached must not cost the ones already flown.
# Two ways to lose a pose have to be treated alike: a move REFUSED BEFORE
# MOVING (CaptureRefused, e.g. the cable guard) and a move that RAN AND DID NOT
# COMPLETE (CaptureMotionFailed, a plain RuntimeError, e.g. a Cartesian leg
# that plans to 51%). Both mean "the arm is not at that pose", and neither says
# anything about the poses already in hand, so catching only the first leaves a
# hole exactly the shape of the second.
#
# THREE INDEPENDENT PIECES:
#
#   _cal_fly_to()        the arm gets to a pose BY WHATEVER ROUTE WORKS. The
#                        straight line first, because it is fast and it usually
#                        works; a joint move when it does not.
#   _cal_dataset_*()     every pose that returns data is ON DISK before the
#                        next move starts, so a kill -9, a power cut or an
#                        exception from somewhere nobody anticipated still
#                        leaves something that can be solved without the arm.
#   _cal_keyence_solve() ONE solve, run on whatever is in hand -- from the live
#                        run, or afterwards from the files. The guards are in
#                        it, so the offline path cannot be the lenient one.
#
# WHAT RESILIENCE IS NOT. It is not "always emit a number". A set that does not
# determine the transform is still refused, and it is refused in the same
# function whether it was collected five minutes ago or last week. What changes
# is that the run FINISHES and says which poses were lost, instead of ending on
# a traceback with a bag nobody can use.


#: Routes tried after the straight line, per pose. Two: the local IK branch the
#: arm is already in, then whatever SolveIK finds globally, which is a
#: different wrist winding and is the thing a refused cable band or an
#: unplannable Cartesian leg usually needs.
#:
#: REPLANNING THE IDENTICAL CARTESIAN REQUEST IS NOT ONE OF THEM. MoveIt's
#: computeCartesianPath is deterministic given the same start state, so a
#: second attempt at a leg that reached 51% reaches 51% again; it costs another
#: minute and tells nobody anything.
global CAL_MOVE_ROUTES
CAL_MOVE_ROUTES = 2


global _cal_fly_to
def _cal_fly_to(p, label=None, routes=None):
    """Get the tool to one calibration pose, by whatever route works.

    Returns {"ok", "route", "why", "tried"}. A pose that cannot be reached
    costs THAT POSE: the reason is printed and returned, and nothing is raised.

    THE STOP-THE-RUN EXCEPTIONS PASS STRAIGHT THROUGH and are the caller's to
    handle -- CaptureStopped (the monitor physically stopped the arm for
    overspeed or overforce; a human has to look at the cell), CaptureAbort (the
    operator pressed q) and KeyboardInterrupt. Those end the FLYING. They must
    not end the run before it has solved what it already collected, which is
    calibrate_keyence()'s job and not this function's.

    WHY THE SECOND ROUTE IS A JOINT MOVE AND NOT capture_transit(). The path
    between two calibration poses is irrelevant -- only the endpoint is
    measured -- so any route that arrives is as good as any other, and the
    cheapest correct one wins. capture_transit() climbs to a transit height,
    crosses above the work volume and descends, which is three to five
    confirmed, previewed, monitored legs; over 34 calibration poses clustered
    within ~100 mm of one another that is a hundred extra moves and most of the
    session. It also would not help with the failure that actually occurs: a
    leg asking for 180 degrees of wrist reorientation, which transit carries on
    its "across" leg unchanged, and whose own fallback is -- a joint move.

    So this is the pattern capture_transit() uses at its two fallbacks (see
    cell_capture_motion.dpi), applied directly and without the detour. It is
    not less safe than the straight line: capture_move_joints() samples the
    interpolated joint path every 2 degrees, runs FK on every sample, checks
    the work volume and the cable band at each one, and MoveIt collision-checks
    the path it executes. What it does NOT do is require the TIP to travel in a
    straight line, and that requirement is the whole of what failed.
    """
    label = p["label"] if label is None else label
    xyz = np.asarray(p["xyz"], float)
    quat = tuple(p["quat"])
    tried = []
    n_routes = int(CAL_MOVE_ROUTES if routes is None else routes)

    def _bad(kind, e):
        why = str(e).splitlines()[0]
        tried.append((kind, why))
        return why

    # -- 1. the straight line ------------------------------------------------
    try:
        capture_move([(xyz, quat)], label)
        return {"ok": True, "route": "cartesian", "why": None, "tried": tried}
    except (CaptureStopped, CaptureAbort, KeyboardInterrupt):
        raise
    except CaptureSkip:
        # The operator said skip. Skip means skip; do not offer them a retry.
        tried.append(("cartesian", "skipped by the operator"))
        return {"ok": False, "route": None, "tried": tried,
                "why": "skipped by the operator"}
    except (CableRefused, CaptureRefused, CaptureMotionFailed) as e:
        why = _bad("cartesian", e)
        _cal_say("    %-30s straight line did not fly -- %s" % (label, why))

    # -- 2. the same endpoint, reached in joint space ------------------------
    # TWO CONFIGURATIONS, NOT ONE, and the second only if it is really
    # different. _ik_target() is local-then-global: local keeps the branch the
    # arm is in (a small, safe move), global finds another winding, which is
    # what a cable band refusal or an unplannable straight line usually needs.
    # p["joints"] is the configuration the pose SCREEN solved to -- a third
    # branch again, chosen when the set was generated.
    alts = []
    here = None
    try:
        with _local_ik():
            here = _ik_target(xyz, quat)
    except Exception as e:                                    # noqa: BLE001
        _bad("ik", e)
    if here is not None:
        alts.append(("joint move", list(here)))
    screened = p.get("joints")
    if screened is not None and len(screened) == 6:
        if here is None or float(np.max(np.abs(
                np.asarray(screened, float) - np.asarray(here, float)))) > 0.02:
            alts.append(("joint move, the screened configuration",
                         [float(v) for v in screened]))
    if not alts:
        _cal_say("    %-30s and no IK solution for it from here either"
                 % (label,))
        return {"ok": False, "route": None, "tried": tried,
                "why": (tried[0][1] if tried else "no IK solution")
                       + "; no joint solution for the pose from here"}

    for kind, q_target in alts[:max(0, n_routes)]:
        _cal_say("    %-30s retrying as a %s" % (label, kind))
        try:
            capture_move_joints(q_target, "%s (%s)" % (label, kind))
            return {"ok": True, "route": kind, "why": None, "tried": tried}
        except (CaptureStopped, CaptureAbort, KeyboardInterrupt):
            raise
        except CaptureSkip:
            tried.append((kind, "skipped by the operator"))
            return {"ok": False, "route": None, "tried": tried,
                    "why": "skipped by the operator"}
        except (CableRefused, CaptureRefused, CaptureMotionFailed) as e:
            _cal_say("    %-30s %s did not fly either -- %s"
                     % (label, kind, _bad(kind, e)))

    return {"ok": False, "route": None, "tried": tried,
            "why": "; ".join("%s: %s" % t for t in tried)}


# ------------------------------------------------------------------------------
# The dataset on disk -- written as it is collected, not at the end
# ------------------------------------------------------------------------------
# THE FILE IS THE DELIVERABLE, not the solve. A calibration run is half an hour
# of arm time and a trip to the cell; the arithmetic afterwards is seconds and
# can be repeated as often as anybody likes. So the expensive half is committed
# to disk the moment it exists, one file per pose, and the solve reads it back
# -- in the same process on a good day, in another process next week on a bad
# one.
#
# THE SHAPE IS THE ONE THE OFFLINE TOOLING ALREADY CONSUMES: labels, G (world
# -> probe_end, 4x4 per pose), X_urdf (probe_end -> the sensor frame as the
# description had it at capture time), counts, and one stacked points array.
# dgpfiles/utils/cal_extract.py produces exactly that from a bag, so an npz
# from a bag and an npz from a live run are interchangeable and
# solve_keyence_from_take() takes either.

global _cal_fly_or_refuse
def _cal_fly_or_refuse(xyz, quat, label):
    """_cal_fly_to() for a pose that is NOT optional: retry, then refuse.

    verify_calibration()'s four poses are compared against one another, so
    dropping one is not a degradation, it is a different measurement. They
    still get the second route -- a leg that will not plan as a straight line
    usually plans in joint space -- and if nothing reaches the pose the
    verification says so instead of returning a comparison it did not make.
    """
    flown = _cal_fly_to({"label": label, "xyz": xyz, "quat": quat})
    if not flown["ok"]:
        raise CalibrationRefused(
            "%s: the arm did not reach this pose by any route, so nothing has "
            "been measured or compared.\n  %s"
            % (label, "\n  ".join("%s: %s" % t for t in flown["tried"])
               or flown["why"]))
    return flown


global _cal_stop_why
def _cal_stop_why(e):
    """One line naming WHICH stop-the-run condition ended the flying.

    The three are not the same event and they do not need the same response:
    a CaptureStopped means a human has to look at the cell before the arm
    moves again, an abort means the operator chose to stop, and a
    KeyboardInterrupt means they stopped the process.
    """
    if isinstance(e, CaptureStopped):
        return ("THE MONITOR STOPPED THE ARM: %s. Check the cell before "
                "anything else moves." % (str(e).splitlines()[0],))
    if isinstance(e, CaptureAbort):
        return "ABORTED by the operator at: %s" % (str(e).splitlines()[0],)
    if isinstance(e, KeyboardInterrupt):
        return "INTERRUPTED at the keyboard"
    return "stopped: %s" % (str(e).splitlines()[0] or type(e).__name__,)


global _cal_offline_hint
def _cal_offline_hint(sensor, data, used=None):
    """What to type to solve this dataset again without the arm.

    PRINTED ON EVERY PATH OUT, including the ones that worked, because the
    operator who needs it is standing at a cell reading a traceback and is not
    going to go looking for a docstring.
    """
    if not (data and data.get("dir")):
        return ("  Nothing was saved incrementally, so there is nothing to "
                "re-solve. Fix whatever stopped CAPTURE_ROOT being writable "
                "before flying this again.")
    n = len(data.get("rows", [])) if used is None else used
    return ("  %d pose(s) were collected and are on disk. Solve them with no "
            "arm and no cell:\n      solve_%s_from_take(%r)"
            % (n, sensor, data["dir"]))


global _cal_safe_name
def _cal_safe_name(label):
    return "".join(c if (c.isalnum() or c in "+-._") else "_" for c in label)


global _cal_label_standoff
def _cal_label_standoff(label):
    """The standoff, metres, out of a pose label like "keyence t+0,-15 r+90 d-15".

    For datasets that carry no per-pose standoff of their own -- an npz lifted
    out of a bag by extract.py, say. The standoff SPREAD is a guard, not a
    decoration (one rung leaves rotation about the laser line unmeasured), so
    it is recovered rather than assumed when it was not recorded.
    """
    m = re.search(r"\bd([-+]?\d+(?:\.\d+)?)\s*$", str(label))
    return None if m is None else float(m.group(1))*1e-3


global _cal_atomic_write
def _cal_atomic_write(path, write):
    """`write(binary_file)` into path, via a temporary file and a rename.

    A half-written pose file is worse than a missing one: the run that needs
    this is the run that was killed, and it may have been killed HERE. The
    fsync is not ceremony either -- "power cut" is on the list of things this
    has to survive, and a rename without it reorders freely.
    """
    tmp = path + ".part"
    with open(tmp, "wb") as f:
        write(f)
        f.flush()
        os.fsync(f.fileno())
    os.replace(tmp, path)


global _cal_dataset_start
def _cal_dataset_start(sensor, take, planned, header=None):
    """Open an on-disk dataset for a calibration run. Never raises.

    Inside the take when there is one, so it travels with the bag and the
    scenario.json; beside CAPTURE_ROOT when there is not, so that calling a
    calibration outside a take still records something.
    """
    d = None
    if take is not None:
        try:
            d = os.path.join(take.dir, "%s_poses" % sensor)
            os.makedirs(d, exist_ok=True)
        except Exception as e:                                # noqa: BLE001
            _cal_say("  (could not write inside the take: %s)" % (e,))
            d = None
    if d is None:
        d = os.path.join(os.path.expanduser(CAPTURE_ROOT), "cal_poses",
                         "%s_%s" % (sensor, time.strftime("%Y%m%d_%H%M%S")))
        try:
            os.makedirs(d, exist_ok=True)
        except Exception as e:                                # noqa: BLE001
            _cal_say("  NOTHING WILL BE SAVED INCREMENTALLY: %s" % (e,))
            d = None
    data = {"sensor": sensor, "dir": d, "rows": [], "misses": [],
            "planned": int(planned), "closed": False,
            "header": dict(header or {})}
    if d:
        _cal_say("  collecting into %s" % d)
        _cal_say("    if this run is interrupted, nothing is lost:  "
                 "solve_%s_from_take(%r)" % (sensor, d))
        _cal_dataset_index(data)
    return data


global _cal_dataset_index
def _cal_dataset_index(data):
    """Rewrite index.json. Small, atomic, and rewritten after every pose."""
    if not data.get("dir"):
        return None
    poses = []
    for r in data["rows"]:
        rec = {k: v for k, v in r.items() if k not in ("points", "G", "X_urdf")}
        rec["G"] = np.asarray(r["G"], float).tolist()
        rec["X_urdf"] = (None if r.get("X_urdf") is None
                         else np.asarray(r["X_urdf"], float).tolist())
        rec["n_points"] = (None if r.get("points") is None
                           else int(np.asarray(r["points"]).shape[0]))
        if r.get("board") is not None:
            rec["board"] = np.asarray(r["board"], float).tolist()
        poses.append(rec)
    doc = {"sensor": data["sensor"], "planned": data["planned"],
           "closed": bool(data.get("closed")),
           "note": data.get("note"),
           "written": datetime.datetime.now().isoformat(timespec="seconds"),
           "header": data["header"],
           "misses": [list(m) for m in data["misses"]],
           "poses": poses}
    path = os.path.join(data["dir"], "index.json")
    def _plain(o):
        if isinstance(o, np.ndarray):
            return o.tolist()
        if isinstance(o, (np.integer, np.floating, np.bool_)):
            return o.item()
        return str(o)
    try:
        _cal_atomic_write(path, lambda f: f.write(
            json.dumps(doc, indent=1, sort_keys=True,
                       default=_plain).encode("utf-8")))
    except Exception as e:                                    # noqa: BLE001
        _cal_say("  (could not write %s: %s)" % (path, e))
    return path


global _cal_dataset_add
def _cal_dataset_add(data, row):
    """Append one pose and put it on disk BEFORE the next move starts.

    Never raises: a disk that is full must not throw away the arm time that is
    already in memory. It says so, loudly, and the run goes on.
    """
    row = dict(row)
    row["index"] = len(data["rows"])
    data["rows"].append(row)
    if not data.get("dir"):
        return None
    name = "%03d_%s.npz" % (row["index"], _cal_safe_name(row.get("label", "")))
    path = os.path.join(data["dir"], name)
    row["file"] = name
    try:
        arrays = {"label": np.array(row.get("label", "")),
                  "G": np.asarray(row["G"], float),
                  "index": np.array(row["index"])}
        if row.get("X_urdf") is not None:
            arrays["X_urdf"] = np.asarray(row["X_urdf"], float)
        for key in ("points", "board"):
            if row.get(key) is not None:
                arrays[key] = np.asarray(row[key])
        for key in ("distance", "roll"):
            if row.get(key) is not None:
                arrays[key] = np.array(float(row[key]))
        for key in ("tilt", "aim"):
            if row.get(key) is not None:
                arrays[key] = np.asarray(row[key], float)
        _cal_atomic_write(path, lambda f: np.savez_compressed(f, **arrays))
    except Exception as e:                                    # noqa: BLE001
        _cal_say("  COULD NOT SAVE %s: %s -- this pose is in memory only"
                 % (name, e))
        row["file"] = None
    _cal_dataset_index(data)
    return path


global _cal_dataset_finish
def _cal_dataset_finish(data, note=None):
    """Close the dataset: one combined npz beside the per-pose files.

    The per-pose files are the crash-proof half and are never rewritten; this
    is the convenience half, in the shape extract.py emits, so one path feeds
    everything downstream.
    """
    data["closed"] = True
    if note:
        data["note"] = note
    rows = data["rows"]
    path = None
    if data.get("dir") and rows:
        path = os.path.join(data["dir"], "%s_calibration.npz" % data["sensor"])
        try:
            arrays = {"labels": np.array([r.get("label", "") for r in rows]),
                      "G": np.array([np.asarray(r["G"], float) for r in rows])}
            if all(r.get("X_urdf") is not None for r in rows):
                arrays["X_urdf"] = np.array(
                    [np.asarray(r["X_urdf"], float) for r in rows])
            if all(r.get("points") is not None for r in rows):
                arrays["counts"] = np.array(
                    [np.asarray(r["points"]).shape[0] for r in rows])
                arrays["points"] = np.vstack(
                    [np.asarray(r["points"]) for r in rows])
            if all(r.get("board") is not None for r in rows):
                arrays["board"] = np.array(
                    [np.asarray(r["board"], float) for r in rows])
            if all(r.get("distance") is not None for r in rows):
                arrays["distances"] = np.array(
                    [float(r["distance"]) for r in rows])
            _cal_atomic_write(path, lambda f: np.savez_compressed(f, **arrays))
        except Exception as e:                                # noqa: BLE001
            _cal_say("  (could not write the combined npz: %s)" % (e,))
            path = None
    _cal_dataset_index(data)
    return path


global _cal_dataset_load
def _cal_dataset_load(path, sensor="keyence"):
    """Read back what a run collected. A directory, or an npz.

    `path` may be the pose directory itself, the take directory that holds it,
    a session directory holding takes, the combined npz, or an npz produced by
    dgpfiles/utils/cal_extract.py from a bag. Anything else is an error
    that names what it looked for, because "no data" at the end of a session
    is the least useful message this file could print.
    """
    path = os.path.expanduser(str(path))
    if os.path.isdir(path):
        here = os.path.join(path, "index.json")
        if not os.path.exists(here):
            # a take directory, or a session of takes: find the pose dir
            # THE SENSOR'S OWN DIRECTORY, NOT WHICHEVER SORTS LAST. A session
            # holds both calibrations, so a session handed to
            # solve_keyence_from_take() must not come back with the Azure's
            # views -- they would load (G is G) and solve to nonsense.
            cands = []
            for root, dirs, files in os.walk(path):
                if "index.json" in files and os.path.basename(root) == (
                        "%s_poses" % sensor):
                    cands.append(root)
            if not cands:
                for root, dirs, files in os.walk(path):
                    cands += [os.path.join(root, f) for f in files
                              if f == "%s_calibration.npz" % sensor]
            if not cands:
                raise CalibrationRefused(
                    "no %s calibration dataset under %s. Looked for a "
                    "%s_poses/index.json and for a %s_calibration.npz. If the "
                    "run predates incremental saving, lift one out of the bag "
                    "with dgpfiles/utils/cal_extract.py and pass the npz."
                    % (sensor, path, sensor, sensor))
            return _cal_dataset_load(sorted(cands)[-1], sensor)
        with open(here) as f:
            doc = json.load(f)
        rows = []
        for rec in doc.get("poses", []):
            row = dict(rec)
            fn = rec.get("file")
            if fn and os.path.exists(os.path.join(path, fn)):
                with np.load(os.path.join(path, fn), allow_pickle=False) as z:
                    for key in ("points", "board"):
                        if key in z:
                            row[key] = z[key]
            row["G"] = np.asarray(rec["G"], float)
            if rec.get("X_urdf") is not None:
                row["X_urdf"] = np.asarray(rec["X_urdf"], float)
            rows.append(row)
        return {"sensor": doc.get("sensor", sensor), "dir": path, "rows": rows,
                "planned": int(doc.get("planned") or len(rows)),
                "misses": [tuple(m) for m in doc.get("misses", [])],
                "closed": bool(doc.get("closed")), "note": doc.get("note"),
                "header": doc.get("header", {}), "source": here}
    if not os.path.exists(path):
        raise CalibrationRefused("%s does not exist" % (path,))
    with np.load(path, allow_pickle=False) as z:
        labels = [str(v) for v in z["labels"]] if "labels" in z else None
        G = np.asarray(z["G"], float)
        if labels is None:
            labels = ["pose %d" % i for i in range(G.shape[0])]
        X = np.asarray(z["X_urdf"], float) if "X_urdf" in z else None
        pts = None
        if "points" in z and "counts" in z:
            counts = [int(v) for v in z["counts"]]
            flat = np.asarray(z["points"])
            edges = np.cumsum([0] + counts)
            pts = [flat[edges[i]:edges[i + 1]] for i in range(len(counts))]
        dist = ([float(v) for v in z["distances"]] if "distances" in z
                else [_cal_label_standoff(lbl) for lbl in labels])
        board = np.asarray(z["board"], float) if "board" in z else None
        rows = []
        for i, label in enumerate(labels):
            rows.append({"label": label, "index": i, "G": G[i],
                         "X_urdf": (None if X is None else X[i]),
                         "points": (None if pts is None else pts[i]),
                         "board": (None if board is None else board[i]),
                         "distance": dist[i] if i < len(dist) else None})
    return {"sensor": sensor, "dir": os.path.dirname(path), "rows": rows,
            "planned": len(rows), "misses": [], "closed": True, "note": None,
            "header": {}, "source": path}


# ------------------------------------------------------------------------------
# The two calibrations
# ------------------------------------------------------------------------------

def calibrate_azure(point="cal_board", poses=None, distances=None, tilts=None,
                    ir=False, require=True, save=True):
    """Solve probe_end -> the Azure's optical frame. No touch-off.

    The camera sees a fixed printed checkerboard from many tool orientations;
    each view gives the board's pose in the camera and the robot gives the
    flange's pose in the base, and AX = XB gives the one transform that makes
    every view agree that the board never moved.

    WHAT IS BEING SOLVED AND WHAT IS NOT. On hardware this cell's depth topic
    is depth_to_rgb -- the depth image already resampled into the COLOUR
    camera by the Azure's own factory extrinsic -- so the depth points and the
    colour image live in ONE frame, rgb_camera_link, and solving where that
    frame is places both. What is NOT solved here is the factory extrinsic
    itself, the colour intrinsics, or any error in the DEPTH VALUES: hand-eye
    locates the camera, it does not check that the camera measures distance
    correctly. A time-of-flight range bias survives this untouched, looks
    exactly like a mounting error in the resulting mesh, and is caught only by
    verify_calibration(). Run that afterwards. Always.

    `ir=True` additionally detects the board in the IR amplitude image and
    solves the depth camera's own frame, as a cross-check on the factory
    depth-to-colour extrinsic. It is slower and it is not what the pipeline
    uses; leave it off unless the colour solve and the verification disagree.
    """
    from sensor_msgs.msg import Image
    g = _cal_geom()
    topics = sensor_topics("azure") or {}
    colour = (CAL_AZURE_IR_TOPIC if ir
              else topics.get("color") or sensor_topic("azure", "color"))
    info = ("/azure/ir/camera_info" if ir
            else topics.get("camera_info") or sensor_topic("azure", "camera_info"))
    poses = (azure_calibration_poses(point, distances, tilts)
             if poses is None else poses)
    cond = check_calibration_poses(poses, "azure pose set")
    if require and cond["verdict"] == "inadequate":
        raise CalibrationRefused(
            "the azure pose set cannot determine the transform:\n    "
            + "\n    ".join(cond["problems"])
            + "\n  Nothing has moved. Widen the tilts, or move the board so "
              "more of them are reachable, and try again.")

    K, D, w, h, cam_frame = _cal_intrinsics(info)
    _cal_say("  camera %s: %d x %d, fx %.1f, %d distortion coefficients"
             % (cam_frame, w, h, K[0, 0], D.size))
    _cal_say(describe_calibration_artifact())

    params = {"point": point if isinstance(point, str) else list(point),
              "poses": len(poses), "ir": bool(ir), "board": {
                  k: v for k, v in cal_board().items() if k != "object_points"}}
    G, C, kept, misses, res = [], [], [], [], None
    with capture_scenario("calibrate_azure", sets=("core",), params=params,
                          expect_s=60.0*len(poses)/10.0, motion=True) as take:
        data = _cal_dataset_start(
            "azure", take, len(poses),
            header={"frame": cam_frame, "point": params["point"],
                    "board": params["board"], "ir": bool(ir),
                    "cell": globals().get("CELL_NAME"),
                    "mode": globals().get("CELL_MODE")})
        stop = None
        p = None                      # the pose in flight, for the stop handler
        try:
            # A POSE THAT WILL NOT FLY COSTS THAT POSE, NOT THE RUN -- the same
            # rule as calibrate_keyence(), and for the same reason. With no
            # handling here, one refused pose or one incomplete Cartesian leg
            # discards every view already taken, out of a set of 39.
            for p in poses:
                flown = _cal_fly_to(p)
                if not flown["ok"]:
                    misses.append((p["label"], flown["why"]))
                    data["misses"] = misses
                    _cal_say("    %-28s NOT FLOWN -- %s"
                             % (p["label"], flown["why"]))
                    continue
                time.sleep(CAL_SETTLE_S)
                got = _cal_one_message(colour, Image, timeout=15.0,
                                       node_name="cal_colour")
                if not got:
                    misses.append((p["label"], "no image"))
                    data["misses"] = misses
                    continue
                det = detect_board(_cal_gray(got[-1]), K, D)
                if det is None:
                    misses.append((p["label"], "no board in view"))
                    data["misses"] = misses
                    _cal_say("    %-28s no board" % p["label"])
                    continue
                T_cam_board, img, _obj = det
                # THE FLANGE POSE IS READ FROM TF AT THE POSE THE ARM REACHED,
                # not from the pose that was commanded. They differ -- the
                # planner settles where it settles -- and using the command is
                # a silent systematic error in every observation.
                G.append(_cal_tf("world", "probe_end"))
                C.append(T_cam_board)
                kept.append(p)
                _cal_dataset_add(data, {
                    "label": p["label"], "G": G[-1], "board": T_cam_board,
                    "X_urdf": _cal_tf("probe_end", cam_frame),
                    "corners": int(img.shape[0]),
                    "distance": float(p.get("distance", 0.0)),
                    "tilt": [float(v) for v in p.get("tilt", (0.0, 0.0))],
                    "roll": float(p.get("roll", 0.0)),
                    "route": flown["route"]})
                take.event(kind="calibration_view", label=p["label"],
                           corners=int(img.shape[0]))
                _cal_say("    %-28s %d corners, board at %.3f m"
                         % (p["label"], img.shape[0], T_cam_board[2, 3]))
        except (CaptureStopped, CaptureAbort, KeyboardInterrupt) as e:
            stop = e
            if p is not None:
                misses.append((p["label"], _cal_stop_why(e)))
            _cal_say("")
            _cal_say("  %s -- NO MORE POSES WILL BE FLOWN." % _cal_stop_why(e))
            _cal_say("  %d of %d views are in hand and the solve runs on them."
                     % (len(G), len(poses)))
        finally:
            data["misses"] = misses
            _cal_dataset_finish(data, note=(None if stop is None
                                            else _cal_stop_why(stop)))

        if misses:
            _cal_say("")
            _cal_say("  %d of %d poses did not contribute; %d did."
                     % (len(misses), len(poses), len(G)))
        try:
            if len(G) < 3:
                raise CalibrationRefused(
                    "only %d of %d poses saw the board. Is it inside the "
                    "camera's view at every pose, flat, and lit without glare?"
                    % (len(G), len(poses)))

            # probe_end is the gripper frame, so X is probe_end -> camera and
            # the composite world -> camera is right even if probe_end itself
            # is not where the tooling URDF says. That is the frame everything
            # downstream asks TF for, which is the frame worth being right
            # about.
            res = g.solve_handeye(G, C, name="azure", fix_flips=True)
            _cal_say("")
            for line in res.report().splitlines():
                _cal_say("  " + line)

            # The correction against what TF says today -- the number that
            # tells the operator whether this is a loose fixture or a typo in a
            # xacro.
            now = _cal_tf("probe_end", cam_frame)
            dt, dr = g.pose_delta(now, res.X)
            _cal_say("")
            _cal_say("  AGAINST THE ROBOT DESCRIPTION IN USE: %.2f mm and %.2f "
                     "mrad (%.2f deg)" % (dt*1e3, dr*1e3, math.degrees(dr)))
            if dt*1e3 > 25.0:
                _cal_say("    That is a large move. Check the board pitch has "
                         "been measured (set_board_square) and that the plate "
                         "did not shift, before believing it.")

            take.results.update(
                sensor="azure", frame=cam_frame, poses=len(poses), used=len(G),
                missed=misses, xyz=list(res.xyz), quat=list(res.quat),
                rpy=list(res.rpy), residual_mm=res.residual_mm,
                residual_mrad=res.residual_mrad,
                sigma=(None if res.sigma is None
                       else [float(v) for v in res.sigma]),
                conditioning=res.conditioning, adequate=bool(res.adequate),
                per_pose=res.per_pose, flips=res.flips,
                delta_from_urdf_mm=dt*1e3, delta_from_urdf_mrad=dr*1e3,
                dataset=data.get("dir"), report=res.report())
            _CAL["azure"] = res
            if save and res.adequate:
                take.results["files"] = write_calibration(
                    "azure", res, cam_frame, take=take)
            elif save:
                _cal_say("  NOT SAVED: the pose set does not determine this "
                         "transform. Nothing has been written.")
        except Exception as e:                                # noqa: BLE001
            # Anything, not only CalibrationRefused -- see the note on the same
            # clause in calibrate_keyence(). Nothing is swallowed.
            _cal_say("")
            _cal_say("  NOT SOLVED (%s): %s"
                     % (type(e).__name__, str(e).splitlines()[0]))
            _cal_say(_cal_offline_hint("azure", data, len(G)))
            if stop is None:
                raise
            _cal_say("  ... and the run had already been stopped, which is "
                     "re-raised instead.")
        if stop is not None:
            _cal_say("")
            _cal_say("  %s" % _cal_stop_why(stop))
            _cal_say("  Everything above this line came from the %d view(s) "
                     "that flew before it." % (len(G),))
            _cal_say(_cal_offline_hint("azure", data, len(G)))
            raise stop
    return res


def calibrate_keyence(point="cal_flat", poses=None, standoffs=None, tilts=None,
                      artifact=None, require=True, save=True):
    """Solve probe_end -> lj_v7080_optical_frame by landing profiles on a flat.

    The Keyence cannot see a printed pattern -- it is a line profiler, 800
    heights along a 31 mm line at 0.5 um resolution, and toner is 5-10 um
    thick, which is at its noise floor and not above it. So it is calibrated
    against SHAPE: every profile point, carried into the world by the candidate
    transform, must land on the artifact's surface. No correspondences, no
    features, no detection.

    Needs a flat at least as big as the sensor's line, held at varied tilts AND
    AT VARIED STANDOFFS. The standoffs are not optional; see
    CAL_KEYENCE_STANDOFFS and the test that pins it.

    The artifact's pose is solved alongside the transform, so the flat does not
    have to be anywhere in particular -- but its STARTING guess has to be close
    enough for the first iteration to find it, which is what the plane fitted
    from the first pose provides.
    """
    g = _cal_geom()
    art = cal_artifact() if artifact is None else artifact
    topic = sensor_topic("keyence", "profiles", "/profiles")
    poses = (keyence_calibration_poses(point, standoffs, tilts)
             if poses is None else poses)
    if len({p["distance"] for p in poses}) < 2 and require:
        raise CalibrationRefused(
            "the surviving Keyence poses are all at one standoff. Rotation of "
            "the head about its own laser line is then unmeasured. Nothing has "
            "moved.")
    _cal_say("  %d poses at standoffs %s mm"
             % (len(poses), sorted({round(p["distance"]*1e3) for p in poses})))
    line = _cal_dropped_line("keyence pose set")
    if line:
        _cal_say("  " + line)
    if len(poses) < 8:
        raise CalibrationRefused(
            "only %d Keyence poses survived. %s" % (len(poses), line or
            "Move the flat nearer the middle of the work volume."))

    params = {"point": point if isinstance(point, str) else list(point),
              "poses": len(poses), "standoffs": sorted(
                  {float(p["distance"]) for p in poses})}
    # sets=("core", "keyence") RECORDS /profiles. Without it, a run whose
    # Keyence data turns out to be unusable leaves nothing to re-examine or
    # re-solve from and the whole session is lost for this sensor. See the note
    # in verify_calibration() for what it costs.
    res = None
    with capture_scenario("calibrate_keyence", sets=("core", "keyence"),
                          laser=True, params=params, expect_s=30.0*len(poses),
                          motion=True) as take:
        data = _cal_dataset_start(
            "keyence", take, len(poses),
            header={"frame": "lj_v7080_optical_frame", "topic": topic,
                    "point": params["point"], "standoffs": params["standoffs"],
                    "artifact": {"kind": CAL_ARTIFACT, "describe": art.describe()},
                    "ref_dist_m": float(CAL_KEYENCE_REF_DIST),
                    "range_m": [float(v) for v in CAL_KEYENCE_RANGE_M],
                    "profiles_per_pose": int(CAL_PROFILES_PER_POSE),
                    "settle_s": float(CAL_SETTLE_S),
                    "cell": globals().get("CELL_NAME"),
                    "mode": globals().get("CELL_MODE")})
        misses = []
        stop = None
        p = None                      # the pose in flight, for the stop handler
        try:
            for p in poses:
                # A POSE THAT WILL NOT FLY COSTS THAT POSE, NOT THE RUN. Half
                # an hour of arm time and a multi-gigabyte bag ride on this.
                #
                # Catching CaptureRefused alone is not enough:
                # CaptureMotionFailed is a RuntimeError, not a CaptureRefused,
                # so a move refused BEFORE MOVING would cost its pose while a
                # move that RAN AND DID NOT COMPLETE cost the whole run.
                # _cal_fly_to() treats them alike, and tries a second route
                # before giving up.
                #
                # The screen in _cal_candidate_poses() cannot promise agreement
                # with the guard at move time, because it solves IK from
                # wherever the arm was when the set was generated and the move
                # solves it from wherever the arm actually is; those pick
                # different wrist-3 branches. Seeding the screen in flight
                # order makes them agree far more often. It cannot make them
                # agree always, and a calibration that throws away everything
                # it has whenever they differ is not one that finishes on a
                # real cell.
                flown = _cal_fly_to(p)
                if not flown["ok"]:
                    misses.append((p["label"], flown["why"]))
                    data["misses"] = misses
                    _cal_say("    %-30s NOT FLOWN -- %s"
                             % (p["label"], flown["why"]))
                    continue
                time.sleep(CAL_SETTLE_S)
                try:
                    pts, frame, n = _cal_profile_points(topic)
                except CalibrationRefused as e:
                    # THE REASON IS PRINTED, not swallowed into "nothing
                    # returned". A pose that came back a constant and a pose
                    # that came back silent are different faults with different
                    # fixes, and the operator is standing there while this runs.
                    why = str(e)
                    misses.append((p["label"], why.splitlines()[0]))
                    data["misses"] = misses
                    _cal_say("    %-30s REFUSED" % p["label"])
                    for ln in why.splitlines():
                        _cal_say("      " + ln)
                    continue
                # ON DISK BEFORE THE NEXT MOVE STARTS. Everything after this
                # line -- the rest of the pose set, the solve, the process --
                # can die without costing this pose.
                _cal_dataset_add(data, {
                    "label": p["label"], "G": _cal_tf("world", "probe_end"),
                    "X_urdf": _cal_tf("probe_end", "lj_v7080_optical_frame"),
                    "points": pts, "frame": frame, "n_msgs": int(n),
                    "distance": float(p["distance"]),
                    "tilt": [float(v) for v in p.get("tilt", (0.0, 0.0))],
                    "roll": float(p.get("roll", 0.0)),
                    "aim": [float(v) for v in p.get("aim", (0.0, 0.0, 0.0))],
                    "route": flown["route"]})
                _cal_say("    %-30s %5d points from %d profiles%s"
                         % (p["label"], pts.shape[0], n,
                            "" if flown["route"] == "cartesian"
                            else "  (reached by %s)" % flown["route"]))
        except (CaptureStopped, CaptureAbort, KeyboardInterrupt) as e:
            # THE FLYING ENDS HERE. THE RUN DOES NOT.
            #
            # CAUGHT SEPARATELY, and before the clause above: CaptureStopped
            # subclasses CaptureRefused, so a monitor stop for overforce would
            # otherwise be swallowed and this loop would carry on to the next
            # pose. That is the one thing it must never do. But "stop flying"
            # is not "throw away the half-hour of arm time already collected":
            # the poses in hand were measured before the stop and are as good
            # as they ever were. So the solve runs, and THEN the exception
            # leaves.
            stop = e
            # THE POSE THAT TRIGGERED IT IS A LOST POSE WITH A REASON, and the
            # reason is the most interesting one in the run. Record it like any
            # other, so it appears in the take and in the summary rather than
            # only in a traceback.
            if p is not None:
                misses.append((p["label"], _cal_stop_why(e)))
            _cal_say("")
            _cal_say("  %s -- NO MORE POSES WILL BE FLOWN." % _cal_stop_why(e))
            _cal_say("  %d of %d poses are in hand and the solve runs on them."
                     % (len(data["rows"]), len(poses)))
        finally:
            data["misses"] = misses
            _cal_dataset_finish(data, note=(None if stop is None
                                            else _cal_stop_why(stop)))

        if misses:
            _cal_say("")
            _cal_say("  %d of %d poses did not contribute; %d did."
                     % (len(misses), len(poses), len(data["rows"])))
        try:
            res = _cal_keyence_solve(data, artifact=art, require=require,
                                     save=save, take=take)
        except Exception as e:                                # noqa: BLE001
            # NOT JUST CalibrationRefused. A solve that walks away from the
            # artifact raises ValueError out of calibration_solve, and a solve
            # that hits something nobody anticipated raises whatever it raises;
            # every one of those still has to print where the data is before
            # the traceback, because the data is the expensive part and the
            # arithmetic can be repeated for nothing. Nothing is swallowed --
            # the exception is re-raised below, or the stop that preceded it
            # is.
            _cal_say("")
            _cal_say("  NOT SOLVED (%s):" % type(e).__name__)
            for ln in str(e).splitlines():
                _cal_say("  " + ln)
            _cal_say(_cal_offline_hint("keyence", data))
            if stop is None:
                raise
            _cal_say("  ... and the run had already been stopped, which is "
                     "re-raised instead.")
        if stop is not None:
            # SAID LAST, because a traceback follows it and the last line
            # before a traceback is the one that gets read.
            _cal_say("")
            _cal_say("  %s" % _cal_stop_why(stop))
            _cal_say("  Everything above this line came from the %d pose(s) "
                     "that flew before it%s."
                     % (len(data["rows"]),
                        " and has been written" if res is not None
                        and save else ""))
            _cal_say(_cal_offline_hint("keyence", data))
            raise stop
    return res


global _cal_keyence_solve
def _cal_keyence_solve(data, artifact=None, require=True, save=True, take=None,
                       quiet=False):
    """Solve probe_end -> the Keyence from a collected dataset. No motion.

    ONE SOLVE, TWO CALLERS: calibrate_keyence() at the end of a run, and
    solve_keyence_from_take() days later from the files. They share this
    function rather than each having their own, because the guards below are
    the only thing standing between a pose set that does not determine the
    transform and a xacro that gets deployed. An offline path with its own
    lenient copy of them would be worse than no offline path.

    EVERY GUARD APPLIES TO WHAT SURVIVED, not to what was planned:

      at least 3 poses          three points do not make a fit, but fewer than
                                three is not arguable.
      at least 2 standoffs      at one standoff, rotation of the head about its
                                own laser line moves no measured point at first
                                order. The fit converges, reports a residual at
                                the noise floor, and returns whatever the URDF
                                said. `require=False` overrides it deliberately.
      check_plane_support       one static profile is a LINE, and a plane
                                fitted to a line has a normal chosen by
                                nothing -- it comes back roughly horizontal,
                                reported as a 90 degree "tilt".
      surface_fit_recovery      pushes the answer off and sees how much comes
                                back. A fit can report 0.179 mm rms with the
                                standoff 3.8 mm out; this is the check that
                                says so.

    A set that fails them REFUSES TO SAVE. Finishing the run is not the same as
    emitting a number.
    """
    g = _cal_geom()
    art = cal_artifact() if artifact is None else artifact
    rows = [r for r in data.get("rows", []) if r.get("points") is not None]
    misses = list(data.get("misses") or [])
    planned = int(data.get("planned") or len(rows))
    G = [np.asarray(r["G"], float) for r in rows]
    P = [np.asarray(r["points"], float).reshape(-1, 3) for r in rows]
    say = (lambda _m: None) if quiet else _cal_say

    if len(G) < 3:
        raise CalibrationRefused(
            "only %d of %d poses returned usable profiles, so there is "
            "nothing to solve. The first one was refused because:\n  %s"
            % (len(G), planned,
               misses[0][1] if misses else "no profiles arrived at all."))

    # THE STANDOFF SPREAD IS CHECKED ON WHAT FLEW, not on what was planned. It
    # is checked before the run as well, but poses drop out in flight -- a
    # refused pose, a grab that came back a constant -- and a set that started
    # with three rungs can arrive at the solver with one.
    dists = [r.get("distance") for r in rows]
    if any(d is None for d in dists):
        dists = [_cal_label_standoff(r.get("label", "")) if d is None else d
                 for r, d in zip(rows, dists)]
    flown = sorted({round(float(d), 6) for d in dists if d is not None})
    if len(flown) < 2 and require:
        lost = "\n  ".join("%s: %s" % (m[0], m[1]) for m in misses[:6])
        raise CalibrationRefused(
            "%d poses returned profiles but they are all at one standoff "
            "(%s). Rotation of the head about its own laser line is unmeasured "
            "there, so the solve would be degenerate and this refuses rather "
            "than returning the URDF's own number back to you.\n"
            "  %d pose(s) were lost:\n  %s\n"
            "  What to do: fly the set again (the standoffs are now "
            "interleaved, so an interruption keeps the spread), or pass "
            "require=False to see the numbers knowing they do not determine "
            "the head's rotation."
            % (len(G),
               "unknown -- no standoff was recorded" if not flown
               else "%+.0f mm" % (1e3*flown[0],),
               len(misses), lost or "(none recorded)"))

    # probe_end -> the sensor as the description had it AT CAPTURE TIME, which
    # is the starting guess and is also what the answer is reported against. A
    # dataset that carries its own is believed over live TF: the description
    # may have been redeployed since, and comparing today's solve against a
    # transform that has moved underneath it reports a change that is not one.
    X0 = None
    for r in rows:
        if r.get("X_urdf") is not None:
            X0 = np.asarray(r["X_urdf"], float)
            break
    if X0 is None:
        X0 = _cal_tf("probe_end", "lj_v7080_optical_frame")

    # The artifact's starting pose: the plane EVERY pose measured, carried into
    # the world by the transform we have now. It only has to be close enough
    # that the first iteration finds the surface.
    #
    # EVERY POSE, NOT THE FIRST ONE. One static profiler pose is a LINE -- 31
    # mm long and microns wide -- and fit_plane() handed a line returns the
    # direction of least scatter, which is the sensor's own y axis: a normal
    # that is roughly HORIZONTAL, at zero residual, for perfectly good data.
    # Starting the artifact off at a vertical plane is not a near miss for a
    # solver that looks for the surface near where it was told. The union over
    # poses at several tilts and standoffs is a real patch.
    # check_plane_support() below says so rather than assuming it.
    world = [P[i].dot((G[i].dot(X0))[:3, :3].T) + (G[i].dot(X0))[:3, 3]
             for i in range(len(P))]
    first = np.vstack(world)
    sup = g.check_plane_support(first, name="the measured surface")
    if not sup["ok"]:
        raise CalibrationRefused(
            "the starting plane cannot be fitted: " + sup["message"])
    n0, c0, rms0, _k = g.fit_plane(first)
    zx = np.cross(n0, [1.0, 0.0, 0.0])
    if np.linalg.norm(zx) < 1e-6:
        zx = np.cross(n0, [0.0, 1.0, 0.0])
    zx = zx/np.linalg.norm(zx)
    W0 = g.rt_to_T(np.column_stack([zx, np.cross(n0, zx), n0]), c0)
    say("  %d poses at standoffs %s mm, %d points"
        % (len(G), " ".join("%+.0f" % (1e3*d) for d in flown),
           sum(p.shape[0] for p in P)))
    say("  starting flat: %.4f m, %.3f mm rms about it, from %s"
        % (c0[2], rms0*1e3, sup["message"]))

    # SOLVE ON ONE COPY OF EACH LINE, NOT SIXTY. CAL_PROFILES_PER_POSE profiles
    # at a STATIC pose are the same 31 mm line measured over and over: a 35-pose
    # take hands the solver about 1.5 M points that carry roughly 25 000 lines'
    # worth of information. The cost is not free -- unthinned, that solve runs
    # for over eleven minutes and looks like a hang.
    #
    # Measured on such a take, subsampling changes the ANSWER by nothing:
    #
    #   1/1    1 492 668 pts   rms 0.0658 mm   standoff -4.413 mm   37.9 s
    #   1/10     149 277 pts   rms 0.0658 mm            -4.415 mm    3.2 s
    #   1/30      49 765 pts   rms 0.0658 mm            -4.408 mm    2.8 s
    #   1/60      24 887 pts   rms 0.0657 mm            -4.403 mm    1.6 s
    #   1/120     12 451 pts   rms 0.0656 mm            -4.407 mm    1.0 s
    #
    # 0.012 mm of spread across a 120x range, for 38x the time. The repeats
    # were never information -- they are what made the formal uncertainty read
    # 7 microns on an answer that was millimetres out, because it divides by
    # the point count. Keeping every 60th point does not weaken the fit; it
    # stops the fit lying about how much it knows.
    P = _cal_thin_for_solve(P, say)

    res = g.solve_surface_fit(G, P, art, X0, W0, name="keyence",
                              progress=_cal_solve_progress(say))
    say("")
    for line in res.report().splitlines():
        say("  " + line)

    # AND WHETHER THE DATA ACTUALLY DETERMINED IT. The residual does not answer
    # that question and the formal uncertainty answers it wrongly: this solve
    # can return 0.179 mm rms with a 7 micron uncertainty on a standoff that is
    # 3.8 mm out. surface_fit_recovery() pushes the answer off and sees how
    # much comes back, which is the question the residual does not ask. It
    # costs six more solves on a tenth of the points -- about a minute, against
    # the half-hour of arm time that produced them.
    say("")
    rec, rec_error = None, None
    try:
        thin = [p[::CAL_RECOVERY_STRIDE] for p in P]
        rec = g.surface_fit_recovery(G, thin, art, res.X, res.W)
        for line in g.describe_surface_fit_recovery(rec):
            say("  " + line)
    except Exception as e:                                    # noqa: BLE001
        # A DIRECTION THAT WILL NOT CONVERGE BACK IS ALREADY HANDLED, inside
        # surface_fit_recovery(), as a recovery of 0.0 -- "it could not even
        # converge back" -- which fails the check and refuses the save. Getting
        # here means the CHECK ITSELF did not run, which is a different thing
        # and is not evidence either way.
        #
        # It stays non-fatal, deliberately. Refusing to save because a
        # diagnostic broke is how a fifth calibration attempt comes home empty,
        # and absence of evidence is not evidence of degeneracy. But it is said
        # where nobody can miss it and it is recorded in the take, because the
        # alternative -- one parenthesised line in a long log -- is a guard
        # that silently is not there.
        rec_error = "%s: %s" % (type(e).__name__, e)
        say("  THE RECOVERY CHECK DID NOT RUN: %s" % (rec_error,))
        say("    So NOTHING here has tested whether this pose set actually")
        say("    MEASURES the answer, as opposed to converging near it. A set")
        say("    that does not measure the standoff can return 0.179 mm rms")
        say("    and be 3.8 mm out. Run verify_calibration() before trusting")
        say("    anything solved from this.")
    res.recovery = rec
    res.recovery_error = rec_error
    dt, dr = g.pose_delta(X0, res.X)
    say("")
    say("  AGAINST THE ROBOT DESCRIPTION IN USE: %.2f mm and %.2f mrad"
        % (dt*1e3, dr*1e3))
    dz = float(res.X[2, 3] - X0[2, 3])
    say("  of which %+.2f mm is along probe_end's z -- the same quantity "
        "keyence_ref_dist_cal carries. THIS SOLVE OWNS IT from here: the "
        "emitted file folds whatever ref_dist_cal is in force into the mount "
        "correction and sets ref_dist_cal to zero, and the description refuses "
        "to render if both are set." % (dz*1e3,))

    # AND SAY WHAT WAS LOST, at the point the number is handed over. A
    # calibration from 22 of 34 poses is a different object from a calibration
    # from 34, and the operator has to be able to tell without reading a log.
    #
    # TWO DIFFERENT KINDS OF LOSS, kept apart. A pose that was ATTEMPTED and
    # did not contribute has a reason and the reason is printed. A pose that
    # was NEVER FLOWN -- because a stop or an abort ended the run before it
    # came up -- has no reason of its own, and listing it under a heading that
    # promises reasons and then shows none is worse than saying nothing.
    if misses or len(G) < planned:
        say("")
        say("  SOLVED FROM %d OF %d POSES." % (len(G), planned))
        if misses:
            say("    %d were attempted and did not contribute:" % len(misses))
            for label, why in misses[:12]:
                say("      %-30s %s" % (label, why))
            if len(misses) > 12:
                say("      ... and %d more" % (len(misses) - 12,))
        never = planned - len(G) - len(misses)
        if never > 0:
            say("    %d were never flown: the run ended before reaching them."
                % (never,))

    if take is not None:
        take.results.update(
            sensor="keyence", frame="lj_v7080_optical_frame", poses=planned,
            used=len(G), missed=misses, xyz=list(res.xyz), quat=list(res.quat),
            rpy=list(res.rpy), rms_mm=res.rms_mm, n_points=res.n_points,
            sigma=(None if res.sigma is None
                   else [float(v) for v in res.sigma]),
            adequate=bool(res.adequate), per_pose=res.per_pose,
            null_space=[[s, v] for s, v in res.null_space],
            feature_counts=res.feature_counts,
            delta_from_urdf_mm=dt*1e3, delta_from_urdf_mrad=dr*1e3,
            delta_along_z_mm=dz*1e3, standoffs_flown_m=flown,
            dataset=data.get("dir"), report=res.report())
        take.results["recovery"] = rec
        take.results["recovery_error"] = rec_error
    _CAL["keyence"] = res
    if rec is not None and not rec["ok"] and save:
        say("")
        say("  NOT SAVED. %r came back %.2f of the %.0f mm it was pushed, so "
            "this pose set does not measure it. Fly the third standoff rung "
            "and the off-centre aim points (CAL_KEYENCE_AIM_OFFSETS), or pass "
            "save=False and look at the numbers by hand."
            % (rec["worst"][0], rec["worst"][1], rec["probe_mm"]))
        save = False
    if save and res.adequate:
        files = write_calibration("keyence", res, "lj_v7080_optical_frame",
                                  take=take)
        if take is not None:
            take.results["files"] = files
    elif save:
        say("  NOT SAVED: under-constrained. Nothing has been written.")
    return res


def solve_keyence_from_take(path, artifact=None, require=True, save=True):
    """Solve the Keyence from a dataset ALREADY COLLECTED. No arm, no cell.

    `path` is what calibrate_keyence() printed when it started -- the take's
    keyence_poses directory -- or the take directory, or the session directory,
    or the combined keyence_calibration.npz, or an npz that
    dgpfiles/utils/cal_extract.py lifted out of a bag. All five load.

    THIS IS THE POINT OF THE INCREMENTAL FILES. A run that was stopped, aborted,
    interrupted, or killed outright still leaves everything the solve needs, so
    the half-hour of arm time is spent once and the arithmetic as often as
    anybody likes. It applies the same guards as the live path -- it IS the
    live path, minus the moving -- so a set it accepts is a set the cell would
    have accepted, and a set it refuses is one that genuinely does not
    determine the transform.

    NEEDS TF ONLY TO SAVE, and only when the dataset carries no X_urdf of its
    own: write_calibration() asks the live description where the sensor is now,
    to express the answer as a mount correction. Pass save=False to look at the
    numbers on a machine with no ROS at all.
    """
    data = _cal_dataset_load(path, "keyence")
    _cal_say("  %d pose(s) from %s" % (len(data["rows"]), data["source"]))
    head = data.get("header") or {}
    if head.get("artifact") and artifact is None:
        kind = head["artifact"].get("kind")
        art = cal_artifact(kind)
        if head["artifact"].get("describe") not in (None, art.describe()):
            _cal_say("  THE ARTIFACT HAS CHANGED SINCE THIS WAS COLLECTED.")
            _cal_say("    collected against:  %s" % head["artifact"]["describe"])
            _cal_say("    in force now:       %s" % art.describe())
            _cal_say("    The solve uses the one in force. If that is wrong, "
                     "set the CAL_ARTIFACT_* globals back and call again.")
    else:
        art = cal_artifact() if artifact is None else artifact
    if data.get("note"):
        _cal_say("  the run that collected this ended: %s" % data["note"])
    return _cal_keyence_solve(data, artifact=art, require=require, save=save)


def solve_azure_from_take(path, require=True, save=True):
    """Solve the Azure from views ALREADY COLLECTED. No arm, no cell.

    The counterpart of solve_keyence_from_take(); see its docstring. The Azure
    dataset is small -- two 4x4s per pose, no point clouds -- so this is fast
    and the file is a few tens of kilobytes.
    """
    g = _cal_geom()
    data = _cal_dataset_load(path, "azure")
    rows = [r for r in data["rows"] if r.get("board") is not None]
    _cal_say("  %d view(s) from %s" % (len(rows), data["source"]))
    if len(rows) < 3:
        raise CalibrationRefused(
            "only %d of %d poses saw the board, so there is nothing to solve."
            % (len(rows), data.get("planned") or len(data["rows"])))
    G = [np.asarray(r["G"], float) for r in rows]
    C = [np.asarray(r["board"], float) for r in rows]
    cond = g.pose_set_conditioning(G)
    if require and cond["verdict"] == "inadequate":
        raise CalibrationRefused(
            "the %d views that were collected cannot determine the transform:"
            "\n    " % len(G) + "\n    ".join(cond["problems"])
            + "\n  Nothing has been written. Fly more tilts.")
    res = g.solve_handeye(G, C, name="azure", fix_flips=True)
    for line in res.report().splitlines():
        _cal_say("  " + line)
    _CAL["azure"] = res
    frame = (data.get("header") or {}).get("frame") or "rgb_camera_link"
    if save and res.adequate:
        write_calibration("azure", res, frame)
    elif save:
        _cal_say("  NOT SAVED: the pose set does not determine this transform.")
    return res


# ------------------------------------------------------------------------------
# THE ROUTINE CHECK -- the part that has to survive being boring
# ------------------------------------------------------------------------------

#: Median grey level (0..255) below which the Azure's depth is not to be
#: believed over a patch.
#:
#: MEASURED ON THIS CELL against heights known from touch-off:
#:   bare black breadboard    grey 103   depth reads -18.1 mm
#:   bright targets           grey 250   depth reads -11.6 to -13.6 mm
#: i.e. darkness costs about 5 mm ON TOP OF this cell's standing -12.45 mm
#: depth bias; see _cal_verify_why().
#: The breadboard is black anodised and drilled on a 25 mm grid; a time-of-
#: flight camera gets very little signal back from it and what it does get is
#: contaminated by the holes. The Keyence reads the same breadboard to 0.015 mm
#: rms, because a laser triangulator brings its own light. 140 sits between the
#: two with room either side; it is a WARNING and not a refusal, because one
#: cell's lighting is not every cell's.
global CAL_VERIFY_MIN_GREY
CAL_VERIFY_MIN_GREY = 140.0


global _cal_patch_brightness
def _cal_patch_brightness(aim, half, K, cam_frame, why=None):
    """Median grey level of the colour image over the patch, or None.

    Never raises: this is a diagnostic, and a verification that cannot reach
    the colour topic still has two depths to compare.

    BUT IT SAYS WHY IT GAVE UP. Pass a one-argument `why` and it is called with
    the reason. Without it, a bare None here is indistinguishable from a patch
    that was measured, and the one check that separates "the Azure cannot
    measure this target" from "the mount is wrong" is dead invisibly -- which
    costs sessions spent re-solving a mount that was never the fault.
    """
    def _no(reason):
        if why is not None:
            try:
                why(reason)
            except Exception:                                 # noqa: BLE001
                pass
        return None
    try:
        # "color" IS THE KEY THE MANIFEST USES. sensor_topics() returns the
        # per-mode merge of sensors.azure.topics -- color / depth /
        # camera_info / points -- so .get("rgb") is None and
        # sensor_topic("azure", "rgb") raises. "rgb" is still tried first so a
        # cell that does declare it keeps working, and the raising call asks
        # for "color" so its message names a key an operator can actually look
        # for in the manifest.
        topics = sensor_topics("azure") or {}
        topic = topics.get("rgb") or topics.get("color")
        if not topic:
            topic = sensor_topic("azure", "color")
        from sensor_msgs.msg import Image
        got = _cal_one_message(topic, Image, timeout=5.0, node_name="cal_grey")
        if not got:
            return _no("nothing arrived on the colour topic %s in 5 s" % topic)
        grey = _cal_gray(_cal_decode_image(got[-1]))
        T = _cal_tf(cam_frame, "world")
        c = T[:3, :3].dot(np.asarray(aim, float)) + T[:3, 3]
        if c[2] <= 0:
            return _no("the patch is behind the colour camera (z %.3f m in %s)"
                       % (c[2], cam_frame))
        u = K[0, 0]*c[0]/c[2] + K[0, 2]
        v = K[1, 1]*c[1]/c[2] + K[1, 2]
        rad = float(K[0, 0]*half/c[2])
        u0, u1 = int(max(0, u - rad)), int(min(grey.shape[1], u + rad))
        v0, v1 = int(max(0, v - rad)), int(min(grey.shape[0], v + rad))
        if u1 - u0 < 4 or v1 - v0 < 4:
            return _no("the patch covers only %dx%d px of the colour image, "
                       "which is too few to judge" % (u1-u0, v1-v0))
        return float(np.median(grey[v0:v1, u0:u1]))
    except Exception as e:                                    # noqa: BLE001
        return _no("%s: %s" % (type(e).__name__, e))


global _cal_azure_surface
def _cal_azure_surface(depth_topic, info_topic, aim, half, tag, take=None,
                       say=None, keep_world=None):
    """One Azure depth source, measured over the patch and SAVED.

    Returns (points in world over the patch, meta). Raises nothing the caller
    does not already handle.

    WHY IT IS SAVED. The verify take records `("core", "keyence")` -- no Azure
    topic at all -- so a verification that puts the Azure millimetres off the
    Keyence would leave nothing to re-examine, and answering "why" would mean
    another trip to the cell. Recording the Azure topics wholesale is not the
    fix: registered depth is 2048x1536 of 16-bit at 30 Hz, about 188 MB/s,
    against the ~465 MB this take already writes. One grab is about 6 MB
    compressed, is exactly what the number was computed from, and is enough to
    re-derive it, re-fit it, or compare it against the other source.
    """
    say = (lambda s: None) if say is None else say
    K, _D, _w, _h, cam_frame = _cal_intrinsics(info_topic)
    grab = {}
    pts_cam, depth_frame = _cal_depth_points(depth_topic, K, keep=grab)
    T = _cal_tf("world", depth_frame)
    pts = pts_cam.dot(T[:3, :3].T) + T[:3, 3]
    near = (np.abs(pts[:, 0] - aim[0]) < half) & (np.abs(pts[:, 1] - aim[1]) < half)
    patch = pts[near]
    # Pass a dict as `keep_world` to receive the WHOLE grab in world coordinates,
    # not just the patch. _cal_tilt_agreement() needs a wider baseline than the
    # patch to say anything about orientation, and the points are already here;
    # re-deriving them from the saved npz would be the same arithmetic twice.
    # It stays out of `meta`, which is JSON and goes into the take's results.
    if keep_world is not None:
        keep_world["pts"] = pts
    meta = {"tag": tag, "depth_topic": depth_topic, "info_topic": info_topic,
            "frame": depth_frame, "cam_frame": cam_frame,
            "image": [grab.get("height"), grab.get("width")],
            "encoding": grab.get("encoding"), "stride": grab.get("stride"),
            "n_patch": int(patch.shape[0]),
            "n_valid_sampled": grab.get("n_valid"),
            "camera_z": float(T[2, 3]),
            "range_m": float(abs(T[2, 3] - float(aim[2])))}
    # WHAT THE PIXEL COUNT MEANS, stated with the stride and the image's OWN
    # size so it cannot be got wrong again.
    try:
        side_u = 2.0*float(K[0, 0])*float(half)/meta["range_m"]
        side_v = 2.0*float(K[1, 1])*float(half)/meta["range_m"]
        st = float(grab.get("stride") or 1)
        meta["expected_sampled"] = int(round(side_u*side_v/(st*st)))
        meta["yield"] = (float(patch.shape[0])/meta["expected_sampled"]
                         if meta["expected_sampled"] else None)
    except Exception:                                         # noqa: BLE001
        meta["expected_sampled"], meta["yield"] = None, None
    y = meta.get("yield")
    say("    azure[%s]: %d points over the patch from a %sx%s %s image at "
        "%.0f mm%s"
        % (tag, patch.shape[0], meta["image"][1], meta["image"][0],
           meta["encoding"], 1e3*meta["range_m"],
           "" if y is None else ", %.0f%% of the %d that stride %d samples"
           % (100.0*y, meta["expected_sampled"], meta["stride"])))
    if take is not None and grab.get("depth") is not None:
        try:
            d = os.path.join(take.dir, "azure_grabs")
            os.makedirs(d, exist_ok=True)
            path = os.path.join(d, "%s.npz" % _cal_safe_name(tag))
            _cal_atomic_write(path, lambda f: np.savez_compressed(
                f, depth=grab["depth"].astype(np.float32), K=grab["K"],
                T_world_cam=T, aim=np.asarray(aim, float), half=float(half),
                meta=np.array(json.dumps(meta))))
            meta["file"] = path
            say("      saved %s" % path)
        except Exception as e:                                # noqa: BLE001
            say("      (the grab could not be saved: %s: %s)"
                % (type(e).__name__, e))
    return patch, meta


global _cal_keyence_offsets
def _cal_keyence_offsets(offsets=None):
    """CAL_VERIFY_KEYENCE_OFFSETS as [(across, along), ...], metres.

    A BARE NUMBER IS READ AS (across, 0.0), which is the shape a cell config or
    a saved parameter block may still carry. It costs four lines here and it is
    the difference between an old config producing a shorter baseline and an
    old config raising TypeError with the arm already parked over the flat.
    """
    src = CAL_VERIFY_KEYENCE_OFFSETS if offsets is None else offsets
    out = []
    for o in src:
        if isinstance(o, (list, tuple, np.ndarray)):
            v = np.asarray(o, float).reshape(-1)
            if v.shape[0] != 2:
                raise CalibrationRefused(
                    "CAL_VERIFY_KEYENCE_OFFSETS entries are (across, along) "
                    "in metres or a bare across; %r has %d numbers in it."
                    % (o, v.shape[0]))
            out.append((float(v[0]), float(v[1])))
        else:
            out.append((float(o), 0.0))
    if len(out) < 2:
        raise CalibrationRefused(
            "CAL_VERIFY_KEYENCE_OFFSETS has %d grab(s) in it. One profiler "
            "pose measures a LINE, and a plane fitted to a line has a normal "
            "chosen by nothing -- it comes back roughly horizontal, reported "
            "as a 90 degree \"tilt\"."
            % (len(out),))
    return out


global _cal_keyence_reach
def _cal_keyence_reach(planned, quat, say=None):
    """Which of the planned Keyence grabs can be flown: (kept, dropped).

    RUN BEFORE ANY OF THEM IS FLOWN. The grid reaches 73 mm from the taught
    point, so a flat taught near the edge of the work volume is a way for the
    fourth grab to refuse after three have been flown -- two minutes spent to
    produce nothing. Screening first turns that into one refusal, before the
    arm moves, naming the offsets that do not fit.

    THE WORK VOLUME IS A HARD GATE. It is pure arithmetic on the commanded
    pose, it is always available, and flying outside it is the thing the
    envelope exists to prevent.

    IK AND THE CABLE ENVELOPE ARE APPLIED ONLY IF THEY CAN ANSWER AT ALL.
    _cal_ik() returns None when there is no live ROS behind it -- in a rehearsal,
    in a unit test, on a cell whose driver is not up -- and a screen that can
    solve nothing would otherwise drop every grab and blame the taught point.
    So: if not one pose solved, the screen says so out loud and drops nothing,
    which is the same bargain _cal_candidate_poses() strikes with the envelope.

    A DROPPED GRAB IS NOT A DIFFERENT MEASUREMENT. With five grabs on a grid,
    losing one costs precision that the delete-one-grab jackknife then reports
    honestly -- so the caller may go on with four, and is refused only when
    what is left cannot span both axes.
    """
    say = (lambda s: None) if say is None else say
    kept, dropped, solved, blind = [], [], 0, []
    seed = None
    for p in planned:
        if not _cap_inside([p["xyz"]]):
            dropped.append((p, "outside the work volume"))
            continue
        sol = _cal_ik(p["xyz"], quat, seed=seed)
        if sol is None:
            # KEPT, NOT DROPPED. _cal_ik() is local IK on a 1 s timeout and
            # fails for reasons that have nothing to do with reachability,
            # while _cal_fly_or_refuse() has a joint-space route it does not
            # model. Refusing here on its word would drop flyable poses.
            blind.append(p)
            kept.append(p)
            continue
        solved += 1
        try:
            check_wrist3([sol], "verify keyence grab %s" % p["label"],
                         quats=[quat], tilt=(0.0, 0.0))
        except CableRefused:
            dropped.append((p, "refused by the cable envelope"))
            continue
        except KeyError:
            pass                  # nothing measured; check_wrist3 has said so
        seed = list(sol)
        kept.append(p)
    if solved == 0 and kept:
        say("    (no IK solution for any verification grab, so reachability "
            "and the cable envelope are UNSCREENED here -- the work volume "
            "still is. A grab that cannot be flown will refuse at the move.)")
    elif blind:
        say("    (%d of %d verification grabs had no local IK solution to "
            "screen with and are flown anyway: %s. The screen models neither "
            "the joint-space retry nor a longer IK timeout.)"
            % (len(blind), len(planned),
               ", ".join(p["label"] for p in blind)))
    return kept, dropped


global _cal_keyence_scatter
def _cal_keyence_scatter(P, groups, band=None):
    """How far each Keyence grab sits off the plane of THE OTHERS, metres.

    THE PLANE OF THE OTHERS, not of all of them: a grab that has walked off
    the edge of the target drags the common fit toward itself and then looks
    about half as wrong as it is. Deleting it first is the same idea as the
    jackknife next door, used for a different question.

    Two things come out of it and they are both needed at the cell:

      off_mm      per grab. Anything past `band` is not on the same flat, and
                  the run is refused rather than fitted -- see
                  CAL_VERIFY_KEYENCE_BAND. This is the failure mode a wider
                  grid buys: 20 mm of reach never left the paper.
      scatter_mm  the pose-to-pose height scatter, estimated from the grab
                  residuals of the common fit with its three fitted parameters
                  taken out. It is the number the whole geometry of
                  CAL_VERIFY_KEYENCE_OFFSETS was chosen from (0.10 mm on this
                  cell), so measuring it every run is how the choice stays
                  honest. Needs more than three grabs; None below that.
    """
    tolb = float(CAL_VERIFY_KEYENCE_BAND if band is None else band)
    P = np.asarray(P, float).reshape(-1, 3)
    g = np.asarray(groups).reshape(-1)
    if g.shape[0] != P.shape[0]:
        raise CalibrationRefused(
            "the keyence scatter was handed %d grab labels for %d points"
            % (g.shape[0], P.shape[0]))
    ids = [int(v) for v in np.unique(g)]
    # ONE CENTRE FOR EVERY FIT BELOW. The world coordinates here are around
    # (0.8, 0.1) and the grid is +/-0.055, so an uncentred design matrix is
    # conditioned two hundred to one for no reason, and -- worse -- a
    # delete-one fit centred on its own subset cannot be evaluated against the
    # deleted grab without carrying its centre around with it.
    x0, y0 = float(P[:, 0].mean()), float(P[:, 1].mean())

    def _fit(Q):
        A = np.column_stack([Q[:, 0] - x0, Q[:, 1] - y0, np.ones(Q.shape[0])])
        sol, _r, _rk, _sv = np.linalg.lstsq(A, Q[:, 2], rcond=None)
        return sol

    def _predict(sol, Q):
        return sol[0]*(Q[:, 0] - x0) + sol[1]*(Q[:, 1] - y0) + sol[2]

    sol_all = _fit(P)
    resid = P[:, 2] - _predict(sol_all, P)
    within, off = [], []
    for i in ids:
        m = (g == i)
        within.append(float(np.sqrt(float(np.mean(
            (resid[m] - resid[m].mean())**2)))))
        rest = P[~m]
        if rest.shape[0] < 4 or len(ids) < 4:
            off.append(float(resid[m].mean()))
            continue
        off.append(float(np.mean(P[m, 2] - _predict(_fit(rest), P[m]))))
    means = np.array([float(resid[g == i].mean()) for i in ids])
    scat = (None if len(ids) <= 3 else
            float(math.sqrt(float(means.dot(means))/(len(ids) - 3))))
    worst = int(np.argmax(np.abs(off))) if off else None
    return {"grabs": len(ids), "ids": ids,
            "n": [int((g == i).sum()) for i in ids],
            "off_mm": [1e3*v for v in off],
            "within_rms_mm": [1e3*v for v in within],
            "worst_off_mm": (None if worst is None else 1e3*off[worst]),
            "worst_grab": worst,
            "band_mm": 1e3*tolb,
            "scatter_mm": None if scat is None else 1e3*scat,
            "off_flat": [k for k, v in enumerate(off) if abs(v) > tolb]}


global _cal_save_keyence_patch
def _cal_save_keyence_patch(take, tag, P, groups, grabs, aim, basis,
                            meta=None, say=None):
    """The Keyence patch, SAVED, the way _cal_azure_surface saves the Azure's.

    WHY. The Azure grab is written to <take>/azure_grabs/, which is what lets a
    tilt failure be taken apart afterwards on a host with no cell. Without the
    same for the Keyence, the only way to re-examine its half is a SYNTHETIC
    patch reconstructed from the take's recorded normal, rms, extent and count
    -- an assumption wearing a measurement's clothes.

    WHAT IS IN IT, and the grouping is the point. `group` labels every point
    with the grab it came from, so the pose-to-pose height scatter can be
    measured directly offline instead of inferred from an rms; `T_world_sensor`
    and `probe_end` say where the head was, so the sensor-frame data and the
    poses are both recoverable; `offsets` is the (across, along) grid actually
    flown, which is not always the one the constant asked for.

    ABOUT 1 MB compressed for five grabs -- 213 000 points, stored as float32,
    whose 0.06 um resolution at a metre is three orders below the head's own
    0.102 mm noise. Against the 465 MB the take already writes.
    """
    say = (lambda s: None) if say is None else say
    if take is None or getattr(take, "dir", None) is None:
        return None
    try:
        d = os.path.join(take.dir, "keyence_patches")
        os.makedirs(d, exist_ok=True)
        path = os.path.join(d, "%s.npz" % _cal_safe_name(tag))
        info = dict(meta or {})
        info.update(tag=tag, n=int(P.shape[0]), grabs=len(grabs),
                    offsets_m=[[float(v["across"]), float(v["along"])]
                               for v in grabs],
                    labels=[str(v["label"]) for v in grabs],
                    frames=[str(v.get("frame")) for v in grabs],
                    profiles=[int(v.get("profiles") or 0) for v in grabs],
                    aim=[float(v) for v in np.asarray(aim, float).reshape(3)],
                    across=[float(v) for v in basis[0]],
                    along=[float(v) for v in basis[1]])
        _cal_atomic_write(path, lambda f: np.savez_compressed(
            f, points=np.asarray(P, np.float32),
            group=np.asarray(groups, np.int16),
            offsets=np.asarray([[v["across"], v["along"]] for v in grabs],
                               float),
            T_world_sensor=np.asarray([v["T"] for v in grabs], float),
            probe_end=np.asarray([v["xyz"] for v in grabs], float),
            aim=np.asarray(aim, float).reshape(3),
            across=np.asarray(basis[0], float),
            along=np.asarray(basis[1], float),
            meta=np.array(json.dumps(info))))
        say("      saved %s" % path)
        return path
    except Exception as e:                                    # noqa: BLE001
        say("      (the keyence patch could not be saved: %s: %s)"
            % (type(e).__name__, e))
        return None


global _cal_fmt_tilt
def _cal_fmt_tilt(mrad, sigma=None):
    """"8.70 +/- 5.56 mrad", or "8.70 mrad (sigma unknown)". Never bare.

    A tilt without its uncertainty cannot be acted on -- over this patch the
    sigma is comparable with the tolerance -- so it is not optional in the
    printing even when it could not be computed.
    """
    if mrad is None:
        return "(not measured)"
    if sigma is None:
        return "%.2f mrad (sigma unknown)" % (float(mrad),)
    return "%.2f +/- %.2f mrad" % (float(mrad), float(sigma))


global _cal_plane_slopes
def _cal_plane_slopes(P):
    """(slope_x, slope_y, rms, n) for z = sx*x + sy*y + c, least squares.

    SLOPES AND NOT A NORMAL, because the uncertainty of a tilt is the
    uncertainty of two slopes and that is not available from fit_plane()'s SVD.
    For a nearly horizontal surface the two are the same thing to a part in
    10^5: slope_x = -n_x/n_z, and the tilt from horizontal is hypot(sx, sy).
    """
    P = np.asarray(P, float).reshape(-1, 3)
    P = P[np.isfinite(P).all(axis=1)]
    if P.shape[0] < 4:
        raise ValueError("slopes need 4 finite points, got %d" % P.shape[0])
    x0, y0 = float(P[:, 0].mean()), float(P[:, 1].mean())
    A = np.column_stack([P[:, 0] - x0, P[:, 1] - y0, np.ones(P.shape[0])])
    sol, _res, _rk, _sv = np.linalg.lstsq(A, P[:, 2], rcond=None)
    resid = P[:, 2] - A.dot(sol)
    rms = float(np.sqrt(float(resid.dot(resid))/P.shape[0]))
    return float(sol[0]), float(sol[1]), rms, int(P.shape[0])


global _cal_slope_sigma
def _cal_slope_sigma(P, blocks=None, groups=None):
    """((sigma_sx, sigma_sy), n_blocks) by a DELETE ONE BLOCK spatial jackknife.

    NOT THE TEXTBOOK LEAST-SQUARES COVARIANCE. That one divides the residual
    scatter by sqrt(N), which is right only if the residuals are independent.
    The Azure's are not: they are a radial bowl plus local warp, correlated over
    tens of millimetres, so N counts pixels rather than observations and the
    answer comes out six times too small -- 0.90 mrad against a measured
    5.56 mrad over a +/-45 mm patch whose tilt reads 8.70 mrad. A criterion
    built on that sigma fails takes for nothing.

    So: tile the points into blocks x blocks cells over their own bounding box,
    refit the plane with each cell DELETED, and take the jackknife sd of the
    resulting slopes. A block is much wider than the correlation length, so the
    blocks behave as independent observations; and each deleted-block fit still
    spans nearly the whole window, so nothing is measured over a shortened
    baseline. Deterministic -- no resampling, no seed.

    Returns (None, 0) when fewer than four blocks can be dropped and still leave
    a set with extent in both directions. The caller must treat that as "no
    sigma", never as zero.

    WHAT IT CANNOT DO: a jackknife estimates variance, not bias. An error that
    happens to be linear across the patch is indistinguishable from a real tilt
    by this or any other method, which is the standing reason to prefer the
    widest baseline available rather than to lean on sigma.

    PASS `groups` AND THE DELETED UNIT IS A GRAB, NOT A TILE, which is the only
    honest unit for the Keyence. Its points do not arrive as a cloud: they
    arrive as one line per arm pose, and every point in a line shares that
    pose's height error. A spatial tile cuts a quarter off one line and cannot
    see that error at all, so the tiled sigma on a Keyence patch comes back
    near zero -- the same six-fold understatement, for the same reason, in the
    other direction. `groups` is a per-point integer label; deleting each label
    in turn asks exactly "how much does the answer depend on any one arm pose".
    It needs four grabs to produce four estimates and returns (None, 0) below
    that -- three offsets on one axis have no uncertainty to report.

    MEASURED AGAINST THE TRUTH, 300 Monte Carlo draws of the five-grab grid
    with the cell's own numbers: the grouped jackknife reads 1.2 to 1.5 times
    the actual sd of the fitted tilt. It is biased HIGH, which widens the gate
    rather than narrowing it, and no correction factor is applied -- an
    empirical fudge on a five-estimate jackknife would be worth less than the
    conservatism it removed.
    """
    nb = int(CAL_VERIFY_TILT_BLOCKS if blocks is None else blocks)
    P = np.asarray(P, float).reshape(-1, 3)
    keep_finite = np.isfinite(P).all(axis=1)
    P = P[keep_finite]
    # The group labels have to be filtered with the points or they stop
    # labelling them, which would silently jackknife the wrong subsets.
    gid = None
    if groups is not None:
        gid = np.asarray(groups).reshape(-1)
        if gid.shape[0] != keep_finite.shape[0]:
            raise ValueError("groups has %d labels for %d points"
                             % (gid.shape[0], keep_finite.shape[0]))
        gid = gid[keep_finite]
    if P.shape[0] < 40:
        return None, 0
    lo = P[:, :2].min(axis=0)
    span = P[:, :2].max(axis=0) - lo
    span = np.where(span > 1e-9, span, 1.0)
    if gid is not None:
        bid = gid
    else:
        ix = np.clip(((P[:, 0] - lo[0])/span[0]*nb).astype(int), 0, nb - 1)
        iy = np.clip(((P[:, 1] - lo[1])/span[1]*nb).astype(int), 0, nb - 1)
        bid = ix*nb + iy
    est = []
    for b in np.unique(bid):
        keep = bid != b
        if int(keep.sum()) < 20:
            continue
        Q = P[keep]
        # A deletion that costs half the window in either direction is not a
        # like-for-like refit, so it is not allowed to contribute.
        if np.ptp(Q[:, 0]) < 0.5*span[0] or np.ptp(Q[:, 1]) < 0.5*span[1]:
            continue
        sx, sy, _rms, _n = _cal_plane_slopes(Q)
        est.append((sx, sy))
    if len(est) < 4:
        return None, 0
    E = np.asarray(est, float)
    B = int(E.shape[0])
    var = (B - 1.0)/B*np.sum((E - E.mean(axis=0))**2, axis=0)
    return (math.sqrt(max(float(var[0]), 0.0)),
            math.sqrt(max(float(var[1]), 0.0))), B


global _cal_tilt_plane
def _cal_tilt_plane(P, aim, half, wide=None, band=None, groups=None):
    """The widest part of ONE flat around `aim`: (slopes, sigma, meta).

    `P` is a world-frame point set, `half` the dz patch half-width. When `wide`
    exceeds `half` the window is widened to it and trimmed back to the patch's
    own plane, twice, so nothing off that flat survives.

    `half=None` MEANS "ALL OF IT", and that is how the Keyence is passed: its
    patch is only ever what the head actually flew over, so cropping it to the
    Azure's dz window would silently drop the outer lines from the fit without
    the printed count saying so. The default grid already reaches 73 mm, well
    past the +/-45 mm patch.

    `groups` is a per-point grab label, carried through every selection below
    and handed to _cal_slope_sigma so the Keyence's sigma is a delete-one-GRAB
    jackknife. It is filtered alongside the points rather than re-derived,
    because a label array that stops lining up with its points produces a
    plausible number from the wrong subsets.
    """
    aim = np.asarray(aim, float).reshape(3)
    w = float(CAL_VERIFY_TILT_PATCH if wide is None else wide)
    tolb = float(CAL_VERIFY_TILT_BAND if band is None else band)
    P = np.asarray(P, float).reshape(-1, 3)
    gid = None
    if groups is not None:
        gid = np.asarray(groups).reshape(-1)
        if gid.shape[0] != P.shape[0]:
            raise CalibrationRefused(
                "the tilt fit was handed %d grab labels for %d points"
                % (gid.shape[0], P.shape[0]))
    if half is None:
        patch, patch_g = P, gid
    else:
        half = float(half)
        inpatch = ((np.abs(P[:, 0] - aim[0]) < half)
                   & (np.abs(P[:, 1] - aim[1]) < half))
        patch = P[inpatch]
        patch_g = None if gid is None else gid[inpatch]
    if patch.shape[0] < 4:
        raise CalibrationRefused(
            "only %d point(s) %s: there is no plane to tilt."
            % (patch.shape[0], "in the set" if half is None
               else "over the +/-%.0f mm patch" % (1e3*half,)))
    meta = {"window_m": w, "band_m": tolb, "patch_n": int(patch.shape[0])}
    used, used_g, why = patch, patch_g, None
    if half is not None and w > half:
        n_p, c_p, _r, _n = _cal_geom().fit_plane(patch)
        box = ((np.abs(P[:, 0] - aim[0]) < w)
               & (np.abs(P[:, 1] - aim[1]) < w))
        Q = P[box]
        keep = np.abs((Q - c_p).dot(n_p)) < tolb
        if int(keep.sum()) >= 200:
            # One reselection about the WIDE plane. The patch plane's own tilt
            # error extrapolates at the window's edge, and this takes it out.
            n1, c1, _r1, _n1 = _cal_geom().fit_plane(Q[keep])
            keep2 = np.abs((Q - c1).dot(n1)) < tolb
            if int(keep2.sum()) >= int(keep.sum()):
                keep = keep2
        W = Q[keep]
        meta["n_in_window"] = int(Q.shape[0])
        meta["n_on_flat"] = int(W.shape[0])
        if W.shape[0] < max(4*patch.shape[0], 500):
            why = ("only %d of %d points in the +/-%.0f mm window lie on the "
                   "patch's plane" % (W.shape[0], Q.shape[0], 1e3*w))
        elif np.ptp(W[:, 0]) < 4.0*half or np.ptp(W[:, 1]) < 4.0*half:
            why = ("the flat reaches only %.0f x %.0f mm, which is not enough "
                   "more than the patch to be worth fitting"
                   % (1e3*np.ptp(W[:, 0]), 1e3*np.ptp(W[:, 1])))
        elif _cal_plane_slopes(W)[2] > 0.6*tolb:
            # Everything inside the band by construction, yet most of the way
            # to its edge: that is a curved surface or two planes, not a flat.
            why = ("the wider surface is %.2f mm rms from flat, so it is not "
                   "one plane" % (1e3*_cal_plane_slopes(W)[2],))
        else:
            used = W
            used_g = None if gid is None else gid[box][keep]
    meta["basis"] = "wide" if used is not patch else "patch"
    if why is not None:
        meta["why_patch"] = why
    sx, sy, rms, n = _cal_plane_slopes(used)
    sig, B = _cal_slope_sigma(used, groups=used_g)
    meta.update(n=int(n), rms_mm=1e3*rms, blocks=int(B),
                unit="grab" if used_g is not None else "block",
                extent_mm=[1e3*float(np.ptp(used[:, 0])),
                           1e3*float(np.ptp(used[:, 1]))],
                tilt_from_horizontal_mrad=1e3*math.hypot(sx, sy),
                sigma_mrad=(None if sig is None
                            else 1e3*math.hypot(sig[0], sig[1])))
    return (sx, sy), sig, meta


global _cal_tilt_agreement
def _cal_tilt_agreement(key, az_all, aim, half, tol_mrad, wide=None,
                        key_groups=None):
    """Do the two sensors agree about the surface's ORIENTATION? A dict.

    `key` is the Keyence patch, `az_all` the Azure's whole grab in world
    coordinates -- not the +/-45 mm patch, because orientation is the one thing
    that patch cannot measure. See CAL_VERIFY_TILT_PATCH for the numbers.

    `key_groups` labels each Keyence point with the grab it came from, so its
    sigma is a delete-one-GRAB jackknife. BOTH SENSORS OR NEITHER: the gate is
    only widened when both sides produced a sigma, because half an uncertainty
    is not an uncertainty. Without it the gate is the bare tolerance and
    tilt_sigma_missing names the side that could not say, so an operator is
    told that the criterion is back to the coin toss rather than left to infer
    it from a "(sigma unknown)" in the middle of a line.

      tilt_mrad         the angle between the two fitted planes, the graded one
      tilt_sigma_mrad   1 sigma of it, both fits combined, blocked jackknife
      tilt_gate_mrad    max(tolerance, k*sigma): what it is actually judged on
      tilt_pass         tilt_mrad <= tilt_gate_mrad
      tilt_patch_mrad   the same angle from the +/-45 mm patch, reported for
                        comparison and not graded
      tilt_sigma_missing  [] or the sensors whose sigma could not be estimated
    """
    # half=None: the Keyence patch is used whole. It is only ever what the head
    # flew over, and there is nothing wider of it to widen to.
    s_k, sig_k, m_k = _cal_tilt_plane(key, aim, None, groups=key_groups)
    s_a, sig_a, m_a = _cal_tilt_plane(az_all, aim, half, wide=wide)
    near = ((np.abs(az_all[:, 0] - aim[0]) < half)
            & (np.abs(az_all[:, 1] - aim[1]) < half))
    sx_p, sy_p, _r, _n = _cal_plane_slopes(az_all[near])

    def _angle(a, b):
        u = np.array([-a[0], -a[1], 1.0])
        v = np.array([-b[0], -b[1], 1.0])
        u = u/np.linalg.norm(u)
        v = v/np.linalg.norm(v)
        return float(math.acos(float(np.clip(abs(u.dot(v)), -1.0, 1.0)))*1e3)

    tilt = _angle(s_a, s_k)
    # The angle between two nearly horizontal planes is hypot of the two slope
    # differences, so its variance is the sum of all four slope variances.
    sig = None
    if sig_a is not None and sig_k is not None:
        sig = 1e3*math.sqrt(sig_a[0]**2 + sig_a[1]**2
                            + sig_k[0]**2 + sig_k[1]**2)
    gate = float(tol_mrad)
    if sig is not None:
        gate = max(gate, float(CAL_VERIFY_TILT_SIGMA_K)*sig)
    missing = [n for n, s in (("keyence", sig_k), ("azure", sig_a))
               if s is None]
    return {"tilt_mrad": tilt,
            "tilt_sigma_mrad": sig,
            "tilt_gate_mrad": gate,
            "tilt_pass": bool(tilt <= gate),
            "tilt_patch_mrad": _angle((sx_p, sy_p), s_k),
            "tilt_sigma_missing": missing,
            "tilt_azure": m_a, "tilt_keyence": m_k}


global _cal_verify_why
def _cal_verify_why(out, bright=None):
    """Why the two sensors disagree, most likely cause first.

    "Run calibrate_azure(), then this again" is the wrong answer to most of
    these. A hand-eye solve moves where the camera IS; it cannot change what
    the camera's depth sensor RETURNS, and these are different faults with
    different fixes. A verification aimed at the bare breadboard, for instance,
    reads the Azure 13..18 mm low and the Keyence perfectly no matter how good
    the mount solve is.
    """
    L = []
    dz = float(out.get("dz_mm") or 0.0)
    # TILT ONLY. Every line below is about a height disagreement, so none of it
    # applies when the heights agree and only the orientation failed. Said
    # first, and on its own, because the rest would be actively misleading.
    if abs(dz) <= float(out.get("tol_mm") or 0.0):
        L.append("the two HEIGHTS agree (%+.2f mm, inside %.1f mm) and only the "
                 "tilt failed, at %.2f +/- %.2f mrad against a %.1f mrad gate. "
                 "No standoff is wrong by that; it is an orientation "
                 "disagreement. Check which sensor is tilted in the two lines "
                 "above, and see CAL_VERIFY_TILT_PATCH."
                 % (dz, float(out.get("tol_mm") or 0.0),
                    float(out.get("tilt_mrad") or 0.0),
                    float(out.get("tilt_sigma_mrad") or 0.0),
                    float(out.get("tilt_gate_mrad")
                          or out.get("tol_mrad") or 0.0)))
        return L
    if bright is not None:
        L.append("the patch reads grey %.0f of 255 in the colour image."
                 % (bright,))
        if bright < CAL_VERIFY_MIN_GREY:
            L.append("  THAT IS PROBABLY THE WHOLE ANSWER. A dark or drilled "
                     "surface returns very little to a time-of-flight camera "
                     "and its depth goes long by centimetres; the Keyence "
                     "brings its own laser and does not care. This cell's "
                     "breadboard measured grey 103 and 18.1 mm low, against "
                     "11.6 to 13.6 mm on every bright target.")
            L.append("  AIM THIS AT THE SPECIMEN, not at the bench: teach "
                     "%r on the part and run it again." % (CAL_VERIFY_POINTS[0],))
            return L
    applied = None
    try:
        applied = check_calibration_applied(quiet=True)
    except Exception:                                         # noqa: BLE001
        pass
    if applied is not None and not applied.get("pass", True):
        L.append("the calibration on record is NOT the one in force. Deploy it "
                 "(deploy_calibration()), rebuild and restart, then re-run.")
        return L
    L.append("the mount is where the solve put it and the patch is bright "
             "enough to measure, so a %+.1f mm disagreement is a DEPTH RANGE "
             "error, not a pose error. Re-running calibrate_azure() will not "
             "move it: a hand-eye solve fixes where the camera is, not what "
             "its depth returns." % (dz,))
    # TWO LINES, because the operator reads these standing at the cell. Do not
    # add a reassurance that the Azure is better on real parts: the only
    # measurement that ever suggested it came off a patch with a 36% return
    # rate, against eight measurements reading -11.6 to -13.6 mm.
    L.append("  this cell's standing disagreement is -12.45 mm, sd 0.68 mm over "
             "8 measurements, 4 days and 2 targets; a contact touch-off agrees "
             "with the Keyence twice, so it is the DEPTH VALUE and not the "
             "mount, and calibrate_azure() cannot move it.")
    L.append("  a constant correction for it is applied by the bring-up adapter "
             "on the manifest's azure depth topic, and THIS IS THE CHECK THAT "
             "IT IS WORKING: with the adapter in the path this reads under "
             "1 mm, so %+.1f mm means it is not." % (dz,))
    return L


#: Taught points verify_calibration() will use, in order of preference.
#:
#: BOTH NAMES ARE ACCEPTED because the written procedure says to teach
#: "cal_flat" and older configs teach "flat"; insisting on one produces a
#: KeyError naming a point the instructions never mention. Either will do: this
#: aims a sensor, it is not a datum, and 10 mm of disagreement about where to
#: look costs nothing.
global CAL_VERIFY_POINTS
CAL_VERIFY_POINTS = ("cal_flat", "flat")


def verify_calibration(point=None, patch=None, tol_mm=None, tilt_mrad=None,
                       distance=None, raise_on_fail=False, depth=None):
    """Fly both sensors over one flat patch and make them agree. No touch-off.

    THE CHECK THAT CATCHES A DRIFTED SENSOR MOUNT, and the reason this module
    is worth having at all. It needs no artifact, no printed board, no contact
    and no operator judgement: put anything flat under the arm -- the
    calibration plate, the bench, the specimen itself -- and this measures it
    with the Azure and with the Keyence and subtracts.

    THE KEYENCE IS THE REFERENCE, not the average of the two. It agrees with a
    contact touch-off to 0.7 mm on a ground flat, and its 0.102 mm noise on a
    flat is an order below the Azure's. So a disagreement is reported as the
    AZURE'S error, and the consequence is stated in the units that matter: the
    standoff a Noether raster planned over an Azure mesh would actually fly at,
    against the head's 57 mm hard limit.

    THE KEYENCE IS GRABBED ON A GRID AROUND THE TAUGHT POINT, and that is not
    optional either. One static profiler pose measures ONE LINE: 35 mm long,
    microns wide, and every point in it has y exactly 0 in the sensor's frame.
    fit_plane() handed a line still returns a plane -- the one whose normal is
    the direction of least scatter, which is the sensor's y axis, roughly
    horizontal, at a residual of exactly zero. A single-line grab therefore
    reports "0.000 mm rms flat" at 1571.91 mrad (90.06 degrees, the angle
    between that horizontal artefact and the Azure's vertical normal) and a
    height that means nothing. check_plane_support() refuses a fit whose points
    are still a line.

    PANNING ACROSS THE LINE IS ONLY HALF A FIX. It puts the ACROSS-line slope
    on a real baseline and leaves the ALONG-line slope to the shape of a single
    35 mm profile, which is the half that scatters -- 9.4 mrad sd against a
    10 mrad tolerance, reproducible at a point and different at different
    points, i.e. a real 35 mm chord of a surface the Azure is reading over
    300 mm. CAL_VERIFY_KEYENCE_OFFSETS is a five-grab grid, four corners and
    the centre, so both slopes come from between-grab heights over 110 mm and
    the profile's own shape keeps 3.5% of the leverage instead of all of it. It
    needs a flat 150 mm across.

    EACH GRAB IS CHECKED AGAINST THE PLANE OF THE OTHERS before anything is
    compared, because a grid that reaches 73 mm can find the edge of the
    target, and each grab's points are SAVED to <take>/keyence_patches/ with
    the grab they came from -- which is what lets the pose-to-pose scatter be
    re-measured offline instead of assumed.

    THE TWO NUMBERS ARE MEASURED OVER DIFFERENT WINDOWS, and that is the point
    of CAL_VERIFY_TILT_PATCH. dz comes from the +/-45 mm patch, where it is
    stable and where the Keyence measured. The TILT comes from the widest part
    of the same flat the Azure can see, because a +/-45 mm baseline cannot
    resolve 10 mrad of orientation and reports pure noise as a FAIL. It
    is reported with its own 1 sigma and judged against max(tolerance,
    3 sigma), so a fit that cannot resolve the tolerance cannot fail on it.

    Returns a dict; `["pass"]` is the answer. Two minutes.
    """
    g = _cal_geom()
    tol = float(CAL_VERIFY_DZ_MM if tol_mm is None else tol_mm)
    tol_r = float(CAL_VERIFY_TILT_MRAD if tilt_mrad is None else tilt_mrad)
    half = float(CAL_VERIFY_PATCH if patch is None else patch)
    if point is None:
        have = [n for n in CAL_VERIFY_POINTS if n in taught_points]
        if not have:
            raise CalibrationRefused(
                "verify_calibration() needs a taught point over a flat patch "
                "and there is none. Jog the PROBE TIP onto the flat and call "
                "teach_point(%r). Taught now: %s"
                % (CAL_VERIFY_POINTS[0],
                   ", ".join(sorted(taught_points)) or "nothing"))
        point = have[0]
    aim = (_cap_point(point) if isinstance(point, str)
           else np.asarray(point, float))
    topics = sensor_topics("azure") or {}
    depth_topic = topics.get("depth") or sensor_topic("azure", "depth")
    info_topic = topics.get("camera_info") or sensor_topic("azure", "camera_info")
    prof_topic = sensor_topic("keyence", "profiles", "/profiles")
    d_az = float(CAL_AZURE_DISTANCE if distance is None else distance)
    which_depth = str(CAL_VERIFY_DEPTH if depth is None else depth).lower()
    if which_depth not in ("registered", "raw", "both"):
        raise CalibrationRefused(
            "depth=%r is not one of 'registered', 'raw' or 'both'. See "
            "CAL_VERIFY_DEPTH." % (depth,))

    out = {"point": point if isinstance(point, str) else list(aim),
           "patch_half_m": half, "tol_mm": tol, "tol_mrad": tol_r,
           "depth_source": which_depth}
    # sets=("core", "keyence") RECORDS /profiles, so a Keyence number that
    # turns out to be nonsense can be looked at afterwards instead of being
    # gone. It is the expensive topic -- 217 Hz x 800 columns x 16 bytes is
    # 2.8 MB/s on this cell -- so it is added to the two CALIBRATION scenarios,
    # where the whole point is that the data is later doubted, and not to every
    # take.
    #
    # THE AZURE IS NOT IN THE SETS, and that is deliberate rather than an
    # oversight: registered depth is 2048x1536 of 16-bit at 30 Hz, about
    # 188 MB/s, against the ~465 MB this whole take already writes. What is
    # needed is not the topic but THE GRAB -- the one image each number was
    # computed from -- so _cal_azure_surface() writes that into
    # <take>/azure_grabs/ instead. About 6 MB, and enough to re-derive the
    # height, re-fit the plane, or compare the two depth pipelines offline.
    #
    # THE KEYENCE PATCH IS SAVED THE SAME WAY, into <take>/keyence_patches/,
    # and for the same reason: /profiles in the bag is the raw stream, not the
    # world-frame patch each number came from nor the grab each point belongs
    # to. About 2 MB. See _cal_save_keyence_patch().
    with capture_scenario("verify_calibration", sets=("core", "keyence"),
                          laser=True,
                          params=dict(out),
                          expect_s=120.0 + 60.0*len(CAL_VERIFY_KEYENCE_OFFSETS),
                          motion=True) as take:
        # -- the Azure ------------------------------------------------------
        K, D, _w, _h, cam_frame = _cal_intrinsics(info_topic)
        q_home = _cal_tool_quat(0.0, 0.0, 0.0)
        xyz = _cal_pose_for_sensor(aim, q_home, d_az, cam_frame)
        # RETRIED, NOT SKIPPED. Every pose in a verification is load-bearing --
        # there are four of them and they are compared against one another --
        # so a leg that will not plan has to be flown another way rather than
        # dropped. _cal_fly_to() tries the straight line and then joint space.
        _cal_fly_or_refuse(xyz, q_home, "verify: azure over the flat")
        time.sleep(CAL_SETTLE_S)
        # BOTH DEPTH SOURCES, AT THE SAME POSE, when asked. The arm does not
        # move between them, so any difference is the two pipelines and nothing
        # else. The verdict is always the configured one; "raw" and "both" add
        # a measurement rather than changing a pass into a fail.
        # az_world receives the WHOLE grab in world coordinates. The tilt is
        # fitted over a wider window than the dz patch, and it has to be the
        # same grab, not a second one taken a moment later.
        az_world, raw_world = {}, {}
        az, az_meta = _cal_azure_surface(depth_topic, info_topic, aim, half,
                                         "registered", take=take, say=_cal_say,
                                         keep_world=az_world)
        out["azure_depth"] = az_meta
        if which_depth in ("raw", "both"):
            raw_d = CAL_AZURE_RAW_TOPICS.get("depth")
            raw_i = CAL_AZURE_RAW_TOPICS.get("camera_info")
            try:
                raw_pts, raw_meta = _cal_azure_surface(
                    raw_d, raw_i, aim, half, "raw", take=take, say=_cal_say,
                    keep_world=raw_world)
            except Exception as e:                            # noqa: BLE001
                raw_pts, raw_meta = None, {"error": "%s: %s"
                                           % (type(e).__name__, e)}
                _cal_say("    azure[raw]: NOT AVAILABLE -- %s"
                         % raw_meta["error"])
            out["azure_depth_raw"] = raw_meta
            if raw_pts is not None and raw_pts.shape[0] >= 100:
                n_r, c_r, rms_r, _k = g.fit_plane(raw_pts)
                out["azure_raw_z"] = float(c_r[2])
                out["azure_raw_rms_mm"] = float(rms_r)*1e3
                _cal_say("    azure[raw]   z = %.4f m   %.3f mm rms flat, "
                         "%d points" % (c_r[2], rms_r*1e3, raw_pts.shape[0]))
            if which_depth == "raw" and raw_pts is not None \
                    and raw_pts.shape[0] >= 100:
                # Asked for raw ONLY: it is the comparison as well as the note.
                # The tilt has to follow it to the same pipeline.
                az, out["azure_depth"] = raw_pts, raw_meta
                if raw_world.get("pts") is not None:
                    az_world = raw_world
        # AND HOW BRIGHT THE PATCH IS, because the commonest reason this check
        # fails is not a calibration at all -- it is being pointed at something
        # the Azure cannot measure. See _cal_patch_brightness().
        grey_why = []
        bright = _cal_patch_brightness(aim, half, K, cam_frame,
                                       why=grey_why.append)
        out["patch_grey"] = bright
        out["patch_grey_why"] = grey_why[0] if grey_why else None
        if bright is None:
            # SAID OUT LOUD. _cal_patch_brightness() returns None on any
            # failure, so a silent None here leaves the one diagnostic that
            # separates "the Azure cannot measure this target" from "the mount
            # is wrong" switched off with nobody able to tell. A check that
            # disables itself silently is worse than no check.
            _cal_say("    (no patch brightness: %s. 'Can the Azure see this "
                     "target' is UNTESTED below.)"
                     % (grey_why[0] if grey_why else "reason not recorded"))
        if az.shape[0] < 100:
            raise CalibrationRefused(
                "the Azure returned %d points over the patch at (%.3f, %.3f). "
                "Is the flat there, and inside the camera's view?"
                % (az.shape[0], aim[0], aim[1]))

        # -- the Keyence ----------------------------------------------------
        # A GRID AROUND THE TAUGHT POINT, NOT A LINE ACROSS ONE. The profile
        # runs along the sensor's x and the sensor's y is across it; both are
        # read from the same transform _cal_pose_for_sensor() uses -- the tool
        # orientation times probe_end -> optical -- so no motion is needed to
        # find them and they stay right on any tooling.
        #
        # WHY BOTH AXES. A pan across the line measures the across-line slope
        # from the height differences between grabs, and leaves the along-line
        # slope to the shape of one 35 mm profile -- which is the half that
        # scatters, by 9.4 mrad against a 10 mrad
        # tolerance. Stepping ALONG the line as well puts both slopes on a
        # real baseline. The measurements are at CAL_VERIFY_KEYENCE_OFFSETS.
        T_ps = _cal_tf("probe_end", "lj_v7080_optical_frame")
        R_ws = g.quat_to_R(q_home).dot(T_ps[:3, :3])
        along, across = R_ws[:, 0], R_ws[:, 1]
        planned = []
        for ac, al in _cal_keyence_offsets():
            at_o = np.asarray(aim, float) + across*ac + along*al
            planned.append(
                {"across": ac, "along": al, "aim": at_o,
                 "label": "%+.0f,%+.0f mm" % (ac*1e3, al*1e3),
                 "xyz": _cal_pose_for_sensor(at_o, q_home, 0.0,
                                             "lj_v7080_optical_frame")})
        # SCREENED BEFORE THE FIRST ONE IS FLOWN, because the grid reaches
        # 73 mm and a flat near the edge of the work volume would otherwise
        # refuse on the fourth grab with three already flown.
        fly, cannot = _cal_keyence_reach(planned, q_home, say=_cal_say)
        for p, whynot in cannot:
            _cal_say("    keyence grab at %s DROPPED: %s"
                     % (p["label"], whynot))
        out["keyence_dropped"] = [[p["label"], w] for p, w in cannot]
        if len(fly) < 2:
            raise CalibrationRefused(
                "%d of %d keyence verification grabs can be flown from this "
                "taught point, and one pose measures a LINE, whose plane has a "
                "normal chosen by nothing. Teach the flat further inside the "
                "work volume, or shrink CAL_VERIFY_KEYENCE_OFFSETS.\n  %s"
                % (len(fly), len(planned),
                   "\n  ".join("%s: %s" % (p["label"], w) for p, w in cannot)))
        # NOT A REFUSAL, A WARNING, and deliberately so: a grid reduced to one
        # axis still measures dz -- the safety-critical number, the one that
        # decides whether a raster flies into the head's near limit -- and the
        # tilt then has no uncertainty, which the gate and tilt_sigma_missing
        # already say out loud. Throwing the height away to protect the
        # orientation would be the wrong trade.
        if len(fly) < 4 or min(np.ptp([p["across"] for p in fly]),
                               np.ptp([p["along"] for p in fly])) <= 0.0:
            _cal_say("    (only %d grab(s), spanning %.0f mm across the line "
                     "and %.0f mm along it: the keyence tilt will have NO "
                     "uncertainty of its own and is judged against the bare "
                     "%.1f mrad tolerance. Four grabs spanning both axes are "
                     "what the jackknife needs.)"
                     % (len(fly), 1e3*np.ptp([p["across"] for p in fly]),
                        1e3*np.ptp([p["along"] for p in fly]), tol_r))
        key, key_g, n = [], [], 0
        for i, p in enumerate(fly):
            _cal_fly_or_refuse(p["xyz"], q_home,
                               "verify: keyence over the flat %s" % p["label"])
            time.sleep(CAL_SETTLE_S)
            pts_s, frame, k = _cal_profile_points(prof_topic)
            T = _cal_tf("world", frame)
            W = pts_s.dot(T[:3, :3].T) + T[:3, 3]
            key.append(W)
            key_g.append(np.full(W.shape[0], i, np.int16))
            p["T"], p["frame"], p["profiles"] = T, frame, int(k)
            n += k
        key = np.vstack(key)
        key_g = np.concatenate(key_g)
        grabs = len(fly)
        offs = [(p["across"], p["along"]) for p in fly]

        # -- is every grab on the SAME flat? ---------------------------------
        # The grid reaches 73 mm, far enough to walk off a small target, and a
        # grab that has found the bench arrives as a tilt rather than as an
        # obvious fault. It is also where the pose-to-pose scatter the grid was
        # sized from gets measured, every run, instead of being taken on trust
        # from this file's comments.
        sc = _cal_keyence_scatter(key, key_g)
        out["keyence_scatter"] = sc
        _cal_say("    keyence grabs: %s"
                 % ", ".join("%s %+.2f mm" % (p["label"], v)
                             for p, v in zip(fly, sc["off_mm"])))
        if sc["scatter_mm"] is not None:
            _cal_say("      pose-to-pose height scatter %.3f mm over %d grabs "
                     "(the grid is sized for 0.10 mm; see "
                     "CAL_VERIFY_KEYENCE_OFFSETS)"
                     % (sc["scatter_mm"], sc["grabs"]))
        if sc["off_flat"]:
            # THE WORST GRAB IS NAMED FIRST, because once one grab is off the
            # flat the plane through "the others" still contains it, so every
            # other grab measures off too and the list is usually all of them.
            # The one to go and look at is the outlier.
            raise CalibrationRefused(
                "keyence grab %s is %+.2f mm off the plane of the others, past "
                "the %.1f mm that says they are the same surface (all of them: "
                "%s). The grid reaches %.0f mm across the line and %.0f mm "
                "along it from the taught point and has found an edge, a step "
                "or a second surface out there -- so nothing has been "
                "compared. Put the check on a flat at least 150 mm across with "
                "the taught point in the middle of it, or shrink "
                "CAL_VERIFY_KEYENCE_OFFSETS and accept the wider tilt gate "
                "that comes with it."
                % (fly[sc["worst_grab"]]["label"], sc["worst_off_mm"],
                   sc["band_mm"],
                   ", ".join("%s %+.2f" % (p["label"], v)
                             for p, v in zip(fly, sc["off_mm"])),
                   1e3*max(abs(p["across"]) for p in fly),
                   1e3*max(abs(p["along"]) for p in fly)))
        _cal_save_keyence_patch(take, "verify", key, key_g, fly, aim,
                                (across, along),
                                meta={"scatter": sc, "profile_topic": prof_topic,
                                      "point": out["point"]},
                                say=_cal_say)

        # -- can either of them determine a plane at all? --------------------
        for name, pts in (("the keyence patch", key), ("the azure patch", az)):
            sup = g.check_plane_support(pts, name=name)
            out.setdefault("support", {})[name] = {
                k: sup[k] for k in ("n", "length", "width", "thickness", "ok")}
            if not sup["ok"]:
                raise CalibrationRefused(
                    sup["message"] + "\n  Nothing has been compared and no "
                    "verdict has been reached: the numbers this would have "
                    "printed would have been an artefact of the fit, not a "
                    "measurement of either sensor.")

        # -- the subtraction ------------------------------------------------
        a = g.plane_agreement(key, az, at=aim, name_a="keyence", name_b="azure")
        out.update(a)
        out["azure_points"] = int(az.shape[0])
        out["keyence_points"] = int(key.shape[0])
        out["keyence_profiles"] = n
        out["keyence_grabs"] = grabs
        out["keyence_offsets_m"] = [[float(ac), float(al)] for ac, al in offs]
        # -- and the orientation, on its own terms ---------------------------
        # NOT plane_agreement()'s tilt, which is fitted over the +/-45 mm patch
        # and cannot resolve the tolerance. See CAL_VERIFY_TILT_PATCH for the
        # measured reason.
        #
        # key_groups IS WHAT MAKES THE KEYENCE SIDE HONEST. Its points arrive
        # as one line per arm pose and every point in a line shares that pose's
        # height error, so a spatial jackknife of them reports a sigma near
        # zero -- the same six-fold understatement the Azure's iid sigma gives,
        # pointing the other way. Labelled by grab, the deleted unit is the
        # pose.
        try:
            tl = _cal_tilt_agreement(key, az_world.get("pts", az), aim, half,
                                     tol_r, key_groups=key_g)
        except Exception as e:                                # noqa: BLE001
            # The dz answer does not depend on this, so a tilt that cannot be
            # estimated leaves the patch number standing rather than taking the
            # verification down with it -- BUT IT SAYS SO, out loud. A silent
            # fall back to the patch-width criterion is indistinguishable from
            # the check working.
            tl = {"tilt_mrad": float(a["tilt_mrad"]), "tilt_sigma_mrad": None,
                  "tilt_gate_mrad": tol_r,
                  "tilt_pass": bool(a["tilt_mrad"] <= tol_r),
                  "tilt_patch_mrad": float(a["tilt_mrad"]),
                  "tilt_error": "%s: %s" % (type(e).__name__, e)}
            _cal_say("    (the wide tilt fit failed -- %s. Falling back to the "
                     "+/-%.0f mm patch, which cannot resolve %.1f mrad; treat "
                     "the tilt below as uninformative.)"
                     % (tl["tilt_error"], 1e3*half, tol_r))
        out.update(tl)
        ok = (abs(a["dz_mm"]) <= tol and tl["tilt_pass"])
        out["pass"] = bool(ok)

        _cal_say("")
        _cal_say("  VERIFICATION over a flat at (%.3f, %.3f), +/-%.0f mm"
                 % (aim[0], aim[1], half*1e3))
        _cal_say("    keyence  z = %.4f m   %.3f mm rms flat, %d points from %d "
                 "profiles at %d grabs on a %.0f x %.0f mm grid (across x "
                 "along the line): %s"
                 % (a["z_a"], a["rms_a_mm"], key.shape[0], n, grabs,
                    1e3*float(np.ptp([ac for ac, _al in offs])),
                    1e3*float(np.ptp([al for _ac, al in offs])),
                    " ".join("%+.0f,%+.0f" % (ac*1e3, al*1e3)
                             for ac, al in offs)))
        _cal_say("    azure    z = %.4f m   %.3f mm rms flat, %d points"
                 % (a["z_b"], a["rms_b_mm"], az.shape[0]))
        _cal_say("    AZURE IS %+.2f mm OFF THE KEYENCE" % (a["dz_mm"],))
        # THE TILT WITH ITS OWN UNCERTAINTY, and each plane's tilt from
        # horizontal beside it, so a disagreement can be attributed to a sensor
        # instead of guessed at.
        _cal_say("    TILT %s OFF THE KEYENCE (gate %.2f), "
                 "from horizontal keyence %s azure %s"
                 % (_cal_fmt_tilt(tl.get("tilt_mrad"),
                                  tl.get("tilt_sigma_mrad")),
                    float(tl.get("tilt_gate_mrad") or tol_r),
                    _cal_fmt_tilt(
                        (tl.get("tilt_keyence") or {})
                        .get("tilt_from_horizontal_mrad"),
                        (tl.get("tilt_keyence") or {}).get("sigma_mrad")),
                    _cal_fmt_tilt(
                        (tl.get("tilt_azure") or {})
                        .get("tilt_from_horizontal_mrad"),
                        (tl.get("tilt_azure") or {}).get("sigma_mrad"))))
        m_a = tl.get("tilt_azure") or {}
        if m_a.get("basis") == "wide":
            _cal_say("      the azure tilt is fitted over %.0f x %.0f mm of the "
                     "same flat (%d points), not the +/-%.0f mm patch, which "
                     "would have said %.2f mrad"
                     % (m_a["extent_mm"][0], m_a["extent_mm"][1], m_a["n"],
                        1e3*half, float(tl.get("tilt_patch_mrad") or 0.0)))
        elif m_a.get("why_patch"):
            _cal_say("      the azure tilt is the +/-%.0f mm patch only -- %s"
                     % (1e3*half, m_a["why_patch"]))
        m_k = tl.get("tilt_keyence") or {}
        if m_k.get("blocks"):
            _cal_say("      the keyence tilt is fitted over %.0f x %.0f mm "
                     "(%d points), its sigma from deleting each of %d grabs "
                     "in turn"
                     % (m_k["extent_mm"][0], m_k["extent_mm"][1], m_k["n"],
                        m_k["blocks"]))
        # WHICH SIDE COULD NOT SAY, in the open. A gate that has quietly
        # reverted to the bare tolerance is back to a coin toss, and the only
        # other sign of it is a "(sigma unknown)" in the middle of a longer
        # line.
        if tl.get("tilt_sigma_missing"):
            _cal_say("      NO UNCERTAINTY FOR THE %s TILT, so the gate is the "
                     "bare %.1f mrad tolerance and a pass or a fail near it "
                     "means little. Four grabs spanning both axes are what the "
                     "keyence side needs; see CAL_VERIFY_KEYENCE_OFFSETS."
                     % (" AND ".join(s.upper()
                                     for s in tl["tilt_sigma_missing"]), tol_r))

        # THE EXPERIMENT, when both depth sources were grabbed. Same pose, same
        # patch, same Keyence: the only difference is registered depth against
        # the depth camera's own image, so this separates a RESAMPLING fault
        # from the depth measurement itself. Nothing else can.
        if out.get("azure_raw_z") is not None:
            raw_dz = (float(out["azure_raw_z"]) - a["z_a"])*1e3
            out["azure_raw_dz_mm"] = raw_dz
            out["azure_raw_minus_registered_mm"] = raw_dz - a["dz_mm"]
            _cal_say("    RAW DEPTH IS %+.2f mm OFF THE KEYENCE, which is "
                     "%+.2f mm from the registered answer"
                     % (raw_dz, raw_dz - a["dz_mm"]))
            if abs(raw_dz) <= tol and abs(a["dz_mm"]) > tol:
                _cal_say("      THE REGISTRATION IS THE FAULT. The depth "
                         "camera's own image agrees with the Keyence and the "
                         "registered one does not, so the error is in "
                         "depth_to_rgb's resampling through the factory "
                         "depth-to-colour extrinsics, not in either sensor's "
                         "mount and not in the depth measurement. Point the "
                         "manifest's azure depth topic at %s."
                         % CAL_AZURE_RAW_TOPICS.get("depth"))
            elif abs(raw_dz - a["dz_mm"]) <= max(1.0, 0.25*tol):
                _cal_say("      BOTH PIPELINES AGREE, so the registration is "
                         "not the fault: this is what the depth sensor "
                         "returns. A mount solve cannot move it.")
            else:
                _cal_say("      They disagree by %+.2f mm and neither is "
                         "inside tolerance; both the resampling and the depth "
                         "itself are still in play."
                         % (raw_dz - a["dz_mm"],))

        # What that costs, in the units the failure actually arrived in.
        ref = CAL_KEYENCE_REF_DIST
        flown = ref + a["dz_mm"]*1e-3
        margin = (flown - CAL_KEYENCE_RANGE[0])*1e3
        _cal_say("    CONSEQUENCE: a raster planned over an Azure mesh at the "
                 "%.0f mm reference distance would fly at %.1f mm, which is "
                 "%.1f mm clear of the head's %.0f mm hard limit."
                 % (ref*1e3, flown*1e3, margin, CAL_KEYENCE_RANGE[0]*1e3))
        out["implied_standoff_mm"] = flown*1e3
        out["margin_to_limit_mm"] = margin
        gate_r = float(tl.get("tilt_gate_mrad") or tol_r)
        if ok:
            _cal_say("    PASS (tolerance %.1f mm, %.1f mrad)" % (tol, gate_r))
        else:
            # WHICH ONE FAILED, in the verdict line itself. They have different
            # causes and different fixes, and _cal_verify_why() branches on it.
            bad = " and ".join(
                w for w, f in (("height", abs(a["dz_mm"]) > tol),
                               ("tilt", not tl["tilt_pass"])) if f)
            _cal_say("    FAIL on %s (tolerance %.1f mm, %.1f mrad). Do not "
                     "plan a Keyence raster over an Azure mesh until this "
                     "passes: that has cost 26-39%% of a plate."
                     % (bad, tol, gate_r))
            for line in _cal_verify_why(out, bright):
                _cal_say("    " + line)
        take.results.update(out)
    _CAL["verify"] = out
    if raise_on_fail and not out["pass"]:
        raise CalibrationRefused(
            "calibration verification failed: the Azure is %+.2f mm and %s off "
            "the Keyence over a flat (tolerance %.1f mm, gate %.1f mrad)."
            % (out["dz_mm"],
               _cal_fmt_tilt(out.get("tilt_mrad"), out.get("tilt_sigma_mrad")),
               tol, float(out.get("tilt_gate_mrad") or tol_r)))
    return out


# ------------------------------------------------------------------------------
# Writing it somewhere the robot description can consume it
# ------------------------------------------------------------------------------

def _cal_site_package():
    """The per-cell tari_site package name for this cell."""
    return "tari_cell_" + str(CELL_NAME).replace("-", "_")


def _cal_site_urdf_dir():
    """(the cell package's SOURCE urdf directory, how it was found), or (None, why).

    The file has to land in the SOURCE tree, not in the install tree, or the
    next colcon build throws the calibration away. Three routes, in order:

      TARI_SITE_URDF      set it and this stops guessing. Always right.
      the install symlink colcon --symlink-install links installed files back
                          at their sources, so realpath() of an installed file
                          IS the source. Recognised by finding "/src/" in it.
      the workspace       walk from the install prefix to its sibling src/ and
                          look for the package there.

    When none of them work this returns why, and write_calibration() prints
    the file's own path and tells the operator to copy it themselves. That is
    a worse experience than one command, and it is much better than a command
    that silently writes somewhere the build does not read.
    """
    pkg = _cal_site_package()
    env = os.environ.get("TARI_SITE_URDF")
    if env:
        return os.path.expanduser(env), "TARI_SITE_URDF"
    share = None
    try:
        from ament_index_python.packages import get_package_share_directory
        share = get_package_share_directory(pkg)
    except Exception as e:                               # noqa: BLE001
        return None, "%s is not on AMENT_PREFIX_PATH (%s)" % (pkg, e)
    for probe in ("urdf/environment.urdf.xacro", "urdf/sensor_calibration.urdf.xacro"):
        real = os.path.realpath(os.path.join(share, probe))
        if os.path.exists(real) and os.sep + "src" + os.sep in real:
            return os.path.dirname(real), "the install symlink"
    here = share
    for _ in range(6):
        here = os.path.dirname(here)
        cand = os.path.join(os.path.dirname(here), "src")
        if not os.path.isdir(cand):
            continue
        for root, dirs, _files in os.walk(cand):
            if os.path.basename(root) == pkg and os.path.isdir(
                    os.path.join(root, "urdf")):
                return os.path.join(root, "urdf"), "a walk of " + cand
            dirs[:] = [d for d in dirs if not d.startswith(".")]
    return None, ("found %s installed at %s but no source tree for it -- this "
                  "machine may build from a copy" % (pkg, share))


def _cal_file():
    """The per-cell calibration record, beside the work-volume override."""
    d = os.path.join(os.path.expanduser(CAPTURE_ROOT), "cell_override")
    return os.path.join(d, "%s.sensor_calibration.json" % (CELL_NAME,))


def _cal_dropin_file():
    """The drop-in xacro, beside the record. THE FILE THE OPERATOR COPIES.

    Deliberately NOT in the session directory. A session directory is named
    after a timestamp and is gone next week; this path is stable, so the copy
    command in the doc is a command and not a template. A copy does go into the
    session as part of the take's record.
    """
    d = os.path.join(os.path.expanduser(CAPTURE_ROOT), "cell_override")
    return os.path.join(d, "sensor_calibration.urdf.xacro")


def _cal_session_file(name):
    try:
        return os.path.join(_session()["dir"], name)
    except Exception:                                    # noqa: BLE001
        return os.path.join(os.path.expanduser(CAPTURE_ROOT), name)


def _cal_mount_correction(sensor, X, frame):
    """The correction joint that makes the deployed chain publish `X`.

    Returns a dict: the new correction, the one in force, how far apart they
    are, and the keyence_ref_dist_cal this supersedes. Reads three transforms
    from LIVE TF and nothing from a file, because the chain in force is only
    actually known from the running description.

    THE ARITHMETIC IS IN calibration_solve.mount_cal(), where it is tested. The
    job here is to fetch the right three transforms, and one of them needs
    care -- see the ref_dist_cal note below.
    """
    g = _cal_geom()
    m = CAL_MOUNTS.get(sensor)
    if m is None:
        raise CalibrationRefused("no mount correction is defined for %r" % sensor)
    try:
        A = _cal_tf(m["parent"], "probe_end")
        B = _cal_tf(m["cal_link"], frame)
        old = _cal_tf(m["parent"], m["cal_link"])
    except CalibrationRefused as e:
        raise CalibrationRefused(
            "%s. The description in force has no %s link, so it predates the "
            "6 DOF mount calibration. Update tari_ur_description, rebuild it, "
            "and restart the bring-up before calibrating."
            % (e, m["cal_link"]))

    # THE KEYENCE STANDOFF, AND WHY B IS ADJUSTED. B is read from TF, so it
    # carries whatever keyence_ref_dist_cal the running description has. The
    # emitted file sets keyence_ref_dist_cal to zero -- the 6 DOF solve owns
    # the standoff -- so the correction has to be computed against a chain
    # WITHOUT it, or the standoff would be lost rather than double counted.
    # TF publishes only the sum, so the value in force is recovered by
    # subtracting the head's specified reference distance from the optical
    # joint, which is a pure translation along the head's z.
    ref_cal = 0.0
    if sensor == "keyence":
        M = _cal_tf("lj_v7080_frame", "lj_v7080_optical_frame")
        if not np.allclose(M[:3, :3], np.eye(3), atol=1e-9):
            raise CalibrationRefused(
                "lj_v7080_frame -> lj_v7080_optical_frame is rotated, which "
                "this cannot be. The description has changed shape; read "
                "lj_v7080_macro.xacro before going further.")
        ref_cal = float(-M[2, 3] - CAL_KEYENCE_REF_DIST)
        B = B.dot(g.rt_to_T(np.eye(3), (0.0, 0.0, ref_cal)))

    Cal = g.mount_cal(X, A, B)
    dt, dr = g.pose_delta(old, Cal)
    return {"sensor": sensor, "parent": m["parent"], "cal_link": m["cal_link"],
            "Cal": Cal, "old": old, "B": B, "A": A,
            "move_mm": dt*1e3, "move_mrad": dr*1e3,
            "superseded_ref_dist_cal_mm": ref_cal*1e3,
            "xyz": [float(v) for v in Cal[:3, 3]],
            "rpy": [float(v) for v in g.R_to_rpy(Cal[:3, :3])],
            "old_xyz": [float(v) for v in old[:3, 3]],
            "old_rpy": [float(v) for v in g.R_to_rpy(old[:3, :3])]}


def calibration_xacro(record=None, header=None):
    """The whole per-cell drop-in file, as text, from the recorded corrections.

    ONE FILE FOR BOTH SENSORS, regenerated in full every time either is
    calibrated, from the JSON record rather than from whatever is in the file
    already. Emitting only the sensor just calibrated would mean the file on
    disk is a merge of two runs and the record is a third thing; regenerating
    from one source of truth means the file always says exactly what the record
    says, and a half-finished calibration cannot leave a stale half behind.
    """
    g = _cal_geom()
    doc = load_calibration() if record is None else record
    doc = doc or {}
    cals, notes = {}, []
    for sensor in sorted(g.CAL_XACRO_PROPERTIES):
        e = doc.get(sensor) or {}
        mc = e.get("mount_cal")
        if not mc:
            notes.append("%s not calibrated" % sensor)
            continue
        cals[sensor] = g.properties_to_cal(
            " ".join("%.9f" % v for v in mc["xyz"]),
            " ".join("%.9f" % v for v in mc["rpy"]))
        notes.append("%s measured %s, %s in force -> %s, %.2f mm"
                     % (sensor, e.get("measured", "?")[:16],
                        _cal_fmt_xyz(mc.get("old_xyz")), _cal_fmt_xyz(mc["xyz"]),
                        mc.get("move_mm", float("nan"))))
    head = ["cell %s, mode %s" % (CELL_NAME, CELL_MODE)]
    head += list(header or [])
    return g.render_calibration_xacro(cals, ref_dist_cal=0.0,
                                      notes=notes, header=head)


def _cal_fmt_xyz(v):
    if not v:
        return "(none)"
    return "(" + " ".join("%+.2f" % (x*1e3) for x in v) + ") mm"


def write_calibration(sensor, res, frame, take=None):
    """Record a solved transform AND write the file that deploys it.

    WHAT THE OPERATOR GETS, and it is deliberately a file rather than text to
    paste. Pasting a xacro origin means opening the right file, finding the
    right joint, replacing the right attribute and not the one above it, and
    doing all of that at a cell at the end of a long day. Every one of those is
    a step that can be done wrong silently. A whole file that is copied over
    another whole file cannot be.

      <CAPTURE_ROOT>/cell_override/<cell>.sensor_calibration.json
          the machine-readable record. Both sensors, the full report, the
          conditioning, the pose set. This is the source of truth.
      <CAPTURE_ROOT>/cell_override/sensor_calibration.urdf.xacro
          THE DROP-IN. Copy it over the same file in the cell's tari_site
          package, rebuild that package, restart ROS. Regenerated in full from
          the record every time, so it always carries both sensors.

    IT STILL DOES NOT APPLY ITSELF, and that is not laziness. A mount lives in
    the robot description -- it is consumed by xacro at bring-up and it is what
    MoveIt plans collisions against -- so changing it under a running stack
    would leave TF and the planning scene disagreeing about where a camera on
    the arm is. The operator restarts ROS, and check_calibration_applied()
    proves it took.
    """
    g = _cal_geom()
    path = _cal_file()
    os.makedirs(os.path.dirname(path), exist_ok=True)
    doc = {}
    if os.path.exists(path):
        try:
            with open(path) as f:
                doc = json.load(f)
        except Exception:                                # noqa: BLE001
            doc = {}

    mc = _cal_mount_correction(sensor, res.X, frame)
    entry = {
        "cell": CELL_NAME, "mode": CELL_MODE, "frame": frame,
        "parent": "probe_end",
        "measured": datetime.datetime.now().isoformat(timespec="seconds"),
        "xyz": [float(v) for v in res.xyz],
        "quat": [float(v) for v in res.quat],
        "rpy": [float(v) for v in res.rpy],
        "adequate": bool(res.adequate),
        "sigma_mm_mrad": (None if res.sigma is None
                          else [float(v) for v in res.sigma]),
        "board": {k: v for k, v in cal_board().items() if k != "object_points"},
        "artifact": CAL_ARTIFACT,
        "session": (_session()["dir"] if take is not None else None),
        "report": res.report(),
        "mount_cal": {k: v for k, v in mc.items()
                      if k not in ("Cal", "old", "A", "B")},
    }
    doc.setdefault(CELL_MODE, {})[sensor] = entry
    with open(path, "w") as f:
        json.dump(doc, f, indent=2, sort_keys=True)

    xac = calibration_xacro(doc.get(CELL_MODE))
    drop = _cal_dropin_file()
    with open(drop, "w") as f:
        f.write(xac)
    human = _cal_session_file("sensor_calibration.urdf.xacro")
    try:
        with open(human, "w") as f:
            f.write(xac)
    except Exception:                                    # noqa: BLE001
        human = None

    dest, how = _cal_site_urdf_dir()
    _cal_say("")
    _cal_say("  WHAT CHANGED for the %s, in %s coordinates:" % (sensor, mc["parent"]))
    _cal_say("    in force now   %s" % _cal_fmt_xyz(mc["old_xyz"]))
    _cal_say("    this solve     %s" % _cal_fmt_xyz(mc["xyz"]))
    _cal_say("    the move       %.2f mm and %.2f mrad"
             % (mc["move_mm"], mc["move_mrad"]))
    if mc["move_mm"] > CAL_BIG_MOVE_MM:
        _cal_say("    THAT IS A REAL MOVE, not a refinement. %.1f mm means the "
                 "fixture has shifted or the description never matched it. "
                 "Look at the bracket before you believe it, and check the "
                 "board pitch was measured (set_board_square)." % mc["move_mm"])
    if sensor == "keyence" and abs(mc["superseded_ref_dist_cal_mm"]) > 1e-6:
        _cal_say("    keyence_ref_dist_cal was %+.2f mm and is FOLDED INTO the "
                 "correction above. The emitted file sets it to zero -- one "
                 "owner for the standoff, and the description refuses to "
                 "render if both are set."
                 % mc["superseded_ref_dist_cal_mm"])

    _cal_say("")
    _cal_say("  WRITTEN")
    _cal_say("    %s" % path)
    _cal_say("    %s" % drop)
    _cal_say("")
    _cal_say("  DEPLOY IT -- copy one file, rebuild one package, restart ROS")
    if dest:
        _cal_say("    cp %s %s/" % (drop, dest))
        _cal_say("    (found via %s)" % how)
    else:
        _cal_say("    copy %s into the urdf/ directory of %s in your tari_site"
                 % (drop, _cal_site_package()))
        _cal_say("    (could not locate it here: %s)" % how)
    _cal_say("    colcon build --packages-select %s" % _cal_site_package())
    _cal_say("    restart the bring-up, then:  check_calibration_applied()")
    _cal_say("")
    _cal_say("  deploy_calibration() does the copy for you. Nothing about the "
             "running session has changed either way.")
    if take is not None:
        for f in (human, path):
            try:
                if f:
                    take.keep_file(f)
            except Exception:                            # noqa: BLE001
                pass
    return {"record": path, "xacro": drop, "session": human,
            "destination": dest, "mount_cal": entry["mount_cal"]}


def deploy_calibration(dest=None):
    """Copy the drop-in file into the cell's tari_site package. One command.

    Does the copy and nothing else -- no build, no restart, no TF. Those are
    the operator's, deliberately: a rebuild takes a minute and a restart takes
    the cell down, and neither should happen because a function was called.
    """
    import shutil
    src = _cal_dropin_file()
    if not os.path.exists(src):
        raise CalibrationRefused(
            "there is no calibration to deploy (%s does not exist). Run "
            "calibrate_azure() or calibrate_keyence() first." % src)
    if dest is None:
        dest, how = _cal_site_urdf_dir()
        if dest is None:
            raise CalibrationRefused(
                "cannot find the source tree of %s (%s). Pass the urdf "
                "directory as deploy_calibration(dest=...), or set "
                "TARI_SITE_URDF." % (_cal_site_package(), how))
    else:
        how = "given"
    if os.path.isdir(dest):
        dest = os.path.join(dest, "sensor_calibration.urdf.xacro")
    if not os.path.isdir(os.path.dirname(dest)):
        raise CalibrationRefused("%s is not a directory" % os.path.dirname(dest))
    shutil.copyfile(src, dest)
    _cal_say("  copied %s" % src)
    _cal_say("      to %s  (%s)" % (dest, how))
    _cal_say("  NOW:  colcon build --packages-select %s" % _cal_site_package())
    _cal_say("        restart the bring-up")
    _cal_say("        check_calibration_applied()")
    return dest


def check_calibration_applied(tol_mm=0.5, tol_mrad=1.0, quiet=False):
    """Did the file take? Reads TF and compares it against the record.

    RUN THIS AFTER THE RESTART. It is the only step that closes the loop: a
    file can be copied to the wrong tree, a package can fail to rebuild, a
    bring-up can be pointed at a different cell, and every one of those leaves
    a system that comes up clean and is still uncalibrated. It takes a second,
    moves nothing, and needs no target.

    Three statements per sensor, and the second is the one that matters:

      the correction joint is what was written    the file arrived
      probe_end -> the sensor is what was solved  the CHAIN gives the answer
      keyence_ref_dist_cal is zero                the standoff has one owner

    The middle one is the real check. The first can pass while the second
    fails if some other part of the chain changed underneath, which is exactly
    the case worth catching.
    """
    g = _cal_geom()
    doc = load_calibration()
    out = {"cell": CELL_NAME, "mode": CELL_MODE, "sensors": {}, "pass": True}
    if not doc:
        _cal_say("  no sensor calibration recorded for %s/%s -- nothing to "
                 "check. calibrate_azure() / calibrate_keyence() write one."
                 % (CELL_NAME, CELL_MODE))
        out["pass"] = False
        out["why"] = "no record"
        return out

    for sensor in sorted(doc):
        e = doc[sensor]
        mc = e.get("mount_cal")
        if not mc:
            continue
        want_cal = g.properties_to_cal(" ".join("%.9f" % v for v in mc["xyz"]),
                                       " ".join("%.9f" % v for v in mc["rpy"]))
        want_X = g.rt_to_T(g.quat_to_R(e["quat"]), e["xyz"])
        r = {"measured": e.get("measured")}
        try:
            got_cal = _cal_tf(mc["parent"], mc["cal_link"])
            got_X = _cal_tf("probe_end", e["frame"])
        except CalibrationRefused as ex:
            r["ok"] = False
            r["why"] = str(ex).splitlines()[0]
            out["sensors"][sensor] = r
            out["pass"] = False
            _cal_say("  %-8s CANNOT CHECK -- %s" % (sensor, r["why"]))
            continue
        dtj, drj = g.pose_delta(want_cal, got_cal)
        dtc, drc = g.pose_delta(want_X, got_X)
        r.update(joint_mm=dtj*1e3, joint_mrad=drj*1e3,
                 chain_mm=dtc*1e3, chain_mrad=drc*1e3)
        r["ok"] = bool(dtc*1e3 <= tol_mm and drc*1e3 <= tol_mrad
                       and dtj*1e3 <= tol_mm and drj*1e3 <= tol_mrad)
        out["sensors"][sensor] = r
        out["pass"] = out["pass"] and r["ok"]
        if not quiet:
            _cal_say("  %-8s %s" % (sensor, "APPLIED" if r["ok"] else "NOT APPLIED"))
            _cal_say("           correction joint %s <- %s   off by %.3f mm, "
                     "%.3f mrad" % (mc["parent"], mc["cal_link"],
                                    r["joint_mm"], r["joint_mrad"]))
            _cal_say("           probe_end -> %-24s off by %.3f mm, %.3f mrad"
                     % (e["frame"], r["chain_mm"], r["chain_mrad"]))
            if not r["ok"]:
                _cal_say("           The file did not reach the description in "
                         "force. Was it copied into the cell's tari_site "
                         "package, rebuilt, and the bring-up restarted?")

    if "keyence" in out["sensors"]:
        try:
            M = _cal_tf("lj_v7080_frame", "lj_v7080_optical_frame")
            rc = float(-M[2, 3] - CAL_KEYENCE_REF_DIST)
            out["ref_dist_cal_mm"] = rc*1e3
            if abs(rc) > 1e-5:
                out["pass"] = False
                _cal_say("  keyence_ref_dist_cal is still %+.2f mm. That is the "
                         "same standoff the mount correction now carries, so it "
                         "is being counted TWICE. Set it to 0.0 in the cell's "
                         "sensor_calibration.urdf.xacro." % (rc*1e3,))
            elif not quiet:
                _cal_say("  keyence_ref_dist_cal is zero -- the mount "
                         "correction owns the standoff, as it should")
        except CalibrationRefused:
            pass

    if not out["sensors"]:
        _cal_say("  the record has no mount correction in it. It predates the "
                 "drop-in file; re-run the calibration.")
        out["pass"] = False
    elif not quiet:
        _cal_say("")
        if out["pass"]:
            _cal_say("  PASS (tolerance %.2f mm, %.2f mrad). Now run "
                     "verify_calibration(): this said the numbers ARRIVED, "
                     "that says they were RIGHT." % (tol_mm, tol_mrad))
        else:
            _cal_say("  FAIL (tolerance %.2f mm, %.2f mrad). The description "
                     "in force is not the one that was calibrated, so do not "
                     "scan against it. deploy_calibration(), rebuild the cell "
                     "package, restart the bring-up, and run this again."
                     % (tol_mm, tol_mrad))
    _CAL["applied"] = out
    return out


def load_calibration(quiet=True):
    """The recorded calibration for this cell and mode, or None."""
    path = _cal_file()
    if not os.path.exists(path):
        if not quiet:
            _cal_say("  no sensor calibration recorded for %s (%s)"
                     % (CELL_NAME, path))
        return None
    try:
        with open(path) as f:
            doc = json.load(f)
    except Exception as e:                               # noqa: BLE001
        _cal_say("  could not read %s (%s)" % (path, e))
        return None
    return doc.get(CELL_MODE) or None


def describe_calibration():
    """One block of text about the calibration on record, for a banner."""
    doc = load_calibration()
    if not doc:
        return ("sensor calibration: NONE RECORDED for %s/%s. "
                "verify_calibration() says whether one is needed."
                % (CELL_NAME, CELL_MODE))
    L = ["sensor calibration on record for %s/%s:" % (CELL_NAME, CELL_MODE)]
    for sensor, e in sorted(doc.items()):
        s = e.get("sigma_mm_mrad")
        L.append("  %-8s %s  xyz (%+.4f %+.4f %+.4f)%s"
                 % (sensor, e.get("measured", "?")[:16], e["xyz"][0],
                    e["xyz"][1], e["xyz"][2],
                    "" if not s else "  1 sigma %.2f mm" % max(s[:3])))
        if not e.get("adequate", True):
            L.append("           UNDER-CONSTRAINED when it was solved -- do not "
                     "apply it")
        mc = e.get("mount_cal")
        if mc:
            L.append("           correction %s in %s, %.2f mm from what it "
                     "replaced" % (_cal_fmt_xyz(mc["xyz"]), mc["parent"],
                                   mc.get("move_mm", float("nan"))))
    if any((e.get("mount_cal") for e in doc.values())):
        L.append("  drop-in file: %s" % _cal_dropin_file())
        L.append("  RECORDED IS NOT DEPLOYED. check_calibration_applied() "
                 "reads TF and says whether the description in force carries "
                 "these numbers.")
    v = _CAL.get("verify")
    if v:
        L.append("  last verification: azure %+.2f mm off the keyence -- %s"
                 % (v["dz_mm"], "PASS" if v["pass"] else "FAIL"))
    return "\n".join(L)


def calibration_status():
    """Everything this module knows, printed. The first thing to call."""
    _cal_say("")
    _cal_say(describe_calibration_artifact())
    _cal_say("")
    _cal_say(describe_calibration())
    try:
        _cal_say("")
        _cal_say("  " + describe_cable_envelope().strip())
    except Exception:                                    # noqa: BLE001
        pass
    return _CAL.get("verify")
