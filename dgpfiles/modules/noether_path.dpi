# Scenario B: an existing mesh of the specimen goes in, a toolpath comes out.
#
# The plane scan builds its own raster from three taught points and needs none of
# this. Everything here exists for the other case -- a mesh already describes the
# surface, and the scan should follow it rather than a rectangle.
#
# Four pieces, each of which can be used on its own:
#
#   plan_noether_toolpath()  call principal_axis_noether_srv on a mesh file
#   scanpath_from_noether()  turn its PoseArray into a ScanPath, with the tool
#                            orientation made consistent and the specimen placed
#   mesh_uv_x3d()            parameterize an arbitrary mesh so it can be
#                            projected onto -- projection needs a UV map and a
#                            PLY has none
#   write_plate_ply()        synthesise a plate mesh, so the whole path can be
#                            exercised without depending on a particular
#                            specimen being present and positioned
#
# Deliberately kept out of the config: none of it is specific to UT, and the
# service call needs its own ROS node rather than the dgpy motion module's.

import math
import os
import subprocess
import sys
import tempfile
import threading

import numpy as np

# A .dpi is compiled as a function body, so anything the including config needs
# to see has to be declared global before it is assigned.
global plan_noether_toolpath
global scanpath_from_noether
global mesh_uv_x3d
global write_plate_ply
global quat_to_matrix
global matrix_to_quat
global orient_tool_away_from_surface
global cap_tool_tilt
global regularize_tool_roll
global orient_segments_along
global last_uv_report
global roll_reference_quat
global tool_twist_deg
global tool_tilt_deg
global tool_roll_report
global locked_quats_from_axes
global smooth_tool_axis
global resample_segments
global read_ply_mesh
global clean_mesh_for_planning
# Used across files (mesh_scan.dpi's axis-sanity repair recomputes the number
# plan_mesh_path() prints), so it has to be declared here or it is file-local and
# silently invisible at runtime. dpi_exports_test.py is what catches that.
global _worst_orientation_step
global NOETHER_SERVICE
global last_roll_report
global PATH_ROLL_MIN_ARC_M
global PATH_ROLL_MIN_STEP_M
global MeshNotPlannable
global RoiDoesNotFitMesh
global crop_mesh_to_roi
global last_roi_crop_report
global mesh_plan_report
global mesh_plannable
global require_plannable_mesh
global describe_mesh_plan_report
global mesh_plan_requirements
global describe_mesh_plan_requirements
global last_mesh_plan_report
global GATE_MAX_MEDIAN_EDGE_M
global GATE_MAX_TILT_AREA_FRACTION
global GATE_REFUSE_TILT_AREA_FRACTION
global GATE_MIN_WAYPOINTS_PER_PASS
global GATE_MAX_NORMAL_TURN_DEG
global GATE_MAX_PASS_FRAGMENTATION
global GATE_MIN_REGION_COVERAGE
global GATE_MIN_ROI_FACES
global GATE_ROI_MIN_MESH_OVERLAP
global GATE_ROI_CROP_MARGIN_M
global GATE_CROP_TO_ROI
global GATE_MAX_MESH_OUTSIDE_REGION
global noether_pass_axis
global noether_principal_axes
global noether_cut_axes


NOETHER_SERVICE = "principal_axis_noether"

#: How much arc length a travel direction is fitted over, metres. See
#: _local_travel_directions(): Noether puts a waypoint wherever a slicing plane
#: crosses a mesh EDGE, so consecutive waypoints are routinely microns apart and
#: the direction from one to the next is noise. 5 mm is 1.7% of a 0.30 m pass --
#: far below the scale on which a real part's surface turns, and far above the
#: edge-crossing jitter (steps on a reconstructed mesh run from 0.00001 to
#: 3.1 mm).
PATH_ROLL_MIN_ARC_M = 0.005

#: Below this, two waypoints are the same point and the step between them is
#: never used as a direction. A metre-scale path in float32 (which is what comes
#: back over the wire) resolves about 1e-7 m, so this is at the noise floor.
PATH_ROLL_MIN_STEP_M = 1e-6

#: What the last regularize_tool_roll() did: {"mode", "min_arc_m",
#: "short_steps", "fallback_waypoints", "worst_step_deg"}. Kept as a global
#: rather than returned so the (quats, worst) signature every caller uses is
#: unchanged.
last_roll_report = None

# What the last mesh_uv_x3d() said about the layout it wrote. "rejected" is its
# own verdict that x3d_load_geometry will refuse the file -- which, in a live
# scan, happens when the projector is built at the first trace, and can take
# the whole dgpy process down with it (reconstructing-a-specimen skill).
last_uv_report = None


global quat_mul
def quat_mul(a, b):
    """Quaternion product, both (x, y, z, w)."""
    ax, ay, az, aw = a
    bx, by, bz, bw = b
    return (aw*bx + ax*bw + ay*bz - az*by,
            aw*by - ax*bz + ay*bw + az*bx,
            aw*bz + ax*by - ay*bx + az*bw,
            aw*bw - ax*bx - ay*by - az*bz)


def quat_to_matrix(q):
    """Rotation matrix from an (x, y, z, w) quaternion. Columns are the axes."""
    x, y, z, w = q
    n = np.sqrt(x*x + y*y + z*z + w*w)
    if n == 0.0:
        return np.eye(3)
    x, y, z, w = x/n, y/n, z/n, w/n
    return np.array([
        [1-2*(y*y+z*z), 2*(x*y-z*w),   2*(x*z+y*w)],
        [2*(x*y+z*w),   1-2*(x*x+z*z), 2*(y*z-x*w)],
        [2*(x*z-y*w),   2*(y*z+x*w),   1-2*(x*x+y*y)]], dtype=np.float64)


def matrix_to_quat(R):
    """(x, y, z, w) from a rotation matrix, via the largest-diagonal branch."""
    R = np.asarray(R, dtype=np.float64)
    tr = R[0, 0] + R[1, 1] + R[2, 2]
    if tr > 0.0:
        s = np.sqrt(tr + 1.0)*2.0
        w = 0.25*s
        x = (R[2, 1] - R[1, 2])/s
        y = (R[0, 2] - R[2, 0])/s
        z = (R[1, 0] - R[0, 1])/s
    elif R[0, 0] > R[1, 1] and R[0, 0] > R[2, 2]:
        s = np.sqrt(1.0 + R[0, 0] - R[1, 1] - R[2, 2])*2.0
        w = (R[2, 1] - R[1, 2])/s
        x = 0.25*s
        y = (R[0, 1] + R[1, 0])/s
        z = (R[0, 2] + R[2, 0])/s
    elif R[1, 1] > R[2, 2]:
        s = np.sqrt(1.0 + R[1, 1] - R[0, 0] - R[2, 2])*2.0
        w = (R[0, 2] - R[2, 0])/s
        x = (R[0, 1] + R[1, 0])/s
        y = 0.25*s
        z = (R[1, 2] + R[2, 1])/s
    else:
        s = np.sqrt(1.0 + R[2, 2] - R[0, 0] - R[1, 1])*2.0
        w = (R[1, 0] - R[0, 1])/s
        x = (R[0, 2] + R[2, 0])/s
        y = (R[1, 2] + R[2, 1])/s
        z = 0.25*s
    q = np.array([x, y, z, w], dtype=np.float64)
    return q/np.linalg.norm(q)


global _local_travel_directions
def _local_travel_directions(pos, min_arc, min_step):
    """Direction of travel at each point of ONE pass, fitted over `min_arc`.

    WHY NOT positions[i+1] - positions[i], WHICH IS WHAT NOETHER ITSELF USES.
    plane_slicer_raster_planner.cpp's createTransform() takes the tool x from
    the direction to the next point, and the planner emits a waypoint wherever
    a slicing plane crosses a mesh EDGE -- so two consecutive waypoints are
    routinely microns apart, and on a reconstructed mesh they can be at the
    same point to float32. The step between them is then not a direction, it is
    the mesh's triangulation noise, and it is perpendicular to travel as often
    as not. That is the 90 degree sawtooth this module's header measures: a
    commanded roll of exactly 90 degrees and back, several times inside one
    straight 0.30 m pass whose normal never changes.

    So take the chord across a WINDOW of at least `min_arc` of arc length that
    contains the point -- centred where the pass allows it, one-sided at the
    ends, the whole pass when the pass is shorter than the window. A chord over
    5 mm cannot be turned 90 degrees by a 1 micron edge crossing, and on a real
    surface it still tracks the pass: the window is far shorter than the scale
    on which a scanned part's surface direction changes.

    Steps shorter than `min_step` are counted and reported but not removed --
    removing them would change the positions, and where the probe goes is the
    mesh's business, not the roll's. They simply stop contributing a direction.

    Returns (directions N x 3, short_steps).
    """
    pos = np.asarray(pos, dtype=np.float64).reshape(-1, 3)
    n = pos.shape[0]
    if n < 2:
        return np.zeros((n, 3)), 0
    d = np.linalg.norm(np.diff(pos, axis=0), axis=1)
    s = np.concatenate([[0.0], np.cumsum(d)])
    short = int((d < float(min_step)).sum())
    arc = float(min_arc)
    i = np.arange(n)
    if arc <= 0.0 or s[-1] <= 0.0:
        t = np.zeros((n, 3))
        t[:-1] = np.diff(pos, axis=0)
        t[-1] = t[-2] if n > 1 else 0.0
        return t, short
    # Centre the window, then push its far end out until it spans the arc, then
    # pull its near end back for the same reason. Either clamp lands on the end
    # of the pass, so a pass shorter than the window gets one direction.
    lo = np.minimum(np.searchsorted(s, s - 0.5*arc, side="left"), i)
    hi = np.maximum(np.clip(np.searchsorted(s, s[lo] + arc, side="left"),
                            0, n - 1), i)
    lo = np.minimum(np.clip(np.searchsorted(s, s[hi] - arc, side="right") - 1,
                            0, n - 1), i)
    return pos[hi] - pos[lo], short


def regularize_tool_roll(positions, quats, segments=None, mode="fixed",
                         reference=(1.0, 0.0, 0.0), min_arc=None,
                         min_step=None):
    """Choose the roll about the tool axis rather than inheriting the planner's.

    THIS IS NOT COSMETIC. Noether builds each pose with z along the surface
    normal and x along the raster direction, and on some lines it emits x and y
    SWAPPED for a run of waypoints -- a commanded roll of exactly 90 degrees,
    then exactly 90 back, several times within one straight 0.30 m pass whose
    surface normal never changes. The arm executes it faithfully: on one such
    pass wrist_3 travelled 557 degrees to accomplish a move that needed 20, in a
    sawtooth of three full out-and-back cycles. It affects a minority of passes
    at a time -- on a flat plate, 9 of 29, the other 20 having exactly 0.0
    degrees of within-pass orientation variation -- and it multiplies the
    trajectory-state count and the time those passes take by about four.

    orient_tool_away_from_surface() cannot catch this. It corrects the SIGN of
    the tool z axis; a 90 degree roll about z leaves z untouched.

    The fix is to stop inheriting the roll at all, because for this measurement
    it carries no information: a UT transducer is rotationally symmetric about
    its own axis, so the roll is free for us to choose. Choosing it well is worth
    real time and real wrist travel.

      "fixed"    (default) roll from a fixed world reference. The tool z still
                 follows the surface; the roll then changes only as much as the
                 normal forces it to, which is the least wrist motion available
                 and has no discontinuities anywhere -- including at the
                 serpentine turns, where a travel-aligned frame would flip 180.
      "path"     x along the direction of travel, computed from the positions
                 rather than trusted from the planner. This is what Noether
                 intends; use it when the tool is NOT symmetric and its
                 orientation relative to the scan direction matters. The
                 direction is a chord over at least `min_arc` of arc length
                 (_local_travel_directions()), NOT the step to the next
                 waypoint -- that step is what produces the 90 degree sawtooth
                 described above, and taking it from the planner or
                 recomputing it from the positions makes no difference because
                 both are the same degenerate step. The sign is kept
                 continuous, so a serpentine turn does not hand back a 180
                 degree roll flip at every row boundary.
      "planner"  keep whatever came back. The old behaviour, kept so the fault
                 above can be reproduced.
      "locked"   the tool never turns about its own axis. Every pose is ONE
                 reference orientation -- tool z up, tool x along `reference` --
                 tilted about a HORIZONTAL axis, by the smallest angle that puts
                 tool z on the surface normal. No twist anywhere, by
                 construction, so the roll a technician sees is the roll the
                 reference names. This is the eddy-current mode, and it is a
                 requirement rather than an optimisation: the contact probe's
                 rotation is held fixed for the whole scan, which simplifies
                 planning and keeps the Azure and Keyence cables from wrapping.

    WHY "fixed" IS NOT LOCKED. It projects the reference onto each pose's
    plane. When the surface tilts along the reference or across it -- a flat
    plate, or a cylinder lying along the reference -- that is exactly the
    locked pose. When it tilts diagonally it is not, and it turns the tool
    about its own axis as the normal moves. Measured with tool_twist_deg(), a
    tilt toward 45 degrees off the reference twists it 0.4 degrees at 10
    degrees of tilt, 4.1 at 30, 9.7 at 45, 18.4 at 60 and 35.1 at 80
    (noether_roll_test.py). And within about 8 degrees of the reference
    direction -- the +x end cap of a cylinder lying along x -- the projection
    is undefined: "fixed" falls back to another axis and takes the sign from
    the previous waypoint, so the roll there depends on waypoint ORDER. A path
    that begins there is a half-turn out, and stays out. On a reconstructed
    mesh the normals are noisy in every direction, so "fixed" twists by the
    noise.

    Returns (quats, max_roll_change_deg) so the caller can report what it did.
    """
    global last_roll_report
    positions = np.asarray(positions, dtype=np.float64).reshape(-1, 3)
    quats = np.asarray(quats, dtype=np.float64).reshape(-1, 4)
    min_arc = PATH_ROLL_MIN_ARC_M if min_arc is None else float(min_arc)
    min_step = PATH_ROLL_MIN_STEP_M if min_step is None else float(min_step)
    last_roll_report = {"mode": mode, "min_arc_m": min_arc, "short_steps": 0,
                        "fallback_waypoints": 0, "worst_step_deg": 0.0}
    if mode == "planner":
        return quats.copy(), 0.0
    if mode not in ("fixed", "path", "locked"):
        raise ValueError("mode must be 'fixed', 'path', 'locked' or 'planner', "
                         "not %r" % (mode,))

    if mode == "locked":
        q_ref = np.asarray(roll_reference_quat(reference), dtype=np.float64)
        z_ref = quat_to_matrix(q_ref)[:, 2]
        out = np.empty_like(quats)
        for i in range(quats.shape[0]):
            z = quat_to_matrix(quats[i])[:, 2]
            nz = np.linalg.norm(z)
            if nz == 0.0:
                out[i] = q_ref
                continue
            z = z/nz
            c = float(np.dot(z_ref, z))
            if c < -0.999999:
                # Tool axis pointing straight back along the reference's: the
                # tilt has no unique axis. orient_tool_away_from_surface() has
                # already made every tool z point up, so this is a mesh normal
                # pointing into the floor -- refuse rather than pick one.
                raise ValueError(
                    "pose %d points its tool axis opposite the reference's %s; "
                    "a locked roll is undefined there" % (i, tuple(z_ref)))
            # Shortest rotation taking z_ref onto z: axis z_ref x z, and the
            # half-angle quaternion (z_ref x z, 1 + z_ref.z), normalised.
            axis = np.cross(z_ref, z)
            qs = np.array([axis[0], axis[1], axis[2], 1.0 + c])
            qs = qs/np.linalg.norm(qs)
            out[i] = quat_mul(tuple(qs), tuple(q_ref))
        worst = _worst_orientation_step(out)
        last_roll_report["worst_step_deg"] = worst
        return out, worst

    n = quats.shape[0]
    # A reference is a DIRECTION (3 numbers) or an ORIENTATION (4), the same as
    # it is everywhere else here: "locked" has always taken both and
    # tool_roll_report() measures against both, and a caller that has an
    # orientation -- mesh_reconstruction.dpi's Keyence stage derives one from
    # the raster's own travel direction -- should not have to take it apart
    # first. What "fixed" and "path" want out of it is the world direction tool
    # x should follow, which is that orientation's own x axis.
    ref = np.asarray(reference, dtype=np.float64).reshape(-1)
    if ref.size == 4:
        ref = quat_to_matrix(ref/np.linalg.norm(ref))[:, 0]
    elif ref.size != 3:
        raise ValueError("a roll reference is a direction (3 numbers) or a "
                         "quaternion (4), not %r" % (reference,))
    ref = ref/np.linalg.norm(ref)

    # Tangents, per segment so a segment boundary never contributes a direction,
    # and within a segment over a minimum arc length so a pair of waypoints a
    # micron apart never contributes one either. See _local_travel_directions().
    tangent = np.zeros((n, 3))
    if mode == "path":
        bounds = list(segments) if segments else [(0, n)]
        for a, b in bounds:
            if b - a < 2:
                continue
            tangent[a:b], short = _local_travel_directions(positions[a:b],
                                                           min_arc, min_step)
            last_roll_report["short_steps"] += short

    out = np.empty_like(quats)
    prev_x = None
    fallbacks = 0
    for i in range(n):
        z = quat_to_matrix(quats[i])[:, 2]
        nz = np.linalg.norm(z)
        if nz == 0.0:
            out[i] = quats[i]
            continue
        z = z/nz

        if mode == "path":
            cand = tangent[i]
            # A direction that is gone (a pass of one waypoint) or that lies
            # along the tool axis leaves the roll undefined, and the ONE thing
            # not to do there is keep the planner's own orientation: that is
            # exactly the arbitrary 90 degree roll this function exists to
            # remove. Carry the previous waypoint's x instead, which is what
            # "the tool did not turn" means, and fall back to the reference
            # only at the very start of a path.
            if np.linalg.norm(cand) < min_step \
                    or abs(float(np.dot(cand/max(np.linalg.norm(cand), 1e-300),
                                        z))) > 0.99:
                cand = prev_x if prev_x is not None else ref
                fallbacks += 1
        else:
            cand = ref
            # A reference parallel to the tool axis leaves the roll undefined.
            # Only happens on a near-vertical surface with the default +x.
            if abs(float(np.dot(cand, z))) > 0.99:
                cand = np.array([0.0, 0.0, 1.0]) if abs(z[2]) < 0.9 \
                    else np.array([0.0, 1.0, 0.0])

        x = cand - float(np.dot(cand, z))*z
        nx = np.linalg.norm(x)
        if nx < 1e-9:
            x = prev_x
            if x is None:
                out[i] = quats[i]
                continue
            fallbacks += 1
        else:
            x = x/nx
        # Keep the sign continuous, so a direction that reverses at a
        # serpentine turn does not hand back a 180 degree roll. THIS APPLIES TO
        # "path" AS WELL AS TO "fixed", and "path" is the mode that needs it:
        # Noether snakes, so the travel direction reverses at every row
        # boundary, and without this every turn flips the tool 180 degrees about
        # its own axis. "fixed" takes its x from a CONSTANT reference and so
        # only rarely reverses at all, which is why gating this to "fixed" looks
        # harmless and is not.
        if prev_x is not None and float(np.dot(x, prev_x)) < 0.0:
            x = -x
        y = np.cross(z, x)
        out[i] = matrix_to_quat(np.column_stack([x, y, z]))
        prev_x = x

    # Report the worst roll change between neighbours, which is the number the
    # arm pays for.
    worst = 0.0
    for i in range(1, n):
        Ra = quat_to_matrix(out[i-1])
        Rb = quat_to_matrix(out[i])
        c = (np.trace(Ra.T @ Rb) - 1.0)/2.0
        worst = max(worst, float(np.degrees(np.arccos(np.clip(c, -1.0, 1.0)))))
    last_roll_report["fallback_waypoints"] = fallbacks
    last_roll_report["worst_step_deg"] = worst
    return out, worst


def _unit_quats(quats):
    q = np.asarray(quats, dtype=np.float64).reshape(-1, 4)
    n = np.linalg.norm(q, axis=1, keepdims=True)
    n[n == 0.0] = 1.0
    return q/n


def _worst_orientation_step(quats):
    """Largest orientation change between consecutive waypoints, degrees."""
    q = _unit_quats(quats)
    if q.shape[0] < 2:
        return 0.0
    d = np.abs(np.einsum("ij,ij->i", q[:-1], q[1:]))
    return float(np.degrees(2.0*np.arccos(np.clip(d, 0.0, 1.0))).max())


def roll_reference_quat(reference=(1.0, 0.0, 0.0), up=(0.0, 0.0, 1.0)):
    """The orientation a roll reference names, as (x, y, z, w).

    `reference` is either a quaternion (four numbers), used as it is, or a
    direction (three): the way tool x points when the tool axis is `up` --
    world +z for a probe looking down at a part on a table. (1, 0, 0) is "tool
    x along world x", which is close to how this arm holds its tooling over
    the bench: plan_mesh_path() poses have come back near identity.
    """
    ref = np.asarray(reference, dtype=np.float64).reshape(-1)
    if ref.size == 4:
        return tuple(ref/np.linalg.norm(ref))
    if ref.size != 3:
        raise ValueError("a roll reference is a direction (3 numbers) or a "
                         "quaternion (4), not %r" % (reference,))
    z = np.asarray(up, dtype=np.float64)
    z = z/np.linalg.norm(z)
    x = ref - float(np.dot(ref, z))*z
    if np.linalg.norm(x) < 1e-9:
        raise ValueError("roll reference %r is parallel to up %r" % (reference, up))
    x = x/np.linalg.norm(x)
    y = np.cross(z, x)
    return tuple(matrix_to_quat(np.column_stack([x, y, z])))


def tool_twist_deg(quats, reference=(1.0, 0.0, 0.0)):
    """Rotation of each pose about the tool's OWN axis, against `reference`.

    The swing-twist split of each pose relative to the reference orientation:
    any orientation is "turn the tool about its own axis by psi, then tilt it
    about a horizontal axis", and this returns psi in degrees, in [-180, 180).
    A "locked" path is 0 everywhere. This is the number that says whether the
    probe -- and the cables on the tooling -- turned; how far it leaned is
    tool_tilt_deg().
    """
    q = _unit_quats(quats)
    ax, ay, az, aw = roll_reference_quat(reference)
    ax, ay, az = -ax, -ay, -az                    # the reference's inverse
    bx, by, bz, bw = q[:, 0], q[:, 1], q[:, 2], q[:, 3]
    rz = aw*bz + ax*by - ay*bx + az*bw            # (ref^-1 * q).z
    rw = aw*bw - ax*bx - ay*by - az*bz            # (ref^-1 * q).w
    psi = 2.0*np.arctan2(rz, rw)
    psi = (psi + np.pi) % (2.0*np.pi) - np.pi
    return np.degrees(psi)


def tool_tilt_deg(quats, up=(0.0, 0.0, 1.0)):
    """Angle between each pose's tool axis and `up`, degrees."""
    q = _unit_quats(quats)
    x, y, z, w = q[:, 0], q[:, 1], q[:, 2], q[:, 3]
    tz = np.stack([2.0*(x*z + y*w), 2.0*(y*z - x*w), 1.0 - 2.0*(x*x + y*y)], axis=1)
    u = np.asarray(up, dtype=np.float64)
    u = u/np.linalg.norm(u)
    return np.degrees(np.arccos(np.clip(tz.dot(u), -1.0, 1.0)))


def tool_roll_report(quats, segments=None, reference=(1.0, 0.0, 0.0),
                     up=(0.0, 0.0, 1.0)):
    """How far a path turns the tool about its own axis, and how far it tilts.

    twist_range_deg      spread of the roll over the whole path
    twist_in_pass_deg    the largest spread inside one segment -- what the
                         wrist does DURING a pass
    twist_step_deg       the largest roll change between neighbours
    tilt_max_deg         the most the tool axis leans from `up`
    orientation_step_deg the largest total orientation change between
                         neighbours inside a segment, tilt included

    Measured against the same reference a "locked" path is built from, so a
    locked path reads 0 and anything else reads what it would cost.
    """
    q = _unit_quats(quats)
    n = q.shape[0]
    if n == 0:
        return {"poses": 0, "twist_range_deg": 0.0, "twist_in_pass_deg": 0.0,
                "twist_step_deg": 0.0, "twist_min_deg": 0.0, "twist_max_deg": 0.0,
                "tilt_max_deg": 0.0, "tilt_mean_deg": 0.0,
                "orientation_step_deg": 0.0}
    tw = np.radians(tool_twist_deg(q, reference))
    tilt = tool_tilt_deg(q, up)
    segs = [(int(a), int(b)) for a, b in (segments or [(0, n)]) if b > a]
    in_pass = 0.0
    step = 0.0
    ostep = 0.0
    for a, b in segs:
        u = np.unwrap(tw[a:b])
        in_pass = max(in_pass, float(u.max() - u.min()))
        if b - a > 1:
            step = max(step, float(np.abs(np.diff(u)).max()))
            ostep = max(ostep, _worst_orientation_step(q[a:b]))
    # Centre on the circular mean, so a path sitting near +-180 does not read
    # as a 360 degree spread.
    c = float(np.angle(np.mean(np.exp(1j*tw))))
    rel = (tw - c + np.pi) % (2.0*np.pi) - np.pi
    return {"poses": n,
            "twist_min_deg": float(np.degrees(c + rel.min())),
            "twist_max_deg": float(np.degrees(c + rel.max())),
            "twist_range_deg": float(np.degrees(rel.max() - rel.min())),
            "twist_in_pass_deg": float(np.degrees(in_pass)),
            "twist_step_deg": float(np.degrees(step)),
            "tilt_max_deg": float(tilt.max()),
            "tilt_mean_deg": float(tilt.mean()),
            "orientation_step_deg": float(ostep)}


# ------------------------------------------------------------------------------
# THE PROBE'S OWN ROTATION, SET BY THE OPERATOR AND HELD FOR THE WHOLE SCAN
# ------------------------------------------------------------------------------
# WHY THERE IS A SETTING AT ALL. A split-D differential coil is DIRECTIONAL: it
# responds to a crack perpendicular to its split and is nearly blind to one
# parallel to it. So which way the probe is turned about its own axis is a
# measurement parameter, not a free choice the planner may make -- and the
# planner was making it, because Noether takes the tool x from the raster's
# direction of travel (see regularize_tool_roll()).
#
# WHAT ZERO MEANS, and it is stated here once because every other file points at
# this comment: at a rotation of ZERO the probe's split lies along the roll
# reference direction in the PART's frame -- NOETHER_ROLL_REFERENCE, which is
# world +x in this cell -- with the probe axis vertical. A POSITIVE rotation
# turns the split anticlockwise about the probe's own axis seen from outside the
# part (the right-hand rule about tool +z, which points away from the surface).
# The rotation is in DEGREES and it is the same number in the part frame at every
# waypoint of every pass.
#
# HOW IT IS HELD CONSTANT, by construction rather than by checking afterwards.
# The "locked" roll builds every pose as ONE reference orientation swung onto the
# surface normal by the smallest rotation about a horizontal axis. A swing adds
# no rotation about the tool's own axis, so if the rotation is baked into that
# ONE reference orientation, every pose carries exactly it -- every pass, both
# serpentine directions, every waypoint. The direction of travel never enters,
# because nothing in the construction reads it.
#
# AND WHY IT HAS TO BE CHECKED BEFORE THE ARM MOVES. The rotation lands on wrist
# 3 one degree for one degree, and wrist 3 is the joint the cable envelope
# bounds. Nothing here may resolve a refusal by adding or subtracting 360: the
# cables physically wrap, so -6 deg and +354 deg are the same tool orientation
# and entirely different cable states, and the ABSOLUTE angle governs.

global probe_rotation_reference
def probe_rotation_reference(degrees, reference=(1.0, 0.0, 0.0),
                             up=(0.0, 0.0, 1.0)):
    """The roll reference with the probe turned `degrees` about its own axis.

    -> a reference ORIENTATION as (x, y, z, w), which is what every roll-aware
    function here already accepts in place of a direction. Hand it to
    scanpath_from_noether(roll_reference=), regularize_tool_roll(),
    locked_quats_from_axes() or smooth_tool_axis() and the rotation is in the
    pose construction rather than applied to it afterwards.

    Right-multiplied, because the turn is about the TOOL's own z and not about
    the world's: q = q_datum * Rz(degrees).
    """
    q0 = roll_reference_quat(reference, up=up)
    half = math.radians(float(degrees))*0.5
    return tuple(quat_mul(q0, (0.0, 0.0, math.sin(half), math.cos(half))))


global probe_rotation_of
def probe_rotation_of(quats, reference=(1.0, 0.0, 0.0), up=(0.0, 0.0, 1.0)):
    """How far each pose turns the probe about its own axis from the zero datum.

    Degrees, in [-180, 180). This is tool_twist_deg() named for what it means
    here: on a correctly built path it is the SET rotation at every waypoint, and
    its spread is the evidence that travel direction did not leak into it.
    """
    return tool_twist_deg(quats, reference=roll_reference_quat(reference, up=up))


global probe_rotation_wrist3_deg
def probe_rotation_wrist3_deg(degrees, datum_deg):
    """The absolute wrist_3 angle a probe rotation implies, in degrees.

    `datum_deg` is the wrist_3 angle the arm holds at the ZERO datum with the
    probe axis vertical -- a measured per-cell number, because it depends on how
    the tooling is bolted on. The relation is exact and additive: rotating the
    tool about its own axis IS wrist 3, one degree for one degree.

    NOT REDUCED INTO ANY RANGE. That is the whole point: see check_probe_rotation().
    """
    return float(datum_deg) + float(degrees)


global _tilt_coordinates
def _tilt_coordinates(quats, home_quat=(0.0, 0.0, 0.0, 1.0)):
    """(tx_deg, ty_deg) per pose, in the plane the cable envelope was measured in.

    wrist3_tilt_of() for a whole array: the minimal rotation carrying the home
    tool axis onto each pose's, as x and y components in degrees. Vectorised here
    because a real toolpath has hundreds of thousands of poses and that function
    takes one at a time.
    """
    q = _unit_quats(quats)
    x, y, z, w = q[:, 0], q[:, 1], q[:, 2], q[:, 3]
    a = np.stack([2.0*(x*z + y*w), 2.0*(y*z - x*w), 1.0 - 2.0*(x*x + y*y)],
                 axis=1)
    a0 = quat_to_matrix(np.asarray(home_quat, dtype=np.float64))[:, 2]
    a0 = a0/max(float(np.linalg.norm(a0)), 1e-300)
    axis = np.cross(np.broadcast_to(a0, a.shape), a)
    s = np.linalg.norm(axis, axis=1)
    c = np.clip(a.dot(a0), -1.0, 1.0)
    angle = np.arctan2(s, c)
    scale = np.where(s > 1e-12, angle/np.maximum(s, 1e-300), 0.0)
    v = axis*scale[:, None]
    # Anti-parallel: the tool is upside down, a 180 degree tilt with no direction,
    # and outside any measured hull. Reported as such rather than as no tilt.
    flip = (s <= 1e-12) & (c < 0.0)
    tx = np.degrees(v[:, 0])
    ty = np.degrees(v[:, 1])
    tx = np.where(flip, 180.0, tx)
    ty = np.where(flip, 0.0, ty)
    return tx, ty


global check_probe_rotation
def check_probe_rotation(degrees, path=None, datum_deg=None,
                         reference=(1.0, 0.0, 0.0), up=(0.0, 0.0, 1.0),
                         margin_deg=None, per_pass=True, what="probe rotation",
                         verbose=True, indent="  "):
    """Refuse a probe rotation the cables cannot hold, BEFORE anything moves.

    -> a report dict. Raises (CableRefused where cable_envelope.dpi is loaded,
    RuntimeError otherwise) naming the rotation, the wrist_3 angle it implies and
    the band that was allowed.

    With a `path`, the band is taken at the tilt of EACH pose rather than at a
    single worst case, because the band the cables allow depends on how far the
    tool is leaned -- so a rotation can be fine over one end of a part and
    refused over the other. The passes that are outside are named.

    NEVER RESOLVED BY +/-360. The cables wrap: -6.3 deg and +353.7 deg are one
    tool orientation and two cable states, and the absolute angle is the one that
    matters. A refusal here means choosing a different rotation or re-measuring
    the envelope, not turning the wrist the other way round to the same place.
    """
    band_fn = globals().get("wrist3_band_deg")
    refuse = globals().get("CableRefused") or RuntimeError
    #: Where the datum came from, so a report can say whether it was measured.
    datum_from = "the caller"
    if datum_deg is None:
        # THE MEASUREMENT FIRST, THE CONFIG SECOND. The envelope capture records
        # the wrist_3 angle at the reference orientation in the same joint state
        # it measures the band from, so the two belong together and the measured
        # pair is self-consistent. A constant in a config is the same number
        # transcribed by hand, and it goes stale the moment the tooling is
        # unbolted -- silently, because it still looks like a measurement.
        datum_fn = globals().get("wrist3_datum_deg")
        if callable(datum_fn):
            try:
                datum_deg = datum_fn(tilt=(0.0, 0.0))
            except Exception:                                     # noqa: BLE001
                datum_deg = None
            if datum_deg is not None:
                datum_from = "the measured cable envelope"
    if datum_deg is None:
        datum_deg = globals().get("EC_PROBE_ROTATION_WRIST3_DEG")
        if datum_deg is not None:
            datum_from = "EC_PROBE_ROTATION_WRIST3_DEG in the config"
    rep = {"rotation_deg": float(degrees), "datum_deg": datum_deg,
           "datum_from": datum_from,
           "checked": False, "wrist3_deg": None, "band_deg": None,
           "passes_outside": [], "poses": 0}
    if datum_deg is None or not callable(band_fn):
        rep["why"] = ("no measured cable envelope for this cell"
                      if callable(band_fn) else
                      "cable_envelope.dpi is not loaded")
        if datum_deg is None:
            rep["why"] = ("EC_PROBE_ROTATION_WRIST3_DEG is not set: the wrist_3 "
                          "angle at the zero datum is a measured property of how "
                          "the tooling is bolted on")
        if verbose:
            print("%s%s: %+.1f deg is UNCHECKED against the cables (%s). Measure "
                  "the envelope before scanning."
                  % (indent, what, float(degrees), rep["why"]))
        return rep

    w3 = probe_rotation_wrist3_deg(degrees, datum_deg)
    rep["wrist3_deg"] = w3
    rep["checked"] = True

    # The untilted band first: it is the one every pose has to pass whatever the
    # surface does, and it is the one the operator can act on.
    try:
        lo, hi = band_fn(tilt=(0.0, 0.0), margin_deg=margin_deg)
    except Exception as e:                                        # noqa: BLE001
        rep["checked"] = False
        rep["why"] = str(e).splitlines()[0][:120]
        if verbose:
            print("%s%s: %+.1f deg is UNCHECKED against the cables (%s)."
                  % (indent, what, float(degrees), rep["why"]))
        return rep
    rep["band_deg"] = (lo, hi)
    if w3 < lo - 1e-9 or w3 > hi + 1e-9:
        raise refuse(
            "a %s of %+.1f deg puts wrist 3 at %+.1f deg, and the cables allow "
            "%+.1f..%+.1f deg with the probe held vertical. Nothing has moved.\n"
            "  The rotation lands on wrist 3 one degree for one degree from the "
            "zero datum (%+.1f deg, from %s), so the rotations this cell can hold "
            "at no tilt are %+.1f..%+.1f deg.\n"
            "  This is an ABSOLUTE joint angle. Turning the other way round to "
            "the same probe orientation is a different cable state and is NOT a "
            "fix: do not add or subtract 360."
            % (what, float(degrees), w3, lo, hi, float(datum_deg), datum_from,
               lo - float(datum_deg), hi - float(datum_deg)))

    if path is not None and per_pass:
        # Per pose, at the tilt each pose actually asks for. A pass whose band is
        # tighter than the untilted one is named rather than being hidden behind
        # an average.
        #
        # ONE BAND LOOKUP PER DISTINCT TILT, not per waypoint: the band is a
        # function of the tilt alone, and a real path has hundreds of thousands
        # of waypoints over a few dozen tilts once they are taken to the nearest
        # degree. The rounding is OUTWARD, away from no tilt, so a pose is never
        # graded against a band measured closer to vertical than it is.
        home = getattr(globals().get("cable_envelope_model", lambda: None)(),
                       "home_quat", (0.0, 0.0, 0.0, 1.0)) or (0.0, 0.0, 0.0, 1.0)
        tx, ty = _tilt_coordinates(path.quats, home)
        key = np.column_stack([np.sign(tx)*np.ceil(np.abs(tx)),
                               np.sign(ty)*np.ceil(np.abs(ty))])
        uniq, inv = np.unique(key, axis=0, return_inverse=True)
        inv = np.asarray(inv).ravel()
        # THE DATUM MOVES WITH THE TILT TOO, when it was measured. Reaching a tilt
        # turns the wrist on the way, so the wrist_3 angle at zero rotation is not
        # the untilted one -- across this cell's five samples it runs 147 to 179
        # deg. Both ends of the comparison therefore have to be taken at the same
        # tilt: the band AND the angle the rotation implies. Using the untilted
        # datum against a tilted band compares two different places.
        #
        # With no measured datum this falls back to the single `w3` above at every
        # tilt, which is what it did before the measurement was carried through.
        datum_fn = globals().get("wrist3_datum_deg")
        bands = {}
        w3_at = {}
        for j, (ux, uy) in enumerate(uniq):
            tilt = (float(ux), float(uy))
            try:
                bands[j] = band_fn(tilt=tilt, margin_deg=margin_deg)
            except Exception:
                # A tilt outside the measured hull is not a band, and it is the
                # tilt cap's business rather than the rotation's.
                bands[j] = None
            w3_at[j] = w3
            if callable(datum_fn):
                try:
                    d = datum_fn(tilt=tilt)
                except Exception:                                 # noqa: BLE001
                    d = None
                if d is not None:
                    w3_at[j] = probe_rotation_wrist3_deg(degrees, d)
        rep["poses"] = int(len(inv))
        outside = []
        for si, (a, b) in enumerate(path.segments):
            if b <= a:
                continue
            worst = None
            for j in np.unique(inv[a:b]):
                band = bands[int(j)]
                if band is None:
                    continue
                plo, phi = band
                w3_here = w3_at[int(j)]
                if w3_here < plo - 1e-9 or w3_here > phi + 1e-9:
                    i = int(a + np.flatnonzero(inv[a:b] == j)[0])
                    if worst is None or (phi - plo) < (worst[2] - worst[1]):
                        worst = (i, plo, phi, w3_here)
            if worst is not None:
                outside.append({"segment": si, "waypoint": worst[0],
                                "lo_deg": worst[1], "hi_deg": worst[2],
                                "wrist3_deg": worst[3]})
        rep["passes_outside"] = outside
        if outside:
            raise refuse(
                "a %s of %+.1f deg puts wrist 3 at %+.1f deg, which is inside the "
                "untilted band %+.1f..%+.1f deg but OUTSIDE the band at the tilt "
                "%d of the %d pass(es) need. Nothing has moved.\n"
                "  The first is pass %d at waypoint %d, where the cables allow "
                "%+.1f..%+.1f deg. The band tightens as the tool leans, so this "
                "rotation is holdable over part of the specimen and not over the "
                "rest: choose a rotation inside every pass's band, shrink the "
                "scan area to the part that can hold this one, or measure the "
                "envelope at the tilts this path needs.\n"
                "  Do not add or subtract 360 to get inside a band."
                % (what, float(degrees), w3, lo, hi, len(outside),
                   len(path.segments), outside[0]["segment"],
                   outside[0]["waypoint"], outside[0]["lo_deg"],
                   outside[0]["hi_deg"]))
    if verbose:
        print("%s%s: %+.1f deg puts wrist 3 at %+.1f deg, inside the measured "
              "%+.1f..%+.1f deg%s"
              % (indent, what, float(degrees), w3, lo, hi,
                 " at every pose of every pass" if rep["poses"]
                 else " with the probe vertical"))
    return rep


def orient_tool_away_from_surface(quats, up=(0.0, 0.0, 1.0)):
    """Make every tool z axis point away from the specimen, not into it.

    Two independent things want this, and they want the same thing:

      * the projector. raytrace_sensor_evaluate_zdist puts the sensor at the
        origin of its own frame looking in the MINUS z direction, so a probe
        above a part has its frame z pointing UP: splatting with z up hits the
        surface from above and misses from below, z down does the reverse.
      * the arm. probe_end is mounted the same way round, which is why the plane
        scan can hand the projector the robot's own pose unmodified.

    Noether emits tool z along the surface normal, which is the right convention
    -- but the normals it gets from NormalEstimationPCLMeshModifier are not
    consistently oriented. On a curved reconstruction nearly half the poses can
    come out pointing the other way, and a probe told to approach half the part
    from underneath is not a scan.

    The flip is 180 degrees about the tool's own x axis, which reverses z while
    leaving x -- the direction of travel along the raster line -- alone.

    `up` is the direction "away from the specimen" points on average. The default
    is world +z, correct for a part lying on a table.
    """
    up = np.asarray(up, dtype=np.float64)
    out = np.array(quats, dtype=np.float64).reshape(-1, 4).copy()
    flipped = 0
    for i in range(out.shape[0]):
        R = quat_to_matrix(out[i])
        if float(np.dot(R[:, 2], up)) < 0.0:
            out[i] = quat_mul(tuple(out[i]), (1.0, 0.0, 0.0, 0.0))
            flipped += 1
    return out, flipped


def cap_tool_tilt(quats, max_tilt_deg, up=(0.0, 0.0, 1.0)):
    """Lean every pose back toward `up` until it tilts no more than the cap.

    THE MIDDLE COURSE BETWEEN THE TWO THINGS THAT DO NOT WORK ON A CURVED PART.

    Hold the tool vertical over a cylinder and the sensor lands where the stage
    wants it while the rest of the tooling goes into the flank -- on a 32 mm
    radius cylinder the eddy-current probe ends up 5-6 mm inside the part while
    the Keyence sits correctly in its window. Follow the normals all the way and
    the flank poses tilt the tool near horizontal, and the first pass cannot be
    entered at all.

    So follow the normal as far as a cap and no further. The correction is a
    rotation about the HORIZONTAL axis of the tilt plane -- tool z moves along
    the great circle toward `up` by exactly the excess angle -- which is the
    smallest change that meets the cap, and it carries tool x and y with it, so
    the roll about the tool's own axis is untouched. A line sensor's laser stays
    across the direction of travel and an eddy-current probe's locked roll stays
    locked: both are properties of the tool frame's x, and this does not turn the
    tool about its z.

    max_tilt_deg = 0 is "hold it vertical", which reproduces orient="fixed"'s
    tool axis exactly. A cap larger than anything on the path is a no-op.
    """
    q = _unit_quats(quats)
    cap = math.radians(float(max_tilt_deg))
    u = np.asarray(up, dtype=np.float64)
    u = u/np.linalg.norm(u)
    out = np.array(q, copy=True)
    for i in range(out.shape[0]):
        R = quat_to_matrix(out[i])
        z = R[:, 2]
        tilt = math.acos(float(np.clip(np.dot(z, u), -1.0, 1.0)))
        if tilt <= cap + 1e-12:
            continue
        axis = np.cross(z, u)
        n = np.linalg.norm(axis)
        if n < 1e-12:
            # z is anti-parallel to up: any horizontal axis will do, and the
            # tool is upside down, which orient_tool_away_from_surface() has
            # already ruled out on any path that reaches here.
            axis = np.array([1.0, 0.0, 0.0])
            n = 1.0
        axis = axis/n
        half = 0.5*(tilt - cap)
        # A rotation in the WORLD frame, applied on the left, because the axis is
        # world-horizontal: q_new = dq * q.
        dq = (axis[0]*math.sin(half), axis[1]*math.sin(half),
              axis[2]*math.sin(half), math.cos(half))
        out[i] = quat_mul(dq, tuple(out[i]))
    return _unit_quats(out)


# ------------------------------------------------------------------------------
# WHICH WAY THE PASSES RUN
# ------------------------------------------------------------------------------
# ONE PLACE SAYS IT, AND THIS IS IT: the rule lives here as code that the gate
# and the tests both use, and the prose elsewhere points at this rather than
# restating it. Stated from memory it is easy to get backwards, and its two
# halves -- which principal axis, and which way round -- are wrong
# independently of each other.
#
# THE SOURCE, which is what settles it; ros_ws/src/noether/noether_tpp:
#
#   PrincipalAxisDirectionGenerator::generate()
#   src/tool_path_planners/raster/direction_generators/
#       principal_axis_direction_generator.cpp
#
#       return AngleAxisd(rotation_offset_, pca_vecs.col(2).normalized())
#              * pca_vecs.col(1).normalized();
#
#   PlaneSlicerRasterPlanner::planImpl()
#   src/tool_path_planners/raster/plane_slicer_raster_planner.cpp
#
#       mesh_normal   = pca.getEigenVectors().col(2).normalized();
#       cut_direction = dir_gen_->generate(mesh);
#       cut_normal    = cut_direction.normalized().cross(mesh_normal).normalized();
#       ... one vtkPlane every line_spacing, stepped along cut_normal ...
#
# pcl::PCA sorts its eigenvectors by DESCENDING eigenvalue, so col(0) is the
# mesh's longest direction, col(1) the second-longest, col(2) the thinnest --
# and col(2) is also `mesh_normal`. So what the direction generator returns is
# the direction the RASTER LINES RUN. It is not the plane normal; the plane
# normal is that crossed with the thin axis. Reading it as the plane normal is
# the easy mistake, and it inverts the rule below.
#
#   rotation_offset = 0      lines run along the SECOND principal axis.
#                            The cutting planes are normal to the FIRST and step
#                            along the part's LONGEST dimension.
#   rotation_offset = pi/2   lines run along the FIRST (longest) axis.
#                            The cutting planes are normal to the SECOND and
#                            step along the SECOND-longest dimension.
#
# CONFIRMED AGAINST REAL PLANS. At pi/2 over a mesh whose principal extents are
# 313.3 x 169.7 mm the planner returns 566 cutting planes at a 0.30 mm line
# spacing -- 169.7/0.30, the SECOND-longest extent -- and every acquiring pass
# lies within 7 degrees of the first principal axis. noether_cut_axes() below is
# this rule as arithmetic, and it reproduces such a plan's pose count and its
# total contour travel to about 0.1%, which is what lets the gate answer
# without calling the service.
#
# TWO THINGS THAT ARE NOT THE BOUNDING BOX, and both have bitten:
#
#   * The axes come from a PCA of the VERTICES. They are weighted by vertex
#     density, not by area and not by extent. On an evenly meshed part they
#     agree with the bounding box to about a percent (169.7 against 171.8 mm on
#     one measured plate); on one that is not, they need not, and "longest" here
#     always means the largest PCA extent.
#   * They are the axes of the WHOLE MESH -- breadboard, clamps and mount block
#     included. Cropping the mesh to the part can turn the whole raster ninety
#     degrees, so crop BEFORE planning, not after.

global noether_pass_axis
def noether_pass_axis(rotation_offset=0.0):
    """Which principal axis the raster lines run along: 0 longest, 1 second.

    The rule above with no mesh needed. A raster line is a LINE and not a ray,
    so the offset only matters modulo pi: 0 and pi both mean the second axis,
    pi/2 and -pi/2 both mean the longest. An offset in between puts the lines on
    a diagonal and this returns whichever axis they are nearer; exactly pi/4 is
    a tie and reads as the second axis.
    """
    off = float(rotation_offset) % math.pi
    return 0 if abs(math.sin(off)) > abs(math.cos(off)) else 1


global noether_principal_axes
def noether_principal_axes(vertices):
    """(axes, centroid, extent). Rows of axes are a0 (longest) .. a2 (thinnest).

    pcl::PCA over the mesh's vertices, which is what both the direction
    generator and the plane slicer run. `extent` is the span of the vertices
    along each axis in metres, in the same order. Non-finite vertices are
    dropped -- PCL would assert on one rather than ignore it, but the gate has
    its own fatal check for that and this must still be able to measure.
    """
    v = np.asarray(vertices, dtype=np.float64).reshape(-1, 3)
    v = v[np.isfinite(v).all(axis=1)]
    if len(v) < 3:
        raise ValueError("a PCA needs at least 3 finite vertices, got %d"
                         % (len(v),))
    c = v.mean(axis=0)
    ev, evec = np.linalg.eigh(np.cov((v - c).T))
    order = np.argsort(ev)[::-1]
    axes = evec[:, order].T
    proj = (v - c) @ axes.T
    return axes, c, proj.max(axis=0) - proj.min(axis=0)


global noether_cut_axes
def noether_cut_axes(vertices, rotation_offset=0.0, line_spacing=None):
    """What the plane slicer will do to this mesh, without asking the service.

    principal_axis_noether_srv is not reachable from a host that is not running
    ROS, and the whole point of the mesh gate is to answer before the planner is
    asked -- so this is arithmetic, not a call. It is the construction quoted
    above, transcribed.

    Returns a dict:

      pass_direction   unit vector the raster lines RUN along (the planner's
                       own `cut_direction`)
      plane_normal     unit normal of the cutting planes; they step along it
      axes             (3, 3), rows a0 (longest) .. a2 (thinnest)
      extent_m         the vertex span along each of those, metres
      pass_axis        0 or 1, whichever principal axis the lines are nearer
      pass_extent_m    how far the mesh reaches along pass_direction -- the
                       length of the longest possible pass
      step_extent_m    how far it reaches along plane_normal -- what the planes
                       have to cover
      planes           how many cutting planes at `line_spacing`, or None
      squareness       |extent[0] - extent[1]| / extent[0]. Near zero the two
                       in-plane axes are degenerate and WHICH WAY THE PASSES RUN
                       IS NOT DETERMINED: PCA picks an arbitrary pair, and so
                       does PCL's. A square plate is the case to watch.
    """
    axes, centroid, extent = noether_principal_axes(vertices)
    a1, a2 = axes[1], axes[2]
    off = float(rotation_offset)
    # Rodrigues about a2. a2 is perpendicular to a1, so the (1 - cos) term
    # vanishes and this is exactly AngleAxisd(off, a2) * a1. Written with the
    # cross product rather than as +/- a0 because neither numpy's eigenvectors
    # nor Eigen's are guaranteed to be a right-handed set, and the sign of a0
    # would then be a coin toss.
    d = math.cos(off)*a1 + math.sin(off)*np.cross(a2, a1)
    d = d/np.linalg.norm(d)
    n = np.cross(d, a2)
    n = n/np.linalg.norm(n)
    v = np.asarray(vertices, dtype=np.float64).reshape(-1, 3)
    v = v[np.isfinite(v).all(axis=1)]
    out = {"pass_direction": d, "plane_normal": n, "axes": axes,
           "centroid": centroid, "extent_m": extent,
           "pass_axis": noether_pass_axis(off),
           "rotation_offset": off,
           "pass_extent_m": float(np.ptp(v @ d)),
           "step_extent_m": float(np.ptp(v @ n)),
           "squareness": float(abs(extent[0] - extent[1])/max(extent[0], 1e-12)),
           "planes": None}
    if line_spacing:
        # ceil, as PlaneSlicerRasterPlanner does it -- but nudged, because
        # 0.300/0.0003 is 1000.0000000000001 in binary and a bare ceil turns
        # that into 1001 planes over a plate that has exactly 1000.
        out["planes"] = int(math.ceil(
            out["step_extent_m"]/float(line_spacing) - 1e-9))
    return out


def plan_noether_toolpath(mesh_filename, line_spacing=0.01, z_offset=0.0,
                          snake=True, rotation_offset=0.0, origin=(0, 0, 0),
                          distance_threshold=0.0, estimate_normals=True,
                          timeout=300.0, service=None):
    """Ask principal_axis_noether_srv for a raster toolpath over a mesh.

    Returns the service response, which carries `success`, `noether_pose_array`
    and `segment_start_indices`. Use those indices -- they are the planner's own
    raster-line boundaries, and inferring them from geometry tops out around 78%
    recall on a real path because some link steps are shorter than the longest
    step inside a line and some have zero length.

    Runs on its own short-lived node rather than through the dgpy motion module.
    A service call that blocks while holding a module context is the standard way
    to wedge this stack, and none of this needs the module's state.

    Four things that are easy to get wrong and expensive to diagnose:

      * The mesh is read in WORLD coordinates. The server emits vertex positions
        as poses directly, so a mesh authored about its own origin plans a
        toolpath in the floor.
      * z_offset is SUBTRACTED from every pose. Negative lifts the path above the
        surface, which is what standoff wants; positive drives the probe into
        the part.
      * estimate_normals must be on for any mesh without vertex normals --
        PlaneSlicerRasterPlanner refuses one outright ("does not have vertex
        normals"). It maps to the request's `depth_reconstruction` field, which
        is misleadingly named: it is the normals switch.
      * The request has an `orientation` field. The server ignores it. Fix the
        orientation on this side -- see orient_tool_away_from_surface().
    """
    import rclpy
    from rclpy.node import Node
    from tari_interfaces.srv import PrincipalAxisNoetherPlanner

    if not os.path.exists(mesh_filename):
        raise IOError("no such mesh: %s" % (mesh_filename,))

    node = Node("noether_toolpath_client")
    try:
        client = node.create_client(PrincipalAxisNoetherPlanner,
                                    service or NOETHER_SERVICE)
        if not client.wait_for_service(timeout_sec=15.0):
            raise RuntimeError(
                "no %s service. Start it with:\n"
                "  ros2 run tari_noether_srv principal_axis_noether_srv"
                % (service or NOETHER_SERVICE,))

        req = PrincipalAxisNoetherPlanner.Request()
        req.mesh_filename = mesh_filename
        req.line_spacing = float(line_spacing)
        req.rotation_offset = float(rotation_offset)
        req.origin = [int(v) for v in origin]
        req.z_offset = float(z_offset)
        req.distance_threshold = float(distance_threshold)
        req.depth_reconstruction = bool(estimate_normals)
        req.snake = bool(snake)
        req.orientation.w = 1.0

        # THE PLANNER IS THE SLOW PART OF PLANNING, and it is one blocking
        # service call with nothing to count on this side. It slices the mesh
        # once per raster line, so the cost goes as the part's width over
        # line_spacing: at a 0.3 mm production spacing over a 120 mm plate that
        # is 400 slices through a 23 000-face mesh, returning of the order of
        # 280 000 waypoints, and it takes minutes. Hence the heartbeat.
        nv, nf = _mesh_size(mesh_filename)
        with progress("planning the toolpath (principal_axis_noether, "
                      "%.1f mm spacing)" % (1e3*float(line_spacing),),
                      heartbeat=True) as p:
            if nv:
                p.note("over %s: %d vertices, %d faces"
                       % (os.path.basename(mesh_filename), nv, nf))
            future = client.call_async(req)
            rclpy.spin_until_future_complete(node, future, timeout_sec=timeout)
            res = future.result()
            if res is None:
                raise RuntimeError("noether planner did not answer within %.0f s"
                                   % timeout)
            p.result("%d waypoints in %d passes"
                     % (len(getattr(getattr(res, "noether_pose_array", None),
                                    "poses", ()) or ()),
                        len(getattr(res, "segment_start_indices", ()) or ())))
        return res
    finally:
        node.destroy_node()


global _mesh_size
def _mesh_size(path):
    """(vertices, faces) from a PLY header, for a progress line. (0, 0) if not.

    Header only, so it is free on a three-million-point cloud, and it never
    raises: this is here to make a message informative, not to make a decision.
    """
    try:
        nv = nf = 0
        with open(path, "rb") as f:
            for _ in range(200):
                line = f.readline()
                if not line or line.strip() == b"end_header":
                    break
                tok = line.split()
                if len(tok) >= 3 and tok[0] == b"element":
                    if tok[1] == b"vertex":
                        nv = int(tok[2])
                    elif tok[1] == b"face":
                        nf = int(tok[2])
        return nv, nf
    except Exception:
        return 0, 0


#: The `source` string of every path built with orient="normal" in this process.
#:
#: A BELT FOR THE ATTRIBUTE, because the attribute is not always carried. The
#: crop helpers a scan config runs after planning -- _crop_path_by_mask() for the
#: tilt limit, _crop_path_to_box() for the region -- build a fresh ScanPath and
#: copy only the positions, the quaternions, the segment starts and the SOURCE.
#: So a path that was cropped has lost `normal_constrained` and would be averaged
#: by a downstream smoother that only asked the attribute. (It is not lost when
#: nothing is dropped: those helpers return the path itself then, which is the
#: expected case once the normals are repaired.) The source string survives every
#: one of them, so it is what path_is_normal_constrained() falls back to.
global NORMAL_CONSTRAINED_SOURCES
NORMAL_CONSTRAINED_SOURCES = set()


global path_is_normal_constrained
def path_is_normal_constrained(path):
    """Is this path's tool axis the surface normal by construction?

    The attribute when it is there -- including an explicit False, which a caller
    that deliberately rebuilt the orientation can set -- and the source string
    otherwise. See NORMAL_CONSTRAINED_SOURCES for why there are two answers.
    """
    v = getattr(path, "normal_constrained", None)
    if v is not None:
        return bool(v)
    return getattr(path, "source", None) in NORMAL_CONSTRAINED_SOURCES


global _swing_tool_axis_onto
def _swing_tool_axis_onto(quats, axes):
    """Each pose turned by the smallest world rotation putting tool z on `axes`.

    The roll about the tool's own axis is CARRIED, not reset, so this composes
    with regularize_tool_roll() in any mode instead of quietly re-locking one --
    the same reason cap_tool_tilt() rotates about the horizontal axis of the tilt
    plane. Vectorised; the half-angle quaternion of the rotation taking a to b is
    (a x b, 1 + a.b) normalised.
    """
    q = _unit_quats(quats)
    x, y, zc, w = q[:, 0], q[:, 1], q[:, 2], q[:, 3]
    z = np.stack([2.0*(x*zc + y*w), 2.0*(y*zc - x*w), 1.0 - 2.0*(x*x + y*y)],
                 axis=1)
    a = np.asarray(axes, dtype=np.float64).reshape(-1, 3)
    a = a/np.maximum(np.linalg.norm(a, axis=1, keepdims=True), 1e-300)
    c = np.einsum("ij,ij->i", z, a)
    axis = np.cross(z, a)
    # Anti-parallel: the rotation is a half turn about ANY perpendicular axis, so
    # one is constructed rather than left as the zero vector a cross product
    # gives there.
    flip = c < -0.999999
    if flip.any():
        alt = np.cross(z[flip], np.array([0.0, 0.0, 1.0]))
        bad = np.linalg.norm(alt, axis=1) < 1e-9
        if bad.any():
            alt[bad] = np.cross(z[flip][bad], np.array([1.0, 0.0, 0.0]))
        axis[flip] = alt
    qs = np.column_stack([axis, 1.0 + c])
    qs[flip, 3] = 0.0
    qs = qs/np.maximum(np.linalg.norm(qs, axis=1, keepdims=True), 1e-300)
    ax, ay, az, aw = qs[:, 0], qs[:, 1], qs[:, 2], qs[:, 3]
    bx, by, bz, bw = q[:, 0], q[:, 1], q[:, 2], q[:, 3]
    return np.column_stack([aw*bx + ax*bw + ay*bz - az*by,
                            aw*by - ax*bz + ay*bw + az*bx,
                            aw*bz + ax*by - ay*bx + az*bw,
                            aw*bw - ax*bx - ay*by - az*bz])


global _quats_from_surface_normals
def _quats_from_surface_normals(pos, quats, surface, up=(0.0, 0.0, 1.0)):
    """Put every pose's tool z on the SURFACE's normal there. -> (quats, flipped, report)

    This is where "tilt with respect to the surface normal is zero" stops being a
    thing that is checked and becomes a thing that is TRUE BY CONSTRUCTION: the
    axis is not the planner's estimate corrected, it is the repaired mesh's own
    field, sampled at the waypoint.

    NOTHING IS TURNED OVER, AND THAT IS THE CHANGE FROM
    orient_tool_away_from_surface(). That function flips a pose whose tool z
    points into the part, which is right when the axis is the planner's ESTIMATE
    of a normal -- a wrong sign is the commonest thing an estimate gets wrong. It
    is WRONG when the axis is the surface's own repaired normal: turning it over
    points the probe at a surface that faces the other way, which is a 180 degree
    tilt with respect to the actual surface normal and so is exactly what the
    tilt rule forbids. A mesh that includes the bench and a draped skirt has a
    small number of waypoints -- of the order of 100 in 70 000 -- on surface that
    faces DOWN, and flipping those is enough on its own to fail the
    postcondition, at exactly 180 degrees and nowhere else.

    A surface facing away from the probe is not a sign error. It is an
    UNREACHABLE REGION, and repair_tool_axis_to_surface() is what DROPS it, with a
    count and a bounding box, once the path is built. Nothing here turns one over.

    THE COUNT THIS FUNCTION REPORTS IS AGAINST WORLD UP, and that is all it can
    be: it is a statement about the direction the probe COMES FROM, which is
    global. It is not a check on the poses -- a pose can be turned round with
    respect to the surface it sits on and be perfectly vertical. That check is
    tool_axis_flip_report(), and it is measured against the surface.

    Two refusals, both of them about the surface rather than the path:
      * MOST of the normals facing into the part means the mesh is INSIDE OUT, and
        every pose on such a path would drive the probe at the part from
        underneath;
      * a normal within LOCKED_ROLL_GUARD_DEG of straight DOWN leaves a locked
        roll undefined (regularize_tool_roll() refuses it, and rightly), so it is
        named here where the cause is visible instead of surfacing later as a pose
        index. Neither is expected on a mesh reconstructed from above: even a
        mesh carrying a draped skirt has only a few normals per thousand below
        the horizon, and the most downward of those still sits more than 45
        degrees away from straight down.
    """
    if surface is None:
        raise ValueError(
            "orient='normal' needs the surface its normals come from: pass "
            "surface=<the repaired mesh> (a path, or (v, n, t))")
    nrm, dist = sample_mesh_normals(surface, pos, up=up)
    upv = np.asarray(up, dtype=np.float64).reshape(3)
    upv = upv/max(float(np.linalg.norm(upv)), 1e-300)
    cos_up = nrm.dot(upv)
    into = cos_up < 0.0
    frac_up = float((~into).mean()) if len(into) else 1.0
    rep = {"waypoints": int(len(nrm)), "facing_up_fraction": frac_up,
           "height_field": bool(frac_up >= GATE_HEIGHT_FIELD_UP_FRACTION),
           "surface_distance_max_m": float(dist.max()) if len(dist) else 0.0,
           "facing_down": int(into.sum()), "turned_over": 0,
           "worst_facing_down_deg": (float(np.degrees(np.arccos(
               np.clip(cos_up.min(), -1.0, 1.0)))) if len(cos_up) else 0.0)}
    if frac_up < 0.5:
        raise MeshNotPlannable(
            "the surface's normals are inside out: %.1f%% of the %d waypoints "
            "would drive the probe at the part from underneath. Repair the mesh "
            "normals (repair_mesh_normals()) before planning on it."
            % (100.0*(1.0 - frac_up), len(nrm)), rep)
    if rep["worst_facing_down_deg"] > 180.0 - LOCKED_ROLL_GUARD_DEG:
        raise MeshNotPlannable(
            "the surface normal at waypoint %d is %.3f deg from straight down, "
            "and a roll locked to a horizontal reference is undefined within %.1f "
            "deg of there. That is a surface a probe coming from above cannot "
            "touch at all; crop it out of the region being scanned."
            % (int(np.argmin(cos_up)), rep["worst_facing_down_deg"],
               LOCKED_ROLL_GUARD_DEG), rep)
    return _swing_tool_axis_onto(quats, nrm), 0, rep


def scanpath_from_noether(response, offset=(0.0, 0.0, 0.0), orient="surface",
                          fixed_quat=None, up=(0.0, 0.0, 1.0), roll="fixed",
                          roll_reference=(1.0, 0.0, 0.0), max_tilt_deg=None,
                          surface=None):
    """ScanPath from a Noether response, ready to hand to the acquisition.

    offset translates the whole path, which is how a mesh gets placed in the
    cell without re-authoring it. It has to be applied to the projection surface
    too or the traces land on the wrong part of the image -- SurfaceProjector
    takes the same offset for exactly that reason.

    orient:
      "normal"   THE TOOL AXIS IS THE SURFACE'S OWN NORMAL, sampled from
                 `surface` at each waypoint -- which is the eddy-current mode,
                 because the probe's tilt with respect to the actual surface
                 normal must be ZERO and this is the only one of these options
                 that makes that true BY CONSTRUCTION rather than by filtering
                 afterwards. `surface` is
                 the mesh whose normals have been repaired
                 (repair_mesh_normals()), so the axis field is as smooth as that
                 mesh is and the planner's own normal estimation -- which put
                 16.0% of poses facing INTO the part -- is out of the loop
                 entirely. assert_probe_normal_to_surface() is the postcondition
                 that says so as a number.
      "surface"  keep Noether's per-pose orientation, made consistent by
                 orient_tool_away_from_surface(). Follows the part, and inherits
                 whatever the mesh's normals said pose by pose -- which on a
                 reconstruction is how a few percent of the waypoints come to
                 exceed the tilt cap and be dropped.
      "fixed"    one orientation for the whole path, from fixed_quat (x,y,z,w).
                 Right when the surface is mild and the probe is a fixed
                 standoff transducer, and the only option that works at all if
                 the estimated normals swing further than the wrist can follow.
      "capped"   "surface", then leaned back toward `up` until nothing tilts
                 more than `max_tilt_deg`. The only one of the three that can
                 scan a cylinder flank: vertical puts the far side of the
                 tooling into the part, fully normal-following tilts the tool
                 near horizontal and cannot be entered. See cap_tool_tilt().
                 max_tilt_deg is required for it and 0 makes it "fixed"'s tool
                 axis with a per-pose roll.
    """
    poses = response.noether_pose_array.poses
    if not poses:
        raise ValueError("noether returned an empty pose array")

    # np.fromiter, not a list comprehension of lists. A rosidl Pose costs about
    # 316 bytes of Python objects on Iron, so a 911 511-pose reply is already
    # 288 MB before anything is done with it; the comprehension form then builds
    # a million more small lists on top of that just to be copied into an array
    # and thrown away. This streams.
    n_poses = len(poses)
    # Seven attribute reads per pose through the rosidl wrappers. At the sizes
    # this planner returns -- a few hundred thousand waypoints at production
    # spacing, approaching a million at a fine one -- that is seconds of pure
    # Python between the planner answering and anything else happening, with
    # nothing said.
    with progress_step("unpacking %d planner poses" % (n_poses,)) as unpack:
        pos_mesh = np.fromiter(
            (v for p in poses
             for v in (p.position.x, p.position.y, p.position.z)),
            dtype=np.float64, count=3*n_poses).reshape(-1, 3)
        # KEPT SEPARATELY, because orient="normal" has to sample the mesh in the
        # MESH's frame. `offset` places the mesh in the cell by moving the path
        # instead of re-authoring the file, so the offset positions are not on the
        # surface the normals come from -- sampling there would read the normal of
        # whatever the mesh happens to have at that displaced point.
        pos = pos_mesh + np.asarray(offset, dtype=np.float64).reshape(1, 3)
        quats = np.fromiter(
            (v for p in poses for v in (p.orientation.x, p.orientation.y,
                                        p.orientation.z, p.orientation.w)),
            dtype=np.float64, count=4*n_poses).reshape(-1, 4)
        unpack.result("%d poses, %d passes"
                      % (n_poses, len(response.segment_start_indices)))

    starts = [int(i) for i in response.segment_start_indices]

    normal_report = None
    if orient == "fixed":
        if fixed_quat is None:
            raise ValueError("orient='fixed' needs fixed_quat as (x, y, z, w)")
        quats = np.tile(np.asarray(fixed_quat, dtype=np.float64).reshape(1, 4),
                        (pos.shape[0], 1))
        flipped = 0
        worst_roll = 0.0
    elif orient in ("surface", "capped", "normal"):
        if orient == "normal":
            quats, flipped, normal_report = _quats_from_surface_normals(
                pos_mesh, quats, surface, up=up)
        else:
            quats, flipped = orient_tool_away_from_surface(quats, up=up)
        # Then re-derive the roll about the tool axis. The sign correction above
        # cannot see a 90 degree roll, and Noether emits those in runs, mid-pass,
        # on a surface whose normal is not changing. See regularize_tool_roll().
        bounds = list(starts) + [pos.shape[0]]
        segs = [(bounds[i], bounds[i+1]) for i in range(len(bounds)-1)
                if bounds[i+1] > bounds[i]]
        quats, worst_roll = regularize_tool_roll(pos, quats, segments=segs, mode=roll,
                                                 reference=roll_reference)
        if orient == "capped":
            if max_tilt_deg is None:
                raise ValueError(
                    "orient='capped' needs max_tilt_deg -- the cap IS the "
                    "decision. cap_tool_tilt() says what it costs.")
            before = tool_tilt_deg(quats, up=up)
            quats = cap_tool_tilt(quats, max_tilt_deg, up=up)
            after = tool_tilt_deg(quats, up=up)
            capped = int((before > float(max_tilt_deg) + 1e-9).sum())
            print("  tilt capped at %.1f deg: %d of %d poses leaned back, tilt "
                  "%.1f -> %.1f deg at worst"
                  % (float(max_tilt_deg), capped, len(before), before.max(),
                     after.max()))
            worst_roll = _worst_orientation_step(quats)
    else:
        raise ValueError("orient must be 'normal', 'surface', 'capped' or "
                         "'fixed', not %r" % (orient,))

    path = ScanPath(pos, quats, starts, source="noether (%d poses)" % len(poses))
    path.noether_flipped = flipped
    # THE FLAG THAT STOPS THE SECOND SMOOTHER. A path whose axis IS the repaired
    # surface normal must not then be averaged, medianed or leaned: every one of
    # those moves the probe OFF the normal, which is the one thing the rule
    # forbids. smooth_tool_axis() and sanitize_tool_axis() both read this and
    # say what they declined to do -- see the division of labour written down in
    # sanitize_tool_axis().
    path.normal_constrained = (orient == "normal")
    path.normal_report = normal_report
    path.normal_surface = surface if orient == "normal" else None
    path.normal_offset = tuple(float(c) for c in
                               np.asarray(offset, dtype=np.float64).reshape(3))
    if path.normal_constrained:
        NORMAL_CONSTRAINED_SOURCES.add(path.source)
    else:
        # DISCARDED, not merely not added. Two paths built from the same planner
        # reply share a source string, so a set that only ever grew would say
        # "constrained" about an UNCONSTRAINED path planned from the same reply --
        # which is exactly what a before/after comparison builds, and it would
        # then compare two paths that are both treated as constrained. The last
        # plan from a given reply is the one that counts.
        NORMAL_CONSTRAINED_SOURCES.discard(path.source)
    path.worst_roll_step_deg = worst_roll
    # Kept with the path so a report on it -- plan_mesh_path(), a dry run --
    # measures roll against the reference the path was built from.
    path.roll_mode = (roll if orient in ("surface", "capped", "normal")
                      else "fixed orientation")
    path.orient_mode = orient
    path.max_tilt_deg = (float(max_tilt_deg) if orient == "capped" else None)
    path.roll_reference = tuple(float(v) for v in np.asarray(roll_reference).reshape(-1))
    return path


def mesh_uv_x3d(mesh_filename, x3d_filename, method="planar", timeout=900.0,
                blender_python=None):
    """UV-parameterize a mesh and write it as X3D for the projector.

    project_point_onto_parameterization needs a parameterization, and a PLY or
    STL has none. For the plane scan the surface is synthesised with a trivial
    two-triangle UV map; for a real mesh something has to compute one.

    This reuses the Blender workflow already in the tree (dgpfiles/x3dConverter.py,
    which drives the eddy-current process): import, clean, consistent normals,
    triangulate, unwrap. Two properties of Blender's own X3D exporter make its
    output unloadable, so it is not used:

      * it rounds texture coordinates to FOUR decimal places. spatialnde2
        reindexes texture vertices by exact coordinate, so on an 18780-vertex
        mesh that quantization welds eight distinct UV vertices together,
        producing seven zero-area UV triangles and seven UV edges shared by more
        than two triangles -- and x3d_load_geometry refuses the mesh ("Edge
        involving original uv vertices ... is shared by more than two
        triangles"). So Blender does the unwrap and the helper script writes the
        X3D itself, at full precision.
      * The exporter also converts to the X3D Y-up convention and emits a
        Transform to match. The mesh is already in world coordinates and has to
        stay there, because the projector is registered to probe poses by
        construction.

    method:
      "planar"       UV is the surface's footprint on its own principal plane.
                     One island, no seams, bijective for anything plate-like,
                     and it makes the projected image directly comparable to a
                     rectangular c-scan -- the same property the synthesised
                     plane patch has. Wrong for a part that folds back on itself.
      "angle_based"  seams from sharp edges, angle-based unwrap: the existing
                     x3dConverter.py recipe. General, but the UV layout has no
                     simple relationship to the part.

    Blender runs as a SUBPROCESS deliberately. bpy is a singleton that installs
    its own signal handlers and never really unloads; importing it into a
    long-running dgpy session is not worth the risk when a subprocess costs a few
    seconds.
    """
    if not os.path.exists(mesh_filename):
        raise IOError("no such mesh: %s" % (mesh_filename,))
    helper = os.path.join(os.path.dirname(os.path.abspath(_noether_module_file())),
                          "mesh_uv_blender.py")
    if not os.path.exists(helper):
        raise IOError("missing helper script %s" % (helper,))

    cmd = [blender_python or sys.executable, helper, "--",
           mesh_filename, x3d_filename, method]
    # A BLENDER SUBPROCESS WITH A 900 s TIMEOUT, whose output is captured and so
    # reaches nobody until it exits -- the stage that looks most like a hang in
    # the whole pipeline. Nothing to count: unwrapping is one call inside
    # Blender. Heartbeat, and say how big the mesh is first, because that is
    # what decides whether this is seconds or minutes.
    nv, nf = _mesh_size(mesh_filename)
    with progress("UV parameterization in Blender (%s)" % (method,),
                  heartbeat=True) as p:
        if nv:
            p.note("%d vertices, %d faces" % (nv, nf))
        proc = subprocess.run(cmd, stdout=subprocess.PIPE,
                              stderr=subprocess.STDOUT, timeout=timeout)
    out = proc.stdout.decode("utf-8", "replace")
    summary = [l for l in out.splitlines() if l.startswith("MESHUV")]
    if proc.returncode != 0 or not os.path.exists(x3d_filename):
        raise RuntimeError("UV parameterization failed (exit %d):\n%s"
                           % (proc.returncode, out[-4000:]))
    for line in summary:
        print("  %s" % line)
    global last_uv_report
    last_uv_report = {"x3d": x3d_filename, "lines": summary,
                      "rejected": any("will be rejected" in l for l in summary)}
    return x3d_filename


def orient_segments_along(path, direction, serpentine=False):
    """A copy of `path` with the direction of travel of every pass CHOSEN.

    THIS IS THE ONE PLACE THE ORDER OF A PASS IS DECIDED. principal_axis_noether
    does not keep a sign -- its own check is commented out -- so one plan's
    passes may run +x and the next plan's -x, and whatever the planner's own
    snake modifier did is undone here. Nothing downstream re-orders a pass:
    resample_segments() interpolates along each pass as it stands, and the crops
    and the clearance gate only drop waypoints.

    serpentine=False is a COMB: every pass runs along `direction`, so the probe
    is carried the whole length of the part back to the same side between
    passes. That is the honest choice for a reading that depends on the
    direction of travel -- a probe dragged in contact leans against its travel
    in the spring fixture, and alternating the lean alternates the lift-off,
    which stripes the image line by line.

    serpentine=True is a RASTER: the first pass runs along `direction` and each
    one after it starts at whichever of its ends is nearer to where the previous
    pass finished. On a raster that is strict alternation, and the move between
    passes becomes one line spacing sideways instead of the length of the part --
    most of the per-pass overhead of a many-pass scan. Taking the nearer end
    rather than counting passes odd and even also keeps this sensible when a
    crop has split a pass in two or the passes do not arrive in tidy order.

    REVERSING A PASS MUST NOT TOUCH THE TOOL FRAME. Only the ORDER of the
    waypoints changes; each waypoint's orientation travels with its position, so
    the frame the tool holds at any given point on the surface is the same in
    either direction. Nothing here recomputes an orientation from the direction
    of travel -- doing that at a serpentine turn hands back a 180 degree flip,
    which points the tool z into the part.

    Segments shorter than two waypoints, and ones square to `direction`, are
    left as they are.
    """
    d = np.asarray(direction, dtype=np.float64).reshape(3)
    d = d/np.linalg.norm(d)
    pos, qs, starts = [], [], []
    reversed_count = 0
    prev_end = None
    for a, b in path.segments:
        idx = list(range(a, b))
        if b - a >= 2:
            head, tail = path.positions[a], path.positions[b-1]
            if serpentine and prev_end is not None:
                flip = (float(np.linalg.norm(head - prev_end))
                        > float(np.linalg.norm(tail - prev_end)))
            else:
                flip = float(np.dot(tail - head, d)) < 0.0
            if flip:
                idx = idx[::-1]
                reversed_count += 1
        prev_end = path.positions[idx[-1]]
        starts.append(len(pos))
        pos.extend(path.positions[i] for i in idx)
        qs.extend(path.quats[i] for i in idx)
    out = ScanPath(np.array(pos), np.array(qs), starts, source=path.source)
    for attr in ("noether_flipped", "worst_roll_step_deg", "roll_mode",
                 "roll_reference", "roll_report", "normal_constrained",
                 "normal_report", "normal_surface"):
        if hasattr(path, attr):
            setattr(out, attr, getattr(path, attr))
    out.segments_reversed = reversed_count
    out.serpentine = bool(serpentine)
    return out


global _noether_module_file
def _noether_module_file():
    """Where this .dpi lives, so the Blender helper beside it can be found.

    A .dpi has no __file__ -- it is compiled as a function body -- so the config
    records the module directory when it includes this file.
    """
    return os.path.join(SCAN_MODULE_DIR, "noether_path.dpi")


def write_plate_ply(path, origin, u_vec, v_vec, nu=41, nv=41, bow=0.0,
                    also_x3d=None):
    """Write a plate as a triangulated PLY with vertex normals.

    This exists to make the mesh path testable. The specimen mesh that happens to
    be in this tree is a real scanned surface whose normals swing to near
    horizontal, and whose position the arm cannot work around -- so a scan that
    depends on it cannot distinguish "the mesh workflow is broken" from "that
    part is not reachable from here". A plate written over ground the arm is
    known to cover separates the two.

    origin/u_vec/v_vec are world-frame 3-vectors: the plate spans
    origin -> origin+u_vec -> origin+u_vec+v_vec -> origin+v_vec.

    bow raises the middle of the plate by that many metres along the surface
    normal, as a half-cosine in u. bow=0 gives a flat plate whose Noether
    toolpath should reproduce a plain raster; a few centimetres gives a genuinely
    curved surface with the normals still pointing usefully upward.

    Vertex normals are written, so the planner does not need to estimate them --
    which also means the toolpath orientation is exact rather than whatever a
    radius-0.01 PCL normal estimate produced.
    """
    o = np.asarray(origin, dtype=np.float64)
    u = np.asarray(u_vec, dtype=np.float64)
    v = np.asarray(v_vec, dtype=np.float64)
    n = np.cross(u, v)
    n = n/np.linalg.norm(n)

    us = np.linspace(0.0, 1.0, nu)
    vs = np.linspace(0.0, 1.0, nv)
    uu, vv = np.meshgrid(us, vs, indexing="ij")
    height = bow*np.sin(np.pi*uu) if bow else np.zeros_like(uu)
    pts = (o.reshape(1, 1, 3)
           + uu[..., None]*u.reshape(1, 1, 3)
           + vv[..., None]*v.reshape(1, 1, 3)
           + height[..., None]*n.reshape(1, 1, 3))

    # Analytic normals: the surface is o + s*u + t*v + bow*sin(pi*s)*n, so
    # d/ds and d/dt are exact and the cross product is the true normal. Estimated
    # normals are the single largest source of nonsense in a Noether toolpath, so
    # where they can be computed they should be.
    du = u.reshape(1, 1, 3) + (bow*np.pi*np.cos(np.pi*uu))[..., None]*n.reshape(1, 1, 3)
    dv = np.tile(v.reshape(1, 1, 3), (nu, nv, 1))
    nrm = np.cross(du, dv)
    nrm = nrm/np.linalg.norm(nrm, axis=2, keepdims=True)
    if float(np.dot(nrm.reshape(-1, 3).mean(axis=0), n)) < 0.0:
        nrm = -nrm

    verts = pts.reshape(-1, 3)
    norms = nrm.reshape(-1, 3)

    def vid(i, j):
        return i*nv + j

    tris = []
    for i in range(nu-1):
        for j in range(nv-1):
            a, b, c, d = vid(i, j), vid(i+1, j), vid(i+1, j+1), vid(i, j+1)
            tris.append((a, b, c))
            tris.append((a, c, d))
    tris = np.array(tris, dtype=np.int64)

    # Wind every triangle so its face normal agrees with the surface normal.
    # The x3d loader sorts the triangle fan around each vertex and asserts when
    # it cannot, and inconsistent winding is one way to get there.
    p0, p1, p2 = verts[tris[:, 0]], verts[tris[:, 1]], verts[tris[:, 2]]
    fn = np.cross(p1-p0, p2-p0)
    wrong = (fn*norms[tris[:, 0]]).sum(axis=1) < 0.0
    tris[wrong] = tris[wrong][:, [0, 2, 1]]

    with open(path, "w") as f:
        f.write("ply\nformat ascii 1.0\n")
        f.write("comment plate written by noether_path.dpi\n")
        f.write("element vertex %d\n" % verts.shape[0])
        f.write("property float x\nproperty float y\nproperty float z\n")
        f.write("property float nx\nproperty float ny\nproperty float nz\n")
        f.write("element face %d\n" % tris.shape[0])
        f.write("property list uchar int vertex_indices\n")
        f.write("end_header\n")
        for p, q in zip(verts, norms):
            f.write("%.9g %.9g %.9g %.9g %.9g %.9g\n"
                    % (p[0], p[1], p[2], q[0], q[1], q[2]))
        for t in tris:
            f.write("3 %d %d %d\n" % (t[0], t[1], t[2]))

    if also_x3d is not None:
        # Noether loads meshes with pcl::io::loadPolygonFile -- PLY, OBJ, STL,
        # VTK, and NOT X3D. spatialnde2's projector reads X3D and not PLY. The
        # same surface therefore has to exist in both formats, and writing them
        # from one array is the only way they stay the same surface.
        _write_x3d_grid(also_x3d, pts, nu, nv)

    return path, verts, tris


global _write_x3d_grid
def _write_x3d_grid(path, pts, nu, nv):
    """X3D for a plate grid, with UV running 0..1 along u and v.

    The parameterization is the plate's own (u, v), so the projected image is
    directly comparable to a rectangular c-scan over the same area -- and it
    needs no Blender, because a grid already has a parameterization.
    """
    verts = pts.reshape(-1, 3)
    us = np.linspace(0.0, 1.0, nu)
    vs = np.linspace(0.0, 1.0, nv)
    uu, vv = np.meshgrid(us, vs, indexing="ij")
    uvs = np.stack([uu.reshape(-1), vv.reshape(-1)], axis=1)

    idx = []
    for i in range(nu-1):
        for j in range(nv-1):
            a, b, c, d = i*nv+j, (i+1)*nv+j, (i+1)*nv+j+1, i*nv+j+1
            idx.append((a, b, c))
            idx.append((a, c, d))

    coordidx = " ".join("%d %d %d -1" % t for t in idx)
    with open(path, "w") as f:
        f.write('<?xml version="1.0" encoding="UTF-8"?>\n')
        f.write('<!DOCTYPE X3D PUBLIC "ISO//Web3D//DTD X3D 3.3//EN" '
                '"http://www.web3d.org/specifications/x3d-3.3.dtd">\n')
        f.write('<X3D profile="Interchange" version="3.3">\n  <Scene>\n    <Transform>\n')
        f.write('      <Shape>\n')
        f.write('        <IndexedFaceSet solid="false" coordIndex="%s" texCoordIndex="%s">\n'
                % (coordidx, coordidx))
        f.write('          <Coordinate point="%s"/>\n'
                % " ".join("%.9g %.9g %.9g" % (p[0], p[1], p[2]) for p in verts))
        f.write('          <TextureCoordinate point="%s"/>\n'
                % " ".join("%.9g %.9g" % (t[0], t[1]) for t in uvs))
        f.write('        </IndexedFaceSet>\n')
        f.write('        <Appearance><Material diffuseColor="0.8 0.8 0.8"/></Appearance>\n')
        f.write('      </Shape>\n    </Transform>\n  </Scene>\n</X3D>\n')
    return path


def locked_quats_from_axes(axes, reference=(1.0, 0.0, 0.0)):
    """The "locked" orientation for each tool axis in `axes` (N x 3), vectorised.

    The same construction as regularize_tool_roll(mode="locked"): the reference
    orientation tilted about a horizontal axis, by the smallest angle that puts
    tool z on the given axis. No rotation about the tool's own axis, ever.
    """
    q_ref = np.asarray(roll_reference_quat(reference), dtype=np.float64)
    z_ref = quat_to_matrix(q_ref)[:, 2]
    z = np.asarray(axes, dtype=np.float64).reshape(-1, 3)
    n = np.linalg.norm(z, axis=1, keepdims=True)
    if np.any(n == 0.0):
        raise ValueError("a tool axis of zero length has no orientation")
    z = z/n
    c = z.dot(z_ref)
    if np.any(c < -0.999999):
        raise ValueError("pose %d points its tool axis opposite the reference's %s; "
                         "a locked roll is undefined there"
                         % (int(np.argmin(c)), tuple(z_ref)))
    axis = np.cross(np.broadcast_to(z_ref, z.shape), z)
    qs = np.column_stack([axis, 1.0 + c])
    qs = qs/np.linalg.norm(qs, axis=1, keepdims=True)
    ax, ay, az, aw = qs[:, 0], qs[:, 1], qs[:, 2], qs[:, 3]
    bx, by, bz, bw = q_ref
    return np.column_stack([aw*bx + ax*bw + ay*bz - az*by,
                            aw*by - ax*bz + ay*bw + az*bx,
                            aw*bz + ax*by - ay*bx + az*bw,
                            aw*bw - ax*bx - ay*by - az*bz])


def smooth_tool_axis(path, window_m, reference=(1.0, 0.0, 0.0), force=False):
    """A copy of `path` with the tool axis averaged along each segment over
    `window_m` of travel, and the roll re-locked to `reference`.

    Positions are not touched: the tip still goes exactly where the mesh says.
    What changes is only which way the probe points, and only on a scale finer
    than `window_m`. A contact probe cannot follow the surface's orientation on
    a finer scale than its own face, and a reconstructed mesh's normals change
    on every waypoint -- which the arm does not ignore: at a sweep's small
    MoveIt scaling each orientation change is slow, so a noisy axis makes the
    probe rock AND crawl.

    The average is a box over +-window_m/2 of arc length, so a pass shorter than
    the window gets one axis, and a pass along a cylinder -- constant normal --
    is unchanged. Afterwards `path.axis_smoothing` says how far the axis moved:
    {"window_m", "moved_max_deg", "moved_mean_deg"}.

    DECLINED ON A NORMAL-CONSTRAINED PATH, and this is the "reconcile, do not
    stack" decision made explicit. This function exists to fight noisy mesh
    normals from downstream, by averaging them. Once the normals are repaired AT
    THE MESH and the tool axis IS the repaired normal (orient="normal"), there is
    nothing left for it to fight and averaging can only do harm: a box mean over
    6 mm is symmetric in the middle of a pass and ONE-SIDED at its ends, so on a
    60 mm radius it would lean the last poses of every pass about 1.4 degrees OFF
    the surface normal -- which is precisely the quantity that must be zero.
    force=True overrides it for a deliberate experiment.
    """
    if not window_m or float(window_m) <= 0.0:
        return path
    if path_is_normal_constrained(path) and not force:
        print("  NOT averaging the tool axis over %.1f mm: this path's axis IS "
              "the repaired surface normal (orient='normal'), and an average of "
              "it is a tilt away from the normal. The mesh was repaired instead "
              "-- see repair_mesh_normals()." % (float(window_m)*1e3,))
        return path
    half = 0.5*float(window_m)
    pos = np.asarray(path.positions, dtype=np.float64)
    q = _unit_quats(path.quats)
    x, y, zq, w = q[:, 0], q[:, 1], q[:, 2], q[:, 3]
    z = np.stack([2.0*(x*zq + y*w), 2.0*(y*zq - x*w), 1.0 - 2.0*(x*x + y*y)], axis=1)
    out = z.copy()
    for a, b in path.segments:
        if b - a < 2:
            continue
        s = np.concatenate([[0.0], np.cumsum(np.linalg.norm(np.diff(pos[a:b], axis=0),
                                                            axis=1))])
        lo = np.searchsorted(s, s - half, side="left")
        hi = np.searchsorted(s, s + half, side="right")
        cz = np.vstack([np.zeros((1, 3)), np.cumsum(z[a:b], axis=0)])
        out[a:b] = (cz[hi] - cz[lo])/(hi - lo)[:, None]
    out = out/np.linalg.norm(out, axis=1, keepdims=True)
    moved = np.degrees(np.arccos(np.clip(np.einsum("ij,ij->i", out, z), -1.0, 1.0)))
    smoothed = ScanPath(pos.copy(), locked_quats_from_axes(out, reference),
                        list(path.segment_starts), source=path.source)
    _carry_path_attrs(path, smoothed)
    smoothed.axis_smoothing = {"window_m": float(window_m),
                               "moved_max_deg": float(moved.max()) if len(moved) else 0.0,
                               "moved_mean_deg": float(moved.mean()) if len(moved) else 0.0}
    return smoothed


def resample_segments(path, spacing_m, reference=(1.0, 0.0, 0.0), surface=None):
    """A copy of a LOCKED `path` with every segment resampled to a uniform
    `spacing_m` along its length. Both ends of each segment are kept exactly;
    the roll stays locked to `reference`.

    Why: Noether puts a waypoint wherever a slicing plane crosses a mesh edge,
    so a pass arrives with steps from under a micron to millimetres -- 0.00066
    to 0.49 mm on an analytic cylinder, 0.00001 to 3.1 mm on a reconstructed
    plate, a few hundred thousand waypoints in one plan. A uniform spacing
    keeps every sweep request even and a fraction of the size, and gives the
    sweep's relative jump test (a step is a jump at more than jump_threshold
    times the mean step) a mean that is what a step actually is.

    Positions are interpolated along the polyline and the locked orientation is
    rebuilt from the tool axis at the new position, so nothing turns about the
    tool axis. Segments shorter than one spacing, or of fewer than two points,
    are left as they are.

    THE AXIS AT A NEW POSITION IS THE SURFACE'S AT THAT POSITION, when the path
    carries the surface it was constrained to (`surface`, or the path's own
    normal_surface). It has to be re-read rather than interpolated: a resampled
    waypoint is a NEW place on the part, and interpolating the axis between the
    two waypoints it fell between leaves the probe off the normal there by
    whatever the surface did in the gap -- measured at 5.7 deg on a recorded
    eddy-current plan whose postcondition, checked before this stage and never
    after it, read 0.000. With no surface the axis is interpolated on the SPHERE
    between the bracketing waypoints (slerp, not a chord), which is at least a
    rotation the whole way; the departure from the surface remains and is
    reported as `axis_from_surface: False`.
    """
    if not spacing_m or float(spacing_m) <= 0.0:
        return path
    spacing = float(spacing_m)
    pos = np.asarray(path.positions, dtype=np.float64)
    q = _unit_quats(path.quats)
    x, y, zq, w = q[:, 0], q[:, 1], q[:, 2], q[:, 3]
    z = np.stack([2.0*(x*zq + y*w), 2.0*(y*zq - x*w), 1.0 - 2.0*(x*x + y*y)], axis=1)
    out_p, out_z, starts = [], [], []
    # One numpy pass per PASS, and a real plan has hundreds of them -- 577 on
    # the mesh with the holes in it, over 284 514 waypoints. Counted by pass
    # rather than by waypoint, because a pass is the unit of work here.
    with progress("resampling to %.1f mm" % (1e3*spacing,),
                  total=len(path.segments), unit="passes") as rs:
        for a, b in path.segments:
            rs.step()
            P, Z = pos[a:b], z[a:b]
            d = (np.linalg.norm(np.diff(P, axis=0), axis=1) if b - a > 1
                 else np.zeros(0))
            L = float(d.sum())
            starts.append(sum(len(v) for v in out_p))
            if b - a < 2 or L < spacing:
                out_p.append(P)
                out_z.append(Z)
                continue
            keep = np.concatenate([[True], d > 1e-9])
            P, Z = P[keep], Z[keep]
            sc = np.concatenate([[0.0], np.cumsum(
                np.linalg.norm(np.diff(P, axis=0), axis=1))])
            n = max(1, int(round(L/spacing)))
            t = np.linspace(0.0, sc[-1], n + 1)
            out_p.append(np.column_stack(
                [np.interp(t, sc, P[:, k]) for k in range(3)]))
            out_z.append(_slerp_along(sc, Z, t))
        rs.result("%d -> %d waypoints"
                  % (len(pos), sum(len(v) for v in out_p)))
    P = np.vstack(out_p)
    Z = np.vstack(out_z)
    Z = Z/np.linalg.norm(Z, axis=1, keepdims=True)
    # THE AXIS FROM THE SURFACE AT THE NEW POSITION, when there is a surface to
    # ask. Interpolating it -- however carefully -- answers a question about the
    # two old waypoints, and the pose is at neither of them.
    surf = getattr(path, "normal_surface", None) if surface is None else surface
    from_surface = False
    moved = 0.0
    if surf is not None and path_is_normal_constrained(path):
        off = np.asarray(getattr(path, "normal_offset", (0.0, 0.0, 0.0)),
                         dtype=np.float64).reshape(1, 3)
        nrm, _d = sample_mesh_normals(surf, P - off)
        moved = float(np.degrees(np.arccos(np.clip(
            np.einsum("ij,ij->i", nrm, Z), -1.0, 1.0))).max()) if len(P) else 0.0
        Z = nrm
        from_surface = True
    res = ScanPath(P, locked_quats_from_axes(Z, reference), starts, source=path.source)
    _carry_path_attrs(path, res)
    res.resampled = {"spacing_m": spacing, "waypoints_before": int(len(pos)),
                     "waypoints_after": int(len(P)),
                     "axis_from_surface": bool(from_surface),
                     "axis_moved_max_deg": float(moved)}
    return res


global _slerp_along
def _slerp_along(s, dirs, at):
    """Unit directions interpolated ON THE SPHERE along arc length. -> (len(at), 3)

    A chord between two unit vectors, renormalised, is not a rotation: it lags
    the great circle in the middle and collapses altogether where the two are
    opposite. Interpolating a direction along a path is a rotation from one to
    the next, and this is that.

    Where two bracketing directions are within a hair of each other the chord
    IS the great circle to machine precision, and that branch is taken -- not as
    an optimisation but because sin(theta) is what the general form divides by.
    """
    s = np.asarray(s, dtype=np.float64).ravel()
    d = np.asarray(dirs, dtype=np.float64).reshape(-1, 3)
    d = d/np.maximum(np.linalg.norm(d, axis=1, keepdims=True), 1e-300)
    at = np.asarray(at, dtype=np.float64).ravel()
    if len(s) < 2:
        return np.tile(d[0] if len(d) else np.array([0.0, 0.0, 1.0]),
                       (len(at), 1))
    j = np.clip(np.searchsorted(s, at, side="right") - 1, 0, len(s) - 2)
    span = np.maximum(s[j+1] - s[j], 1e-300)
    u = np.clip((at - s[j])/span, 0.0, 1.0)
    a, b = d[j], d[j+1]
    c = np.clip(np.einsum("ij,ij->i", a, b), -1.0, 1.0)
    th = np.arccos(c)
    sn = np.sin(th)
    near = sn < 1e-9
    w0 = np.where(near, 1.0 - u, np.sin((1.0 - u)*th)/np.maximum(sn, 1e-300))
    w1 = np.where(near, u, np.sin(u*th)/np.maximum(sn, 1e-300))
    out = w0[:, None]*a + w1[:, None]*b
    ln = np.linalg.norm(out, axis=1, keepdims=True)
    # Exactly opposite: no great circle is defined, so the direction at the far
    # waypoint is carried rather than a half-turn being invented. A step like that
    # is a discontinuity the pass should have been cut at (sanitize_tool_axis()).
    bad = ln.ravel() < 1e-9
    out[bad] = b[bad]
    ln = np.maximum(np.linalg.norm(out, axis=1, keepdims=True), 1e-300)
    return out/ln


def read_ply_mesh(filename):
    """(vertices N x 3, normals N x 3 or None, triangles M x 3) from a PLY file,
    ASCII or binary little-endian, as Open3D, trimesh and Blender write them.
    Colours and other vertex properties are read past and dropped."""
    types = {"char": "i1", "uchar": "u1", "int8": "i1", "uint8": "u1",
             "short": "<i2", "ushort": "<u2", "int16": "<i2", "uint16": "<u2",
             "int": "<i4", "uint": "<u4", "int32": "<i4", "uint32": "<u4",
             "float": "<f4", "float32": "<f4", "double": "<f8", "float64": "<f8"}
    with open(filename, "rb") as _f:
        data = _f.read()
    end = data.index(b"end_header") + len(b"end_header")
    end = data.index(b"\n", end) + 1
    fmt, elements = None, []
    for line in data[:end].decode("ascii", "replace").splitlines():
        w = line.split()
        if not w:
            continue
        if w[0] == "format":
            fmt = w[1]
        elif w[0] == "element":
            elements.append([w[1], int(w[2]), []])
        elif w[0] == "property" and elements:
            if w[1] == "list":
                elements[-1][2].append((w[4], "list", types[w[2]], types[w[3]]))
            else:
                elements[-1][2].append((w[2], types[w[1]]))
    if fmt not in ("ascii", "binary_little_endian"):
        raise ValueError("%s: PLY format %r is not supported" % (filename, fmt))
    body = data[end:]
    verts = norms = tris = None
    if fmt == "ascii":
        rows = body.decode("ascii").split("\n")
        at = 0
        for name, count, props in elements:
            lines = rows[at:at + count]
            at += count
            if name == "vertex":
                a = np.array([l.split() for l in lines], dtype=np.float64)
                names = [pr[0] for pr in props]
                verts = a[:, [names.index(c) for c in ("x", "y", "z")]]
                if all(c in names for c in ("nx", "ny", "nz")):
                    norms = a[:, [names.index(c) for c in ("nx", "ny", "nz")]]
            elif name == "face":
                f = [l.split() for l in lines]
                if any(int(r[0]) != 3 for r in f):
                    raise ValueError("%s: only triangle meshes are supported" % (filename,))
                tris = np.array([r[1:4] for r in f], dtype=np.int64)
    else:
        off = 0
        for name, count, props in elements:
            if name == "face" and len(props) == 1 and props[0][1] == "list":
                ct, it = np.dtype(props[0][2]), np.dtype(props[0][3])
                dt = np.dtype([("n", ct), ("v", it, 3)])
                f = np.frombuffer(body, dtype=dt, count=count, offset=off)
                if (f["n"] != 3).any():
                    raise ValueError("%s: only triangle meshes are supported" % (filename,))
                tris = f["v"].astype(np.int64)
                off += count*dt.itemsize
                continue
            if any(pr[1] == "list" for pr in props):
                raise ValueError("%s: list property in element %r" % (filename, name))
            dt = np.dtype([(pr[0], pr[1]) for pr in props])
            a = np.frombuffer(body, dtype=dt, count=count, offset=off)
            off += count*dt.itemsize
            if name == "vertex":
                verts = np.column_stack([a[c].astype(np.float64) for c in ("x", "y", "z")])
                if all(c in dt.names for c in ("nx", "ny", "nz")):
                    norms = np.column_stack([a[c].astype(np.float64) for c in ("nx", "ny", "nz")])
    if verts is None or tris is None:
        raise ValueError("%s has no vertices or no faces" % (filename,))
    return verts, norms, tris


def clean_mesh_for_planning(mesh_in, mesh_out, min_component_fraction=0.01):
    """Write a copy of a reconstructed mesh that Noether's plane slicer can cut.

    A Poisson reconstruction routinely carries defects that stop
    principal_axis_noether with "Connecting vertex does not exist at the start
    or end of a segment", and the refusal costs the whole plan: a reconstruction
    of a cylinder can come back as a dozen components -- the part plus crumbs of
    8 to 400 faces sitting INSIDE it -- with tens of non-manifold edges on the
    part itself.

      * faces touching a NON-FINITE vertex are dropped, and so are faces with
        zero area. These two are not a refusal, they are a CRASH: PCL's normal
        estimation calls KdTreeFLANN::radiusSearch, which asserts on a NaN
        point, and the assert aborts principal_axis_noether_srv itself. A
        reconstruction's own smoothing step can write NaN vertices (6 in 8466
        has been seen), and once the server is gone every later plan fails with
        "no principal_axis_noether service", which names the wrong thing
        entirely;
      * faces on a non-manifold edge are dropped. Two such edges -- 8 faces of
        22899, 0.03% -- are enough to make the planner refuse, and the refusal
        is NOT monotone in line spacing: the same mesh plans at 20, 10, 5, 3, 2,
        1, 0.8, 0.6 and 0.4 mm and refuses at 1.5, 0.5 and 0.3 mm with "Too many
        connecting vertices found between adjacent segments". 0.3 mm is the
        eddy-current production spacing. Dropping only those 8 faces makes every
        one of those spacings plan;
      * components smaller than `min_component_fraction` of the faces are
        dropped. NOT "keep the largest": a part with holes through it is
        several components, and each of them is far bigger than 1%.

    Faces wound against the mesh's own vertex normals are TURNED ROUND, which
    the signed distance every clearance check uses takes its sign from. Two such
    faces in 13 180 are enough to lose 47% of an eddy-current toolpath; see the
    comment at the flip.

    Vertex normals are kept when the input has them. Returns a dict of what
    was removed, with the output filename under "mesh".
    """
    # READING THE MESH IS THE SLOW HALF on anything the Keyence produced: an
    # ASCII PLY of a few hundred thousand vertices is parsed a line at a time
    # here, and the cleaning that follows is vectorised numpy over the same
    # data. Reported separately so a run that feels stuck says which of the two
    # it is stuck in.
    with progress_step("reading %s" % (os.path.basename(mesh_in),)) as reading:
        v, n, t = read_ply_mesh(mesh_in)
        reading.result("%d vertices, %d faces" % (len(v), len(t)))
    rep = {"mesh": mesh_out, "faces_in": int(len(t)), "vertices_in": int(len(v))}
    # Non-finite vertices and the faces that use them, BEFORE anything else:
    # every measurement below (edge keys, areas, components) is meaningless on
    # a NaN, and the planner does not merely refuse such a mesh, it dies on it.
    finite_v = np.isfinite(v).all(axis=1)
    if n is not None:
        finite_v &= np.isfinite(n).all(axis=1)
    rep["nonfinite_vertices"] = int((~finite_v).sum())
    nf_face = ~finite_v[t].all(axis=1)
    rep["faces_on_nonfinite_vertices"] = int(nf_face.sum())
    t = t[~nf_face]
    # Zero-area faces: they have no normal, so normal estimation invents one and
    # the slicer can cross them without producing a usable direction.
    cr = np.cross(v[t[:, 1]] - v[t[:, 0]], v[t[:, 2]] - v[t[:, 0]])
    area = 0.5*np.linalg.norm(cr, axis=1)
    degen = area <= 0.0
    rep["degenerate_faces"] = int(degen.sum())
    t = t[~degen]
    e = np.sort(np.vstack([t[:, [0, 1]], t[:, [1, 2]], t[:, [2, 0]]]), axis=1)
    key = e[:, 0]*int(len(v)) + e[:, 1]
    uk, inv, cnt = np.unique(key, return_inverse=True, return_counts=True)
    bad_edge = cnt[inv] >= 3
    bad_face = bad_edge.reshape(3, -1).any(axis=0)
    rep["nonmanifold_edges"] = int((cnt >= 3).sum())
    rep["faces_on_nonmanifold_edges"] = int(bad_face.sum())
    t = t[~bad_face]
    # Connected components over shared vertices (union-find, path halving).
    par = np.arange(len(v))

    def find(a):
        while par[a] != a:
            par[a] = par[par[a]]
            a = par[a]
        return a
    # THE ONE PURE-PYTHON LOOP IN THIS FUNCTION, and it is over every face.
    # Milliseconds on the 23 000-face Poisson mesh, seconds on a dense one, and
    # it is the only part of the cleaning that is not vectorised numpy -- so it
    # is the part that goes quiet. step() costs a counter increment and a
    # compare; see the fast-path note in progress.dpi.
    with progress("finding connected components", total=len(t),
                  unit="faces") as comp:
        for tri in t:
            r0 = find(tri[0])
            for k in (1, 2):
                r = find(tri[k])
                if r != r0:
                    par[r] = r0
            comp.step()
    lab = np.array([find(a) for a in t[:, 0]])
    ul, lc = np.unique(lab, return_counts=True)
    keep_lab = ul[lc >= min_component_fraction*len(t)]
    keep = np.isin(lab, keep_lab)
    rep["components"] = int(len(ul))
    rep["components_kept"] = int(len(keep_lab))
    rep["faces_in_small_components"] = int((~keep).sum())
    t = t[keep]
    # FACES WOUND AGAINST THE SURFACE'S OWN NORMALS ARE TURNED ROUND.
    #
    # TWO FACES IN THIRTEEN THOUSAND COST HALF A TOOLPATH, measured on a
    # cylinder. The signed distance a clearance check uses takes its
    # SIGN from the nearest face's winding, and the gate takes the MINIMUM over
    # every sample point of the tooling -- about 120 000 of them. So one face
    # pointing the wrong way makes a link 200 mm clear of the part report as
    # 200 mm inside it, and every pose whose tooling passes near that face is
    # dropped. 0.02% of the faces cost 47% of the eddy-current path.
    #
    # The vertex normals decide, not "make them all point up": a closed mesh
    # legitimately has downward faces underneath it, and flipping those would
    # invert the whole underside. The reconstruction writes normals that are
    # already oriented (reconstruction_srv.py flips its point normals to +Z
    # before meshing), so a face whose winding opposes the mean of its own
    # three vertex normals is wound wrong whatever shape the mesh is.
    rep["faces_rewound"] = 0
    rep["faces_turned_up"] = 0
    if n is not None and len(t):
        fn = np.cross(v[t[:, 1]] - v[t[:, 0]], v[t[:, 2]] - v[t[:, 0]])
        vn = n[t].mean(axis=1)
        agree = np.einsum("ij,ij->i", fn, vn)
        flip = agree < 0.0
        rep["faces_rewound"] = int(flip.sum())
        if flip.any():
            t = t.copy()
            t[flip] = t[flip][:, [0, 2, 1]]

        # AND THE ONES WHOSE NORMALS ARE WRONG TOO. The pass above trusts the
        # vertex normals; a face whose winding and normals BOTH point into the
        # part is not caught by it, and four such faces in 27 771 are still
        # worth 17.5% of an eddy-current path after the rest have been turned
        # round.
        #
        # ONLY ON A SURFACE THAT SAYS IT IS A HEIGHT FIELD. If nearly every
        # vertex normal in the mesh points up, the mesh was measured from above
        # and a downward face is an artefact. If they do not -- a closed TSDF of
        # a whole part, where half the surface legitimately faces down -- this
        # does nothing at all, because flipping the underside of a closed mesh
        # is exactly the damage the normals-based pass exists to avoid.
        up = float((n[:, 2] > 0.0).mean())
        if up >= GATE_HEIGHT_FIELD_UP_FRACTION:
            fn2 = np.cross(v[t[:, 1]] - v[t[:, 0]], v[t[:, 2]] - v[t[:, 0]])
            down = fn2[:, 2] < 0.0
            rep["faces_turned_up"] = int(down.sum())
            if down.any():
                t = t.copy()
                t[down] = t[down][:, [0, 2, 1]]
                n = n.copy()
                bad = np.unique(t[down].ravel())
                n[bad] = np.where(n[bad][:, 2:3] < 0.0, -n[bad], n[bad])
        rep["height_field_up_fraction"] = up

    used = np.unique(t.ravel())
    remap = -np.ones(len(v), dtype=np.int64)
    remap[used] = np.arange(len(used))
    v2, t2 = v[used], remap[t]
    n2 = n[used] if n is not None else None
    rep["faces_out"] = int(len(t2))
    rep["vertices_out"] = int(len(v2))
    props = [("x", "<f8"), ("y", "<f8"), ("z", "<f8")]
    if n2 is not None:
        props += [("nx", "<f8"), ("ny", "<f8"), ("nz", "<f8")]
    vd = np.zeros(len(v2), dtype=np.dtype(props))
    vd["x"], vd["y"], vd["z"] = v2[:, 0], v2[:, 1], v2[:, 2]
    if n2 is not None:
        vd["nx"], vd["ny"], vd["nz"] = n2[:, 0], n2[:, 1], n2[:, 2]
    fd = np.zeros(len(t2), dtype=np.dtype([("n", "u1"), ("v", "<u4", 3)]))
    fd["n"] = 3
    fd["v"] = t2
    head = ["ply", "format binary_little_endian 1.0",
            "comment clean_mesh_for_planning(%s)" % (os.path.basename(mesh_in),),
            "element vertex %d" % len(v2)]
    head += ["property double %s" % c for c, _ in props]
    head += ["element face %d" % len(t2), "property list uchar uint vertex_indices",
             "end_header"]
    with open(mesh_out, "wb") as f:
        f.write(("\n".join(head) + "\n").encode("ascii"))
        f.write(vd.tobytes())
        f.write(fd.tobytes())
    # WHAT IT DROPPED, on one line, next to the progress lines rather than in a
    # dict the caller may or may not print. Each of these four numbers is a
    # different cause with a different fix, and a mesh that loses most of itself
    # here is a reconstruction problem rather than a planning one.
    turned = ""
    if rep.get("faces_rewound") or rep.get("faces_turned_up"):
        turned = ("; %d face(s) REWOUND against the surface normals"
                  % (rep["faces_rewound"],))
        if rep.get("faces_turned_up"):
            turned += (" and %d TURNED UP on a height field (%.1f%% of its "
                       "normals point up)"
                       % (rep["faces_turned_up"],
                          100.0*rep.get("height_field_up_fraction", 0.0)))
        turned += (" -- a face the wrong way round makes a clearance check "
                   "read the tool as inside the part")
    progress_note(
        "cleaned %s: %d -> %d vertices, %d -> %d faces "
        "(%d on non-finite vertices, %d degenerate, %d on non-manifold edges, "
        "%d in small components; %d of %d components kept)%s"
        % (os.path.basename(mesh_in), rep["vertices_in"], rep["vertices_out"],
           rep["faces_in"], rep["faces_out"],
           rep["faces_on_nonfinite_vertices"], rep["degenerate_faces"],
           rep["faces_on_nonmanifold_edges"], rep["faces_in_small_components"],
           rep["components_kept"], rep["components"], turned))
    return rep

# ==============================================================================
# THE MESH'S OWN NORMALS: REPAIRED, NOT FILTERED
# ==============================================================================
# THE RULE, which is the specification for everything in this section:
#
#   The eddy-current probe's tilt must always be ZERO with respect to the
#   CORRECT surface normal. Any connected region of a selected surface is a
#   smooth continuous surface, so a mesh of it that is NOT smooth and continuous
#   has something wrong with its normals and must be repaired. The solution is
#   then constrained to those repaired normals; the rule is met by construction
#   and not by filtering the result afterwards.
#
# TWO DIFFERENT QUANTITIES ARE BOTH CALLED "TILT", AND CONFLATING THEM COSTS
# COVERAGE.
#
#   tilt from VERTICAL         legitimately large on a curved part. A surface
#                              that stands at 60 degrees needs a tool axis at 60
#                              degrees and that is CORRECT. Whether the arm can
#                              hold it is a REACHABILITY question -- IK, the
#                              measured cable envelope, the rest of the tooling
#                              clearing the part. EC_MAX_TILT_DEG bounds THIS,
#                              and nothing else.
#   tilt from the SURFACE      must be ZERO. Always. A contact probe tilted with
#   NORMAL                     respect to the surface it is measuring is a bad
#                              measurement whatever the surface is doing.
#
# EC_MAX_TILT_DEG must not be asked to do both jobs. Bounding tilt from vertical
# and DROPPING every waypoint over the bound pays coverage for a measurement
# error: on an essentially flat surface that removed 1804 of 67672 waypoints,
# and those waypoints were not steep surface, they were BAD NORMALS. A cap is
# the wrong instrument for a normals problem.
#
# SO THE NORMALS ARE REPAIRED, AT THE MESH, BEFORE THE PLANNER EVER SEES IT, AND
# THE TOOL AXIS IS THEN CONSTRAINED TO THE REPAIRED NORMAL BY CONSTRUCTION. Four
# pieces, in this order, and each one has exactly one job:
#
#   1. repair_mesh_normals()             THE REPAIR. Here. Per connected
#                                        component, from a local surface fit to
#                                        the mesh's POSITIONS. The only thing in
#                                        the chain allowed to decide a normal is
#                                        wrong and change it.
#   2. scanpath_from_noether(            THE CONSTRAINT. The tool axis IS the
#          orient="normal")              repaired normal at the waypoint, so
#                                        tilt-relative-to-normal is zero by
#                                        construction rather than by filtering.
#   3. assert_probe_normal_to_surface()  THE POSTCONDITION. angle(probe axis,
#                                        surface normal) over every waypoint,
#                                        reported as a number, every plan.
#   4. sanitize_tool_axis()              AN ASSERTION, not a second repair --
#      (mesh_scan.dpi)                   see the division of labour written down
#                                        in its own docstring.
#
# WHY A FIT TO POSITIONS AND NOT AN AVERAGE OF NORMALS. The fault this has to
# survive is four consecutive waypoints of one 35-point pass carrying
# near-horizontal axes ALTERNATING IN SIGN -- (-0.99,-0.12,+0.02),
# (+0.99,+0.12,+0.01), (-0.99,-0.10,+0.08), (-0.99,-0.11,+0.00) -- between
# neighbours tilted 2.4 and 9.6 degrees. A MEAN across that describes nothing
# and drags the good neighbours with it: EC_AXIS_SMOOTHING_M's box mean still
# lets 55 degrees through. A MEDIAN survives it (sanitize_tool_axis()) but it is
# still an estimator OF THE BAD DATA. The positions, meanwhile, are fine -- the
# same mesh's vertices describe a surface flat to half a millimetre -- so the
# reference normal is taken from a SURFACE FITTED TO THE POSITIONS over a
# geodesic neighbourhood, which never reads a normal at all and therefore cannot
# be fooled by any number of bad ones.
#
# WHAT SURVIVES THE REPAIR, DELIBERATELY. A discontinuity BETWEEN connected
# components is real geometry -- the part and the bench are not one smooth
# surface -- so nothing is ever propagated, fitted or voted across a component
# boundary. Within one component the smoothness assumption holds and is applied.

#: The geodesic neighbourhood the local surface fit is taken over, metres. The
#: same 6 mm as EC_AXIS_SMOOTHING_M and MESH_AXIS_WINDOW_M, and for the same
#: reason: it is the scale on which this cell's reconstructions are smooth and
#: their artefacts are not. At the Keyence mesh's ~1.4 mm median edge that is
#: 4 rings, ~40 vertices, which is a well-conditioned quadric fit.
global NORMAL_REPAIR_RADIUS_M
NORMAL_REPAIR_RADIUS_M = 0.006

#: How far a vertex normal may disagree with the local surface fit before it is
#: called an artefact and replaced, degrees. Set from the distribution of
#: exactly that quantity on real reconstructed meshes -- see
#: mesh_axis_sanity_test.py, which pins it -- where the part's own surface
#: disagrees with its own neighbourhood by a THIRD of a degree at p99.9 and the
#: artefacts sit at 80 and above. 15 degrees is forty-five times the former and
#: a fifth of the latter, so there is no value in this range that changes the
#: answer. It is the same threshold MESH_AXIS_OUTLIER_DEG uses downstream, kept
#: equal on purpose: the two measure the same disagreement, one on the mesh and
#: one on the path, and a reader should not have to hold two numbers.
global NORMAL_REPAIR_TOL_DEG
NORMAL_REPAIR_TOL_DEG = 15.0

#: Ceiling on the ring count the radius is turned into. A coarse mesh (the Azure
#: reconstructions are all 6.00 mm median edge) would otherwise ask for one ring
#: and a fine one for dozens; the fit wants neighbours, not metres, once the
#: neighbourhood is bigger than the artefacts.
global NORMAL_REPAIR_MAX_RINGS
NORMAL_REPAIR_MAX_RINGS = 4

#: Neighbours a vertex needs before the quadric term is trusted. Six coefficients
#: need six points; ten is the margin that keeps the fit from interpolating.
#: Below it the vertex keeps the plane fit, which is the same fit to first order.
global NORMAL_REPAIR_MIN_FIT
NORMAL_REPAIR_MIN_FIT = 10

#: Extra rings a vertex that is still short of NORMAL_REPAIR_MIN_FIT may be given,
#: and only that vertex. The four CORNERS of a rectangular patch are where this
#: bites: the k-ring there is a quarter sector, and on a synthetic crown 8
#: vertices of 2091 come out with 9 neighbours where the interior has 19. Those 8
#: fall back to a plane fit and are the WHOLE of a 3.17 degree error against the
#: analytic normal -- a plane over a one-sided neighbourhood puts the curvature
#: into the slope, which is a tilt. Growing the ball only where it is too small
#: keeps the 6 mm scale everywhere it can be kept.
global NORMAL_REPAIR_GROW_RINGS
NORMAL_REPAIR_GROW_RINGS = 3

#: How decisively a vertex's neighbourhood must disagree with its orientation
#: before the sign relaxation flips it, as a fraction of the neighbourhood's own
#: weight. Any value above 0 makes the relaxation terminate -- see the energy
#: argument in mesh_reference_normals().
global NORMAL_REPAIR_SIGN_MARGIN
NORMAL_REPAIR_SIGN_MARGIN = 0.2

#: Sweeps of that relaxation. It settles in two or three on a measured part; the
#: bound is here so a pathological mesh cannot spin.
global NORMAL_REPAIR_SIGN_SWEEPS
NORMAL_REPAIR_SIGN_SWEEPS = 24

#: How many vertices the fit is done for at a time. MEMORY, and nothing else:
#: at 4 rings a vertex has about 61 neighbours, so a 360 000-vertex mesh has 22
#: million (i, j) pairs and the quadric's design matrix alone is 6 float64 each.
#: Measured unblocked: 40 000 vertices 6.0 s / 0.6 GB, 160 000 31 s / 2.2 GB,
#: 360 000 59 s / 5.1 GB -- and a planning stage that reaches 8.4 GB is
#: OOM-killed on the cell PC, losing every earlier stage of the run. 50 000
#: holds the peak near half a gigabyte and changes not one number, because the
#: block restricts only the CENTRE of a neighbourhood and never its members.
global NORMAL_REPAIR_BLOCK
NORMAL_REPAIR_BLOCK = 50000

#: Ceiling on the (vertex, neighbour) pair list ONE BLOCK's geodesic neighbourhood
#: is built as, so that a pathological mesh loses a RING rather than the process
#: losing its memory. It is the backstop behind NORMAL_REPAIR_BLOCK rather than
#: the primary bound: 50 000 centres at 61 neighbours is 3 million pairs, so on
#: anything with a normal vertex degree this never fires. What it catches is a
#: mesh where one vertex has hundreds of neighbours -- a stitched or badly
#: decimated one -- and a ring that would then cost gigabytes. When it does fire,
#: the fit is over a smaller ball than asked for and
#: describe_normal_repair() says so rather than letting the number pass as a
#: 6 mm fit.
global NORMAL_REPAIR_MAX_PAIRS
NORMAL_REPAIR_MAX_PAIRS = 30000000

#: The postcondition's tolerance, degrees: how far the probe axis may sit from
#: the surface normal at a waypoint before the plan is called wrong. Not zero,
#: because the normal is SAMPLED from a triangulated surface and the surface
#: itself is only piecewise linear -- on a 60 mm radius meshed at 2 mm edges the
#: interpolated normal differs from the analytic one by about 0.01 deg, and on a
#: flat part by 1e-13. 1 degree is a hundred times the former.
global PROBE_NORMAL_TOL_DEG
PROBE_NORMAL_TOL_DEG = 1.0

#: How close to straight DOWN a surface normal may come before a locked roll is
#: called undefined, degrees. regularize_tool_roll(mode="locked") refuses at
#: 0.08 deg (its own 1 - 0.999999 test); this is the margin at which the refusal
#: is raised where the CAUSE is visible -- a surface facing the floor -- instead
#: of as a pose index out of the roll code.
global LOCKED_ROLL_GUARD_DEG
LOCKED_ROLL_GUARD_DEG = 0.5

global last_normal_repair_report
last_normal_repair_report = None


global _vertex_adjacency
def _vertex_adjacency(nv, t):
    """CSR (indptr, indices) of every vertex's 1-ring, both directions.

    np.unique over packed i*nv + j keys, which sorts by i and then by j, so the
    de-duplicated neighbour list is already grouped and indptr is a cumulative
    bincount. No Python loop: this runs on the biggest mesh the cell produces.
    """
    t = np.asarray(t, dtype=np.int64).reshape(-1, 3)
    nv = int(nv)
    if nv <= 0 or not len(t):
        return np.zeros(nv + 1, dtype=np.int64), np.zeros(0, dtype=np.int64)
    a = np.concatenate([t[:, 0], t[:, 1], t[:, 2], t[:, 1], t[:, 2], t[:, 0]])
    b = np.concatenate([t[:, 1], t[:, 2], t[:, 0], t[:, 0], t[:, 1], t[:, 2]])
    key = np.unique(a*np.int64(nv) + b)
    a = key//np.int64(nv)
    b = (key % np.int64(nv)).astype(np.int64)
    indptr = np.zeros(nv + 1, dtype=np.int64)
    np.cumsum(np.bincount(a, minlength=nv), out=indptr[1:])
    return indptr, b


global _gather_neighbours
def _gather_neighbours(indptr, indices, verts):
    """(row, neighbour) for every neighbour of every vertex in `verts`.

    `row` indexes into `verts`, not into the mesh, so this composes: hand it the
    far end of a pair list and it grows the pair list by one ring.
    """
    verts = np.asarray(verts, dtype=np.int64)
    if not len(verts):
        return np.zeros(0, dtype=np.int64), np.zeros(0, dtype=np.int64)
    deg = (indptr[verts + 1] - indptr[verts]).astype(np.int64)
    tot = int(deg.sum())
    if tot == 0:
        return np.zeros(0, dtype=np.int64), np.zeros(0, dtype=np.int64)
    row = np.repeat(np.arange(len(verts), dtype=np.int64), deg)
    csum = np.cumsum(deg)
    off = np.arange(tot, dtype=np.int64) - np.repeat(csum - deg, deg)
    nb = indices[np.repeat(indptr[verts], deg) + off]
    return row, nb.astype(np.int64)


global _geodesic_pairs
def _geodesic_pairs(indptr, indices, nv, rings, max_pairs=None, centres=None):
    """(i, j, rings_used): every vertex j within `rings` mesh edges of i, i too.

    A HARD geodesic ball with UNIFORM membership, not a diffusion weight. The
    difference matters: repeated neighbour-summing is cheaper but weights the
    centre vertex by the number of walks that return to it, which on a degree-6
    mesh is a few hundred by the third ring -- so the "6 mm fit" would in truth
    be a 1-ring fit wearing a 6 mm label, with about a fifth of the resistance
    to a locally wrong patch that a 6 mm fit is supposed to have.

    Grown by composing the pair list with the adjacency and de-duplicating the
    packed keys. `rings_used` is below `rings` when max_pairs stopped the growth,
    and the caller reports it rather than silently fitting a smaller ball.

    `centres` restricts i to a subset -- which is how mesh_reference_normals()
    stays inside a memory budget on a mesh of a few hundred thousand vertices. j
    still ranges over the whole mesh, so a block's answers are identical to the
    whole mesh's; only the peak working set differs.
    """
    max_pairs = NORMAL_REPAIR_MAX_PAIRS if max_pairs is None else int(max_pairs)
    nv = int(nv)
    s = (np.arange(nv, dtype=np.int64) if centres is None
         else np.asarray(centres, dtype=np.int64).reshape(-1))
    keys = s*np.int64(nv) + s
    used = 0
    for _ in range(int(rings)):
        i = keys//np.int64(nv)
        j = keys % np.int64(nv)
        row, nb = _gather_neighbours(indptr, indices, j)
        if not len(nb):
            break
        grown = np.union1d(keys, i[row]*np.int64(nv) + nb)
        if len(grown) > max_pairs:
            break
        keys = grown
        used += 1
    return keys//np.int64(nv), (keys % np.int64(nv)).astype(np.int64), used


global mesh_vertex_components
def mesh_vertex_components(nv, t):
    """A connected-component label per vertex, over shared vertices.

    A connected region of a selected surface is assumed to be one smooth
    continuous surface, so the component is the unit the repair works in and the
    boundary it never crosses. THE LABELS ARE THE VERTEX WITH
    THE SMALLEST INDEX in each component, which makes them stable across runs.

    Shiloach-Vishkin hook-and-compress in numpy rather than the union-find loop
    clean_mesh_for_planning() uses: that loop is over every face in Python and is
    the one part of the cleaning that goes quiet, and this is asked for on every
    plan.
    """
    nv = int(nv)
    t = np.asarray(t, dtype=np.int64).reshape(-1, 3)
    lab = np.arange(nv, dtype=np.int64)
    if nv <= 0 or not len(t):
        return lab
    e0 = np.concatenate([t[:, 0], t[:, 1], t[:, 2]])
    e1 = np.concatenate([t[:, 1], t[:, 2], t[:, 0]])
    for _ in range(64):
        m = lab.copy()
        np.minimum.at(m, e0, lab[e1])
        np.minimum.at(m, e1, lab[e0])
        for _ in range(64):                 # compress: pointer jumping
            m2 = m[m]
            if np.array_equal(m2, m):
                break
            m = m2
        if np.array_equal(m, lab):
            return lab
        lab = m
    return lab


global _normal_edge_turn_deg
def _normal_edge_turn_deg(n, t):
    """Angle between the normals at the two ends of every mesh edge, degrees.

    THIS IS THE NUMBER "SMOOTH AND CONTINUOUS" MEANS: a mesh whose normals turn
    sharply across an edge has something wrong with those normals, and that is
    what the repair is judged by. A mesh edge joins two vertices of one
    component by definition, so no component filter is
    needed or wanted here -- an edge IS the statement that these two points are
    the same surface.
    """
    t = np.asarray(t, dtype=np.int64).reshape(-1, 3)
    n = np.asarray(n, dtype=np.float64).reshape(-1, 3)
    if not len(t):
        return np.zeros(0)
    a = np.concatenate([t[:, 0], t[:, 1], t[:, 2]])
    b = np.concatenate([t[:, 1], t[:, 2], t[:, 0]])
    key = np.unique(np.minimum(a, b)*np.int64(len(n)) + np.maximum(a, b))
    i = key//np.int64(len(n))
    j = key % np.int64(len(n))
    nn = n/np.maximum(np.linalg.norm(n, axis=1, keepdims=True), 1e-300)
    return np.degrees(np.arccos(np.clip(
        np.einsum("ij,ij->i", nn[i], nn[j]), -1.0, 1.0)))


global _pct_stats
def _pct_stats(x):
    """{p50, p95, p99, p999, max} of an array, or None if it is empty."""
    x = np.asarray(x, dtype=np.float64).ravel()
    if not len(x):
        return None
    return {"p50": float(np.percentile(x, 50)),
            "p95": float(np.percentile(x, 95)),
            "p99": float(np.percentile(x, 99)),
            "p999": float(np.percentile(x, 99.9)),
            "max": float(x.max()), "n": int(len(x))}


global mesh_reference_normals
def mesh_reference_normals(v, t, radius_m=None, rings=None, seed_normals=None,
                           up=(0.0, 0.0, 1.0), labels=None, min_fit=None,
                           sign_margin=None, sign_sweeps=None):
    """A smooth normal field for a mesh, from its POSITIONS ALONE. -> (n, info)

    NOT AN AVERAGE OF THE MESH'S NORMALS. Not a median of them either. The
    normals are never read except to pick a global sign per component, so no
    number of wrong ones can move the answer -- which is the whole point, since
    the fault being repaired is normals that alternate in sign between
    neighbours.

    Three stages, all of them vectorised over the whole mesh:

      1. A PLANE, from the weighted covariance of the geodesic neighbourhood's
         positions. Its smallest eigenvector is the local normal to first order
         and its other two are a tangent frame.

      2. A QUADRIC IN THAT FRAME, h = c0 + c1 a + c2 b + c3 a^2 + c4 ab + c5 b^2,
         and the reported normal is ITS normal at the vertex: n = n0 - c1 u - c2 v,
         normalised. This is what makes the fit correct on a CURVED part rather
         than merely smooth: a plane fitted over a one-sided neighbourhood at the
         end of a pass on a 60 mm radius leans by about (3/8)h/R -- 1.1 deg at a
         3 mm half-width -- and a quadric does not, because the curvature is in
         the model instead of in the residual. Local coordinates are divided by
         the neighbourhood's own rms radius before the fit, which is what keeps
         the 6x6 normal equations conditioned at 1e2 instead of 1e12.

         Fewer than `min_fit` neighbours, or a fitted slope past 3 (72 deg inside
         one neighbourhood, which is not a smooth surface), falls back to the
         plane and is counted in info["quadric_fallback"].

      3. A SIGN, consistent within each component and NEVER ACROSS ONE. An
         eigenvector has no sign, so one has to be chosen. It is seeded from the
         mesh's own normals where it has them -- a reconstruction orients its
         point normals before meshing, so the seed is nearly right and this is
         the one and only use made of the numbers being repaired -- and then
         relaxed over the 1-RING: a vertex flips when its immediate neighbours,
         weighted by |dot| so that a crease counts for little and a flat
         neighbour for everything, disagree with it by more than `sign_margin`
         of that weight. The 1-ring and not the geodesic ball the fit uses,
         because consistency is a CONNECTIVITY property -- a sign that agrees
         across every edge agrees everywhere in the component -- and because this
         is the one stage that cannot be blocked, so it is the one whose pair
         list has to stay at 6 per vertex rather than 61.

         THE RELAXATION TERMINATES, and here is why rather than a hope: flipping
         vertex i changes the agreement energy sum(w_ij e_ij s_i s_j) by
         -2 s_i sum_j(w_ij e_ij s_j) = -2 (vote_i s_i), and the flip condition is
         exactly vote_i s_i < -margin * tot_i < 0, so every flip raises a bounded
         energy by at least 2 margin tot_i. sign_sweeps is a belt, not the brace.

         Then each component as a whole is turned to agree with its seed (or with
         `up` when there is none), which is the only decision taken at component
         scale and the only one that could be taken there: whether a component
         faces up or down is not a local property.

    Stages 1 and 2 run in blocks of NORMAL_REPAIR_BLOCK vertices, which is a
    MEMORY bound and nothing else: the block restricts which vertex a
    neighbourhood is CENTRED on and never which vertices are in it, so the
    answer is identical to the bit at any block size and
    mesh_normal_repair_test.py asserts that rather than trusting it.

    info carries rings, rings_used, grown_rings, radius_m, median_edge_m,
    neighbours (median per vertex), short_neighbourhoods, quadric_fallback,
    sign_relaxation_flips, sign_sweeps_used, sign_converged, components and
    components_flipped.
    """
    v = np.asarray(v, dtype=np.float64).reshape(-1, 3)
    t = np.asarray(t, dtype=np.int64).reshape(-1, 3)
    nv = len(v)
    min_fit = NORMAL_REPAIR_MIN_FIT if min_fit is None else float(min_fit)
    sign_margin = (NORMAL_REPAIR_SIGN_MARGIN if sign_margin is None
                   else float(sign_margin))
    sign_sweeps = (NORMAL_REPAIR_SIGN_SWEEPS if sign_sweeps is None
                   else int(sign_sweeps))
    upv = np.asarray(up, dtype=np.float64).reshape(3)
    upv = upv/max(float(np.linalg.norm(upv)), 1e-300)
    info = {}
    indptr, indices = _vertex_adjacency(nv, t)
    row, nb = _gather_neighbours(indptr, indices, np.arange(nv, dtype=np.int64))
    edge_len = (np.linalg.norm(v[nb] - v[row], axis=1) if len(nb)
                else np.zeros(0))
    med_edge = float(np.median(edge_len[edge_len > 0.0])) if (edge_len > 0).any() else 0.0
    info["median_edge_m"] = med_edge
    radius = NORMAL_REPAIR_RADIUS_M if radius_m is None else float(radius_m)
    info["radius_m"] = radius
    if rings is None:
        rings = 1 if med_edge <= 0.0 else int(round(radius/med_edge))
        rings = max(1, min(rings, int(NORMAL_REPAIR_MAX_RINGS)))
    info["rings"] = int(rings)

    # --- 1 and 2, PER BLOCK OF VERTICES --------------------------------------
    # THE ONLY REASON THIS IS BLOCKED IS MEMORY, and the reason it has to be is
    # measured: at 4 rings a vertex has about 61 neighbours, so a 360 000-vertex
    # mesh has 22 million (i, j) pairs, and the quadric's design matrix alone is
    # 6 float64 per pair. Unblocked that peaks at 5.1 GB of RSS, on a machine
    # that OOM-kills a planning stage at 8.4 GB and loses every earlier stage of
    # the run with it. Blocked at 50 000 centres it is 0.5 GB and the arithmetic
    # is bit-identical, because `centres` restricts only i: every neighbour j is
    # still the whole mesh.
    N0 = np.zeros((nv, 3), dtype=np.float64)
    U = np.zeros((nv, 3), dtype=np.float64)
    W = np.zeros((nv, 3), dtype=np.float64)
    A = np.zeros((nv, 3), dtype=np.float64)
    ncount = np.zeros(nv, dtype=np.int64)
    fallback = 0
    grown = 0
    rings_used = int(rings)
    block = max(1, int(NORMAL_REPAIR_BLOCK))
    idx6 = np.arange(6)
    for lo in range(0, nv, block):
        hi = min(lo + block, nv)
        ctr = np.arange(lo, hi, dtype=np.int64)
        pi, pj, got = _geodesic_pairs(indptr, indices, nv, rings, centres=ctr)
        rings_used = min(rings_used, got)
        # ONE MORE RING FOR A VERTEX WHOSE BALL IS TOO SMALL, AND ONLY FOR THAT
        # VERTEX -- see NORMAL_REPAIR_GROW_RINGS for the 3.17 degrees this is
        # worth at the corners of a patch.
        for extra in range(1, int(NORMAL_REPAIR_GROW_RINGS) + 1):
            k0 = np.bincount(pi - lo, minlength=hi - lo)
            short = ctr[k0 < min_fit]
            if not len(short):
                break
            ai, aj, got2 = _geodesic_pairs(indptr, indices, nv, got + extra,
                                           centres=short)
            if got2 <= got + extra - 1:
                break                   # the pair budget stopped the growth
            keys = np.union1d(pi*np.int64(nv) + pj, ai*np.int64(nv) + aj)
            pi = keys//np.int64(nv)
            pj = (keys % np.int64(nv)).astype(np.int64)
            grown = max(grown, extra)
        li = pi - lo
        nb_ = hi - lo
        cnt = np.bincount(li, minlength=nb_).astype(np.float64)
        ncount[lo:hi] = cnt.astype(np.int64)
        cnt = np.maximum(cnt, 1.0)

        # --- the plane ------------------------------------------------------
        S = np.column_stack([np.bincount(li, weights=v[pj, k], minlength=nb_)
                             for k in range(3)])
        c = S/cnt[:, None]
        C = np.zeros((nb_, 3, 3), dtype=np.float64)
        for k in range(3):
            for l in range(k, 3):
                m2 = (np.bincount(li, weights=v[pj, k]*v[pj, l],
                                  minlength=nb_)/cnt - c[:, k]*c[:, l])
                C[:, k, l] = m2
                C[:, l, k] = m2
        _w, E = np.linalg.eigh(C)           # ascending eigenvalues
        n0 = E[:, :, 0]
        u0 = E[:, :, 2]
        w0 = E[:, :, 1]

        # --- the quadric in that frame --------------------------------------
        d = v[pj] - v[pi]
        aa = np.einsum("ij,ij->i", d, u0[li])
        bb = np.einsum("ij,ij->i", d, w0[li])
        hh = np.einsum("ij,ij->i", d, n0[li])
        r2 = np.bincount(li, weights=aa*aa + bb*bb, minlength=nb_)/cnt
        sc = np.sqrt(np.maximum(r2, 1e-24))[li]
        an, bn, hn = aa/sc, bb/sc, hh/sc
        B = np.column_stack([np.ones(len(an)), an, bn, an*an, an*bn, bn*bn])
        G = np.zeros((nb_, 6, 6), dtype=np.float64)
        rhs = np.zeros((nb_, 6), dtype=np.float64)
        for k in range(6):
            rhs[:, k] = np.bincount(li, weights=B[:, k]*hn, minlength=nb_)
            for l in range(k, 6):
                g = np.bincount(li, weights=B[:, k]*B[:, l], minlength=nb_)
                G[:, k, l] = g
                G[:, l, k] = g
        G[:, idx6, idx6] += (1e-9*np.trace(G, axis1=1, axis2=2)/6.0)[:, None] + 1e-30
        try:
            coef = np.linalg.solve(G, rhs[:, :, None])[:, :, 0]
        except np.linalg.LinAlgError:
            coef = np.zeros((nb_, 6), dtype=np.float64)
            info["quadric_solve_failed"] = True
        grad = coef[:, 1:3]
        # A slope past 3 is 72 degrees of surface inside one neighbourhood, which
        # is not the smooth surface the fit assumes; that vertex keeps the plane,
        # which is the same fit to first order.
        okq = (np.bincount(li, minlength=nb_) >= min_fit)
        okq &= np.isfinite(grad).all(axis=1)
        okq &= (np.abs(grad) <= 3.0).all(axis=1)
        fallback += int((~okq).sum())
        blk = n0 - grad[:, 0:1]*u0 - grad[:, 1:2]*w0
        blk = np.where(okq[:, None], blk, n0)
        N0[lo:hi] = n0
        U[lo:hi] = u0
        W[lo:hi] = w0
        A[lo:hi] = blk/np.maximum(np.linalg.norm(blk, axis=1, keepdims=True),
                                  1e-300)
    info["rings_used"] = int(rings_used)
    info["grown_rings"] = int(grown)
    info["short_neighbourhoods"] = int((ncount < min_fit).sum())
    info["neighbours"] = float(np.median(ncount)) if nv else 0.0
    info["quadric_fallback"] = int(fallback)

    # --- 3. the sign, over the 1-RING ----------------------------------------
    # The 1-ring and not the k-ring ball, for two reasons. Consistency is a
    # CONNECTIVITY property -- a sign that agrees across every edge agrees
    # everywhere in the component, and the extra rings add nothing an edge does
    # not already say. And it is the one stage that cannot be blocked, since a
    # sweep reads its neighbours' current signs, so it is the one stage whose pair
    # list has to be small: 6 pairs a vertex instead of 61.
    pio, pjo = _gather_neighbours(indptr, indices,
                                  np.arange(nv, dtype=np.int64))
    e = np.einsum("ij,ij->i", A[pio], A[pjo])
    wo = np.abs(e)
    eo = np.where(e < 0.0, -1.0, 1.0)
    tot = np.maximum(np.bincount(pio, weights=wo, minlength=nv), 1e-300)
    if seed_normals is not None:
        sn = np.asarray(seed_normals, dtype=np.float64).reshape(-1, 3)
        slen = np.linalg.norm(sn, axis=1)
        sn = sn/np.maximum(slen[:, None], 1e-300)
        tgt = np.einsum("ij,ij->i", A, sn)
        tgt = np.where(slen > 0.0, tgt, A.dot(upv))
    else:
        tgt = A.dot(upv)
    s = np.where(tgt < 0.0, -1.0, 1.0)
    flips = 0
    sweeps = 0
    bad = np.zeros(nv, dtype=bool)
    for sweeps in range(1, sign_sweeps + 1):
        vote = np.bincount(pio, weights=wo*eo*s[pjo], minlength=nv)
        bad = (vote*s) < -float(sign_margin)*tot
        if not bad.any():
            break
        s[bad] *= -1.0
        flips += int(bad.sum())
    info["sign_relaxation_flips"] = int(flips)
    info["sign_sweeps_used"] = int(sweeps)
    info["sign_converged"] = bool(not bad.any())
    labels = mesh_vertex_components(nv, t) if labels is None else np.asarray(labels)
    ul, linv = np.unique(labels, return_inverse=True)
    linv = np.asarray(linv).ravel()
    comp = np.bincount(linv, weights=s*tgt, minlength=len(ul))
    flipc = comp < 0.0
    s = s*np.where(flipc[linv], -1.0, 1.0)
    info["components"] = int(len(ul))
    info["components_flipped"] = int(flipc.sum())
    return A*s[:, None], info


global repair_mesh_normals
def repair_mesh_normals(mesh_in, mesh_out=None, tol_deg=None, radius_m=None,
                        rings=None, up=(0.0, 0.0, 1.0), verbose=True,
                        rewind_faces=True, write=True):
    """Repair a mesh's normals against a local surface fit. -> report dict

    A vertex normal more than `tol_deg` from the fitted surface's own normal is
    an artefact and is REPLACED by it. One that agrees is left exactly alone --
    so real detail at the mesh's own resolution survives, and a mesh that is
    already right comes out byte-identical in its normals.

    Faces are then rewound to agree with the repaired normals, which is what the
    signed distance in every clearance check takes its sign from. That pass
    already existed in clean_mesh_for_planning(), where it trusts the mesh's own
    normals; here it trusts the repaired ones, which is the case that pass could
    not handle -- "a face whose winding and normals BOTH point into the part".

    NOTHING IS DROPPED. No vertex, no face, no waypoint. The output has exactly
    the input's geometry and a different normal field.

    mesh_in may be a path or (vertices, normals, triangles). With write=True and
    a path in, the repaired copy goes to `mesh_out`, defaulting to
    <mesh>_normals.ply beside it; report["mesh"] is the file to plan on, which is
    the INPUT path when nothing needed repairing, so a caller can always plan on
    report["mesh"]. report["normals"] is the field itself either way.
    """
    if isinstance(mesh_in, str):
        v, vn, t = read_ply_mesh(mesh_in)
        name = os.path.basename(mesh_in)
    else:
        v, vn, t = mesh_in
        v = np.asarray(v, dtype=np.float64).reshape(-1, 3)
        t = np.asarray(t, dtype=np.int64).reshape(-1, 3)
        vn = None if vn is None else np.asarray(vn, dtype=np.float64).reshape(-1, 3)
        name = "<arrays>"
    tol = NORMAL_REPAIR_TOL_DEG if tol_deg is None else float(tol_deg)
    labels = mesh_vertex_components(len(v), t)
    ref, info = mesh_reference_normals(v, t, radius_m=radius_m, rings=rings,
                                       seed_normals=vn, up=up, labels=labels)
    rep = {"source": name, "tol_deg": tol, "vertices": int(len(v)),
           "faces": int(len(t)), "had_normals": vn is not None}
    rep.update(info)

    if vn is None:
        # A MESH WITH NO NORMALS IS NOT A MESH WITH GOOD NORMALS. The planner
        # would estimate them itself, and on a measured mesh that puts about 16%
        # of the poses facing INTO the part against 0% from the mesh's own -- so
        # the whole field is written rather than left to be guessed downstream.
        before = None
        out = ref.copy()
        bad = np.ones(len(v), dtype=bool)
    else:
        ln = np.linalg.norm(vn, axis=1)
        unit = vn/np.maximum(ln[:, None], 1e-300)
        before = np.degrees(np.arccos(np.clip(
            np.einsum("ij,ij->i", unit, ref), -1.0, 1.0)))
        before = np.where(ln > 0.0, before, 180.0)
        bad = before > tol
        out = unit.copy()
        out[bad] = ref[bad]
    after = np.degrees(np.arccos(np.clip(
        np.einsum("ij,ij->i", out, ref), -1.0, 1.0)))
    rep["replaced"] = int(bad.sum())
    rep["replaced_fraction"] = float(bad.mean()) if len(bad) else 0.0
    rep["backwards_before"] = (0 if before is None
                               else int((before > 90.0).sum()))
    rep["disagreement_before"] = _pct_stats(before) if before is not None else None
    rep["disagreement_after"] = _pct_stats(after)
    rep["edge_turn_before"] = (_pct_stats(_normal_edge_turn_deg(vn, t))
                               if vn is not None else None)
    rep["edge_turn_after"] = _pct_stats(_normal_edge_turn_deg(out, t))

    t_out = t
    rep["faces_rewound"] = 0
    if rewind_faces and len(t):
        fn = np.cross(v[t[:, 1]] - v[t[:, 0]], v[t[:, 2]] - v[t[:, 0]])
        flip = np.einsum("ij,ij->i", fn, out[t].mean(axis=1)) < 0.0
        rep["faces_rewound"] = int(flip.sum())
        if flip.any():
            t_out = t.copy()
            t_out[flip] = t_out[flip][:, [0, 2, 1]]
    rep["normals"] = out
    rep["triangles"] = t_out
    rep["changed"] = bool(rep["replaced"] or rep["faces_rewound"])
    rep["mesh"] = mesh_in if isinstance(mesh_in, str) else None
    if write and isinstance(mesh_in, str) and rep["changed"]:
        target = (os.path.splitext(mesh_in)[0] + "_normals.ply"
                  if mesh_out is None else mesh_out)
        rep["mesh"] = _gate_write_ply(
            target, v, out, t_out,
            "repair_mesh_normals(%s, tol=%.1f deg, %.1f mm fit)"
            % (name, tol, rep.get("radius_m", 0.0)*1e3))
    global last_normal_repair_report
    last_normal_repair_report = rep
    if verbose:
        for line in describe_normal_repair(rep):
            print(line)
    return rep


global describe_normal_repair
def describe_normal_repair(rep=None, indent="  "):
    """The repair, as the lines a scan log should carry."""
    rep = last_normal_repair_report if rep is None else rep
    if rep is None:
        return ["%sno mesh has had its normals repaired yet" % (indent,)]
    out = []
    out.append("%snormals: %d vertices in %d connected component(s), fitted a "
               "local surface over %d ring(s) of a %.1f mm neighbourhood "
               "(%.0f neighbours, %.2f mm median edge)"
               % (indent, rep["vertices"], rep.get("components", 0),
                  rep.get("rings_used", 0), rep.get("radius_m", 0.0)*1e3,
                  rep.get("neighbours", 0.0), rep.get("median_edge_m", 0.0)*1e3))
    b = rep.get("disagreement_before")
    if b is None:
        out.append("%s  the mesh carried NO vertex normals, so all %d are the "
                   "fit's -- the planner would otherwise estimate them, which "
                   "put 16%% of poses facing into the part"
                   % (indent, rep["vertices"]))
    else:
        out.append("%s  %d of %d normals (%.2f%%) disagreed with that surface by "
                   "more than %.0f deg and were REPLACED by it; the "
                   "disagreement ran p50 %.3f, p99 %.2f, p99.9 %.2f, worst %.1f "
                   "deg, and %d pointed the wrong way entirely"
                   % (indent, rep["replaced"], rep["vertices"],
                      100.0*rep["replaced_fraction"], rep["tol_deg"],
                      b["p50"], b["p99"], b["p999"], b["max"],
                      rep.get("backwards_before", 0)))
    eb, ea = rep.get("edge_turn_before"), rep.get("edge_turn_after")
    if ea is not None:
        out.append("%s  SMOOTH AND CONTINUOUS is the test, and it is measured "
                   "across every mesh edge: the normal turns %s deg at p99.9 "
                   "and %s at worst, was %s and %s"
                   % (indent,
                      "%.3f" % ea["p999"], "%.3f" % ea["max"],
                      "n/a" if eb is None else "%.2f" % eb["p999"],
                      "n/a" if eb is None else "%.1f" % eb["max"]))
    if rep.get("faces_rewound"):
        out.append("%s  %d face(s) REWOUND to agree with the repaired normals -- "
                   "a face the wrong way round makes a clearance check read the "
                   "tool as inside the part" % (indent, rep["faces_rewound"]))
    if rep.get("sign_relaxation_flips") or rep.get("components_flipped"):
        out.append("%s  %d normal(s) turned over to agree with their own "
                   "neighbourhood and %d whole component(s) turned over to agree "
                   "with the reconstruction; nothing was propagated ACROSS a "
                   "component, because a step between two components is real "
                   "geometry"
                   % (indent, rep.get("sign_relaxation_flips", 0),
                      rep.get("components_flipped", 0)))
    if not rep.get("sign_converged", True):
        out.append("%s  WARNING: the sign relaxation did not settle in %d sweeps. "
                   "That is a fault in mesh_reference_normals(), not in the mesh."
                   % (indent, rep.get("sign_sweeps_used", 0)))
    if rep.get("quadric_fallback"):
        out.append("%s  %d vertex(es) had too small or too crumpled a "
                   "neighbourhood for the curvature term and kept the plane fit"
                   % (indent, rep["quadric_fallback"]))
    if rep.get("rings_used", 0) < rep.get("rings", 0):
        out.append("%s  WARNING: the neighbourhood was cut to %d ring(s) of the "
                   "%d asked for by NORMAL_REPAIR_MAX_PAIRS. The fit is over a "
                   "smaller ball than %.1f mm and is less able to outvote a wrong "
                   "patch." % (indent, rep["rings_used"], rep["rings"],
                               rep.get("radius_m", 0.0)*1e3))
    if not rep.get("changed"):
        out.append("%s  nothing needed repairing; planning on the mesh as it is"
                   % (indent,))
    elif rep.get("mesh"):
        out.append("%s  planning on %s" % (indent, os.path.basename(str(rep["mesh"]))))
    return out


# ------------------------------------------------------------------------------
# SAMPLING THE REPAIRED FIELD AT A WAYPOINT
# ------------------------------------------------------------------------------
# The constraint and the postcondition both need "the surface normal HERE", at a
# position that is on the surface but is not a vertex -- Noether puts a waypoint
# where a slicing plane crosses a mesh EDGE. Nearest-vertex is not good enough
# for the postcondition to mean anything: on a 60 mm radius meshed at 2 mm edges
# adjacent vertex normals differ by 1.9 deg, so a piecewise-constant sample would
# read 1 deg of error that is not there. So the closest point on the closest
# triangle is found and the three vertex normals are interpolated at it.

global _closest_point_bary
def _closest_point_bary(p, a, b, c):
    """Closest point on each triangle (a,b,c) to p, and its barycentrics.

    -> (q, w) with w = (wa, wb, wc), wa + wb + wc == 1, all >= 0.

    The unconstrained 2x2 least-squares solution when it lands inside the
    triangle, and the best of the three edge clamps when it does not. Vectorised
    over the leading axis; deliberately not tooling_clearance.dpi's
    closest_point_on_triangles(), which returns the point without the weights and
    would make this file depend on that one being included.
    """
    p = np.asarray(p, dtype=np.float64)
    ab, ac, ap = b - a, c - a, p - a
    d00 = np.einsum("...i,...i->...", ab, ab)
    d01 = np.einsum("...i,...i->...", ab, ac)
    d11 = np.einsum("...i,...i->...", ac, ac)
    r0 = np.einsum("...i,...i->...", ab, ap)
    r1 = np.einsum("...i,...i->...", ac, ap)
    det = d00*d11 - d01*d01
    ok = det > 1e-300
    dsafe = np.where(ok, det, 1.0)
    s = np.where(ok, (d11*r0 - d01*r1)/dsafe, 0.0)
    u = np.where(ok, (d00*r1 - d01*r0)/dsafe, 0.0)
    inside = ok & (s >= 0.0) & (u >= 0.0) & (s + u <= 1.0)

    def _seg(p0, p1):
        dd = p1 - p0
        L = np.einsum("...i,...i->...", dd, dd)
        tt = np.clip(np.einsum("...i,...i->...", p - p0, dd)/np.where(L > 1e-300, L, 1.0),
                     0.0, 1.0)
        tt = np.where(L > 1e-300, tt, 0.0)
        return tt, p0 + tt[..., None]*dd

    t_ab, q_ab = _seg(a, b)
    t_ac, q_ac = _seg(a, c)
    t_bc, q_bc = _seg(b, c)
    cand_q = np.stack([q_ab, q_ac, q_bc], axis=-2)
    cand_s = np.stack([t_ab, np.zeros_like(t_ac), 1.0 - t_bc], axis=-1)
    cand_u = np.stack([np.zeros_like(t_ab), t_ac, t_bc], axis=-1)
    d2 = np.einsum("...ij,...ij->...i", cand_q - p[..., None, :],
                   cand_q - p[..., None, :])
    k = np.argmin(d2, axis=-1)
    take = np.take_along_axis(cand_s, k[..., None], axis=-1)[..., 0]
    takeu = np.take_along_axis(cand_u, k[..., None], axis=-1)[..., 0]
    s = np.where(inside, s, take)
    u = np.where(inside, u, takeu)
    q = a + s[..., None]*ab + u[..., None]*ac
    return q, np.stack([1.0 - s - u, s, u], axis=-1)


global _nearest_vertex
def _nearest_vertex(v, p):
    """Index of the nearest vertex to each point. cKDTree, or blocked brute force.

    scipy is already a dependency of this tree (tooling_clearance.dpi builds a
    cKDTree of face centroids), and the cell has 1.15.3. The fallback exists so
    that the geometry in this file can be tested anywhere, and it refuses rather
    than crawling when the product of the two sizes says it would take minutes.
    """
    v = np.asarray(v, dtype=np.float64).reshape(-1, 3)
    p = np.asarray(p, dtype=np.float64).reshape(-1, 3)
    try:
        from scipy.spatial import cKDTree
    except ImportError:
        cKDTree = None
    if cKDTree is not None:
        return np.asarray(cKDTree(v).query(p)[1], dtype=np.int64).reshape(-1)
    if len(v)*len(p) > 100000000:
        raise RuntimeError(
            "sampling %d points against %d vertices needs scipy.spatial.cKDTree; "
            "install scipy or sample fewer points" % (len(p), len(v)))
    out = np.zeros(len(p), dtype=np.int64)
    step = max(1, int(2000000//max(len(v), 1)))
    for lo in range(0, len(p), step):
        blk = p[lo:lo+step]
        d2 = ((blk[:, None, :] - v[None, :, :])**2).sum(axis=2)
        out[lo:lo+step] = np.argmin(d2, axis=1)
    return out


#: How many nearest vertices' incident faces are searched for the closest point
#: on the surface. NOT a tuning knob -- it is the difference between a sampler
#: that answers the question and one that quietly answers a different one.
#:
#: THE CLOSEST TRIANGLE NEED NOT TOUCH THE CLOSEST VERTEX. Looking only at the
#: faces around the nearest vertex is the obvious candidate set and it is wrong
#: wherever a mesh carries thin triangles: a third vertex of some neighbouring
#: sliver sits closer to the query point than either end of the edge the point
#: actually lies on, and the sampler then reads the normal of a triangle the
#: point is nowhere near. Measured on the eddy-current planning meshes in this
#: cell, at the production 0.30 mm line spacing:
#:
#:   nearest vertices searched     waypoints given the wrong triangle
#:   1  (the closest vertex alone)  491 of 33779 (1.45%), up to 1.47 mm away
#:   2                              30
#:   4                              19
#:   8                               6 of 33779 (0.018%), up to 0.42 mm away
#:
#: Those 491 waypoints carried orientation errors up to 11.5 deg while the
#: postcondition read 0.000 deg, because it sampled the same way.
global NORMAL_SAMPLE_VERTICES
NORMAL_SAMPLE_VERTICES = 8

#: Candidate (point, triangle) pairs evaluated at a time. MEMORY, and nothing
#: else: _closest_point_bary() holds about forty float64 per pair, so a
#: 911 511-waypoint plan searched eight vertices deep is 44 million pairs and
#: 16 GB in one go. A million pairs is about 350 MB and the answer is identical.
global NORMAL_SAMPLE_PAIR_BLOCK
NORMAL_SAMPLE_PAIR_BLOCK = 1000000


global sample_mesh_normals
def sample_mesh_normals(surface, points, up=(0.0, 0.0, 1.0), vertices=None):
    """The surface normal at each point, interpolated. -> (normals, distance)

    `surface` is a PLY path or (vertices, normals, triangles). A surface with no
    normals gets mesh_reference_normals() rather than an error, because "the
    normal here" is a question about the geometry and the geometry can answer it.

    The returned normals are unit; `distance` is how far each point was from the
    surface, which is the honesty check on the answer -- a waypoint is supposed to
    be ON the mesh, and one that is not was not sampled where it was asked. That
    check only means anything if the closest point is really found, which is what
    `vertices` (NORMAL_SAMPLE_VERTICES) is for: the closest triangle does not
    have to touch the closest vertex. Degenerate triangles are excluded from the
    search -- a sliver's own plane is an artefact and its corners' normals are
    not, so reading a normal off one is how a waypoint on flat surface comes back
    80 degrees out.
    """
    if isinstance(surface, str):
        v, n, t = read_ply_mesh(surface)
    else:
        v, n, t = surface
        v = np.asarray(v, dtype=np.float64).reshape(-1, 3)
        t = np.asarray(t, dtype=np.int64).reshape(-1, 3)
        n = None if n is None else np.asarray(n, dtype=np.float64).reshape(-1, 3)
    if n is None:
        n, _ = mesh_reference_normals(v, t, up=up)
    n = n/np.maximum(np.linalg.norm(n, axis=1, keepdims=True), 1e-300)
    p = np.asarray(points, dtype=np.float64).reshape(-1, 3)
    if not len(t):
        iv = _nearest_vertex(v, p)
        return n[iv], np.linalg.norm(p - v[iv], axis=1)
    face, w, dist, has = _closest_surface_faces(v, t, p, vertices=vertices)
    iv = _nearest_vertex(v, p)
    out = n[iv].copy()
    tri = t[face]
    interp = (w[:, 0:1]*n[tri[:, 0]] + w[:, 1:2]*n[tri[:, 1]]
              + w[:, 2:3]*n[tri[:, 2]])
    ln = np.linalg.norm(interp, axis=1)
    good = has & (ln > 1e-9)
    out[good] = interp[good]/ln[good, None]
    dist = np.where(has, dist, np.linalg.norm(p - v[iv], axis=1))
    return out/np.maximum(np.linalg.norm(out, axis=1, keepdims=True), 1e-300), dist


global _closest_surface_faces
def _closest_surface_faces(v, t, p, vertices=None):
    """The closest non-degenerate triangle to each point. -> (face, w, dist, has)

    `face` indexes into `t`, `w` are the barycentrics of the closest point on it,
    `dist` how far that point is, and `has` marks the points a candidate was
    found for at all. ONE search, used both by the normal sampler and by the
    independent face-plane check, so the two cannot disagree about which triangle
    a waypoint is on.
    """
    v = np.asarray(v, dtype=np.float64).reshape(-1, 3)
    t = np.asarray(t, dtype=np.int64).reshape(-1, 3)
    p = np.asarray(p, dtype=np.float64).reshape(-1, 3)
    k = int(NORMAL_SAMPLE_VERTICES if vertices is None else vertices)
    k = max(1, min(k, max(len(v), 1)))
    face = np.zeros(len(p), dtype=np.int64)
    w = np.tile(np.array([1.0, 0.0, 0.0]), (len(p), 1))
    dist = np.zeros(len(p))
    has = np.zeros(len(p), dtype=bool)
    if not len(t) or not len(p):
        return face, w, dist, has
    # A face is a candidate only if it has an interior to be closest to: a
    # sliver's plane says nothing about which way the part faces, and reading a
    # normal off one is how a waypoint on flat surface comes back 80 degrees out.
    keep = np.flatnonzero(_non_degenerate_faces(v, t))
    if not len(keep):
        keep = np.arange(len(t), dtype=np.int64)
    tk = t[keep]
    iv = _nearest_vertices(v, p, k)
    # Every face incident on any of the k nearest vertices, as a (query, face)
    # pair list -- the same CSR trick as the 1-ring, over the vertex-to-face map.
    fi = np.repeat(np.arange(len(tk), dtype=np.int64), 3)
    vi = tk.ravel()
    order = np.argsort(vi, kind="stable")
    vptr = np.searchsorted(vi[order], np.arange(len(v) + 1, dtype=np.int64))
    faces = fi[order]
    counts = vptr[iv + 1] - vptr[iv]                 # (points, k)
    # Blocked over POINTS so a block's pair count stays inside the budget; every
    # candidate of a point is always in the same block, so the answer does not
    # depend on the block size.
    for lo, hi in _block_edges(counts.sum(axis=1), int(NORMAL_SAMPLE_PAIR_BLOCK)):
        cnt = counts[lo:hi]
        if not int(cnt.sum()):
            continue
        row = np.repeat(np.arange(lo, hi, dtype=np.int64), cnt.sum(axis=1))
        cand = faces[_ranges(vptr[iv[lo:hi]].ravel(), cnt.ravel())]
        tri = tk[cand]
        q, ww = _closest_point_bary(p[row], v[tri[:, 0]], v[tri[:, 1]],
                                    v[tri[:, 2]])
        dd = np.linalg.norm(q - p[row], axis=1)
        o = np.lexsort((dd, row))
        first = np.searchsorted(row[o], np.arange(lo, hi, dtype=np.int64),
                                side="left")
        blk = np.bincount(row - lo, minlength=hi - lo) > 0
        pick = o[np.clip(first, 0, max(len(o) - 1, 0))]
        sl = slice(lo, hi)
        face[sl][blk] = keep[cand[pick]][blk]
        w[sl][blk] = ww[pick][blk]
        dist[sl][blk] = dd[pick][blk]
        has[sl][blk] = True
    return face, w, dist, has


global _ranges
def _ranges(starts, lengths):
    """Concatenated arange(start, start+length) for every (start, length) pair.

    The flat index list that gathers a CSR row set without a Python loop over
    rows; a real plan has hundreds of thousands of them.
    """
    starts = np.asarray(starts, dtype=np.int64).ravel()
    lengths = np.asarray(lengths, dtype=np.int64).ravel()
    total = int(lengths.sum())
    if not total:
        return np.zeros(0, dtype=np.int64)
    keep = lengths > 0
    s, L = starts[keep], lengths[keep]
    off = np.concatenate([[0], np.cumsum(L)[:-1]])
    idx = np.arange(total, dtype=np.int64)
    which = np.repeat(np.arange(len(L), dtype=np.int64), L)
    return s[which] + (idx - off[which])


global _block_edges
def _block_edges(per_item, budget):
    """[(lo, hi)] splitting a run of items so each block's total stays in budget.

    An item is never split, so a single item larger than the budget gets a block
    of its own rather than being silently truncated.
    """
    per = np.asarray(per_item, dtype=np.int64).ravel()
    out = []
    lo = 0
    run = 0
    for i, c in enumerate(per):
        if run and run + int(c) > int(budget):
            out.append((lo, i))
            lo, run = i, 0
        run += int(c)
    if lo < len(per):
        out.append((lo, len(per)))
    return out


#: A triangle is a SLIVER when its smallest altitude is under this fraction of
#: its longest edge. A sliver's own plane is numerical noise, and reading a
#: surface normal off one is how a waypoint on flat surface comes back 80 degrees
#: from vertical.
#:
#: RELATIVE, NOT A LENGTH, because the meshes differ in resolution by an order of
#: magnitude and a sliver is a SHAPE. Measured over every eddy-current planning
#: mesh in this cell, the ratio for honest triangles runs 0.011 to 0.28 at the
#: 1st percentile and 0.61 at the median, while the slivers sit below 0.01 -- and
#: on one 10 153-face mesh there are 99 of them. The two faces that stand more
#: than 60 degrees from horizontal on an otherwise 13.5 degree plate are both
#: slivers, with altitudes of 0.065 and 1.96 micrometres; an exact-zero-area test
#: (clean_mesh_for_planning()) catches neither, and an absolute micron threshold
#: catches only the first.
#:
#: IT DOES NOT TOUCH REAL STEEP GEOMETRY. On the reconstruction that carries the
#: bench and a draped skirt, the steepest surviving face is 89.9 degrees -- the
#: 28 mm cliff, which is real and must stay.
global FACE_MIN_ASPECT
FACE_MIN_ASPECT = 0.01

#: And a floor in metres, for a triangle so small that the ratio itself is noise.
global FACE_MIN_ALTITUDE_M
FACE_MIN_ALTITUDE_M = 1e-9


global _non_degenerate_faces
def _non_degenerate_faces(v, t):
    """Which faces have an interior worth reading a normal off. -> bool per face

    Smallest altitude over FACE_MIN_ASPECT of the longest edge, and over
    FACE_MIN_ALTITUDE_M outright.
    """
    v = np.asarray(v, dtype=np.float64).reshape(-1, 3)
    t = np.asarray(t, dtype=np.int64).reshape(-1, 3)
    if not len(t):
        return np.zeros(0, dtype=bool)
    p0, p1, p2 = v[t[:, 0]], v[t[:, 1]], v[t[:, 2]]
    twice_area = np.linalg.norm(np.cross(p1 - p0, p2 - p0), axis=1)
    longest = np.maximum.reduce([np.linalg.norm(p1 - p0, axis=1),
                                 np.linalg.norm(p2 - p1, axis=1),
                                 np.linalg.norm(p0 - p2, axis=1)])
    alt = twice_area/np.maximum(longest, 1e-300)
    return ((alt > float(FACE_MIN_ALTITUDE_M))
            & (alt > float(FACE_MIN_ASPECT)*longest))


global _nearest_vertices
def _nearest_vertices(v, p, k):
    """Indices of the k nearest vertices to each point, nearest first. (n, k)

    cKDTree where it is available, blocked brute force otherwise, matching
    _nearest_vertex() -- which is this at k = 1 and is kept because several
    callers want only the one index.
    """
    v = np.asarray(v, dtype=np.float64).reshape(-1, 3)
    p = np.asarray(p, dtype=np.float64).reshape(-1, 3)
    k = max(1, min(int(k), len(v)))
    if k == 1:
        return _nearest_vertex(v, p).reshape(-1, 1)
    try:
        from scipy.spatial import cKDTree
    except ImportError:
        cKDTree = None
    if cKDTree is not None:
        idx = cKDTree(v).query(p, k=k)[1]
        return np.asarray(idx, dtype=np.int64).reshape(len(p), k)
    if len(v)*len(p) > 100000000:
        raise RuntimeError(
            "sampling %d points against %d vertices needs scipy.spatial.cKDTree; "
            "install scipy or sample fewer points" % (len(p), len(v)))
    out = np.zeros((len(p), k), dtype=np.int64)
    step = max(1, int(2000000//max(len(v), 1)))
    for lo in range(0, len(p), step):
        blk = p[lo:lo+step]
        d2 = ((blk[:, None, :] - v[None, :, :])**2).sum(axis=2)
        out[lo:lo+step] = np.argsort(d2, axis=1)[:, :k]
    return out


# ------------------------------------------------------------------------------
# TURNED-ROUND POSES: FOUND AGAINST THE LOCAL SURFACE, REPAIRED OR DROPPED
# ------------------------------------------------------------------------------
# WHY THIS EXISTS WHEN THE CONSTRAINT ALREADY "GUARANTEES" IT. Two reasons, both
# measured on the recorded eddy-current runs in this cell:
#
#   1. THE POSTCONDITION ALONE CANNOT FAIL ON SUCH A PATH.
#      scanpath_from_noether(orient="normal") sets the tool axis from
#      sample_mesh_normals(), and assert_probe_normal_to_surface() compares it
#      with sample_mesh_normals() at the same position. Any error in the sampler
#      cancels exactly, so that half of it reads 0.000 deg however wrong the axis
#      is -- measured at 0.000 on all five recorded runs in this cell. A claim
#      that nothing is flipped, resting on that number, has not looked.
#   2. THE COUNTS THAT WERE PRINTED WERE AGAINST WORLD UP, NOT AGAINST THE
#      SURFACE. _quats_from_surface_normals()'s "facing_down" and
#      tool_reachability_report()'s "facing_away" both compare with world +z. A
#      pose can be turned round with respect to the surface it sits on and pass
#      both, and a pose on legitimately steep surface can fail both while being
#      exactly right.
#
# So the check here measures against the surface at the waypoint, classifies what
# it finds, and says which of the three different faults it is:
#
#   REVERSED    the tool axis points INTO the part. On the mesh one of these runs
#               planned over before it was cropped and repaired, 14 waypoints of
#               43 586, worst 130.9 deg, 13 of them with the axis below horizontal.
#   TANGENTIAL  the axis lies along the surface, not across it -- within
#               TANGENTIAL_AXIS_DEG of 90. 126 waypoints on the same mesh. NOT a
#               sign error: reversing one leaves it just as tangential, which is
#               why a reversal test does not see it and why it is counted apart.
#   OFF         past the tolerance but not turned round. 11.3 deg at worst on the
#               mesh this run really planned over.
#
# And the repair is conservative in exactly one way that matters: a waypoint on
# surface that FACES AWAY from where the probe comes from is UNREACHABLE and is
# DROPPED with a count. Turning it over would point the probe away from the part
# and drive the holder into the specimen.

#: How near 90 degrees an axis has to be before it is called TANGENTIAL rather
#: than merely off or reversed. A tangential axis is a different defect with a
#: different cause -- a sliver face, or a normal fitted across a seam -- and a
#: reversal test cannot see it, so it is classified and counted separately.
global TANGENTIAL_AXIS_DEG
TANGENTIAL_AXIS_DEG = 10.0


global _surface_arrays
def _surface_arrays(surface, up=(0.0, 0.0, 1.0)):
    """(vertices, normals, triangles) from a PLY path or a tuple of arrays."""
    if isinstance(surface, str):
        v, n, t = read_ply_mesh(surface)
    else:
        v, n, t = surface
        v = np.asarray(v, dtype=np.float64).reshape(-1, 3)
        t = np.asarray(t, dtype=np.int64).reshape(-1, 3)
        n = None if n is None else np.asarray(n, dtype=np.float64).reshape(-1, 3)
    if n is None:
        n, _ = mesh_reference_normals(v, t, up=up)
    return v, n/np.maximum(np.linalg.norm(n, axis=1, keepdims=True), 1e-300), t


#: Most waypoints the independent face-plane check measures. It reports a
#: DISTRIBUTION, not a per-waypoint verdict, so a bounded even sample answers the
#: same question -- and the search behind it costs about 19 microseconds a
#: waypoint, which is 17 s on a 911 511-waypoint plan that a planning stage pays
#: for several times over. Evenly spaced and deterministic, so two runs of the
#: same plan report the same number.
global FACE_CHECK_MAX_WAYPOINTS
FACE_CHECK_MAX_WAYPOINTS = 50000


global _tool_axis_against_faces
def _tool_axis_against_faces(surface, points, axes):
    """angle(tool axis, the WINDING normal of the triangle each point is on), deg.

    THE CHECK THAT CANNOT CANCEL. No vertex normal appears in it, so a path whose
    axis came from the vertex normals is being compared with something else --
    which is the half a vertex-normal comparison cannot supply. Its floor is the
    mesh's own faceting, so read it as a diagnostic, not as a tolerance; what it
    detects is the vertex normals and the triangles disagreeing, which is also
    what makes a clearance check read the tool as inside the part.
    """
    v, _n, t = _surface_arrays(surface)
    p = np.asarray(points, dtype=np.float64).reshape(-1, 3)
    z = np.asarray(axes, dtype=np.float64).reshape(-1, 3)
    if not len(t) or not len(p):
        return np.zeros(0)
    cap = int(FACE_CHECK_MAX_WAYPOINTS)
    if cap > 0 and len(p) > cap:
        take = np.linspace(0, len(p) - 1, cap).astype(np.int64)
        p, z = p[take], z[take]
    face, _w, _d, has = _closest_surface_faces(v, t, p)
    tri = t[face]
    fn = np.cross(v[tri[:, 1]] - v[tri[:, 0]], v[tri[:, 2]] - v[tri[:, 0]])
    fn = fn/np.maximum(np.linalg.norm(fn, axis=1, keepdims=True), 1e-300)
    ang = np.degrees(np.arccos(np.clip(np.einsum("ij,ij->i", z, fn), -1.0, 1.0)))
    return ang[has]


global tool_axis_flip_report
def tool_axis_flip_report(path, surface, tol_deg=None, tangential_deg=None,
                          up=(0.0, 0.0, 1.0), offset=None, arrays=False):
    """Classify every pose's tool axis against the surface AT that waypoint.

    -> dict of per-class counts. Measures; changes nothing.

    `up` is the direction the probe comes FROM -- world +z for a part on a
    bench. It is used for one thing only, and it is the one thing a global
    direction is right for: deciding whether the SURFACE faces the probe at all.
    Whether the POSE is right is judged against that surface's own normal.

    `arrays` adds the per-waypoint normals, angles and masks, which is what the
    repair needs and what a REPORT must not carry: a plan at the production line
    spacing has 911 511 waypoints, so those arrays are 30 MB that would then be
    held on the path for the rest of the session, twice over. Off by default.
    """
    tol = PROBE_NORMAL_TOL_DEG if tol_deg is None else float(tol_deg)
    tang = (TANGENTIAL_AXIS_DEG if tangential_deg is None
            else float(tangential_deg))
    if offset is None:
        offset = getattr(path, "normal_offset", (0.0, 0.0, 0.0))
    off = np.asarray(offset, dtype=np.float64).reshape(1, 3)
    pos = np.asarray(path.positions, dtype=np.float64).reshape(-1, 3) - off
    q = _unit_quats(path.quats)
    x, y, zc, w = q[:, 0], q[:, 1], q[:, 2], q[:, 3]
    z = np.stack([2.0*(x*zc + y*w), 2.0*(y*zc - x*w), 1.0 - 2.0*(x*x + y*y)],
                 axis=1)
    nrm, dist = sample_mesh_normals(surface, pos, up=up)
    ang = np.degrees(np.arccos(np.clip(np.einsum("ij,ij->i", z, nrm), -1.0, 1.0)))
    upv = np.asarray(up, dtype=np.float64).reshape(3)
    upv = upv/max(float(np.linalg.norm(upv)), 1e-300)
    away = nrm.dot(upv) < 0.0
    reversed_ = ang >= 90.0 + tang
    tangential = (ang >= 90.0 - tang) & (ang < 90.0 + tang)
    off_normal = (ang > tol) & (ang < 90.0 - tang)
    rep = {"waypoints": int(len(ang)), "tol_deg": tol, "tangential_deg": tang,
           "normals": nrm, "angles": ang,
           "surface_distance_max_m": float(dist.max()) if len(dist) else 0.0,
           "reversed": int(reversed_.sum()), "tangential": int(tangential.sum()),
           "off_normal": int(off_normal.sum()),
           "away_facing_surface": int(away.sum()),
           "max_deg": float(ang.max()) if len(ang) else 0.0,
           "p999_deg": float(np.percentile(ang, 99.9)) if len(ang) else 0.0,
           "worst_index": int(np.argmax(ang)) if len(ang) else -1,
           "reversed_mask": reversed_, "tangential_mask": tangential,
           "off_normal_mask": off_normal, "away_mask": away}
    wrong = reversed_ | tangential | off_normal
    rep["wrong"] = int(wrong.sum())
    rep["wrong_mask"] = wrong
    rep["worst_position"] = (None if rep["worst_index"] < 0 else
                             tuple(float(c) for c in
                                   np.asarray(path.positions)[rep["worst_index"]]))
    rep["orient_mode"] = getattr(path, "orient_mode", None)
    if not arrays:
        for k in ("normals", "angles", "reversed_mask", "tangential_mask",
                  "off_normal_mask", "away_mask", "wrong_mask"):
            rep.pop(k, None)
    return rep


global repair_tool_axis_to_surface
def repair_tool_axis_to_surface(path, surface, tol_deg=None,
                                tangential_deg=None, up=(0.0, 0.0, 1.0),
                                offset=None, crop=None, what="toolpath",
                                min_points=2, reference=None, verbose=True,
                                indent="  "):
    """Put every pose's tool axis back on the surface normal, or drop it.

    -> (path, report). PREVENTION AND REPAIR, NEVER A RUN-ENDING ERROR.

      * a pose whose axis is reversed, tangential or merely off the surface
        normal has its axis RE-SET to that normal.

        ON A LOCKED PATH THE WHOLE POSE IS REBUILT from that normal and the roll
        reference (locked_quats_from_axes()), which puts the SET PROBE ROTATION
        back exactly. It has to be rebuilt rather than swung: whatever turned the
        axis round turned the tool frame with it, so the roll of a broken pose is
        no more trustworthy than its axis -- a pose reversed about its own x comes
        back 180 deg out in roll if the roll is merely carried, and the rotation
        of a split-D coil is a measurement parameter, not a detail.

        On any other roll mode the roll is CARRIED instead (_swing_tool_axis_onto()),
        because re-locking one would silently replace a roll the caller chose;
        the report says which was done.
      * a pose on surface that faces AWAY from the probe is DROPPED, with a
        count and a bounding box. It is not turned over. Turning it over points
        the probe away from the part, which on a contact probe drives the holder
        into the specimen -- so the pose is unreachable from this direction and
        the honest answer is to give up that coverage and say so.

    A turned-round pose is never an error here; it is repaired and counted. The
    one thing that does raise is a CONFIGURATION fault: waypoints that have to be
    dropped and no crop to drop them with.

    Positions are never moved. `crop` is the waypoint-dropping split, defaulting
    to mesh_reconstruction.dpi's _crop_path_by_mask() -- the one place that
    decides how a dropped run splits a pass. With nothing to drop it is not
    needed at all, which is the ordinary case.
    """
    rep = tool_axis_flip_report(path, surface, tol_deg=tol_deg,
                               tangential_deg=tangential_deg, up=up,
                               offset=offset, arrays=True)
    rep["what"] = what
    out = path
    if reference is None:
        reference = getattr(path, "roll_reference", (1.0, 0.0, 0.0))
    locked = getattr(path, "roll_mode", None) == "locked"
    rep["roll"] = "rebuilt from the reference" if locked else "carried"
    if rep["wrong"] or rep["away_facing_surface"]:
        fix = rep["wrong_mask"] & ~rep["away_mask"]
        quats = _unit_quats(path.quats)
        if fix.any():
            quats = np.array(quats, copy=True)
            quats[fix] = (locked_quats_from_axes(rep["normals"][fix], reference)
                          if locked
                          else _swing_tool_axis_onto(quats[fix],
                                                     rep["normals"][fix]))
        rep["repaired"] = int(fix.sum())
        out = ScanPath(np.array(path.positions, copy=True), quats,
                       list(path.segment_starts), source=path.source)
        _carry_path_attrs(path, out)
    else:
        rep["repaired"] = 0

    rep["dropped"] = 0
    rep["dropped_bbox"] = None
    if rep["away_facing_surface"]:
        keep = ~rep["away_mask"]
        lo = np.asarray(path.positions)[rep["away_mask"]].min(axis=0)
        hi = np.asarray(path.positions)[rep["away_mask"]].max(axis=0)
        rep["dropped_bbox"] = (tuple(float(c) for c in lo),
                               tuple(float(c) for c in hi))
        fn = globals().get("_crop_path_by_mask") if crop is None else crop
        if fn is None:
            raise RuntimeError(
                "%d waypoint(s) of the %s sit on surface facing AWAY from the "
                "probe and must be dropped, but the waypoint crop is not "
                "available: add modules/mesh_reconstruction.dpi to the config, "
                "which is where _crop_path_by_mask() lives. They are NOT going "
                "to be turned over -- that points the probe away from the part."
                % (rep["away_facing_surface"], what))
        before = len(out)
        out = fn(out, keep, what, min_points,
                 "on surface facing away from the probe")
        rep["dropped"] = int(before - len(out))
        _carry_path_attrs(path, out)

    if rep["repaired"] or rep["dropped"]:
        after = tool_axis_flip_report(out, surface, tol_deg=tol_deg,
                                      tangential_deg=tangential_deg, up=up,
                                      offset=offset)
        rep["residual_max_deg"] = after["max_deg"]
        rep["residual_wrong"] = after["wrong"]
    else:
        rep["residual_max_deg"] = rep["max_deg"]
        rep["residual_wrong"] = 0
    if verbose:
        for line in describe_tool_axis_flips(rep, indent=indent):
            print(line)
    # THE ARRAYS GO NO FURTHER. The caller keeps this report on the path, and a
    # production plan's normals, angles and five masks are 30 MB of it.
    for k in ("normals", "angles", "reversed_mask", "tangential_mask",
              "off_normal_mask", "away_mask", "wrong_mask"):
        rep.pop(k, None)
    return out, rep


# _carry_path_attrs() lives in toolpath_segments.dpi, beside the ScanPath whose
# attributes it carries -- every file that rebuilds a path already has that one
# loaded, which noether_path.dpi is not always.

global describe_tool_axis_flips
def describe_tool_axis_flips(rep, indent="  "):
    """The flip report as the lines a scan log should carry.

    IT NEVER SAYS NOTHING WAS FLIPPED UNLESS NOTHING WAS. "This code does not
    turn poses over" is a statement about policy; "nothing is flipped" is a
    measurement of the path, and on a run whose mesh repair has replaced 23
    backwards normals the two do not agree.
    """
    if rep is None:
        return []
    n = rep["waypoints"]
    if not (rep["wrong"] or rep["away_facing_surface"]):
        return ["%stool axis against the surface AT each waypoint: none of the "
                "%d is reversed, tangential or off it by more than %.2f deg "
                "(worst %.3f). Checked against the closest triangle, not assumed."
                % (indent, n, rep["tol_deg"], rep["max_deg"])]
    head = ("TURNED-ROUND POSES FOUND" if rep["reversed"] or rep["tangential"]
            else "POSES OFF THE SURFACE NORMAL" if rep["off_normal"]
            else "SURFACE FACING AWAY FROM THE PROBE")
    out = ["%s%s. Of %d waypoint(s), measured against the "
           "surface normal at each one: %d REVERSED (axis into the part), %d "
           "TANGENTIAL (within %.0f deg of along the surface, which a reversal "
           "test cannot see), %d merely off it. Worst %.2f deg at %s."
           % (indent, head, n, rep["reversed"], rep["tangential"],
              rep["tangential_deg"], rep["off_normal"], rep["max_deg"],
              rep["worst_position"])]
    if rep.get("repaired"):
        out.append("%s  REPAIRED: %d pose(s) had the axis put back on the "
                   "surface normal there, roll %s, positions untouched. A locked "
                   "path's poses are rebuilt from the roll reference, which puts "
                   "the set probe rotation back exactly -- whatever turned an "
                   "axis round turned that pose's roll with it."
                   % (indent, rep["repaired"], rep.get("roll", "carried")))
    if rep.get("dropped"):
        lo, hi = rep["dropped_bbox"]
        out.append("%s  DROPPED: %d waypoint(s) sit on surface FACING AWAY from "
                   "the probe, and %d waypoint(s) went with them once the runs "
                   "left behind were too short to fly. Not turned over -- turning "
                   "one over points the probe away from the part and pushes the "
                   "holder into it. WHERE x %.3f..%.3f y %.3f..%.3f z "
                   "%.3f..%.3f m. That coverage is lost; crop the region or "
                   "approach from another direction."
                   % (indent, rep["away_facing_surface"], rep["dropped"],
                      lo[0], hi[0], lo[1], hi[1], lo[2], hi[2]))
    elif rep.get("away_facing_surface"):
        out.append("%s  %d waypoint(s) sit on surface facing AWAY from the probe "
                   "and are unreachable from this direction."
                   % (indent, rep["away_facing_surface"]))
    if "residual_wrong" in rep:
        out.append("%s  after the repair: %d still wrong, worst %.3f deg"
                   % (indent, rep["residual_wrong"], rep["residual_max_deg"]))
    else:
        out.append("%s  NOT repaired: this path's tool axis is not constrained to "
                   "the surface normal (%s), so putting it back on the normal "
                   "would change what the path IS. Measured, and left alone."
                   % (indent, rep.get("orient_mode") or "orient is not 'normal'"))
    out.append("%s  THIS IS NOT A TILT LIMIT'S JOB. EC_MAX_TILT_DEG bounds tilt "
               "from VERTICAL; every pose above was wrong with respect to the "
               "SURFACE, and dropping them for tilt would have deleted coverage "
               "and left the survivors just as wrong." % (indent,))
    return out


global assert_probe_normal_to_surface
def assert_probe_normal_to_surface(path, surface, tol_deg=None, mode=None,
                                  verbose=True, what="toolpath", indent="  ",
                                  offset=None):
    """THE POSTCONDITION: angle(probe axis, surface normal) at every waypoint.

    The rule is that the probe must not be tilted with respect to the actual
    surface normal; this is that rule as a number. The probe looks along
    MINUS tool z and the surface normal points away from the part, so the two are
    anti-parallel and the quantity reported is angle(tool z, outward normal),
    which is zero when the rule holds and 180 when the probe is being driven at
    the part from underneath.

    NOT THE SAME QUANTITY AS tool_tilt_deg(), which is the angle from VERTICAL
    and is legitimately large on a curved part. A pose can be 70 degrees from
    vertical and 0.00 from the normal, and that pose is correct; whether the arm
    can reach it is EC_MAX_TILT_DEG's question and is reported separately by
    tool_reachability_report().

    WHAT IT CANNOT DO ON ITS OWN, AND WHY tool_axis_flip_report() EXISTS. On a
    path built by scanpath_from_noether(orient="normal") the first quantity below
    compares the axis with the same sample_mesh_normals() call that produced it,
    so any error in the sampler cancels and the answer is 0.000 deg by arithmetic
    rather than by measurement -- 0.000 on all five recorded runs in this cell, at
    a line spacing where the sampler could pick a triangle 1.47 mm from the
    waypoint. Two things break that tautology, and both are reported here:

      face_max_deg              the axis against the PLANE of the non-degenerate
                                triangle the waypoint lies on, which uses no
                                vertex normal at all and so cannot cancel. It is
                                a DIAGNOSTIC and not a tolerance -- its floor is
                                the mesh's own faceting, measured at 1.2 to 11.3
                                deg on this cell's planning meshes -- but a value
                                far above that floor means the vertex normals and
                                the triangles disagree, which no amount of
                                resampling the vertex normals will show.
      surface_distance_max_m    now a real honesty check: how far the closest
                                point found was, against a waypoint that is
                                supposed to be ON the mesh (2 micrometres in
                                truth on these meshes).

    mode: "raise" (default) makes a violation a MeshNotPlannable, "warn" prints
    it, "off" measures and says nothing. MESH_NORMAL_POSTCONDITION overrides the
    default from a config.

    Returns the report even when it raises nothing: max_deg, p99_deg, p999_deg,
    mean_deg, over_tol, worst_index, worst_position, facing_into_surface,
    tangential, face_max_deg, face_p999_deg and surface_distance_max_m.
    """
    tol = PROBE_NORMAL_TOL_DEG if tol_deg is None else float(tol_deg)
    mode = globals().get("MESH_NORMAL_POSTCONDITION", "raise") if mode is None else mode
    # Back into the MESH's frame before sampling it -- see pos_mesh in
    # scanpath_from_noether(). A path's own normal_offset is the default, so the
    # common case needs no argument and cannot get it wrong.
    if offset is None:
        offset = getattr(path, "normal_offset", (0.0, 0.0, 0.0))
    offset = np.asarray(offset, dtype=np.float64).reshape(1, 3)
    pos_world = np.asarray(path.positions, dtype=np.float64).reshape(-1, 3)
    pos = pos_world - offset
    q = _unit_quats(path.quats)
    x, y, zc, w = q[:, 0], q[:, 1], q[:, 2], q[:, 3]
    z = np.stack([2.0*(x*zc + y*w), 2.0*(y*zc - x*w), 1.0 - 2.0*(x*x + y*y)],
                 axis=1)
    nrm, dist = sample_mesh_normals(surface, pos)
    cos = np.clip(np.einsum("ij,ij->i", z, nrm), -1.0, 1.0)
    ang = np.degrees(np.arccos(cos))
    worst = int(np.argmax(ang)) if len(ang) else -1
    rep = {"waypoints": int(len(ang)), "tol_deg": tol,
           "max_deg": float(ang.max()) if len(ang) else 0.0,
           "p99_deg": float(np.percentile(ang, 99)) if len(ang) else 0.0,
           "p999_deg": float(np.percentile(ang, 99.9)) if len(ang) else 0.0,
           "mean_deg": float(ang.mean()) if len(ang) else 0.0,
           "over_tol": int((ang > tol).sum()),
           "facing_into_surface": int((cos < 0.0).sum()),
           "worst_index": worst,
           "worst_position": (None if worst < 0
                              else tuple(float(c) for c in pos_world[worst])),
           "surface_distance_max_m": float(dist.max()) if len(dist) else 0.0,
           "tangential": int(((ang > 90.0 - TANGENTIAL_AXIS_DEG)
                              & (ang < 90.0 + TANGENTIAL_AXIS_DEG)).sum()),
           "ok": bool(len(ang) and ang.max() <= tol) or not len(ang)}
    rep["over_tol_fraction"] = (rep["over_tol"]/float(len(ang))) if len(ang) else 0.0
    # THE INDEPENDENT HALF. No vertex normal appears in it, so it cannot cancel
    # against the axis the way the quantity above can.
    fang = _tool_axis_against_faces(surface, pos, z)
    rep["face_max_deg"] = float(fang.max()) if len(fang) else 0.0
    rep["face_p999_deg"] = (float(np.percentile(fang, 99.9)) if len(fang)
                            else 0.0)
    rep["face_reversed"] = int((fang > 90.0).sum())
    rep["face_waypoints"] = int(len(fang))
    msg = ("probe axis against the surface normal over %d waypoint(s) of the %s: "
           "worst %.3f deg, p99.9 %.3f, mean %.4f (tolerance %.2f); %d over it, "
           "%d facing into the part, %d within %.0f deg of tangential. Sampled at "
           "most %.3f mm off the surface. INDEPENDENTLY, against the plane of the "
           "triangle each waypoint lies on (no vertex normal in it, so it cannot "
           "cancel), over %d of them: worst %.2f deg, p99.9 %.2f, %d reversed -- "
           "that number's floor is the mesh's own faceting, so read it beside the "
           "mesh rather than against the tolerance."
           % (rep["waypoints"], what, rep["max_deg"], rep["p999_deg"],
              rep["mean_deg"], tol, rep["over_tol"], rep["facing_into_surface"],
              rep["tangential"], TANGENTIAL_AXIS_DEG,
              rep["surface_distance_max_m"]*1e3, rep["face_waypoints"],
              rep["face_max_deg"], rep["face_p999_deg"], rep["face_reversed"]))
    if rep["ok"]:
        if verbose and mode != "off":
            print("%sPOSTCONDITION HOLDS -- %s" % (indent, msg))
        return rep
    detail = ("%s -- worst at %s. The probe is tilted with respect to the "
              "surface it is measuring, which is the one thing the tool axis is "
              "not allowed to be. This is a fault in the mesh normals or in the "
              "orientation constraint, NOT something EC_MAX_TILT_DEG should be "
              "asked to hide: dropping these waypoints would delete coverage and "
              "leave the survivors just as wrong."
              % (msg, rep["worst_position"]))
    if mode == "raise":
        raise MeshNotPlannable("POSTCONDITION FAILED: %s" % (detail,), rep)
    if mode != "off":
        print("%sWARNING: POSTCONDITION FAILED -- %s" % (indent, detail))
    return rep


# ------------------------------------------------------------------------------
# THE GATE: will Noether get a usable path out of this mesh?
# ------------------------------------------------------------------------------
#
# A reconstruction can be REFUSED with a reason, ten milliseconds after it is
# written, instead of being handed to a planner that answers success=False with
# the reason only in a service log the caller never sees. Every threshold below
# is a number measured on real Keyence reconstructions of a 112 x 120 x 12 mm
# plate rather than a guess. What those measurements say:
#
#   * TWO non-manifold edges, 8 faces out of 22899, are enough to make the
#     planner refuse -- "Too many connecting vertices found between adjacent
#     segments" -- and the refusal is not monotone in line spacing. One such
#     mesh plans at 20, 10, 5, 3, 2, 1, 0.8, 0.6 and 0.4 mm and refuses at 1.5,
#     0.5 and 0.3 mm; 0.3 mm is SCAN_LINE_SPACING for the eddy-current scan.
#     Removing exactly those 8 faces makes all twelve spacings plan. Trying a
#     coarser spacing is a lottery whose ticket is which slicing planes land on
#     the defect, not a diagnosis.
#   * a handful of NaN vertices (6 in 8466 has been seen, written by the
#     reconstruction's own smoothing) ABORTS principal_axis_noether_srv on a PCL
#     assertion, and nothing can plan until it is restarted.
#   * most of the .ply files a reconstruction chain writes have NO FACES at all:
#     they are point clouds. Reading vertices out of one succeeds, so "the file
#     is there and has points in it" is not a check.
#   * on quadric-decimated copies, at a 1.38 mm median edge 10.6% of waypoints
#     exceed the 45 deg tilt cap, at 1.95 mm 13.6%, and at 2.68 and 3.73 mm the
#     planner refuses outright. At 5.2 mm and coarser it returns poses whose
#     orientation is NaN.
#   * holes never cause a refusal, they cause FRAGMENTATION: eight holes of
#     2 mm radius (1.0% of the faces) take a path from 436 segments to 577 and
#     from 354 passes to 444 while costing 1.1% of the travel. Each hole splits
#     about 2r/line_spacing passes in two.
#
# The gate reports; mesh_plannable() and require_plannable_mesh() turn the
# report into a decision. Pure numpy, no ROS, no open3d: a check that needs a
# service running is a check that gets skipped.

#: Median edge length past which the path's QUALITY is called into question,
#: metres. A WARNING and deliberately not a refusal, because coarseness alone is
#: not what the slicer refuses:
#:
#:   * quadric-decimated copies of a Keyence mesh are REFUSED outright at 2.68
#:     and 3.73 mm median edge, and return NaN orientations at 5.2 mm and
#:     coarser.
#:   * every Azure reconstruction this pipeline produces has a median edge of
#:     exactly 6.00 mm -- marching cubes gives one edge per voxel, and
#:     reconstruct_rough() sets the voxel to 0.006 on purpose -- and the planner
#:     PLANS all of them, at 5, 1, 0.5 and 0.3 mm line spacing.
#:
#: So coarseness is not what the slicer refuses; quadric decimation's long thin
#: triangles are. What the edge length does predict is pose quality, and that
#: is monotone: 0.98 mm median edge put 7.0% of the waypoints past the 45 deg
#: tilt cap and 16% of them facing the wrong way, 1.38 mm 10.6%/20.2%, 1.95 mm
#: 13.6%/23.3%. Noether puts a waypoint where a slicing plane crosses a mesh
#: EDGE and takes the tool axis from the surface there, so the edge length is
#: both the sampling interval along a pass and the scale of the normal noise.
GATE_MAX_MEDIAN_EDGE_M = 0.002

#: How much of the mesh's AREA may lean past the tilt cap before it is worth
#: saying so. Area, not vertices: waypoints are spaced along the surface, so
#: surface measure is what a drop fraction is proportional to -- measured 6.2%
#: of area past 45 deg against 7.0% of waypoints actually dropped on the same
#: mesh. 0.15 leaves a good Keyence reconstruction (0.062) comfortably inside.
GATE_MAX_TILT_AREA_FRACTION = 0.15

#: ...and how much makes the plan not worth flying. The planner does not refuse
#: a mesh for leaning: the Azure reconstructions in this tree run from 8% to 45%
#: of their area past the cap and every one of them planned. What it costs is
#: coverage and fragmentation -- the crop cuts every pass that crosses the
#: leaning region in two, which on the real Keyence mesh turned 354 passes into
#: 454 for a 7% loss. At 40% nearly half the part is being thrown away after
#: the planning has been paid for, and the honest answer is to fix the
#: reconstruction (crop it to the face being scanned) rather than fly it.
GATE_REFUSE_TILT_AREA_FRACTION = 0.40

#: At or above this fraction of vertex normals pointing up, a mesh is treated as
#: a HEIGHT FIELD measured from above, and a face still winding downwards after
#: the normals-based repair is an artefact rather than the underside of a solid.
#:
#: The reconstruction guarantees the premise: reconstruction_srv.py flips every
#: point normal to +Z before meshing, so its output runs 99.9% up. A closed TSDF
#: of a whole part runs nearer 50% and is left alone.
GATE_HEIGHT_FIELD_UP_FRACTION = 0.98


#: A pass with fewer waypoints than this is not a pass, it is a stub. Noether's
#: own segments run from 2 to several hundred waypoints on a real mesh.
GATE_MIN_WAYPOINTS_PER_PASS = 5

#: Largest turn between the normals of two faces sharing an edge that is still
#: called surface rather than noise, degrees, at the 99th percentile. A measured
#: reconstruction reads 26.6 (poisson) and 36.6 (quadric-decimated), and its
#: worst single orientation step between consecutive waypoints is 93 deg, which
#: is what this predicts.
GATE_MAX_NORMAL_TURN_DEG = 45.0

#: How many extra passes the holes in a mesh may cost, as a fraction of the
#: passes a hole-free mesh of the same footprint would have. 0.25 is the point
#: at which the eight 2 mm holes measured above (+25%) become a complaint.
GATE_MAX_PASS_FRAGMENTATION = 0.25

#: How much of a requested scan region the mesh must actually cover before the
#: plan is worth flying. A toolpath can only be planned where there is surface.
GATE_MIN_REGION_COVERAGE = 0.9

#: What the last mesh_plan_report() said. Kept as a global so a scan that
#: refused can be asked why afterwards, from the prompt.
last_mesh_plan_report = None


class MeshNotPlannable(RuntimeError):
    """This mesh will not give Noether a usable path, and here is why."""
    def __init__(self, message, report=None):
        RuntimeError.__init__(self, message)
        self.report = report


global _gate_boundary_loops
def _gate_boundary_loops(v, t, nv):
    """Boundary loops as (vertex count, equivalent radius in metres).

    The outer rim of a plate is a boundary loop too, and it is not a hole; it is
    returned with the rest and the caller drops the largest by footprint. Loops
    are found as connected components of the boundary EDGE graph rather than by
    walking, because a reconstruction's boundary is not always a clean cycle.
    """
    e = np.sort(np.vstack([t[:, [0, 1]], t[:, [1, 2]], t[:, [2, 0]]]), axis=1)
    key = e[:, 0]*nv + e[:, 1]
    uk, idx, cnt = np.unique(key, return_index=True, return_counts=True)
    bnd = e[idx[cnt == 1]]
    if not len(bnd):
        return []
    adj = {}
    for a, b in bnd:
        adj.setdefault(int(a), []).append(int(b))
        adj.setdefault(int(b), []).append(int(a))
    seen = set()
    loops = []
    for s in adj:
        if s in seen:
            continue
        comp = []
        stack = [s]
        while stack:
            u = stack.pop()
            if u in seen:
                continue
            seen.add(u)
            comp.append(u)
            for w in adj[u]:
                if w not in seen:
                    stack.append(w)
        P = v[np.array(comp, dtype=np.int64)]
        span = P[:, :2].max(axis=0) - P[:, :2].min(axis=0)
        loops.append((len(comp), float(0.5*np.hypot(span[0], span[1]))))
    loops.sort(key=lambda r: -r[1])
    return loops


global _gate_components
def _gate_components(v, t):
    """Face counts of the connected components of `t`, largest first."""
    if not len(t):
        return []
    par = np.arange(len(v))

    def find(a):
        while par[a] != a:
            par[a] = par[par[a]]
            a = par[a]
        return a
    for tri in t:
        r0 = find(tri[0])
        for k in (1, 2):
            r = find(tri[k])
            if r != r0:
                par[r] = r0
    lab = np.array([find(a) for a in t[:, 0]])
    _ul, lc = np.unique(lab, return_counts=True)
    return sorted((int(c) for c in lc), reverse=True)


global _gate_weighted_pct
def _gate_weighted_pct(values, weights, q):
    """Weighted percentile of `values` (q in 0..1)."""
    o = np.argsort(values)
    v, w = np.asarray(values)[o], np.asarray(weights)[o]
    c = np.cumsum(w)
    if c[-1] <= 0:
        return float("nan")
    return float(np.interp(q*c[-1], c, v))


#: Fewer faces than this inside an ROI and a PERCENTILE over them is noise, so
#: the surface statistics are not restricted to it. 200 is about 1 cm2 of the
#: cell's 0.7 mm Keyence mesh and 0.5% of the 42128 faces the plate actually
#: has.
#:
#: FALLING UNDER IT IS NOT A SILENT FALLBACK. Printing a note and measuring the
#: whole mesh instead is how a 30 x 84 mm selection becomes an 80 x 157 mm plan
#: with the bench in it, so the reasons a crop comes back nearly empty are told
#: apart and reported separately -- see GATE_ROI_MIN_MESH_OVERLAP.
global GATE_MIN_ROI_FACES
GATE_MIN_ROI_FACES = 200

#: How much of an ROI's own footprint the mesh must actually cover before the
#: ROI is believed to describe THIS mesh's surface at all. Below it the two are
#: not the same surface -- a stale selection from an earlier scan, or a mesh
#: reconstructed in the wrong frame -- and that is a REFUSAL, not a fallback: a
#: fallback here plans the bench. Above it, a crop that still lands under
#: GATE_MIN_ROI_FACES is simply a small selection, which is a different fact and
#: says so.
global GATE_ROI_MIN_MESH_OVERLAP
GATE_ROI_MIN_MESH_OVERLAP = 0.10

#: How far OUTSIDE the ROI a planning mesh is kept when it is cropped, metres.
#: Outward is the safe direction: Noether's passes have to be able to run to the
#: edge of the region, and the exact trim is the toolpath crop to `region`
#: (_crop_path_to_box), which happens after planning. 5 mm is under one Keyence
#: line width (~31 mm) and over the 2 mm footprint cell.
global GATE_ROI_CROP_MARGIN_M
GATE_ROI_CROP_MARGIN_M = 0.005

#: How far a face's height may differ from the height of the SELECTED SURFACE in
#: its own footprint cell and still be inside the ROI, metres. The band is
#: +/- this about a per-cell height map, not about one global z range, so on a
#: curved part it follows the curve.
#:
#: WHAT IT IS PROTECTING AGAINST, IN BOTH DIRECTIONS, AND WHY 6 mm.
#:
#: Too SMALL and it empties the crop. The ROI is drawn on the AZURE rough mesh
#: and applied to the KEYENCE one, and the two sensors do not agree about how
#: high a surface is. Per 2 mm cell over a drawn selection:
#:
#:                     min    median   p99    max
#:   Azure - Keyence   0.80    1.35    2.35   2.54 mm
#:
#: That is not a calibration fault -- verify_calibration() passes at +0.18 mm --
#: it is sensor noise plus TSDF and Poisson smoothing, and it has to be absorbed.
#: Add mesh noise and the drape a ball-pivot reconstruction hangs off an edge,
#: and 2.54 mm is the floor this band cannot go under. 6 mm is 2.4x it.
#:
#: Too LARGE and it absorbs the bench, which is the failure this exists to stop:
#: a region selected on top of a flat plate, and the Keyence scanning part of the
#: table. On this cell the plate top is at z 0.9410 and the optical breadboard at
#: 0.9218 -- 19.2 mm below. 6 mm is under a THIRD of that, and even with the
#: height map itself reading 2.5 mm high the band's floor is still 14 mm clear of
#: the bench.
#:
#: MEASURED EFFECT at 6 mm, on a whole-plate selection cropped with the 5 mm
#: planning margin: it keeps 18522 of the 18676 faces the x-y footprint alone
#: keeps (99.2%) and drops 154, which are the plate's side wall and drape at
#: 6-10 mm below its crown. It does not collapse, and it does remove surface
#: that is not the selected face.
#:
#: The band is symmetric because a height map can be wrong in either direction,
#: but note that the two sides are not symmetric in consequence: below it is the
#: bench, and above it is nothing but a floating reconstruction artefact. If this
#: ever has to grow, grow it upward.
global GATE_ROI_Z_TOLERANCE_M
GATE_ROI_Z_TOLERANCE_M = 0.006

#: How much of what the x-y footprint matched must survive the z band before the
#: band is believed to describe this mesh's surface. Under it the two surfaces
#: are at incompatible heights, and that is a REFUSAL naming the measured
#: offset, never a quiet retreat to x-y and never a
#: quiet retreat to the whole mesh. Told apart from a small selection
#: (GATE_MIN_ROI_FACES) and from a lateral mismatch
#: (GATE_ROI_MIN_MESH_OVERLAP) on purpose: collapsing all three into "plan the
#: whole mesh" is what makes an empty crop invisible.
global GATE_ROI_MIN_Z_BAND_KEEP
GATE_ROI_MIN_Z_BAND_KEEP = 0.10

#: Crop the PLANNING MESH to the ROI before Noether sees it, not just the
#: statistics: the mesh is down-selected to the originally selected ROI after
#: every step, so that nothing a later step picks up is planned on. False leaves
#: the mesh alone and restricts only the statistics.
global GATE_CROP_TO_ROI
GATE_CROP_TO_ROI = True

#: How much of the mesh may lie OUTSIDE the requested region before that is
#: worth a warning. It is never a refusal, and that distinction is the whole
#: point: a measured mesh is ALWAYS wider than the region that planned it,
#: because the Keyence line is about 31 mm wide and every raster pass overshoots
#: the region's edge: an 18 x 60 mm ROI routinely comes back as a
#: 54.7 x 122.2 mm mesh, 82% of it outside the region, and that is legitimate.
#: Past 0.9 the mesh is essentially all somewhere else, which is worth saying
#: out loud.
global GATE_MAX_MESH_OUTSIDE_REGION
GATE_MAX_MESH_OUTSIDE_REGION = 0.9


# ------------------------------------------------------------------------------
# WHICH SURFACE THE QUALITY CHECKS MEASURE
# ------------------------------------------------------------------------------
# A WHOLE-MESH STATISTIC GRADES THE FIXTURING, NOT THE PART. A reconstruction
# here is the part AND the optical breadboard it is bolted to, the clamps and
# pins holding it down, and a stepped mount block at one end -- of the order of
# 230 000 faces, of which 42 000 are the plate. The breadboard's holes and the
# block's rim turn 90 degrees between neighbouring faces wherever you look, so
# for two scans of one plate that differ only in surface preparation the
# face-to-face normal turn at p99 reads:
#
#                                       scan A     scan B    ratio
#     over the whole mesh                55.5 deg   52.6 deg  1.05
#     over EC_SCAN_REGION's rectangle    53.8 deg   48.7 deg  1.10
#     over the plate alone               10.5 deg    4.5 deg  2.33
#
# The whole-mesh number separates a bad scan from a good one by 6%; the plate
# alone by 2.3x. A statistic that cannot tell those two apart cannot grade a
# surface preparation, and grading the surface is the only thing it is for.
#
# NOTE WHAT THE RECTANGLE DOES NOT DO. Restricting to EC_SCAN_REGION barely
# helps (53.8 / 48.7), because a detected region is itself unreliable: a YOLO
# detection of an 83 x 165 mm plate can come back as a 135 x 287 mm box, with
# the breadboard, the clamps and the block all inside it. A rectangle is offered
# below, and it is honest about being weak.
#
# WHAT ACTUALLY WORKS is roi_select.dpi's selection, because an operator drew it
# round the part. Its `mask` is exact but is indexed over whatever surface was
# shown -- which in run_automated_scan() is the AZURE ROUGH MESH from stage 2,
# not the Keyence mesh gated at stage 5, so the indices do not line up and never
# will: the two meshes do not even have the same vertex count.
#
# ------------------------------------------------------------------------------
# AND A GLOBAL 3D BOX IS NOT SOMETHING TO FALL BACK TO
# ------------------------------------------------------------------------------
# An ROI's x and y travel between meshes. Its z does not. Measured on one
# selection of one plate:
#
#   the ROI's 3D bounds, off the AZURE mesh       z 0.9416 .. 0.9435
#   the Keyence mesh of the same part             z 0.9127 .. 0.9411
#
# The ranges can fail to overlap: the box's z FLOOR sits above the top of the
# Keyence mesh, the crop keeps 0 of 20327 faces, and a fallback to the whole mesh
# then turns a 30 x 84 mm selection into an 80 x 157 mm plan with the optical
# breadboard in it. In x and y the same ROI sits comfortably inside both meshes;
# there is no lateral offset at all.
#
# This is not a calibration fault. verify_calibration() passes at +0.18 mm, and
# the Azure reads every surface in this cell 11.6 to 13.6 mm too far -- a
# sensor-to-sensor disagreement, measured repeatedly. A crop that can be emptied
# by a 2 mm disagreement in surface height between two sensors is a crop that
# will empty itself again.
#
# SO A GLOBAL z BOX IS NOT PART OF A CROP. An ROI is a region drawn looking DOWN
# at a surface; it is a FOOTPRINT, which is what roi_select_geom's
# own bounding_region() has always said. What the ROI carries instead is
# `footprint`: the drawn shape rasterised onto a 2 mm grid in world x-y. That
# transfers between meshes exactly because it is in metres, and it keeps the
# thing a rectangle throws away -- an L-shaped part's corner is not in it, so it
# still excludes the bench that a rectangle round an L-shaped part contains.
# bounds3d is kept in the ROI for provenance and is REPORTED, never applied.
#
# ------------------------------------------------------------------------------
# BUT z IS IN THE DECISION, AS A BAND THAT FOLLOWS THE SELECTED SURFACE
# ------------------------------------------------------------------------------
# DROPPING z ALTOGETHER IS ALSO WRONG. A region selected on top of a flat plate
# must not let the scan reach the table, and the parts being scanned will not
# stay flat -- on a complex curved geometry the x-y shadow alone keeps whatever
# lies under the crown. The scan has to stay inside its ROI, and the ROI has to
# incorporate z, to a sensible tolerance.
#
# The footprint therefore carries a HEIGHT MAP over the same cells: the z of the
# selected surface in each one (roi_select_geom.footprint()). A face is in the
# ROI when its cell is in the footprint AND its height is within
# GATE_ROI_Z_TOLERANCE_M of that cell's height. What that fixes, and what it does
# not repeat:
#
#   the global box     ONE z range for the whole selection. Its floor is the
#                      minimum over the selection, the other sensor's whole mesh
#                      can sit below that floor, and the crop then keeps 0 faces.
#                      A per-cell band compares LOCAL heights, where the two
#                      sensors differ by 0.8-2.6 mm, which the tolerance absorbs.
#   no z at all        crops the drawn x-y shadow. On a flat plate whose
#                      selection stops short of the edge that is the same answer;
#                      on a selection that reaches the plate's edge it keeps the
#                      side wall and the drape, and on a curved part it keeps
#                      whatever is under the crown.
#   a slab plus a      is no better than the global box the moment the part is
#   tolerance          curved: a crown with 25 mm of relief needs a 25 mm slab
#                      before it accepts its own edges, and a 25 mm slab accepts a
#                      bench 19 mm down.
#
# The band's numbers, and the data behind them, are at GATE_ROI_Z_TOLERANCE_M and
# GATE_ROI_MIN_Z_BAND_KEEP. A footprint with no height map -- one built from a
# plain rectangle -- gets x-y only, and the report says so rather than implying
# that z was checked.
#
# Ranked, that makes the order: the vertex mask when it fits this mesh, then the
# footprint with its height band, then the region rectangle, then bounds3d's x-y
# with its global z dropped.
#
# WHAT IS NOT RESTRICTED, and why. Only the two SURFACE-QUALITY checks --
# normal_roughness and tilt_loss -- take an ROI. Everything else stays on the
# whole mesh on purpose:
#
#   * the fatal topology checks (finite, manifold, components, degenerate) are
#     properties of the FILE, and the planner reads the whole file. One NaN
#     vertex out on the breadboard still aborts principal_axis_noether_srv.
#   * the pass and waypoint estimates come from the mesh's principal axes, and
#     those too are computed over every vertex -- see noether_cut_axes().
#   * holes outside the ROI still fragment passes.
#
# All three of those are about the FILE the planner reads -- which is why
# crop_mesh_to_roi() below crops that file, rather than trying to teach every
# check what to ignore.


global _gate_footprint_decode
def _gate_footprint_decode(fp):
    """An ROI footprint's packed form -> {"cell", "i0", "j0", "grid", "heights"}.

    DELIBERATELY A SECOND COPY of roi_select_geom.footprint_decode(). This file
    must stay importable with numpy alone: the gate is exec'd into a bare
    namespace by mesh_plan_gate_test.py, and in a live config noether_path.dpi is
    included before anything puts the module directory on sys.path. Four lines of
    bit unpacking is a smaller liability than an import that works in the scan
    and not in the test. The packing is documented at footprint_encode().

    `heights` is all-NaN when the footprint carries no height map, which is what
    a rectangle's footprint is: a crop then applies x-y alone and says so.
    """
    if fp is None:
        return None
    if "grid" in fp:
        if fp.get("heights") is None:
            fp = dict(fp, heights=np.full(fp["grid"].shape, np.nan))
        return fp
    nx, ny = int(fp["nx"]), int(fp["ny"])
    g = np.zeros((nx, ny), dtype=bool)
    rows = fp["rows"]
    if len(rows) != nx:
        raise ValueError("an ROI footprint has %d rows for nx %d"
                         % (len(rows), nx))
    for i, h in enumerate(rows):
        b = np.unpackbits(np.frombuffer(bytes.fromhex(h), dtype=np.uint8),
                          bitorder="little")
        g[i] = b[:ny]
    hm = np.full((nx, ny), np.nan)
    zrows = fp.get("zrows")
    if zrows is not None:
        if len(zrows) != nx:
            raise ValueError("an ROI footprint has %d height rows for nx %d"
                             % (len(zrows), nx))
        q = float(fp.get("z_quantum", 0.0001))
        z0 = float(fp["z0"])
        for i, s in enumerate(zrows):
            k = np.frombuffer(bytes.fromhex(s), dtype="<i2")
            if len(k) != ny:
                raise ValueError("ROI footprint height row %d has %d cells for "
                                 "ny %d" % (i, len(k), ny))
            row = z0 + k.astype(np.float64)*q
            row[k == -32768] = np.nan             # the "not known" sentinel
            hm[i] = row
    return {"cell": float(fp["cell"]), "i0": int(fp["i0"]), "j0": int(fp["j0"]),
            "grid": g, "heights": hm,
            "height_source": fp.get("height_source", "unrecorded")}


global _gate_footprint_fill_heights
def _gate_footprint_fill_heights(h, grid):
    """Every cell of `grid` gets a height, from its known 8-neighbours outward.

    The second copy of roi_select_geom._footprint_fill_heights(), for the reason
    at _gate_footprint_decode(). Needed here and not only there because GROWING a
    footprint by the planning margin creates cells the selection never sampled,
    and a margin with no height is a margin with no z protection.
    """
    h = np.asarray(h, dtype=np.float64).copy()
    for _ in range(max(h.shape) + 1):
        miss = grid & ~np.isfinite(h)
        if not miss.any():
            return h
        known = np.isfinite(h)
        v = np.where(known, h, 0.0)
        k = known.astype(np.float64)
        sv = np.zeros_like(v)
        sk = np.zeros_like(k)
        for di in (-1, 0, 1):
            for dj in (-1, 0, 1):
                if di == 0 and dj == 0:
                    continue
                # Sliced, never np.roll: a roll wraps the far edge of the grid
                # round to the near one and fills a cell from 100 mm away.
                si = slice(max(di, 0), h.shape[0] + min(di, 0))
                di_ = slice(max(-di, 0), h.shape[0] + min(-di, 0))
                sj = slice(max(dj, 0), h.shape[1] + min(dj, 0))
                dj_ = slice(max(-dj, 0), h.shape[1] + min(-dj, 0))
                sv[si, sj] += v[di_, dj_]
                sk[si, sj] += k[di_, dj_]
        upd = miss & (sk > 0)
        if not upd.any():
            return h
        h[upd] = sv[upd]/sk[upd]
    return h


global _gate_footprint_grown
def _gate_footprint_grown(fp, margin_m):
    """A footprint grown outward by `margin_m`, height map and all."""
    fp = _gate_footprint_decode(fp)
    n = int(np.ceil(float(margin_m)/fp["cell"] - 1e-9)) if margin_m else 0
    if n <= 0:
        return fp
    g = fp["grid"]
    big = np.zeros((g.shape[0] + 2*n, g.shape[1] + 2*n), dtype=bool)
    big[n:n + g.shape[0], n:n + g.shape[1]] = g
    bigh = np.full(big.shape, np.nan)
    bigh[n:n + g.shape[0], n:n + g.shape[1]] = fp["heights"]
    for _ in range(n):
        h = big.copy()
        h[1:, :] |= big[:-1, :]
        h[:-1, :] |= big[1:, :]
        h[:, 1:] |= big[:, :-1]
        h[:, :-1] |= big[:, 1:]
        h[1:, 1:] |= big[:-1, :-1]
        h[:-1, :-1] |= big[1:, 1:]
        h[1:, :-1] |= big[:-1, 1:]
        h[:-1, 1:] |= big[1:, :-1]
        big = h
    return {"cell": fp["cell"], "i0": fp["i0"] - n, "j0": fp["j0"] - n,
            "grid": big, "heights": _gate_footprint_fill_heights(bigh, big),
            "height_source": fp.get("height_source", "unrecorded")}


global _gate_footprint_cells
def _gate_footprint_cells(fp, points):
    """Where `points` land in an already-grown footprint. -> (inside, height).

    `inside` is the x-y test; `height` is the SELECTED SURFACE's height in each
    point's cell, NaN outside the footprint or where the map does not know.
    """
    g, hm, cell = fp["grid"], fp["heights"], fp["cell"]
    i0, j0 = fp["i0"], fp["j0"]
    p = np.asarray(points, dtype=np.float64)
    inside = np.zeros(len(p), dtype=bool)
    height = np.full(len(p), np.nan)
    if not len(p):
        return inside, height
    # A NaN vertex is not in any footprint, and floor()ing one is a cast warning
    # on every numpy this runs on. Reconstructions do write NaN vertices -- 6 in
    # 8466 has been seen -- so this is not hypothetical.
    fin = np.isfinite(p[:, 0]) & np.isfinite(p[:, 1])
    i = np.zeros(len(p), dtype=np.int64)
    j = np.zeros(len(p), dtype=np.int64)
    i[fin] = np.floor(p[fin, 0]/cell).astype(np.int64) - i0
    j[fin] = np.floor(p[fin, 1]/cell).astype(np.int64) - j0
    ok = fin & (i >= 0) & (j >= 0) & (i < g.shape[0]) & (j < g.shape[1])
    inside[ok] = g[i[ok], j[ok]]
    height[inside] = hm[i[inside], j[inside]]
    return inside, height


global _gate_footprint_mask
def _gate_footprint_mask(fp, points, margin_m=0.0):
    """Which of `points` (N x 2 or N x 3) fall in a footprint. z is ignored.

    The x-y half of the test, on its own, and it stays z-free: the band is
    applied by _gate_roi_faces(), which calls _gate_footprint_cells() directly
    because it needs the height alongside the answer. Kept because it is the
    counterpart of roi_select_geom.footprint_mask() -- the two files' footprint
    primitives are deliberately one-for-one, and a crop written against one has to
    mean the same thing read against the other.
    """
    return _gate_footprint_cells(_gate_footprint_grown(fp, margin_m), points)[0]


global _gate_footprint_from_region
def _gate_footprint_from_region(region, cell=0.002):
    """The footprint a plain (xmin, ymin, xmax, ymax) rectangle implies.

    ITS HEIGHT MAP IS EMPTY, and must be: four numbers say nothing about how high
    the surface is. The crop then applies x-y alone and reports that z had no
    say, which is a different statement from "z was checked and passed".
    """
    x0, y0, x1, y1 = (float(a) for a in region)
    lo_x, hi_x = min(x0, x1), max(x0, x1)
    lo_y, hi_y = min(y0, y1), max(y0, y1)
    i0 = int(np.floor(lo_x/cell))
    j0 = int(np.floor(lo_y/cell))
    nx = int(np.floor(hi_x/cell)) - i0 + 1
    ny = int(np.floor(hi_y/cell)) - j0 + 1
    return {"cell": float(cell), "i0": i0, "j0": j0,
            "grid": np.ones((nx, ny), dtype=bool),
            "heights": np.full((nx, ny), np.nan),
            "height_source": "a rectangle, which carries no height at all"}

global _gate_band_offset
def _gate_band_offset(zb):
    """(mm, what it is measured over) for a band report's height disagreement.

    The accepted faces when there are any -- that is the real sensor-to-sensor
    disagreement -- and every x-y face when the band accepted nothing, because
    then there is no agreed surface and the gross offset is the whole story.
    """
    if zb is None:
        return float("nan"), "nothing"
    if np.isfinite(zb.get("offset_mm", float("nan"))):
        return zb["offset_mm"], "where they overlap"
    return zb.get("offset_all_mm", float("nan")), "over the whole footprint"


global _gate_band_phrase
def _gate_band_phrase(fp, z_tolerance=None):
    """The one clause that says whether z is in the decision, and what band.

    Printed wherever a footprint is named: "was z used, and over what band" is
    the first question to ask of a crop, and a report that leaves it implicit
    hides exactly the failure the band exists to prevent.
    """
    tol = GATE_ROI_Z_TOLERANCE_M if z_tolerance is None else float(z_tolerance)
    h = None if fp is None else fp.get("heights")
    if h is None or not np.isfinite(h).any():
        return ", NO z band (this ROI carries no height map)"
    if not tol:
        return (", z band OFF by request (its surface is at z %.4f..%.4f)"
                % (np.nanmin(h), np.nanmax(h)))
    return (", z within +/-%.1f mm of its own surface at z %.4f..%.4f "
            "(%.1f mm of relief)"
            % (tol*1e3, np.nanmin(h), np.nanmax(h),
               (np.nanmax(h) - np.nanmin(h))*1e3))


global _gate_roi_shape
def _gate_roi_shape(roi, region=None, nvertices=None, nfaces=None):
    """What an `roi` argument MEANS, before any mesh is involved.

    -> {"kind", "what", "footprint"/"vertex_mask"/"face_mask", "z_ignored", ...}
    or None for "the whole mesh". Separated from applying it so that
    crop_mesh_to_roi() and the gate's statistics read one interpretation of the
    argument rather than two.

    `roi` may be:

      None / False            the whole mesh. False is the deliberate one.
      a select_roi() dict     its "mask" when that fits this mesh's vertices,
                              then its "footprint" (the drawn shape in world
                              x-y), then its "region", then its "bounds3d" x-y.
                              NEVER its z -- see the note above.
      a bool array            a vertex mask (len == vertices) or a face mask
                              (len == faces). When a mesh has exactly as many
                              faces as vertices the vertex reading wins; say
                              which you meant by passing a dict instead.
      (lo, hi) or 6 numbers   a 3D box in bounds3d order, (xmin, ymin, zmin,
                              xmax, ymax, zmax). Its z is REPORTED AND IGNORED.
      4 numbers               (xmin, ymin, xmax, ymax).
      "region"                the `region` argument, read as those 4 numbers.
    """
    if roi is None or roi is False:
        return None
    if isinstance(roi, str):
        if roi != "region":
            raise ValueError("roi=%r: the only name this takes is 'region'"
                             % (roi,))
        if region is None:
            return None
        roi = [float(a) for a in region]

    if isinstance(roi, dict):
        vm = roi.get("mask")
        nvm = None if vm is None else len(np.asarray(vm).reshape(-1))
        # Say WHERE the ROI is, not just that there was one. An ROI left over
        # from an earlier scan in the same session is the failure mode here, and
        # it is recognisable from its box and invisible from its name.
        where = ""
        if roi.get("region") is not None:
            r = [float(a) for a in roi["region"]]
            where = (" at x %.3f..%.3f y %.3f..%.3f" % (r[0], r[2], r[1], r[3]))
        z = None
        if roi.get("bounds3d") is not None:
            b = [float(a) for a in roi["bounds3d"]]
            z = (min(b[2], b[5]), max(b[2], b[5]))
        if vm is not None and nvertices is not None and nvm == nvertices:
            return {"kind": "vertex_mask",
                    "vertex_mask": np.asarray(vm).reshape(-1).astype(bool),
                    "z_ignored": z,
                    "what": ("the operator's ROI%s (%d of %d vertices)"
                             % (where, int(np.asarray(vm).sum()), nvm))}
        why_not_mask = ("it carries no vertex mask" if vm is None else
                        "its vertex mask is over a different mesh -- %d values "
                        "for this mesh's %s vertices" % (nvm, nvertices))
        if roi.get("footprint") is not None:
            fp = _gate_footprint_decode(roi["footprint"])
            cells = int(fp["grid"].sum())
            return {"kind": "footprint", "footprint": fp, "z_ignored": z,
                    "what": ("the operator's ROI%s as its drawn x-y footprint "
                             "(%d cells of %.1f mm, %.1f cm2%s; %s)"
                             % (where, cells, fp["cell"]*1e3,
                                cells*fp["cell"]**2*1e4,
                                _gate_band_phrase(fp), why_not_mask))}
        if roi.get("region") is not None:
            r = [float(a) for a in roi["region"]]
            return {"kind": "region", "footprint": _gate_footprint_from_region(r),
                    "region": r, "z_ignored": z,
                    "what": ("the operator's ROI%s as its x-y rectangle "
                             "(%.0f x %.0f mm; %s, and it carries no footprint)"
                             % (where, (r[2] - r[0])*1e3, (r[3] - r[1])*1e3,
                                why_not_mask))}
        if z is not None:
            b = [float(a) for a in roi["bounds3d"]]
            r = [min(b[0], b[3]), min(b[1], b[4]),
                 max(b[0], b[3]), max(b[1], b[4])]
            return {"kind": "bounds3d_xy",
                    "footprint": _gate_footprint_from_region(r), "region": r,
                    "z_ignored": z,
                    "what": ("the operator's ROI%s as the x-y of its 3D bounds "
                             "(%.0f x %.0f mm; %s)"
                             % (where, (r[2] - r[0])*1e3, (r[3] - r[1])*1e3,
                                why_not_mask))}
        raise ValueError("an roi dict needs a 'mask' that fits this mesh, a "
                         "'footprint', a 'region' or a 'bounds3d'; got keys %s"
                         % (sorted(roi),))

    a = np.asarray(roi)
    if a.dtype == bool or (a.ndim == 1 and a.dtype.kind in "biu"
                           and len(a) in (nvertices or -1, nfaces or -2)
                           and set(np.unique(a).tolist()) <= {0, 1}):
        a = a.reshape(-1).astype(bool)
        if nvertices is not None and len(a) == nvertices:
            return {"kind": "vertex_mask", "vertex_mask": a, "z_ignored": None,
                    "what": "a vertex mask (%d of %d vertices)"
                            % (int(a.sum()), nvertices)}
        if nfaces is not None and len(a) == nfaces:
            return {"kind": "face_mask", "face_mask": a, "z_ignored": None,
                    "what": "a face mask (%d of %d faces)"
                            % (int(a.sum()), nfaces)}
        raise ValueError("a boolean roi must have one entry per vertex (%s) or "
                         "per face (%s), got %d" % (nvertices, nfaces, len(a)))

    b = np.asarray(a, dtype=np.float64).reshape(-1)
    if b.size == 6:
        r = [min(b[0], b[3]), min(b[1], b[4]), max(b[0], b[3]), max(b[1], b[4])]
        z = (min(b[2], b[5]), max(b[2], b[5]))
    elif b.size == 4:
        r = [min(b[0], b[2]), min(b[1], b[3]), max(b[0], b[2]), max(b[1], b[3])]
        z = None
    else:
        raise ValueError(
            "an roi box is 4 numbers (xmin, ymin, xmax, ymax) or 6 "
            "(xmin, ymin, zmin, xmax, ymax, zmax), got %d" % (b.size,))
    return {"kind": "box", "footprint": _gate_footprint_from_region(r),
            "region": r, "z_ignored": z,
            "what": ("a %.0f x %.0f mm x-y box"
                     % ((r[2] - r[0])*1e3, (r[3] - r[1])*1e3)
                     + ("" if z is None else
                        " (its z %.4f..%.4f is REPORTED AND IGNORED: a z range "
                        "measured on one sensor's mesh does not apply to "
                        "another's)" % z))}


global _gate_roi_faces
def _gate_roi_faces(v, tf, shape, margin_m=0.0, z_tolerance=None):
    """Apply a _gate_roi_shape() to a mesh. -> (face mask, covered, z report).

    `covered` is HOW MUCH OF THE ROI THIS MESH ACTUALLY OCCUPIES -- the fraction
    of the ROI's own footprint cells that hold at least one of this mesh's
    vertices. That is the number that tells "the operator drew a small region"
    apart from "this ROI and this mesh are not the same surface", and it is
    measured on the ROI rather than on the mesh so that a big mesh cannot dilute
    it. A vertex or face mask that fits this mesh is by definition about this
    mesh, so it reports 1.0. It is measured IN x-y ALONE, deliberately: it has to
    be able to say "laterally these are the same surface but their heights
    disagree", which is a distinct fault with a distinct fix.

    `z` is None when no band was applied, else
    {"tolerance", "xy_faces", "faces", "dropped", "no_height", "kept_fraction",
     "offset_mm", "dropped_z"} -- what the band did, so the caller can print it
    and refuse on it.

    A face is in when its CENTROID is in the footprint, which is the test that
    stays meaningful when the ROI was drawn on a different mesh from the one
    being cropped. A vertex mask is stricter: all three of a face's
    vertices have to be selected, so the mask's own rim does not drag in the
    bench.

    ------------------------------------------------------------------------
    THE z TEST, AND WHY IT IS SHAPED THIS WAY
    ------------------------------------------------------------------------
    A face's REFERENCE HEIGHT is not one number but the range of the heights of
    every footprint cell the face touches -- the cells of its three vertices and
    of its centroid -- and it is in when its centroid's z lies within
    `z_tolerance` of that range. Three decisions, each of which had an obvious
    wrong answer:

      A FACE SPANNING CELLS gets the min..max of those cells rather than only its
      centroid's cell. On a curved part a single face can bridge 2 mm of x-y over
      which the surface climbs; charging it for the difference between its own z
      and one cell's height would drop faces for being on a slope. Taking the
      range means a face is judged against the surface it actually spans. It
      cannot be exploited to reach the bench: the cells a drape face touches are
      the plate's cells and cells outside the footprint, never the bench's, so its
      band is the plate's height and its centroid 10 mm below is out.

      THE CENTROID'S z DECIDES, not the face's own z range. A near-vertical face
      at the rim of a part has a 5 mm z range of its own and would pass any band
      wide enough to contain the surface; asking where the face IS is the same
      question the x-y test asks, and the two then agree about what a face is.

      A CELL WITH NO HEIGHT does not veto. The height map is filled from its
      neighbours, so for a drawn selection this is nowhere; for a rectangle it is
      everywhere, and a rectangle genuinely says nothing about z. Those faces are
      kept and COUNTED in z["no_height"], so "z was not applied here" is a
      number in the report and not a silence.
    """
    if shape is None:
        return None, 1.0, None
    if shape["kind"] == "vertex_mask":
        return shape["vertex_mask"][tf].all(axis=1), 1.0, None
    if shape["kind"] == "face_mask":
        return shape["face_mask"], 1.0, None
    tol = GATE_ROI_Z_TOLERANCE_M if z_tolerance is None else float(z_tolerance)
    fp = _gate_footprint_grown(shape["footprint"], margin_m)
    ctr = v[tf].mean(axis=1)
    inxy, h_ctr = _gate_footprint_cells(fp, ctr)

    # COVERED, in x-y alone, AND OVER THE ROI AS DRAWN -- the ungrown footprint,
    # never the one widened by the planning margin. The question it answers is
    # "does this mesh occupy the region the operator drew", and a mesh that stops
    # exactly at the drawn edge is a complete answer to that; charging it for the
    # 5 mm ring Noether needs to run into would make a perfect mesh read as 85%
    # covered for a reason that has nothing to do with the mesh.
    drawn = _gate_footprint_decode(shape["footprint"])
    g = drawn["grid"]
    fin = np.isfinite(v[:, 0]) & np.isfinite(v[:, 1])
    i = np.zeros(len(v), dtype=np.int64)
    j = np.zeros(len(v), dtype=np.int64)
    i[fin] = np.floor(v[fin, 0]/drawn["cell"]).astype(np.int64) - drawn["i0"]
    j[fin] = np.floor(v[fin, 1]/drawn["cell"]).astype(np.int64) - drawn["j0"]
    ok = fin & (i >= 0) & (j >= 0) & (i < g.shape[0]) & (j < g.shape[1])
    hit = np.zeros(g.shape, dtype=bool)
    hit[i[ok], j[ok]] = True
    covered = float((hit & g).sum())/max(int(g.sum()), 1)

    heights = fp["heights"]
    if (not tol or heights is None or not np.isfinite(heights).any()
            or not np.isfinite(drawn["heights"]).any()):
        return inxy, covered, None

    lo = np.full(len(tf), np.inf)
    hi = np.full(len(tf), -np.inf)
    known = np.zeros(len(tf), dtype=bool)
    for src in (h_ctr, _gate_footprint_cells(fp, v[tf[:, 0]])[1],
                _gate_footprint_cells(fp, v[tf[:, 1]])[1],
                _gate_footprint_cells(fp, v[tf[:, 2]])[1]):
        f = np.isfinite(src)
        lo[f] = np.minimum(lo[f], src[f])
        hi[f] = np.maximum(hi[f], src[f])
        known |= f
    band = inxy.copy()
    judged = inxy & known
    band[judged] = ((ctr[judged, 2] >= lo[judged] - tol) &
                    (ctr[judged, 2] <= hi[judged] + tol))
    dropped = inxy & ~band
    # HOW FAR APART THE TWO SURFACES ARE, and it takes two numbers because the
    # question is different in the two cases. `offset_mm` is the median over the
    # faces the band ACCEPTED: that is the sensor-to-sensor disagreement on the
    # surface the ROI really describes, 1-3 mm on this cell, and it is what the
    # report should show. Measured over every x-y face instead it would average
    # the part with whatever the margin swept up -- 20 mm of bench on a plate --
    # and read as a calibration fault. `offset_all_mm` IS that wider median, and
    # it is the right one for the refusal below: when almost nothing survives the
    # band there is no accepted surface to measure, and the gross offset is the
    # diagnosis.
    def _med(sel):
        if not sel.any():
            return float("nan")
        return float(np.median(0.5*(lo[sel] + hi[sel]) - ctr[sel, 2]))*1e3
    z = {"tolerance": tol, "xy_faces": int(inxy.sum()), "faces": int(band.sum()),
         "dropped": int(dropped.sum()), "no_height": int((inxy & ~known).sum()),
         "kept_fraction": float(band.sum())/max(int(inxy.sum()), 1),
         "offset_mm": _med(judged & band), "offset_all_mm": _med(judged),
         # The ROI AS DRAWN, not as grown by the planning margin: what is
         # reported as "the ROI's surface is at z A..B" has to be the operator's
         # selection, not the selection plus a ring filled from it.
         "surface_z": (float(np.nanmin(drawn["heights"])),
                       float(np.nanmax(drawn["heights"]))),
         # WHERE THE HEIGHTS CAME FROM, carried through so the report can say it.
         # "the selected triangles, sampled; 580 of 690 cells sampled directly,
         # the rest filled from neighbours in 1 pass" is the difference between a
         # band measured on the operator's surface and one interpolated across a
         # gap, and it is not visible in any of the counts.
         "source": drawn.get("height_source", "unrecorded"),
         # nanmin: a NaN-z face has a NaN centroid, fails the band and lands here,
         # and this cell's reconstruction has written NaN vertices before.
         "dropped_z": (None if not dropped.any()
                       or not np.isfinite(ctr[dropped, 2]).any() else
                       (float(np.nanmin(ctr[dropped, 2])),
                        float(np.nanmax(ctr[dropped, 2]))))}
    return band, covered, z


global _gate_surface_mask
def _gate_surface_mask(v, tf, roi, region=None):
    """Which faces the surface-quality checks measure. -> a dict.

    {"mask": face mask or None for all of them, "what": one line,
     "covered": how much of the ROI this mesh occupies, "verdict":
     "whole"/"restricted"/"few_faces"/"mismatch"/"z_mismatch",
     "z_band": what the height band did, or None}.

    The mask is None for "all of them", which is the default and is what this
    gate did before ROIs existed. It is ALSO what comes back from the two
    failure cases -- but those now carry a verdict that mesh_plan_report() turns
    into a check, loudly, instead of a printed note nobody acted on.
    """
    shape = _gate_roi_shape(roi, region, nvertices=len(v), nfaces=len(tf))
    if shape is None:
        if isinstance(roi, str) and region is None:
            return {"mask": None, "verdict": "whole", "covered": 1.0,
                    "what": "the whole mesh (roi='region', but no region was "
                            "given)"}
        return {"mask": None, "verdict": "whole", "covered": 1.0,
                "what": "the whole mesh"}

    mask, covered, zb = _gate_roi_faces(v, tf, shape)
    n = int(mask.sum())
    out = {"mask": mask, "covered": covered, "kind": shape["kind"],
           "z_ignored": shape.get("z_ignored"), "faces": n,
           "z_band": zb, "verdict": "restricted",
           "what": "%s: %d of %d faces%s"
                   % (shape["what"], n, len(tf),
                      "" if zb is None else
                      " (the z band dropped %d of the %d its x-y footprint "
                      "matched%s)"
                      % (zb["dropped"], zb["xy_faces"],
                         "" if not zb["no_height"] else
                         ", and %d had no height to judge" % (zb["no_height"],)))}

    # THE THREE WAYS A CROP COMES BACK NEARLY EMPTY, AND THEY ARE DIFFERENT FACTS.
    # LATERAL FIRST, ALWAYS. An ROI 300 mm away in x matches no cells at all, so
    # its z band trivially matches nothing either; diagnosing that as a height
    # disagreement would send whoever reads it looking at the calibration instead
    # of at which scan the selection came from.
    if covered < GATE_ROI_MIN_MESH_OVERLAP:
        # nanmin: a mesh with NaN vertices is exactly the kind this has to describe.
        lo, hi = np.nanmin(v, axis=0), np.nanmax(v, axis=0)
        out["mask"] = None
        out["verdict"] = "mismatch"
        out["what"] = (
            "the whole mesh -- %s covers only %.0f%% of its own footprint on "
            "this mesh (%d of %d faces), under the %.0f%% that means they are "
            "the same surface at all. THE ROI AND THIS MESH DO NOT DESCRIBE THE "
            "SAME SURFACE: the mesh is at x %.3f..%.3f y %.3f..%.3f z "
            "%.3f..%.3f. A selection left over from an earlier scan, a mesh "
            "reconstructed in the wrong frame, or an ROI drawn on a surface this "
            "one does not overlap all look like this."
            % (shape["what"], covered*100.0, n, len(tf),
               GATE_ROI_MIN_MESH_OVERLAP*100.0,
               lo[0], hi[0], lo[1], hi[1], lo[2], hi[2]))
    elif (zb is not None and zb["xy_faces"]
          and zb["kept_fraction"] < GATE_ROI_MIN_Z_BAND_KEEP):
        # LATERALLY THE SAME SURFACE, VERTICALLY NOT. A refusal rather than a
        # retreat to x-y: a band that matches nothing means the ROI's height map
        # and this mesh disagree by more than two sensors ever should, and
        # planning on the x-y shadow of an ROI that may not even be this part is
        # how the bench gets scanned.
        lo, hi = np.nanmin(v, axis=0), np.nanmax(v, axis=0)
        out["mask"] = None
        out["verdict"] = "z_mismatch"
        out["what"] = (
            "the whole mesh -- %s matches this mesh in x-y (%.0f%% of its own "
            "footprint) but NOT IN HEIGHT: only %d of the %d faces its footprint "
            "matched are within +/-%.1f mm of the selected surface, %.0f%%, under "
            "the %.0f%% that means the two are at compatible heights. The ROI's "
            "surface is at z %.4f..%.4f and this mesh is at z %.4f..%.4f, a "
            "median offset of %.1f mm. Either this ROI was drawn on a different "
            "part, or a sensor is out by far more than the %.1f mm band -- and "
            "this is NOT the same fact as a small selection (roi_few_faces) or a "
            "lateral mismatch."
            % (shape["what"], covered*100.0, zb["faces"], zb["xy_faces"],
               zb["tolerance"]*1e3, zb["kept_fraction"]*100.0,
               GATE_ROI_MIN_Z_BAND_KEEP*100.0,
               zb["surface_z"][0], zb["surface_z"][1], lo[2], hi[2],
               zb["offset_all_mm"], zb["tolerance"]*1e3))
    elif n < GATE_MIN_ROI_FACES:
        out["mask"] = None
        out["verdict"] = "few_faces"
        out["what"] = (
            "the whole mesh -- %s left only %d of %d faces, under the %d a "
            "percentile can be taken over, so the STATISTICS are the whole "
            "mesh's. This is a small selection and not a mismatch: the ROI does "
            "cover %.0f%% of its own footprint here, so it is about this "
            "surface. The mesh crop still applies."
            % (shape["what"], n, len(tf), GATE_MIN_ROI_FACES, covered*100.0))
    return out


class RoiDoesNotFitMesh(RuntimeError):
    """This ROI and this mesh do not describe the same surface.

    Distinct from MeshNotPlannable on purpose: nothing is wrong with the mesh.
    What is wrong is the pairing, and the fix is to find out which of the two is
    from a different scan rather than to clean anything.
    """
    def __init__(self, message, report=None):
        RuntimeError.__init__(self, message)
        self.report = report


#: What the last crop_mesh_to_roi() did, so a plan can be asked afterwards.
global last_roi_crop_report
last_roi_crop_report = None


global _gate_write_ply
def _gate_write_ply(path, v, n, t, comment):
    """Binary little-endian PLY that read_ply_mesh() reads back. Normals kept."""
    props = [("x", "<f8"), ("y", "<f8"), ("z", "<f8")]
    if n is not None:
        props += [("nx", "<f8"), ("ny", "<f8"), ("nz", "<f8")]
    vd = np.zeros(len(v), dtype=np.dtype(props))
    vd["x"], vd["y"], vd["z"] = v[:, 0], v[:, 1], v[:, 2]
    if n is not None:
        vd["nx"], vd["ny"], vd["nz"] = n[:, 0], n[:, 1], n[:, 2]
    fd = np.zeros(len(t), dtype=np.dtype([("n", "u1"), ("v", "<u4", 3)]))
    fd["n"] = 3
    fd["v"] = t
    head = ["ply", "format binary_little_endian 1.0", "comment %s" % (comment,),
            "element vertex %d" % (len(v),)]
    head += ["property double %s" % c for c, _ in props]
    head += ["element face %d" % (len(t),),
             "property list uchar uint vertex_indices", "end_header"]
    with open(path, "wb") as f:
        f.write(("\n".join(head) + "\n").encode("ascii"))
        f.write(vd.tobytes())
        f.write(fd.tobytes())
    return path


global crop_mesh_to_roi
def crop_mesh_to_roi(mesh_in, mesh_out=None, roi=None, region=None,
                     margin_m=None, verbose=True, z_tolerance=None):
    """Down-select a mesh to the ORIGINAL operator ROI. -> the mesh to plan on.

    THE MESH IS DOWN-SELECTED TO THE ORIGINAL SELECTION AFTER EVERY STEP, so
    that whatever a later step picks up is not planned on. It is the MESH that
    needs this: EC_SCAN_REGION already crops the eddy-current waypoints
    correctly, while the mesh handed to Noether is the whole reconstruction --
    which is how an 18 x 60 mm selection comes to be planned over a
    54.7 x 122.2 mm mesh.
    Cropping the FILE is also what makes the checks that cannot take an ROI --
    the topology ones, the principal axes, the hole count -- describe the part:
    the planner reads the whole file, so the file is what has to be right.

    In x and y the crop is GENEROUS by `margin_m`, because the exact trim is the
    toolpath crop to `region` after planning and Noether's passes have to be able
    to reach the edge of the region. In z it is a BAND THAT FOLLOWS THE SELECTED
    SURFACE: each footprint cell carries the height of the surface the operator
    chose there, and a face is in when its height is within `z_tolerance`
    (GATE_ROI_Z_TOLERANCE_M, 6 mm, derived from measured sensor disagreement) of
    the cells it touches. On a flat plate that is a slab; on a curved part it
    follows the curve. What it is NOT is a single global z box -- such a box
    empties this crop outright; see the note above _gate_roi_shape().
    z_tolerance=0 turns the band off for one call.

    Returns `mesh_in` unchanged when there is nothing to do -- no ROI,
    GATE_CROP_TO_ROI off, or the ROI already contains the whole mesh -- so a
    caller can assign the result unconditionally. Raises RoiDoesNotFitMesh when
    the ROI and the mesh are not the same surface, which is the case that used to
    fall back to the whole mesh with a printed note.
    """
    margin_m = GATE_ROI_CROP_MARGIN_M if margin_m is None else float(margin_m)
    rep = {"mesh": mesh_in, "cropped": False, "why": None}
    globals()["last_roi_crop_report"] = rep
    if not GATE_CROP_TO_ROI or roi is None or roi is False:
        rep["why"] = ("GATE_CROP_TO_ROI is off" if not GATE_CROP_TO_ROI
                      else "no ROI was given")
        return mesh_in
    if not isinstance(mesh_in, str):
        rep["why"] = "the mesh is arrays in memory, not a file"
        return mesh_in

    try:
        v, n, t = read_ply_mesh(mesh_in)
    except Exception as exc:
        # A POINT CLOUD, or a missing file. Do not raise here: the gate
        # immediately downstream names that case properly ("a PLY with points and
        # no faces is a POINT CLOUD, not a mesh"), and a ValueError out of the
        # crop would replace a good diagnosis with a worse one.
        rep["why"] = "could not be read (%s); the gate will say why" % (exc,)
        return mesh_in
    shape = _gate_roi_shape(roi, region, nvertices=len(v), nfaces=len(t))
    if shape is None:
        rep["why"] = "the roi argument resolves to the whole mesh"
        return mesh_in
    keep, covered, zb = _gate_roi_faces(v, t, shape, margin_m=margin_m,
                                        z_tolerance=z_tolerance)
    rep.update({"what": shape["what"], "kind": shape["kind"],
                "covered": covered, "margin_m": margin_m,
                "faces_in": int(len(t)), "vertices_in": int(len(v)),
                "faces_out": int(keep.sum()), "z_ignored": shape.get("z_ignored"),
                "z_band": zb})

    if covered < GATE_ROI_MIN_MESH_OVERLAP:
        lo, hi = np.nanmin(v, axis=0), np.nanmax(v, axis=0)
        rep["why"] = "mismatch"
        raise RoiDoesNotFitMesh(
            "the ROI and %s do not describe the same surface, so the mesh was "
            "NOT cropped and NOTHING was planned. %s covers only %.1f%% of its "
            "own footprint on this mesh -- %d of %d faces survive it -- against "
            "the %.0f%% (GATE_ROI_MIN_MESH_OVERLAP) that means they overlap at "
            "all.\n    the mesh is at x %.3f..%.3f y %.3f..%.3f z %.3f..%.3f\n"
            "    Which of the two is from a different scan? A selection left in "
            "last_roi by an earlier run, a reconstruction that tracked the wrong "
            "frame, and an ROI drawn on a surface this one does not overlap all "
            "look exactly like this. Falling back to the WHOLE MESH here is how "
            "a 30 x 84 mm selection becomes an 80 x 157 mm plan with the optical "
            "breadboard in it, so it is refused instead."
            % (os.path.basename(mesh_in), shape["what"], covered*100.0,
               int(keep.sum()), len(t), GATE_ROI_MIN_MESH_OVERLAP*100.0,
               lo[0], hi[0], lo[1], hi[1], lo[2], hi[2]), rep)
    if zb is not None and zb["xy_faces"] \
            and zb["kept_fraction"] < GATE_ROI_MIN_Z_BAND_KEEP:
        # THE SAME PLACE IN PLAN, THE WRONG HEIGHT. Deliberately a different
        # message from the lateral mismatch above and from the small selection
        # below, because it sends you somewhere else: to which sensor measured
        # what, not to which scan the ROI is from. And it is a REFUSAL, not a
        # retreat to x-y -- a band nothing survives is a band that is describing
        # some other surface, and the way back is explicit
        # (GATE_ROI_Z_TOLERANCE_M, or z_tolerance=0 for one call).
        rep["why"] = "z_mismatch"
        raise RoiDoesNotFitMesh(
            "the ROI and %s are in the same place in plan but AT DIFFERENT "
            "HEIGHTS, so the mesh was NOT cropped and NOTHING was planned. %s "
            "matches %.0f%% of its own footprint here laterally, but only %d of "
            "those %d faces (%.1f%%) are within +/-%.1f mm of the surface the "
            "operator selected -- against the %.0f%% "
            "(GATE_ROI_MIN_Z_BAND_KEEP) that means the two are at compatible "
            "heights.\n    the ROI's surface is at z %.4f..%.4f; this mesh is at "
            "z %.4f..%.4f; the median offset where they overlap is %.1f mm\n"
            "    Two sensors on this cell disagree about surface height by "
            "0.8-2.6 mm, which the band absorbs. %.1f mm is something else: an "
            "ROI drawn on a different part, a reconstruction in the wrong frame, "
            "or a calibration that has moved. Raise GATE_ROI_Z_TOLERANCE_M only "
            "if you can say why the disagreement is real -- the bench is 19 mm "
            "below the plate top here, and a band that reaches it is a band that "
            "plans the bench."
            % (os.path.basename(mesh_in), shape["what"], covered*100.0,
               zb["faces"], zb["xy_faces"], zb["kept_fraction"]*100.0,
               zb["tolerance"]*1e3, GATE_ROI_MIN_Z_BAND_KEEP*100.0,
               zb["surface_z"][0], zb["surface_z"][1],
               np.nanmin(v[:, 2]), np.nanmax(v[:, 2]),
               zb["offset_all_mm"], abs(zb["offset_all_mm"])), rep)
    if not keep.any():
        rep["why"] = "empty"
        raise RoiDoesNotFitMesh(
            "cropping %s to %s left NO faces at all, of %d. There is nothing to "
            "plan on." % (os.path.basename(mesh_in), shape["what"], len(t)), rep)
    if keep.all():
        rep["why"] = "the ROI already contains the whole mesh"
        if verbose:
            progress_note("ROI crop: %s already contains all %d faces of %s"
                          % (shape["what"], len(t), os.path.basename(mesh_in)))
        return mesh_in

    if mesh_out is None:
        mesh_out = os.path.splitext(mesh_in)[0] + "_roi.ply"
    kept = t[keep]
    used = np.unique(kept.ravel())
    remap = -np.ones(len(v), dtype=np.int64)
    remap[used] = np.arange(len(used))
    _gate_write_ply(mesh_out, v[used], None if n is None else n[used],
                    remap[kept],
                    "crop_mesh_to_roi(%s)" % (os.path.basename(mesh_in),))
    rep.update({"mesh": mesh_out, "cropped": True, "why": "cropped",
                "vertices_out": int(len(used))})
    if verbose:
        e = shape.get("z_ignored")
        # ONE LINE THE OPERATOR CAN READ IN ONE GLANCE: was z used, what band,
        # how many faces it cost, and how far off the two surfaces are. All four,
        # every time -- a crop that silently empties itself is invisible in a
        # report that mentions none of them.
        if zb is None:
            zsay = ("x-y only, NO z band (this ROI carries no height map, so "
                    "nothing says how high its surface is)")
        else:
            _off, _over = _gate_band_offset(zb)
            zsay = ("z within +/-%.1f mm of the selected surface (z %.4f..%.4f, "
                    "%.1f mm of relief): that cost %d of the %d faces the x-y "
                    "footprint matched, leaving %.1f%%; the two surfaces differ "
                    "by %.1f mm %s%s%s"
                    % (zb["tolerance"]*1e3, zb["surface_z"][0], zb["surface_z"][1],
                       (zb["surface_z"][1] - zb["surface_z"][0])*1e3,
                       zb["dropped"], zb["xy_faces"],
                       zb["kept_fraction"]*100.0, _off, _over,
                       "" if zb["dropped_z"] is None else
                       "; dropped faces were at z %.4f..%.4f"
                       % (zb["dropped_z"][0], zb["dropped_z"][1]),
                       "" if not zb["no_height"] else
                       "; %d faces had no cell height and were judged on x-y "
                       "alone" % (zb["no_height"],)))
        progress_note(
            "ROI crop: %s -> %s, %d of %d faces kept (%.0f%%), %d of %d "
            "vertices; %s, %.1f mm x-y margin; %s%s"
            % (os.path.basename(mesh_in), os.path.basename(mesh_out),
               rep["faces_out"], rep["faces_in"],
               100.0*rep["faces_out"]/max(rep["faces_in"], 1),
               rep["vertices_out"], rep["vertices_in"], shape["what"],
               margin_m*1e3, zsay,
               "" if e is None else
               ". The ROI's GLOBAL z box %.4f..%.4f is provenance and is not a "
               "crop -- this mesh is at z %.4f..%.4f, and applying that box "
               "across two sensors can keep 0 faces; the per-cell band above is "
               "what stands in for it"
               % (e[0], e[1], np.nanmin(v[:, 2]), np.nanmax(v[:, 2]))))
    return mesh_out


global _gate_check
def _gate_check(checks, name, level, ok, value, limit, why, fix=None):
    checks.append({"name": name, "level": ("ok" if ok else level), "ok": bool(ok),
                   "value": value, "limit": limit, "why": why, "fix": fix})
    return checks[-1]


def mesh_plan_report(mesh, line_spacing=None, max_tilt_deg=None,
                     work_volume=None, region=None, envelope=None,
                     estimate_normals=None, waypoint_spacing_m=None,
                     up=(0.0, 0.0, 1.0), rotation_offset=None, roi=None):
    """Everything that decides whether Noether can plan on this mesh.

    Reads the mesh once and measures it. No service, no robot, no ROS: this is
    meant to run the instant a reconstruction is written, and again before a
    plan is committed, and to cost nothing either time.

    mesh              path to a PLY, or (vertices, normals, triangles).
    line_spacing      the distance between passes the plan will ask for. Used
                      for the waypoints-per-pass and fragmentation estimates.
    max_tilt_deg      the tilt cap the pipeline will crop to (EC_MAX_TILT_DEG).
    work_volume       (lo, hi) the cell's measured box, or None to skip.
    region            (xmin, ymin, xmax, ymax) the area asked for, or None.
    envelope          a CableEnvelope, or None. Its measured tilt hull is what
                      the report checks the surface normals against -- a pose
                      outside it is one nobody has measured the cables at.
    estimate_normals  True if the planner will re-estimate normals (the
                      `depth_reconstruction` request field). None means "the
                      pipeline's default for a reconstruction", which is True.
                      It matters: on the real mesh, letting the planner
                      estimate gave 16.0% of poses pointing INTO the part and a
                      52.4 deg tilt p95, and using the mesh's own Poisson
                      normals gave 0% and 20.9 deg, from the same 74100 poses.
    rotation_offset   the planner's `rotation_offset`, which decides which way
                      the passes run and therefore how many of them there are
                      and how long each one is -- see noether_cut_axes(). None
                      reads NOETHER_ROTATION_OFFSET, and 0.0 if no config set
                      one, which is the planner's own default.
    roi               WHICH SURFACE THE QUALITY CHECKS MEASURE. None means the
                      whole mesh, which is what this has always done and is
                      still the default -- see _gate_roi_shape() for the forms
                      it takes, for why the whole-mesh number cannot see the
                      part on a real reconstruction, and for why the ROI's z is
                      reported and never applied. An ROI that does not overlap
                      this mesh is a BLOCKING roi_mesh_agreement check rather
                      than a silent fallback.

    Returns a dict with "verdict" in {"plan", "repair", "refuse"}, the lists
    "fatal"/"blocking"/"warn", every individual check under "checks", and the
    measured numbers under "measured". describe_mesh_plan_report() prints it.
    """
    line_spacing = 0.001 if line_spacing is None else float(line_spacing)
    max_tilt_deg = 45.0 if max_tilt_deg is None else float(max_tilt_deg)
    waypoint_spacing_m = (0.001 if waypoint_spacing_m is None
                          else float(waypoint_spacing_m))
    estimate_normals = True if estimate_normals is None else bool(estimate_normals)
    if rotation_offset is None:
        rotation_offset = globals().get("NOETHER_ROTATION_OFFSET", 0.0)
    rotation_offset = float(rotation_offset)

    rep = {"mesh": mesh if isinstance(mesh, str) else "<arrays>",
           "line_spacing_m": line_spacing, "max_tilt_deg": max_tilt_deg,
           "estimate_normals": estimate_normals,
           "rotation_offset": rotation_offset,
           "checks": [], "fatal": [], "blocking": [], "warn": [],
           "measured": {}, "verdict": "refuse", "repairable": False}
    checks = rep["checks"]
    m = rep["measured"]

    # --- can it even be read? -------------------------------------------------
    if isinstance(mesh, str):
        if not os.path.exists(mesh):
            _gate_check(checks, "readable", "fatal", False, None, None,
                        "no such file: %s" % (mesh,))
            return _gate_finish(rep)
        try:
            v, vn, t = read_ply_mesh(mesh)
        except Exception as exc:
            # "has no vertices or no faces" is what a POINT CLOUD reads as, and
            # most of the .ply files a Keyence reconstruction chain writes are
            # point clouds. Name that case, because handing one to the planner gives
            # "Loaded mesh is empty" in a log the caller never sees.
            _gate_check(checks, "readable", "fatal", False, None, None,
                        "%s: %s%s" % (os.path.basename(mesh), exc,
                                      " -- a PLY with points and no faces is a "
                                      "POINT CLOUD, not a mesh; reconstruct a "
                                      "surface from it first"
                                      if "no vertices or no faces" in str(exc) else ""),
                        fix="reconstruct a surface (poisson/ball pivot) first")
            return _gate_finish(rep)
    else:
        v, vn, t = mesh
        v = np.asarray(v, dtype=np.float64).reshape(-1, 3)
        t = np.asarray(t, dtype=np.int64).reshape(-1, 3)
        vn = None if vn is None else np.asarray(vn, dtype=np.float64).reshape(-1, 3)
    _gate_check(checks, "readable", "fatal", True, None, None, "mesh read")

    m["vertices"] = int(len(v))
    m["faces"] = int(len(t))
    m["has_vertex_normals"] = vn is not None
    _gate_check(checks, "faces", "fatal", len(t) > 0, int(len(t)), 1,
                "%d triangles" % (len(t),),
                fix="reconstruct a surface from the point cloud")
    if not len(t):
        return _gate_finish(rep)

    # --- non-finite: the one that kills the SERVICE, not just the plan --------
    nonfinite_v = int((~np.isfinite(v).all(axis=1)).sum())
    if vn is not None:
        nonfinite_v = max(nonfinite_v, int((~np.isfinite(vn).all(axis=1)).sum()))
    m["nonfinite_vertices"] = nonfinite_v
    _gate_check(
        checks, "finite", "fatal", nonfinite_v == 0, nonfinite_v, 0,
        "%d vertices are NaN or Inf. PCL's normal estimation asserts on one "
        "(KdTreeFLANN::radiusSearch) and the assert ABORTS "
        "principal_axis_noether_srv itself, so every later plan fails with 'no "
        "principal_axis_noether service' until it is restarted. A "
        "reconstruction's own smoothing step has written 6 such vertices in "
        "8466."
        % (nonfinite_v,) if nonfinite_v else "every vertex is finite",
        fix="clean_mesh_for_planning() drops the faces that use them")
    finite = np.isfinite(v).all(axis=1)
    good = finite[t].all(axis=1)
    tf = t[good]            # measure the rest on the finite part
    if not len(tf):
        return _gate_finish(rep)

    lo, hi = v[finite].min(axis=0), v[finite].max(axis=0)
    m["bbox"] = [lo.tolist(), hi.tolist()]
    m["extent_mm"] = ((hi - lo)*1e3).tolist()

    # --- geometry the planner walks ------------------------------------------
    e0 = v[tf[:, 1]] - v[tf[:, 0]]
    e1 = v[tf[:, 2]] - v[tf[:, 1]]
    e2 = v[tf[:, 0]] - v[tf[:, 2]]
    el = np.concatenate([np.linalg.norm(e0, axis=1), np.linalg.norm(e1, axis=1),
                         np.linalg.norm(e2, axis=1)])
    m["edge_mm"] = {"median": float(np.median(el)*1e3),
                    "p05": float(np.percentile(el, 5)*1e3),
                    "p95": float(np.percentile(el, 95)*1e3),
                    "max": float(el.max()*1e3)}
    cr = np.cross(e0, -e2)
    area = 0.5*np.linalg.norm(cr, axis=1)
    m["area_cm2"] = float(area.sum()*1e4)
    degen = int((area <= 0.0).sum())
    m["degenerate_faces"] = degen
    _gate_check(checks, "degenerate_faces", "fatal", degen == 0, degen, 0,
                "%d faces have zero area; they have no normal, so the planner "
                "invents one" % (degen,) if degen else "no zero-area faces",
                fix="clean_mesh_for_planning() drops them")

    ok_a = area > 0.0
    fn = np.zeros_like(cr)
    fn[ok_a] = cr[ok_a]/area[ok_a, None]/2.0
    fn[ok_a] /= np.linalg.norm(fn[ok_a], axis=1, keepdims=True)
    w = area[ok_a]/area[ok_a].sum() if area[ok_a].sum() > 0 else area[ok_a]

    # WHICH SURFACE the two quality checks measure -- normal_roughness and
    # tilt_loss, and only those two. Everything else in this report is about the
    # whole file on purpose; the note above _gate_surface_mask() says why, and
    # what a whole-mesh number costs when the mesh is mostly bench.
    scope = _gate_surface_mask(v, tf, roi, region)
    roi_faces = scope["mask"]
    roi_ok = None if roi_faces is None else roi_faces[ok_a]
    m["surface_scope"] = {
        "restricted": roi_faces is not None,
        "what": scope["what"],
        "verdict": scope["verdict"],
        "covered": scope["covered"],
        "z_ignored": scope.get("z_ignored"),
        "z_band": scope.get("z_band"),
        "faces": int(len(tf) if roi_faces is None else roi_faces.sum()),
        # What the ROI ITSELF selected, which is not the same number when the
        # statistics fell back to the whole mesh -- and it is the number that
        # says how little the crop matched.
        "roi_faces": int(scope.get("faces", len(tf))),
        "faces_total": int(len(tf)),
        "area_fraction": (1.0 if roi_faces is None else
                          float(area[ok_a & roi_faces].sum() /
                                max(area[ok_a].sum(), 1e-300))),
    }
    # A CROP THAT MATCHED ALMOST NOTHING IS A CHECK, NOT A PRINTED NOTE. Ending
    # both cases the same way -- fall back to the whole mesh, print a line, plan
    # anyway -- turns a 30 x 84 mm selection into an 80 x 157 mm plan including
    # the optical bench, with the explanation buried in a log. They are
    # different facts and get different levels: a mismatch is a REFUSAL, a
    # genuinely small selection is a warning.
    if scope["verdict"] == "mismatch":
        _gate_check(
            checks, "roi_mesh_agreement", "blocking", False,
            float(scope["covered"]), float(GATE_ROI_MIN_MESH_OVERLAP),
            scope["what"],
            fix="find out which of the ROI and the mesh is from a different "
                "scan -- re-draw the ROI on THIS surface (select_roi), or pass "
                "roi=False to plan the whole mesh deliberately")
    elif scope["verdict"] == "z_mismatch":
        # ITS OWN CHECK NAME, not roi_mesh_agreement with a different sentence.
        # The two failures send you to different places -- which scan the ROI is
        # from, against which sensor measured what height -- and a scan log is
        # grepped by check name.
        _gate_check(
            checks, "roi_z_band", "blocking", False,
            float(scope["z_band"]["kept_fraction"]),
            float(GATE_ROI_MIN_Z_BAND_KEEP), scope["what"],
            fix="the ROI's surface and this mesh's are at incompatible heights: "
                "check which sensor measured which (verify_calibration), or "
                "re-draw the ROI on THIS surface. GATE_ROI_Z_TOLERANCE_M widens "
                "the band and z_tolerance=0 turns it off -- but the bench is "
                "19 mm below the plate top here, so a band that reaches it plans "
                "the bench")
    elif scope["verdict"] == "few_faces":
        _gate_check(
            checks, "roi_few_faces", "warn", False,
            int(scope["faces"]), int(GATE_MIN_ROI_FACES), scope["what"],
            fix="draw a larger region, or accept whole-mesh statistics")

    # --- topology: the two defects that make the planner REFUSE --------------
    ed = np.sort(np.vstack([tf[:, [0, 1]], tf[:, [1, 2]], tf[:, [2, 0]]]), axis=1)
    key = ed[:, 0]*len(v) + ed[:, 1]
    uk, inv, cnt = np.unique(key, return_inverse=True, return_counts=True)
    nm_edges = int((cnt >= 3).sum())
    nm_faces = int((cnt[inv].reshape(3, -1) >= 3).any(axis=0).sum())
    m["nonmanifold_edges"] = nm_edges
    m["faces_on_nonmanifold_edges"] = nm_faces
    _gate_check(
        checks, "manifold", "fatal", nm_edges == 0, nm_edges, 0,
        "%d edges are shared by three or more triangles (%d faces, %.3f%% of "
        "the mesh). The plane slicer refuses such a mesh with 'Too many "
        "connecting vertices found between adjacent segments' -- and it does it "
        "at SOME line spacings and not others: a measured plate reconstruction "
        "has exactly 2 of these and plans at 20, 10, 5, 3, 2, 1, 0.8, 0.6 and "
        "0.4 mm while refusing at 1.5, 0.5 and 0.3 mm. Trying a coarser spacing "
        "is not a diagnosis."
        % (nm_edges, nm_faces, 100.0*nm_faces/len(tf))
        if nm_edges else "every edge is shared by at most two triangles",
        fix="clean_mesh_for_planning() drops the faces on them")

    # Count components the way clean_mesh_for_planning() will see them: after
    # the non-manifold faces are gone, because dropping those is what splits a
    # crumb off the part in the first place.
    nm_face_mask = (cnt[inv].reshape(3, -1) >= 3).any(axis=0)
    comps = _gate_components(v, tf[~nm_face_mask] if nm_edges else tf)
    m["components"] = comps[:12]
    m["component_count"] = len(comps)
    crumbs = [c for c in comps[1:] if c < 0.01*len(tf)]
    _gate_check(
        checks, "components", "fatal", not crumbs, len(crumbs), 0,
        "%d components under 1%% of the faces (%s) sit alongside the part. The "
        "slicer stops on them with 'Connecting vertex does not exist at the "
        "start or end of a segment'."
        % (len(crumbs), ", ".join(str(c) for c in crumbs[:6]))
        if crumbs else "%d component(s), none of them a crumb" % (len(comps),),
        fix="clean_mesh_for_planning() drops components under 1%")

    # --- is it in the cell at all? -------------------------------------------
    if work_volume is not None:
        wlo, whi = [np.asarray(a, dtype=np.float64).reshape(3) for a in work_volume]
        inside = np.all((v[finite] >= wlo) & (v[finite] <= whi), axis=1)
        frac = float(inside.mean())
        m["in_work_volume"] = frac
        _gate_check(
            checks, "in_work_volume", "fatal", frac >= 0.5, frac, 0.5,
            "only %.0f%% of the mesh is inside the cell's measured work volume "
            "(mesh x %.3f..%.3f y %.3f..%.3f z %.3f..%.3f against x %.3f..%.3f "
            "y %.3f..%.3f z %.3f..%.3f). A mesh authored about its own origin, "
            "or reconstructed while tracking the wrong frame, looks exactly "
            "like this." % (frac*100.0, lo[0], hi[0], lo[1], hi[1], lo[2], hi[2],
                            wlo[0], whi[0], wlo[1], whi[1], wlo[2], whi[2])
            if frac < 0.5 else "%.0f%% of the mesh is inside the work volume"
            % (frac*100.0,),
            fix="place the mesh (NOETHER_MESH_OFFSET) or fix the tracking frame")

    # --- density: how finely the planner can sample a pass -------------------
    med_edge = float(np.median(el))
    _gate_check(
        checks, "density", "warn", med_edge <= GATE_MAX_MEDIAN_EDGE_M,
        med_edge, GATE_MAX_MEDIAN_EDGE_M,
        "the median edge is %.2f mm. That is the sampling interval along a pass "
        "AND the scale of the normal noise, because Noether puts a waypoint "
        "where a slicing plane crosses a mesh edge and takes the tool axis from "
        "the surface there. It is a warning and not a refusal on purpose: the "
        "planner accepted every 6.00 mm marching-cubes mesh in this tree. What "
        "it costs is pose quality -- measured on decimated copies of the real "
        "mesh, waypoints past the 45 deg cap went 7.0%% at 0.98 mm, 10.6%% at "
        "1.38 mm, 13.6%% at 1.95 mm, and poses facing the wrong way 16%% -> "
        "20%% -> 23%%."
        % (med_edge*1e3,) if med_edge > GATE_MAX_MEDIAN_EDGE_M
        else "median edge %.2f mm" % (med_edge*1e3,),
        fix="reconstruct at a finer resolution, or decimate less")

    # How many passes, and how long each one is. Both follow from WHICH WAY THEY
    # RUN, which is noether_cut_axes()' business and not a guess from the
    # bounding box: the planes step along `step_extent_m` and each pass runs the
    # length of `pass_extent_m`. A min/max of the x-y bounding box is right only
    # for rotation_offset = pi/2, and is easy to label the other way round.
    try:
        cutax = noether_cut_axes(v[finite], rotation_offset, line_spacing)
    except ValueError:
        cutax = None
    if cutax is not None:
        est_passes = max(1, int(cutax["planes"] or 1))
        pass_len = cutax["pass_extent_m"]
        m["pass_axis"] = int(cutax["pass_axis"])
        m["pass_extent_mm"] = float(cutax["pass_extent_m"]*1e3)
        m["plane_step_extent_mm"] = float(cutax["step_extent_m"]*1e3)
        m["principal_extent_mm"] = (np.asarray(cutax["extent_m"])*1e3).tolist()
        m["pass_direction"] = np.asarray(cutax["pass_direction"]).tolist()
        m["squareness"] = float(cutax["squareness"])
    else:
        span = hi[:2] - lo[:2]
        est_passes = max(1, int(round(min(span)/line_spacing)))
        pass_len = float(max(span))
    wp_per_pass = pass_len/max(med_edge, 1e-9)
    m["estimated_passes"] = est_passes
    m["estimated_waypoints_per_pass"] = float(wp_per_pass)
    m["estimated_raw_poses"] = int(est_passes*wp_per_pass)
    _gate_check(
        checks, "waypoints_per_pass", "blocking",
        wp_per_pass >= GATE_MIN_WAYPOINTS_PER_PASS,
        float(wp_per_pass), float(GATE_MIN_WAYPOINTS_PER_PASS),
        "a pass across %.0f mm of this mesh gets about %.1f waypoints at a "
        "%.2f mm median edge" % (pass_len*1e3, wp_per_pass, med_edge*1e3),
        fix="reconstruct at a finer resolution")

    # --- the tool axis the surface will demand -------------------------------
    # Sign-free: orient_tool_away_from_surface() will flip whatever points into
    # the part, so what costs coverage is how far the normal LEANS, not which
    # way it faces.
    tilt_all = np.degrees(np.arccos(np.clip(np.abs(fn[ok_a].dot(
        np.asarray(up, dtype=np.float64)/np.linalg.norm(up))), -1.0, 1.0)))
    over_all = float(w[tilt_all > max_tilt_deg].sum())
    m["tilt_deg_whole_mesh"] = {"p50": _gate_weighted_pct(tilt_all, w, 0.5),
                                "p95": _gate_weighted_pct(tilt_all, w, 0.95),
                                "max": float(tilt_all.max())}
    m["tilt_area_fraction_over_cap_whole_mesh"] = over_all
    if roi_ok is None or not roi_ok.any():
        tilt, tw, over = tilt_all, w, over_all
    else:
        tilt, tw = tilt_all[roi_ok], area[ok_a][roi_ok]
        over = float(tw[tilt > max_tilt_deg].sum()/max(tw.sum(), 1e-300))
    m["tilt_deg"] = {"p50": _gate_weighted_pct(tilt, tw, 0.5),
                     "p95": _gate_weighted_pct(tilt, tw, 0.95),
                     "max": float(tilt.max())}
    m["tilt_area_fraction_over_cap"] = over
    _gate_check(
        checks, "tilt_loss",
        "blocking" if over > GATE_REFUSE_TILT_AREA_FRACTION else "warn",
        over <= GATE_MAX_TILT_AREA_FRACTION,
        over, GATE_MAX_TILT_AREA_FRACTION,
        "%.1f%% of %s leans more than %.0f deg from %s and will be "
        "CROPPED OUT of the toolpath, fragmenting every pass that crosses it. "
        "On a measured Keyence mesh 6.2%% of area past 45 deg cost 7.0%% of the "
        "waypoints and turned 354 passes into 454 -- that surface is the "
        "Poisson skirt wrapped round the plate's 12 mm edge. The Azure "
        "reconstructions in this tree run 8%% to 45%%, and the planner accepts "
        "all of them: this is lost coverage, not a refusal, until %.0f%%.%s"
        % (over*100.0, "the measured surface" if roi_faces is not None
           else "the surface", max_tilt_deg, tuple(up),
           GATE_REFUSE_TILT_AREA_FRACTION*100.0,
           "" if roi_faces is None else
           " (over the whole mesh it is %.1f%%)" % (over_all*100.0,)),
        fix="crop the reconstruction to the part's top face, or raise the cap")

    # --- normals: sign, and how far they turn between neighbours -------------
    down = float(w[fn[ok_a][:, 2] < 0.0].sum())
    m["face_normal_down_fraction"] = down
    e_ok = cnt[inv].reshape(3, -1)
    fidx = np.tile(np.arange(len(tf)), 3)
    order = np.argsort(inv)
    inv_s, fidx_s = inv[order], fidx[order]
    pair = np.flatnonzero(np.diff(inv_s) == 0)
    turn = np.array([])
    if len(pair):
        a = fidx_s[pair]
        b = fidx_s[pair + 1]
        keep = ok_a[a] & ok_a[b]
        a, b = a[keep], b[keep]
        d = np.clip(np.abs(np.einsum("ij,ij->i", fn[a], fn[b])), -1.0, 1.0)
        turn = np.degrees(np.arccos(d))

    def _turn_stats(t):
        if not len(t):
            return None, 0.0, 0.0
        return ({"p50": float(np.median(t)),
                 "p95": float(np.percentile(t, 95)),
                 "p99": float(np.percentile(t, 99)),
                 "max": float(t.max()), "pairs": int(len(t))},
                float(np.percentile(t, 99)), float(t.max()))

    whole_stats, whole_p99, whole_max = _turn_stats(turn)
    m["normal_turn_deg_whole_mesh"] = whole_stats
    # A pair counts only when BOTH its faces are in the ROI, so the ROI's own
    # rim -- where the plate meets the bench -- is not measured as part surface.
    if roi_faces is not None and len(turn):
        sel = roi_faces[a] & roi_faces[b]
        turn_sel = turn[sel]
    else:
        turn_sel = turn
    stats, p99, worst = _turn_stats(turn_sel)
    if stats is None:
        stats, p99, worst = whole_stats, whole_p99, whole_max
    m["normal_turn_deg"] = stats
    _gate_check(
        checks, "normal_roughness", "warn", p99 <= GATE_MAX_NORMAL_TURN_DEG,
        p99, GATE_MAX_NORMAL_TURN_DEG,
        "neighbouring faces of %s turn %.1f deg at the 99th percentile (worst "
        "%.1f). That turn becomes an orientation step between consecutive "
        "waypoints, and the arm stops and rotates for it: a measured mesh's "
        "26.6 deg p99 produced a 93 deg worst step, which EC_AXIS_SMOOTHING_M "
        "then averaged down to 10.%s"
        % ("the measured surface" if roi_faces is not None else "this mesh",
           p99, worst,
           (" Over the whole mesh it is %.1f deg, which is the fixturing: a "
            "whole-mesh p99 separates a bad scan from a good one by about 6%%, "
            "and the plate alone by 2.3x."
            % (whole_p99,)) if roi_faces is not None else
           " THIS IS THE WHOLE MESH, bench and clamps included. Two scans of "
           "one plate whose surfaces differ by 2.3x (10.5 against 4.5 deg over "
           "the plate alone) read 55.5 and 52.6 deg this way: a whole-mesh "
           "number grades the fixturing, not the part. Pass roi= to measure the "
           "part -- the drawn selection (plan_ec_path(roi=last_roi)), an x-y "
           "box, or a vertex mask."),
        fix="smooth the reconstruction, or raise EC_AXIS_SMOOTHING_M")
    if estimate_normals:
        _gate_check(
            checks, "normal_source", "warn", not m["has_vertex_normals"],
            "planner estimates", "mesh's own",
            "this mesh HAS vertex normals and the plan will throw them away "
            "(estimate_normals=True -> depth_reconstruction). Measured on one "
            "reconstruction, same 74100 poses: the planner's estimate put 16.0% of "
            "them pointing into the part and left a 52.4 deg tilt p95, against "
            "0% and 20.9 deg from the mesh's own Poisson normals -- which "
            "halved the tilt crop (7.0% -> 3.4% of waypoints) and raised the "
            "scanned travel from 30.26 to 31.34 m. THIS COSTS THE ORIENTATION "
            "NOTHING on a path planned with orient='normal', which is the "
            "eddy-current default: the tool axis there is sampled from this mesh's "
            "own repaired normals and the planner's pose orientations are never "
            "read. What it still costs is whatever the slicer does with its own "
            "normals, so it is still worth setting."
            if m["has_vertex_normals"] else
            "the mesh has no vertex normals, so the planner must estimate them",
            fix="plan_mesh_path(estimate_normals=False)")
    else:
        _gate_check(
            checks, "normal_source", "fatal", bool(m["has_vertex_normals"]),
            "mesh's own", "mesh's own",
            "estimate_normals=False and this mesh has no vertex normals. "
            "PlaneSlicerRasterPlanner refuses one outright ('does not have "
            "vertex normals') and says so only in the service log."
            if not m["has_vertex_normals"] else
            "planning from the mesh's own vertex normals",
            fix="estimate_normals=True, or write normals into the mesh")

    # --- holes: never a refusal, always fragmentation ------------------------
    loops = _gate_boundary_loops(v, tf, len(v))
    holes = loops[1:] if len(loops) > 1 else []
    m["boundary_loops"] = len(loops)
    m["holes"] = [{"vertices": c, "radius_mm": r*1e3} for c, r in holes[:10]]
    extra = sum(2.0*r for _c, r in holes)/max(line_spacing, 1e-9)
    frag = extra/max(est_passes, 1)
    m["hole_extra_passes"] = float(extra)
    m["hole_fragmentation"] = float(frag)
    _gate_check(
        checks, "holes", "warn", frag <= GATE_MAX_PASS_FRAGMENTATION,
        float(frag), float(GATE_MAX_PASS_FRAGMENTATION),
        "%d hole(s), the largest %.1f mm across, will split about %.0f extra "
        "passes out of %d at a %.2f mm line spacing (+%.0f%%). Holes never "
        "make the planner refuse -- they fragment: eight 2 mm holes in a "
        "measured mesh took 354 passes to 444 for 1.1%% of the travel, and each short "
        "fragment is an approach, a lead-in and a lift."
        % (len(holes), 2e3*max((r for _c, r in holes), default=0.0), extra,
           est_passes, line_spacing*1e3, 100.0*frag)
        if holes else "no holes (one boundary loop, the outer rim)",
        fix="fill the holes in the reconstruction, or accept the fragmentation")

    # --- does it cover what was asked for? -----------------------------------
    if region is not None:
        xmin, ymin, xmax, ymax = [float(a) for a in region]
        cell = max(line_spacing, 0.002)
        def _cells(A, x0, y0, x1, y1):
            sel = ((A[:, 0] >= x0) & (A[:, 0] <= x1) &
                   (A[:, 1] >= y0) & (A[:, 1] <= y1))
            return set(map(tuple, np.floor(A[sel, :2]/cell).astype(np.int64).tolist()))
        want = set()
        nx = int(np.ceil((xmax - xmin)/cell)) + 1
        ny = int(np.ceil((ymax - ymin)/cell)) + 1
        for i in range(nx):
            for j in range(ny):
                want.add((int(np.floor((xmin + i*cell)/cell)),
                          int(np.floor((ymin + j*cell)/cell))))
        got = _cells(v[finite], xmin, ymin, xmax, ymax)
        cov = len(want & got)/max(len(want), 1)
        m["region_coverage"] = float(cov)
        outside = float((~((v[finite][:, 0] >= xmin) & (v[finite][:, 0] <= xmax) &
                           (v[finite][:, 1] >= ymin) & (v[finite][:, 1] <= ymax))).mean())
        m["mesh_outside_region"] = outside
        # TWO SEPARATE FACTS, AND THEY MUST NOT SHARE A CHECK OR A MESSAGE:
        #
        #   COVERAGE SHORT  the mesh does not reach part of the region. A
        #                   toolpath can only be planned where there is surface,
        #                   so the region asked for will not be fully scanned.
        #   OVERSHOOT       the mesh is WIDER than the region. Always true of a
        #                   measured mesh: the Keyence line is about 31 mm wide
        #                   and every raster pass overshoots the region's edge,
        #                   so an 18 x 60 mm ROI routinely measures
        #                   54.7 x 122.2 mm -- 82% of it outside. That material
        #                   is CROPPED (crop_mesh_to_roi, and the toolpath crop
        #                   to `region` after planning); it is not a reason to
        #                   refuse a plan.
        #
        # SHORT COVERAGE IS A WARNING, NOT A BLOCK. It is the number to use when
        # deciding to refine the parameters or the process, and not a reason to
        # stop an eddy-current scan.
        #
        # Blocking on it refuses good scans. A 200 x 200 mm plate measures
        # 187.3 x 199.1 mm -- 93% of the PART -- and reads 86% here, and the
        # shortfall is not a fault to fix: the Keyence sits 73 mm to the side of
        # probe_end, so at a part's edge one of the two is always off it and
        # those waypoints are dropped by the clearance and window gates. The band
        # lost is fixed in MILLIMETRES, so the smaller the part the larger the
        # fraction -- about 6% of a 300 mm part against 14% of a 200 mm one.
        #
        # What the check does is say the number, loudly, so a short scan is a
        # decision and not a surprise.
        _gate_check(
            checks, "region_coverage", "warn", cov >= GATE_MIN_REGION_COVERAGE,
            float(cov), float(GATE_MIN_REGION_COVERAGE),
            "the mesh covers only %.0f%% of the requested region at a %.1f mm "
            "cell (x %.3f..%.3f y %.3f..%.3f). A pass can only be planned where "
            "there is surface, so the part of the region that was not measured "
            "will not be scanned. This does NOT stop the plan; it is the number "
            "to look at when deciding whether to sweep again or adjust the "
            "region."
            % (cov*100.0, cell*1e3, xmin, xmax, ymin, ymax),
            fix="extend the sweep, or shrink the region to what was measured")
        _gate_check(
            checks, "region_overshoot", "warn",
            outside <= GATE_MAX_MESH_OUTSIDE_REGION,
            float(outside), float(GATE_MAX_MESH_OUTSIDE_REGION),
            "%.0f%% of the mesh lies outside the requested region -- almost all "
            "of it. Overshoot is normal and is cropped, not refused (a %.0f x "
            "%.0f mm region routinely measures wider: the Keyence line is about "
            "31 mm and every pass overruns the edge), but at this fraction the "
            "mesh is essentially somewhere else, which is what a wrong region or "
            "a mesh reconstructed in the wrong frame looks like."
            % (outside*100.0, (xmax - xmin)*1e3, (ymax - ymin)*1e3),
            fix="check the region against the mesh's own extent; the crop "
                "itself is automatic (crop_mesh_to_roi)")

    # --- tilts nobody has measured the cables at -----------------------------
    if envelope is not None:
        try:
            txr, tyr = envelope.tx_range, envelope.ty_range
            # Tool z on the (sign-corrected) surface normal: tilt about x is the
            # lean in y and vice versa, which is exactly what tilt_of() reads.
            z = fn[ok_a].copy()
            z[z[:, 2] < 0.0] *= -1.0
            tx = np.degrees(np.arctan2(-z[:, 1], z[:, 2]))
            ty = np.degrees(np.arctan2(z[:, 0], z[:, 2]))
            bad = ((tx < min(txr)) | (tx > max(txr)) |
                   (ty < min(tyr)) | (ty > max(tyr)))
            frac = float(w[bad].sum())
            m["outside_cable_tilt_hull"] = frac
            m["cable_tilt_hull"] = {"tx_deg": list(txr), "ty_deg": list(tyr)}
            _gate_check(
                checks, "cable_tilt", "warn", frac <= 0.01, frac, 0.01,
                "%.1f%% of the surface demands a tool tilt outside the measured "
                "cable envelope (tx %s, ty %s deg). The envelope is not "
                "extrapolated: check_wrist3() raises CableRefused there. "
                "On a measured path this was 5.87%% of the flying waypoints "
                "with the planner's normals and 1.01%% with the mesh's own."
                % (frac*100.0, tuple(txr), tuple(tyr)),
                fix="cap the tilt (EC_MAX_TILT_DEG) below the envelope, or "
                    "sweep the cable envelope at those tilts")
        except Exception as exc:
            m["cable_tilt_error"] = str(exc)

    return _gate_finish(rep)


global _gate_finish
def _gate_finish(rep):
    """Sort the checks into the three buckets and decide the verdict."""
    for c in rep["checks"]:
        if c["ok"]:
            continue
        if c["level"] == "fatal":
            rep["fatal"].append(c["name"])
        elif c["level"] == "blocking":
            rep["blocking"].append(c["name"])
        else:
            rep["warn"].append(c["name"])
    # "repair" means clean_mesh_for_planning() would leave a mesh that plans.
    # It only can when every fatal is one of the four defects it removes AND
    # nothing else is blocking: dropping faces does not make a flank face
    # upward or a mesh cover more of the region, so a repair on top of a
    # blocking check is a wasted copy and a misleading verdict.
    repairable = {"finite", "manifold", "components", "degenerate_faces"}
    rep["repairable"] = (bool(rep["fatal"]) and set(rep["fatal"]) <= repairable
                         and not rep["blocking"])
    if rep["fatal"]:
        rep["verdict"] = "repair" if rep["repairable"] else "refuse"
    elif rep["blocking"]:
        rep["verdict"] = "refuse"
    else:
        rep["verdict"] = "plan"
    rep["ok"] = rep["verdict"] == "plan"
    bad = rep["fatal"] + rep["blocking"]
    rep["summary"] = (
        "plan: nothing blocks it%s" % (" (%d warning(s): %s)"
                                       % (len(rep["warn"]), ", ".join(rep["warn"]))
                                       if rep["warn"] else "")
        if rep["verdict"] == "plan" else
        "repair first: %s -- clean_mesh_for_planning() fixes all of these"
        % (", ".join(bad),) if rep["verdict"] == "repair" else
        "refuse: %s" % (", ".join(bad),))
    global last_mesh_plan_report
    last_mesh_plan_report = rep
    return rep


def mesh_plannable(mesh, **kwargs):
    """(ok, one-line reason). The cheap form of the gate."""
    rep = mesh_plan_report(mesh, **kwargs)
    return rep["ok"], rep["summary"]


def require_plannable_mesh(mesh, repair_to=None, verbose=True, crop_to_roi=None,
                           z_tolerance=None, **kwargs):
    """Refuse an unplannable mesh BEFORE the planner is asked, with a reason.

    Returns the mesh to plan on -- which is a copy CROPPED TO THE ROI when one
    was given, and `repair_to` when the mesh also needed cleaning, so the caller
    can simply do

        mesh = require_plannable_mesh(mesh, repair_to=cleaned, roi=roi)

    and get either the original, a cropped and/or repaired copy, or a
    MeshNotPlannable naming every check that failed and what would fix it.

    THE CROP IS FIRST, and it is this function's job because this is the one
    place in the chain that both receives the operator's ROI and returns the file
    the planner will read. Everything downstream -- Noether's principal axes, the
    topology checks, the hole count, the surface statistics -- then describes the
    part instead of the bench it is bolted to. crop_to_roi=False skips it;
    GATE_CROP_TO_ROI is the config-level switch. A RoiDoesNotFitMesh comes
    straight out rather than being turned into a fallback: see crop_mesh_to_roi().

    z_tolerance overrides the crop's height band for one call (0 turns it off).
    It does NOT change what the surface STATISTICS are measured over -- that reads
    GATE_ROI_Z_TOLERANCE_M, which is the config-level switch for both -- so a
    report whose crop was widened by hand still grades the band the config asked
    for, and says so.
    """
    if crop_to_roi is None:
        crop_to_roi = GATE_CROP_TO_ROI
    if crop_to_roi:
        mesh = crop_mesh_to_roi(mesh, roi=kwargs.get("roi"),
                                region=kwargs.get("region"), verbose=verbose,
                                z_tolerance=z_tolerance)
    else:
        # Never leave an earlier call's crop report standing: it is what
        # describe_mesh_plan_report() reads, and a stale one would claim a crop
        # that did not happen on this plan.
        globals()["last_roi_crop_report"] = {"mesh": mesh, "cropped": False,
                                             "why": "crop_to_roi=False"}
    # The gate reads the whole mesh and measures it -- boundary loops, connected
    # components, per-face normals and areas. Milliseconds on the plate, but it
    # scales with the mesh and it runs on the biggest one the cell produces, so
    # it gets a line saying what it decided and how long it took.
    with progress_step("gating %s for planning"
                       % (os.path.basename(str(mesh)),)) as gate:
        rep = mesh_plan_report(mesh, **kwargs)
        gate.result("verdict: %s" % (rep["verdict"],))
    if verbose:
        describe_mesh_plan_report(rep)
    if rep["verdict"] == "plan":
        return mesh
    if rep["verdict"] == "repair" and repair_to and isinstance(mesh, str):
        # clean_mesh_for_planning() reports what it dropped itself, on the
        # progress path, so there is no second copy of those numbers here.
        cr = clean_mesh_for_planning(mesh, repair_to)
        with progress_step("re-gating the repaired mesh") as gate:
            rep2 = mesh_plan_report(repair_to, **kwargs)
            gate.result("%d of %d faces kept; verdict: %s"
                        % (cr["faces_out"], cr["faces_in"], rep2["verdict"]))
        if verbose:
            describe_mesh_plan_report(rep2)
        if rep2["verdict"] == "plan":
            return repair_to
        rep = rep2
    raise MeshNotPlannable(
        "%s will not give Noether a usable path: %s\n%s"
        % (os.path.basename(str(mesh)), rep["summary"],
           "\n".join("    %-20s %s" % (c["name"], c["why"])
                     for c in rep["checks"] if not c["ok"])), rep)


def describe_mesh_plan_report(rep=None):
    """Print a report the way a scan log should carry it."""
    rep = last_mesh_plan_report if rep is None else rep
    if rep is None:
        print("no mesh has been gated yet")
        return
    m = rep["measured"]
    print("mesh gate: %s" % (os.path.basename(str(rep["mesh"])),))
    if "faces" in m:
        print("  %d vertices, %d faces, %s vertex normals; %s mm extent, "
              "%.1f cm2 of surface"
              % (m["vertices"], m["faces"],
                 "with" if m.get("has_vertex_normals") else "NO",
                 " x ".join("%.1f" % a for a in m.get("extent_mm", [])),
                 m.get("area_cm2", float("nan"))))
    if m.get("edge_mm"):
        print("  median edge %.2f mm (p95 %.2f); about %d passes of %.0f "
              "waypoints at a %.2f mm line spacing"
              % (m["edge_mm"]["median"], m["edge_mm"]["p95"],
                 m.get("estimated_passes", 0),
                 m.get("estimated_waypoints_per_pass", 0.0),
                 rep["line_spacing_m"]*1e3))
    if "pass_axis" in m:
        # Say which way they run every time. It is the thing this report is
        # least able to leave implicit: it decides the pass count, the pass
        # length and every estimate built on them, and it is easy to state
        # backwards from memory.
        print("  rotation offset %.3f rad: passes run along the %s principal "
              "axis (%.0f mm), planes step every %.2f mm across %.0f mm%s"
              % (rep.get("rotation_offset", 0.0),
                 "LONGEST" if m["pass_axis"] == 0 else "SECOND-longest",
                 m["pass_extent_mm"], rep["line_spacing_m"]*1e3,
                 m["plane_step_extent_mm"],
                 "" if m.get("squareness", 1.0) >= 0.05 else
                 " -- but this mesh is within %.1f%% of square in plan, so "
                 "which axis is 'longest' is arbitrary and so is the raster "
                 "direction" % (m["squareness"]*100.0,)))
    if m.get("surface_scope"):
        s = m["surface_scope"]
        print("  surface measured for roughness and tilt: %s%s"
              % (s["what"],
                 "" if not s["restricted"] else
                 " (%.0f%% of the mesh's area)" % (s["area_fraction"]*100.0,)))
        # WHETHER z WAS IN THE DECISION, said out loud EVERY time -- both halves.
        # The per-cell band, which IS applied, and the ROI's global z box, which
        # is not. The box is the quantity that can empty the crop outright and
        # the band is what stands in for it, so a report that mentions neither
        # hides both.
        if s["restricted"] or s.get("z_band") or s.get("z_ignored"):
            zb = s.get("z_band")
            if zb is None:
                print("    z: NOT applied -- this ROI carries no height map, so "
                      "the crop is its x-y shadow")
            else:
                _off, _over = _gate_band_offset(zb)
                print("    z: within +/-%.1f mm of the selected surface "
                      "(z %.4f..%.4f, %.1f mm of relief); it excluded %d of the "
                      "%d faces the x-y footprint matched, and the two surfaces "
                      "differ by %.1f mm %s%s"
                      % (zb["tolerance"]*1e3, zb["surface_z"][0],
                         zb["surface_z"][1],
                         (zb["surface_z"][1] - zb["surface_z"][0])*1e3,
                         zb["dropped"], zb["xy_faces"], _off, _over,
                         "" if not zb["no_height"] else
                         "; %d faces had no cell height and were judged on x-y "
                         "alone" % (zb["no_height"],)))
                print("       the height map came from %s"
                      % (zb.get("source", "unrecorded"),))
        if s.get("z_ignored"):
            bb = m.get("bbox") or [[0.0, 0.0, float("nan")]]*2
            print("    the ROI's GLOBAL z box %.4f..%.4f is provenance, not a "
                  "crop; this mesh is at z %.4f..%.4f"
                  % (s["z_ignored"][0], s["z_ignored"][1], bb[0][2], bb[1][2]))
    if "region_coverage" in m:
        # Coverage and overshoot on one line, never as one number: short coverage
        # refuses and overshoot is cropped.
        print("  region: %.0f%% of it is covered by the mesh; %.0f%% of the mesh "
              "is outside it and gets cropped (overshoot is normal)"
              % (m["region_coverage"]*100.0, m.get("mesh_outside_region", 0.0)*100.0))
    cr = last_roi_crop_report
    # Only when the crop produced THIS report's mesh. A report printed for some
    # other mesh must not inherit a crop line from the last plan.
    if (cr and cr.get("cropped")
            and str(cr.get("mesh")) == str(rep.get("mesh"))):
        czb = cr.get("z_band")
        print("  planning mesh cropped to the ROI: %d of %d faces (%s); %s"
              % (cr["faces_out"], cr["faces_in"],
                 os.path.basename(str(cr["mesh"])),
                 "x-y only, no height map on this ROI" if czb is None else
                 "the +/-%.1f mm height band excluded %d of them"
                 % (czb["tolerance"]*1e3, czb["dropped"])))
    for c in rep["checks"]:
        if c["ok"]:
            continue
        print("  %-8s %-18s %s" % (c["level"].upper() + ":", c["name"], c["why"]))
        if c.get("fix"):
            print("           %-18s fix: %s" % ("", c["fix"]))
    print("  VERDICT: %s" % (rep["summary"],))


def mesh_plan_requirements(line_spacing=None, max_tilt_deg=None, region=None):
    """What a reconstruction has to hit, as numbers, BEFORE it is attempted.

    The gate above grades a mesh that exists. This is the same thresholds
    turned round, so a sweep can be configured to meet them -- voxel size,
    coverage, how far past the region to reach -- rather than being run and
    then failed.
    """
    line_spacing = 0.001 if line_spacing is None else float(line_spacing)
    max_tilt_deg = 45.0 if max_tilt_deg is None else float(max_tilt_deg)
    req = {
        "median_edge_m": GATE_MAX_MEDIAN_EDGE_M,
        "voxel_m": GATE_MAX_MEDIAN_EDGE_M/2.0,
        "nonfinite_vertices": 0,
        "nonmanifold_edges": 0,
        "degenerate_faces": 0,
        "components": 1,
        "tilt_area_fraction_over_cap": GATE_MAX_TILT_AREA_FRACTION,
        "tilt_area_fraction_refused": GATE_REFUSE_TILT_AREA_FRACTION,
        "max_tilt_deg": max_tilt_deg,
        "min_waypoints_per_pass": GATE_MIN_WAYPOINTS_PER_PASS,
        "normal_turn_p99_deg": GATE_MAX_NORMAL_TURN_DEG,
        "region_coverage": GATE_MIN_REGION_COVERAGE,
        "hole_fragmentation": GATE_MAX_PASS_FRAGMENTATION,
        "max_hole_radius_m": (GATE_MAX_PASS_FRAGMENTATION*line_spacing *
                              max(1, int(round(
                                  (abs(float(region[2]) - float(region[0]))
                                   if region else 0.1)/line_spacing))))/2.0,
        "line_spacing_m": line_spacing,
    }
    return req


def describe_mesh_plan_requirements(line_spacing=None, max_tilt_deg=None,
                                    region=None):
    """The requirements as text, for a bring-up banner or a sweep's log."""
    r = mesh_plan_requirements(line_spacing, max_tilt_deg, region)
    return "\n".join([
        "what Noether needs from a mesh (line spacing %.2f mm, tilt cap %.0f deg):"
        % (r["line_spacing_m"]*1e3, r["max_tilt_deg"]),
        "  resolution   median edge <= %.1f mm  (TSDF voxel <= %.1f mm). Not a "
        "refusal -- the planner accepts a 6 mm marching-cubes mesh -- but at "
        "2 mm 14%% of the waypoints are already cropped for tilt and 23%% face "
        "the wrong way." % (r["median_edge_m"]*1e3, r["voxel_m"]*1e3),
        "  topology     0 non-finite vertices (they abort the planner process), "
        "0 non-manifold edges, 0 zero-area faces, 1 component",
        "  shape        <= %.0f%% of the surface area past the %.0f deg tilt cap "
        "(refused past %.0f%%); crop the reconstruction to the face being "
        "scanned rather than letting Poisson wrap the part's edge"
        % (r["tilt_area_fraction_over_cap"]*100.0, r["max_tilt_deg"],
           r["tilt_area_fraction_refused"]*100.0),
        "  normals      write them; the planner's own estimate put 16% of the "
        "poses into the part on the real mesh, the mesh's own put 0%",
        "  smoothness   neighbouring faces turn <= %.0f deg at p99"
        % (r["normal_turn_p99_deg"],),
        "  extent       >= %.0f%% of the requested region covered, holes small "
        "enough to cost under %.0f%% extra passes"
        % (r["region_coverage"]*100.0, r["hole_fragmentation"]*100.0),
    ])
