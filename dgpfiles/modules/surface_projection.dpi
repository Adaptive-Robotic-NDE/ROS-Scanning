# Projecting scan data onto a parameterized surface.
#
# The rectangular c-scan is an array indexed by grid position. That only exists
# for a rectangular grid, and it is fragile even there: a trace out of place
# shifts everything after it. Projection replaces the index with geometry --
# spatialnde2 ray-traces from the probe pose onto a parameterized surface and
# splats the value where it lands. It consumes (pose, value) pairs one at a time
# and has no concept of a path, a line or a grid, so a serpentine over a mesh,
# disconnected regions and ragged edges are all the same to it. A stray trace
# lands where the probe actually was, or misses the surface and contributes
# nothing. It cannot displace its neighbours.
#
# The catch is that projection needs a parameterized surface, and building and
# registering a mesh is exactly the cost the plane scan exists to avoid. So for
# a plane we *synthesise* one: the scan defines a rectangle in space, and a
# rectangle is exactly represented by two triangles with a trivial UV map. No
# reconstruction, no registration -- the geometry is whatever the scan said it
# was, which is correct by construction. Everything downstream is then shared
# with the real-mesh case.

import hashlib
import os
import re
import sys
import numpy as np
import spatialnde2 as snde

# A .dpi is compiled as a function body, so anything the including config
# needs to see has to be declared global before it is assigned.
global ORIENT_DTYPE
global SurfaceProjector
global loadable_projection_surface
global describe_projection_status
global PROJECTION_FOOTPRINT_SLACK_M
global PROJECTION_RAY_WINDOW_M
global PROJECTION_RAY_WINDOW_NEAR_M
global projection_surface_geometry
global projection_surface_fingerprint
global projection_surface_matches
global projection_surface_reusable
global toolpath_world_bbox
global bbox_gap
global describe_bbox
global check_projection_covers_path


ORIENT_DTYPE = [('quat', '<f4', (4,)), ('offset', '<f4', (4,))]

#: How far the toolpath's footprint may sit OUTSIDE the surface's, laterally,
#: before the pre-flight guard refuses the scan. Metres.
#:
#: This is a disjointness slack and not a coverage requirement: the guard only
#: fires when the two footprints do not overlap AT ALL, which means no pose on
#: the path is over the surface. A path planned on a surface cannot do that --
#: every waypoint's target is a point of the surface, and the pose is at most
#: standoff*sin(tilt) away from it laterally (29 mm at the 50 mm UT standoff and
#: the 35 degree tilt cap), so the two boxes still overlap however tilted the
#: tool is. 10 mm is therefore slack against a surface whose own footprint is
#: narrower than that, not against a legitimately offset path.
#:
#: ALONG the tool axis there is no constant: a scan may legitimately stand off,
#: and how far is the projector's own business -- its min_dist..max_dist ray
#: window. So the vertical allowance is taken from the projector rather than
#: written down here. See check_projection_covers_path().
PROJECTION_FOOTPRINT_SLACK_M = 0.010

#: How far along the tool axis the projector looks for the surface, metres:
#: project_point_onto_parameterization is given min_dist..max_dist and ignores
#: anything outside. These are SurfaceProjector's defaults -- named so the
#: pre-flight guard can use the same window when it is asked about an .x3d file
#: at planning time, with no projector to read them off.
PROJECTION_RAY_WINDOW_M = 0.25
PROJECTION_RAY_WINDOW_NEAR_M = 0.05


global write_plane_x3d
def write_plane_x3d(path, origin, u_vec, v_vec):
    """Write a UV-parameterized rectangular patch as X3D.

    origin/u_vec/v_vec are world-frame numpy 3-vectors: the patch spans
    origin -> origin+u_vec -> origin+u_vec+v_vec -> origin+v_vec. UV runs 0..1
    along u and v respectively, so parameterization space is the scan's own
    (u, v) coordinates -- which makes the projected image directly comparable
    to the rectangular c-scan.

    Two triangles, because a plane needs no more: projection resolution comes
    from the parameterization pixel count, not from mesh density.
    """
    o = np.asarray(origin, dtype=np.float64)
    u = np.asarray(u_vec, dtype=np.float64)
    v = np.asarray(v_vec, dtype=np.float64)
    verts = [o, o+u, o+u+v, o+v]

    pts = " ".join("%.9g %.9g %.9g" % (p[0], p[1], p[2]) for p in verts)
    uvs = "0.0 0.0 1.0 0.0 1.0 1.0 0.0 1.0"

    with open(path, "w") as f:
        f.write('<?xml version="1.0" encoding="UTF-8"?>\n')
        f.write('<!DOCTYPE X3D PUBLIC "ISO//Web3D//DTD X3D 3.3//EN" '
                '"http://www.web3d.org/specifications/x3d-3.3.dtd">\n')
        f.write('<X3D profile="Interchange" version="3.3">\n  <Scene>\n    <Transform>\n')
        f.write('      <Shape>\n')
        f.write('        <IndexedFaceSet coordIndex="0 1 2 -1 0 2 3 -1" '
                'texCoordIndex="0 1 2 -1 0 2 3 -1" solid="false">\n')
        f.write('          <Coordinate point="%s"/>\n' % pts)
        f.write('          <TextureCoordinate point="%s"/>\n' % uvs)
        f.write('        </IndexedFaceSet>\n')
        f.write('        <Appearance><Material diffuseColor="0.8 0.8 0.8"/></Appearance>\n')
        f.write('      </Shape>\n    </Transform>\n  </Scene>\n</X3D>\n')
    return path


global plane_x3d_from_scanpath
def plane_x3d_from_scanpath(path, uu, vv, ww, margin=0.0):
    """Synthesise the patch that a rectangular plane scan covers.

    Takes the world coordinate grids straight from _plane_grid, so the surface
    is the scan area by definition and lands in the world frame already
    registered. margin extends the patch outward on all sides, which is useful
    because the projection spot has a radius and would otherwise be clipped at
    the edges of the scan.
    """
    o = np.array([uu[0, 0], vv[0, 0], ww[0, 0]], dtype=np.float64)
    umax = np.array([uu[-1, 0], vv[-1, 0], ww[-1, 0]], dtype=np.float64)
    vmax = np.array([uu[0, -1], vv[0, -1], ww[0, -1]], dtype=np.float64)
    u = umax - o
    v = vmax - o

    if margin > 0.0:
        un = u/np.linalg.norm(u)
        vn = v/np.linalg.norm(v)
        o = o - margin*un - margin*vn
        u = u + 2*margin*un
        v = v + 2*margin*vn

    return write_plane_x3d(path, o, u, v), o, u, v


def loadable_projection_surface(x3d_path):
    """The surface to hand to the loader, repaired first if it needs it.

    x3d_load_geometry() sorts the edges around each vertex using the triangle
    winding, and ONE interior edge wound the same way round by both of its
    triangles makes that sort impossible. It does not return an error: it fails an
    assertion, which is SIGABRT for the whole process -- mid-scan, with the probe
    on the part and the recording database lost. So the surface is checked, and
    repaired where it can be, before the loader ever sees it.

    Inconsistent winding is normal here rather than exotic: making each face's
    normal agree with a measured surface is done face by face, and every face
    turned that way disagrees with its neighbours afterwards. The repair reverses
    those faces back, which changes no geometry -- see x3d_winding.py.
    """
    try:
        import x3d_winding
    except ImportError:
        # A live config includes this file before anything adds the module
        # directory to sys.path; the config knows where that is.
        module_dir = globals().get("SCAN_MODULE_DIR")
        if module_dir and module_dir not in sys.path:
            sys.path.insert(0, module_dir)
        import x3d_winding
    return x3d_winding.loadable_x3d(x3d_path)


global check_projection_surface
def check_projection_surface(x3d_path, quiet=False):
    """Prove this surface is loadable, NOW, where it was written.

    -> the path that will actually be loaded (a repaired sibling, or the one
    given). Raises RuntimeError naming what is wrong when it cannot be made
    loadable.

    WHY HERE AND NOT AT THE SCAN. SurfaceProjector is built when the scan
    starts, which is after the approach, the touchdown and the hardware null. A
    surface x3d_load_geometry() will not take therefore costs the whole setup,
    with the probe pressed into the part and the instrument already balanced --
    three runs went that way on 2026-10-05 and 2026-10-06, and every time the
    file had existed since the parameterization minutes earlier. This is the
    same work, done where the answer is still free.

    TWO CHECKS, AND NEITHER IS ENOUGH ALONE. That is measured, not assumed:

      * loadable_x3d() repairs winding, pinched vertex fans and a mirrored
        parameterization. Winding is the one the loader does NOT validate -- it
        still reaches an assert, `edgecheck < vertexnum_edges.second.size()`,
        which is SIGABRT for the whole process with no traceback and nothing to
        catch. The scan surface of 2026-10-06 had 219 inconsistently wound edges
        and passed x3d_validate_geometry() with ZERO problems; loading it
        aborted the process.
      * x3d_validate_geometry() is the loader's OWN list -- out-of-range
        indices, non-triangular polygons, degenerate triangles, orphan
        vertices, over-shared edges, discontiguous fans -- and it is the half
        that cannot drift from what the loader requires, because it is the same
        code. It reserves no channel and allocates nothing, so it is free to
        ask.

    So: repair with ours, then confirm with theirs.
    """
    load_path = loadable_projection_surface(x3d_path)
    try:
        import spatialnde2 as snde
        validate = getattr(snde, "x3d_validate_geometry", None)
    except ImportError:                                           # noqa: BLE001
        validate = None
    if validate is None:
        # An older spatialnde2 without the validator: the repairs above still
        # ran, and saying so is better than implying a check that did not happen.
        if not quiet:
            print("  projection surface: repaired and checked for winding, fans "
                  "and UV handedness; this spatialnde2 has no "
                  "x3d_validate_geometry() so the loader's own index checks were "
                  "not run")
        return load_path
    tags = (["reindex_vertices", "reindex_tex_vertices"]
            + list(snde.project_onto_parameterization_processing_tags))
    problems = validate(load_path, 0, tags)
    fatal = [p for p in problems if p.fatal]
    if fatal:
        raise RuntimeError(
            "%s cannot be loaded for projection, and this is the plan stage, so "
            "nothing has moved:\n  %s\n"
            "  The surface was repaired for winding, pinched fans and UV "
            "handedness first; what is left is in the loader's own list and is "
            "not something this pipeline knows how to repair. Re-run the "
            "parameterization, or look at the reconstruction that produced %s."
            % (os.path.basename(load_path),
               snde.x3d_describe_fatal_problems(problems).replace("\n", "\n  "),
               os.path.basename(x3d_path)))
    if not quiet:
        extra = ""
        if problems:
            # Non-fatal ones are worth one line: an orphan vertex is a hole in
            # the surface where no trace will ever land.
            kinds = {}
            for p in problems:
                kinds[p.check] = kinds.get(p.check, 0) + 1
            extra = (" (%s -- not fatal, but nothing projects there)"
                     % ", ".join("%d %s" % (v, k) for k, v in sorted(kinds.items())))
        print("  projection surface checked at plan time: %s loads%s"
              % (os.path.basename(load_path), extra))
    return load_path


def projection_surface_geometry(x3d_path):
    """What is actually in this X3D file. -> (nverts, nfaces, lo, hi)

    lo/hi are the bounding box of the Coordinate points, in the file's own
    coordinates -- which for every surface this pipeline writes is the WORLD
    frame: write_plane_x3d() emits the scan's own corners, and mesh_uv_blender.py
    deliberately does not apply Blender's Y-up conversion for exactly this
    reason. A projector built with a nonzero `offset` moves it; see
    SurfaceProjector.surface_world_bbox().

    Three numbers rather than a hash because they are the three the operator can
    check against something else: the counts against what the loader reports
    ("Inplanemat calculation complete; numtris=...") and the box against where
    the part is. They are also what makes an overwritten file DIAGNOSABLE rather
    than merely different -- 6489 triangles over x 0.797..0.828 becoming 6782
    over x 0.852..0.906 says which part it is now, which a changed digest does
    not.

    Deliberately a text parse and not a load: this is asked before
    x3d_load_geometry() is called, on a file whose purpose is to be handed to
    it, and the loader aborts the process rather than returning an error.
    """
    with open(x3d_path, "r") as fh:
        text = fh.read()
    m = re.search(r'<Coordinate\b[^>]*\bpoint="([^"]*)"', text, re.S)
    if m is None:
        raise ValueError("%s has no <Coordinate point=...>: there is no surface "
                         "in it to project onto" % (x3d_path,))
    vals = np.array([float(t) for t in m.group(1).replace(",", " ").split()],
                    dtype=np.float64)
    if vals.size < 3 or vals.size % 3:
        raise ValueError("%s has %d coordinate value(s), which is not a whole "
                         "number of 3-vectors" % (x3d_path, vals.size))
    pts = vals.reshape(-1, 3)

    nfaces = 0
    run = 0
    fm = re.search(r'<IndexedFaceSet\b[^>]*\bcoordIndex="([^"]*)"', text, re.S)
    if fm is not None:
        for tok in fm.group(1).split():
            if int(tok) == -1:
                if run:
                    nfaces += 1
                run = 0
            else:
                run += 1
        if run:
            nfaces += 1
    return (int(pts.shape[0]), int(nfaces),
            tuple(float(v) for v in pts.min(axis=0)),
            tuple(float(v) for v in pts.max(axis=0)))


def projection_surface_fingerprint(x3d_path):
    """Enough of a surface file to recognise it again. -> dict

    THE PATH IS NOT THE SURFACE. A projection surface is written into a file
    whose name is derived from the mesh, and two runs of the same pipeline over
    different parts can be handed the same name -- that is how results16 came
    about: run C overwrote run B's .x3d, the reuse test compared only the string,
    and the process kept run B's loaded geometry while scanning run C's part.
    The two surfaces were 31 mm apart, so not one of the 3531 traces could land,
    and nothing anywhere said so.

    So the reuse test is content-addressed instead. Keys:

        size, mtime_ns   from stat(), for the message
        sha1             the file's bytes; this is what decides
        nverts, nfaces   so a mismatch can be DESCRIBED
        bbox             (lo, hi) in the file's own (world) coordinates
        error            why the geometry could not be read, if it could not

    MTIME IS RECORDED AND NOT COMPARED. A rewrite always changes the digest, so
    comparing mtime adds nothing to the detection; what it would add is a false
    mismatch when the same bytes arrive with a new timestamp -- a copy, a
    restore, a rewritten-identical parameterization -- and every false mismatch
    costs a model tree that can never be handed back (see _surface_generation).
    The digest is strictly stronger, so it is the whole test.
    """
    fp = {"path": x3d_path, "size": None, "mtime_ns": None, "sha1": None,
          "nverts": None, "nfaces": None, "bbox": None, "error": None}
    try:
        st = os.stat(x3d_path)
        fp["size"] = int(st.st_size)
        fp["mtime_ns"] = int(st.st_mtime_ns)
        h = hashlib.sha1()
        with open(x3d_path, "rb") as fh:
            for block in iter(lambda: fh.read(1 << 20), b""):
                h.update(block)
        fp["sha1"] = h.hexdigest()
    except Exception as e:                                      # noqa: BLE001
        fp["error"] = "%s: %s" % (type(e).__name__, e)
        return fp
    try:
        nv, nf, lo, hi = projection_surface_geometry(x3d_path)
        fp["nverts"], fp["nfaces"], fp["bbox"] = nv, nf, (lo, hi)
    except Exception as e:                                      # noqa: BLE001
        # The digest still stands, so reuse can still be decided. Only the
        # readable description of a mismatch is lost.
        fp["error"] = "%s: %s" % (type(e).__name__, e)
    return fp


def projection_surface_matches(before, now):
    """Are these two fingerprints the same bytes? -> (bool, why)

    UNKNOWN IS NOT A MATCH. A missing or unreadable fingerprint on either side
    answers False, so the caller takes the teardown-and-rebuild branch, which is
    merely expensive. Answering True there is what produced an empty image with
    every pass reporting 100%.
    """
    if not isinstance(before, dict) or not isinstance(now, dict):
        return False, "no fingerprint was recorded when the surface was loaded"
    if before.get("sha1") is None or now.get("sha1") is None:
        return False, ("the file could not be read (%s)"
                       % (now.get("error") or before.get("error") or "unknown",))
    if before["sha1"] == now["sha1"] and before.get("size") == now.get("size"):
        return True, "same %d bytes, sha1 %s" % (now["size"], now["sha1"][:12])
    was = describe_surface_counts(before)
    isnow = describe_surface_counts(now)
    return False, ("the contents changed: %s -> %s (sha1 %s -> %s)"
                   % (was, isnow,
                      (before.get("sha1") or "?")[:12],
                      (now.get("sha1") or "?")[:12]))


global describe_surface_counts
def describe_surface_counts(fp):
    """One phrase describing what a fingerprint says the surface is. -> str"""
    if not isinstance(fp, dict):
        return "unknown"
    parts = []
    if fp.get("nverts") is not None:
        parts.append("%d vertices, %d triangles" % (fp["nverts"], fp["nfaces"]))
    if fp.get("size") is not None:
        parts.append("%d bytes" % (fp["size"],))
    if fp.get("bbox") is not None:
        parts.append("over %s" % (describe_bbox(fp["bbox"]),))
    return "; ".join(parts) if parts else "unknown"


def projection_surface_reusable(projector, x3d_path):
    """May this projector be restart()ed for x3d_path, or must it be rebuilt?

    -> (bool, why). The three scan modes all ask this, and they must all ask it
    the same way: a reuse decision that is right in one of them and wrong in the
    other two is the same silent empty image in two thirds of the configs.

    Both halves have to hold. The PATH, because a different file is a different
    surface and the loaded geometry is the old one. The CONTENTS, because the
    same path may be a different file -- see projection_surface_fingerprint().
    """
    if projector is None:
        return False, "there is no projector yet"
    if x3d_path is None:
        return False, "no surface was given"
    have = getattr(projector, "x3d_path", None)
    if have != x3d_path:
        return False, "a different surface file (was %s)" % (have,)
    same, why = projection_surface_matches(
        getattr(projector, "x3d_fingerprint", None),
        projection_surface_fingerprint(x3d_path))
    if not same:
        return False, "%s has been REWRITTEN since it was loaded -- %s" % (x3d_path, why)
    return True, why


# ------------------------------------------------------------------------------
# Is the surface anywhere near the toolpath? The pre-flight guard.
# ------------------------------------------------------------------------------

def describe_bbox(box):
    """A world bounding box as one readable phrase. -> str"""
    if box is None:
        return "an unknown extent"
    lo, hi = box
    return ("x %.4f..%.4f  y %.4f..%.4f  z %.4f..%.4f m"
            % (lo[0], hi[0], lo[1], hi[1], lo[2], hi[2]))


def toolpath_world_bbox(path):
    """World bounding box of whatever describes where the probe will go.

    Accepts a ScanPath (its .positions), an (N, 3) array of positions, or the
    (uu, vv, ww) coordinate grids a plane scan builds -- those are the three
    shapes the three scan modes have in hand at the moment the projector is
    handed the plan, and the guard has to work in all three or it is only
    installed in some of them. -> (lo, hi) or None when there is nothing to
    measure.
    """
    pos = getattr(path, "positions", None)
    if pos is None:
        if isinstance(path, (tuple, list)) and len(path) == 3:
            # (uu, vv, ww): three same-shaped coordinate grids.
            grids = [np.asarray(g, dtype=np.float64) for g in path]
            if all(g.size for g in grids):
                return (tuple(float(g.min()) for g in grids),
                        tuple(float(g.max()) for g in grids))
            return None
        pos = path
    pos = np.asarray(pos, dtype=np.float64)
    if pos.ndim != 2 or pos.shape[1] != 3 or not pos.shape[0]:
        return None
    finite = pos[np.all(np.isfinite(pos), axis=1)]
    if not finite.shape[0]:
        return None
    return (tuple(float(v) for v in finite.min(axis=0)),
            tuple(float(v) for v in finite.max(axis=0)))


def bbox_gap(a, b):
    """Per-axis separation of two world bounding boxes, metres. -> (gx, gy, gz)

    Zero on an axis where they overlap. The Euclidean norm of the three is the
    closest the two boxes come to each other, which is the number worth printing.
    """
    alo, ahi = a
    blo, bhi = b
    return tuple(max(0.0, float(blo[i]) - float(ahi[i]),
                     float(alo[i]) - float(bhi[i])) for i in range(3))


global projection_file_world_bbox
def projection_file_world_bbox(x3d_path, offset=(0.0, 0.0, 0.0)):
    """Where the surface in this X3D FILE is, in the world. -> (lo, hi) or None

    The same box SurfaceProjector.surface_world_bbox() reports, read straight
    off the file so that it can be asked at PLANNING time -- before any
    projector exists, before the arm has moved. See
    check_projection_covers_path(), which takes either.
    """
    fp = projection_surface_fingerprint(x3d_path)
    box = fp.get("bbox")
    if box is None:
        return None
    lo, hi = box
    return (tuple(lo[i] + offset[i] for i in range(3)),
            tuple(hi[i] + offset[i] for i in range(3)))


def check_projection_covers_path(projector, path, what="toolpath",
                                 lateral_slack_m=None,
                                 offset=(0.0, 0.0, 0.0), reach_m=None):
    """Refuse a scan whose surface is nowhere near its toolpath. -> dict

    `projector` may be a SurfaceProjector -- whose LOADED surface and real
    min_dist/max_dist are then used -- or the PATH to an .x3d, which is how the
    same question gets asked at planning time, before a projector exists and
    before the arm moves. `offset` and `reach_m` only apply to the file form;
    a projector carries its own.

    THE ONE CHECK THAT WOULD HAVE CAUGHT results16 IN ONE LINE, and it runs
    before the arm touches the part. A projector holding the wrong surface --
    overwritten file, stale reuse, a mesh placed by an offset nobody applied to
    the toolpath -- produces an empty image and NO error: the ray misses,
    raytrace_sensor_evaluate_zdist returns inf, and project_onto_parameterization
    drops the point without logging it. Every pass still reports 100% of its
    expected traces, because the traces were acquired; they just went nowhere.

    Two allowances, because two directions mean different things:

      LATERALLY (x, y) the boxes must overlap, bar PROJECTION_FOOTPRINT_SLACK_M.
      A path planned on a surface always overlaps its footprint, however much
      the tool is tilted -- see that constant.

      ALONG z the allowance is the projector's OWN ray window, min_dist to
      max_dist: that is the interval along the tool axis it will search, so a
      surface further away than that cannot be hit by any pose at any tilt,
      and one inside it might be. Nothing tighter can be claimed without the
      per-pose tool axis, and nothing looser is worth checking.

    Returns the measurement -- {"ok", "surface_bbox", "path_bbox", "gap",
    "separation_m", "reason"} -- so a scan report can carry it. Raises
    RuntimeError on a refusal, naming both boxes and the gap, because by the
    time anything downstream could notice, the scan is over.

    A surface whose extent could not be read, or a path with no positions, is
    reported as unchecked rather than refused: this guard exists to catch a
    geometry collision, and it must not be the thing that stops a scan it cannot
    actually measure.
    """
    out = {"ok": True, "surface_bbox": None, "path_bbox": None,
           "gap": None, "separation_m": None, "reason": None}
    if isinstance(projector, str):
        # One fingerprint, not two: the digest is a full pass over the file and
        # a real parameterization is tens of megabytes.
        fp = projection_surface_fingerprint(projector)
        surf = None
        if fp.get("bbox") is not None:
            flo, fhi = fp["bbox"]
            surf = (tuple(flo[i] + offset[i] for i in range(3)),
                    tuple(fhi[i] + offset[i] for i in range(3)))
        counts = describe_surface_counts(fp)
        reach = PROJECTION_RAY_WINDOW_M if reach_m is None else float(reach_m)
    elif projector is None:
        surf, counts, reach = None, "unknown", PROJECTION_RAY_WINDOW_M
    else:
        surf = projector.surface_world_bbox()
        counts = describe_surface_counts(getattr(projector, "x3d_fingerprint", None))
        reach = max(abs(float(getattr(projector, "min_dist", 0.0))),
                    abs(float(getattr(projector, "max_dist", 0.0))))
    tp = toolpath_world_bbox(path)
    out["surface_bbox"] = surf
    out["path_bbox"] = tp
    if surf is None or tp is None:
        out["reason"] = ("not checked: %s"
                         % ("the surface extent could not be read"
                            if surf is None else
                            "the %s has no finite positions" % (what,)))
        print("  WARNING: the projection surface was NOT checked against the %s "
              "-- %s. An empty projected image is the failure this check exists "
              "to prevent, and it cannot be ruled out here." % (what, out["reason"]))
        return out

    gap = bbox_gap(surf, tp)
    out["gap"] = gap
    out["separation_m"] = float(np.linalg.norm(gap))

    slack = (PROJECTION_FOOTPRINT_SLACK_M if lateral_slack_m is None
             else float(lateral_slack_m))
    bad = []
    for i, axis in enumerate("xy"):
        if gap[i] > slack:
            bad.append("%s by %.1f mm (slack %.1f mm)"
                       % (axis, gap[i]*1e3, slack*1e3))
    if gap[2] > reach:
        bad.append("z by %.1f mm, past the projector's own %.0f mm ray window"
                   % (gap[2]*1e3, reach*1e3))
    if not bad:
        out["reason"] = ("the surface and the %s overlap (closest approach of "
                         "the boxes %.1f mm)" % (what, out["separation_m"]*1e3))
        return out

    out["ok"] = False
    out["reason"] = "; ".join(bad)
    raise RuntimeError(
        "THE PROJECTION SURFACE IS NOT UNDER THE %s. Refusing to scan.\n"
        "  surface  %s  (%s)\n"
        "  %-8s %s\n"
        "  they are separated by %.1f mm (x %.1f, y %.1f, z %.1f) -- %s\n"
        "  Not one trace could land on this surface, and nothing downstream "
        "would say so: a ray that misses is dropped inside the projection math "
        "function with no error and no log, so every pass would report 100%% of "
        "its expected traces onto an empty image.\n"
        "  Either the surface is the wrong one for this part -- a .x3d written "
        "beside a different mesh, or an overwritten one reused -- or the mesh "
        "offset that places the surface was not applied to the %s."
        % (what.upper(),
           describe_bbox(surf), counts,
           what + ":", describe_bbox(tp),
           out["separation_m"]*1e3, gap[0]*1e3, gap[1]*1e3, gap[2]*1e3,
           out["reason"], what))


#: How many surfaces have been loaded under each projection prefix.
#:
#: x3d_load_geometry() reserves the channels of the model tree it loads into --
#: the group itself plus meshed, uv, trinormals, boxes2d, boxes3d, projinfo and
#: inplanemat -- and keeps those reservations to itself. The recording it returns
#: does not expose them, so there is no call that hands them back, and loading a
#: second surface into the same tree fails the whole transaction:
#:
#:     realize_transaction: provided reserved_channel for
#:     /ec/proj/graphics/specimen/ by main is not current
#:
#: So each load gets its OWN tree, numbered from here. Everything the operator
#: and the viewer refer to keeps a fixed name; only the tree moves. The cost is
#: eight channels per surface, held for the life of the process, which is why
#: restart() exists: rescanning the SAME surface reuses one tree and costs
#: nothing.
_surface_generation = {}


def describe_projection_status(status):
    """SurfaceProjector.projection_status() as one readable block. -> str

    Separate from the method so a caller that collected the dict earlier -- a
    scan report, a saved run -- can render it the same way.
    """
    lines = []
    offered = status.get("offered") or 0
    landed = status.get("landed")
    cells = status.get("cells")
    if status.get("error"):
        lines.append("  projection: %d trace(s) offered; COULD NOT READ THE IMAGE "
                     "(%s)" % (offered, status["error"]))
        lines.append("    the channel %s did not answer, so whether anything "
                     "landed is unknown" % status.get("channel"))
    elif offered == 0:
        lines.append("  projection: NOTHING WAS OFFERED -- project() was never "
                     "called")
        lines.append("    so this is not a projection fault: either the scan is "
                     "not in live mode, or every pose it had was None. An empty "
                     "image here is correct.")
    elif landed == 0:
        lines.append("  projection: %d trace(s) offered and NONE LANDED" % offered)
        lines.append("    every ray missed the surface, which the projector "
                     "cannot report on its own -- the image is empty and no "
                     "error was raised anywhere.")
        lines.append("    surface %s" % status.get("surface"))
        # The surface's OWN extent, not left to be looked up. "compare the pose
        # bbox against the surface extent" is the whole diagnosis, and asking the
        # reader to go and find the other half of it is how results16 went a
        # whole session without anyone making the comparison. Formatted inline
        # rather than through describe_bbox() so this function stays liftable on
        # its own -- see projection_status_test.py.
        if status.get("surface_bbox"):
            slo, shi = status["surface_bbox"]
            lines.append("    the surface itself spans x %.4f..%.4f  "
                         "y %.4f..%.4f  z %.4f..%.4f m"
                         % (slo[0], shi[0], slo[1], shi[1], slo[2], shi[2]))
        if status.get("pose_bbox"):
            lo, hi = status["pose_bbox"]
            lines.append("    the poses span x %.4f..%.4f  y %.4f..%.4f  "
                         "z %.4f..%.4f m -- compare that against the surface's "
                         "own world extent. A pose bbox sitting away from the "
                         "part is the answer; one on top of it means the "
                         "standoff or the probe direction is wrong instead."
                         % (lo[0], hi[0], lo[1], hi[1], lo[2], hi[2]))
    else:
        pct = (100.0 * landed / cells) if cells else float("nan")
        lines.append("  projection: %d trace(s) offered, %d of %d image cell(s) "
                     "have data (%.1f%%)" % (offered, landed, cells, pct))
        lines.append("    points ARE going onto the part, so an empty viewer is "
                     "a DISPLAY fault and not a projection one.")
    if status.get("pose_nonfinite"):
        lines.append("    %d pose(s) carried a NaN or an inf and cannot project"
                     % status["pose_nonfinite"])
    if status.get("value_nonfinite"):
        lines.append("    %d value(s) were not finite" % status["value_nonfinite"])
    return "\n".join(lines)


class SurfaceProjector(object):
    """Loads a parameterized surface and projects scalar probe data onto it.

    Deliberately the same object whether the surface came from a mesh
    reconstruction or was synthesised for a plane scan, because the only thing
    that differs is where the .x3d came from.
    """

    def __init__(self, recdb, x3d_path, prefix="/proj",
                 texture_scaling=None,
                 min_dist=-PROJECTION_RAY_WINDOW_NEAR_M,
                 max_dist=PROJECTION_RAY_WINDOW_M, radius=0.003,
                 horizontal_pixels=512, vertical_pixels=512,
                 use_surface_normal=False, create_textured_part=True,
                 offset=(0.0, 0.0, 0.0)):
        self.recdb = recdb
        self.offset = tuple(float(v) for v in offset)
        self.prefix = prefix.rstrip("/")
        # A fresh model tree for this load -- see _surface_generation above.
        # Numbered per prefix so the ultrasound and eddy-current projectors count
        # independently and one does not renumber the other.
        gen = _surface_generation.get(self.prefix, 0)
        _surface_generation[self.prefix] = gen + 1
        self.generation = gen
        self.model_tree = self.prefix + "/graphics/specimen%d/" % gen
        self.specimen_pose_channel = self.prefix + "/specimen_pose"
        self.probe_pose_channel = self.prefix + "/probe_pose"
        self.data_channel = self.prefix + "/probe_value"
        self.projection_channel = self.prefix + "/graphics/projection"
        self.projection_specimen_channel = self.prefix + "/graphics/projection_specimen"

        self.min_dist = min_dist
        self.max_dist = max_dist
        self.radius = radius
        self.horizontal_pixels = horizontal_pixels
        self.vertical_pixels = vertical_pixels
        self.use_surface_normal = use_surface_normal
        self.create_textured_part = create_textured_part

        # WHAT THIS SURFACE IS, taken BEFORE the loader reads it, so the
        # fingerprint provably describes the bytes that were loaded and not
        # whatever is at that path later. This is the whole basis of the reuse
        # test -- see projection_surface_fingerprint().
        fingerprint = projection_surface_fingerprint(x3d_path)

        # Before anything is allocated or reserved: a surface the loader would
        # abort on is either repaired into a sibling file or refused outright.
        load_path = loadable_projection_surface(x3d_path)

        self.graphman = snde.graphics_storage_manager(
            self.prefix + "/graphics/", recdb.lowlevel_alloc,
            recdb.alignment_requirements, recdb.lockmgr, 1e-8, 2000000000)

        trans = recdb.start_transaction()
        self.graphics_chan = trans.define_channel(self.prefix + "/graphics/", "main",
                                                  False, self.graphman)

        # project_onto_parameterization_processing_tags is what builds the
        # boxes3d / projinfo / inplanemat arrays the projector needs; without
        # them the ray tracer has nothing to intersect against.
        #
        # load_path, not x3d_path: an inconsistently wound surface aborts the
        # process inside the loader, so it is repaired first. self.x3d_path stays
        # the surface that was ASKED for, because that is what callers compare
        # against to decide whether they can reuse this projector.
        self.specimen_recording = snde.x3d_load_geometry(
            trans, self.graphman, load_path, 0, "main", self.model_tree,
            texture_scaling,
            ["reindex_vertices", "reindex_tex_vertices"]
            + snde.project_onto_parameterization_processing_tags)

        self.specimen_pose_chan = trans.define_channel(self.specimen_pose_channel, "main")
        pose_ref = snde.create_pose_channel_ndarray_ref(
            trans, self.specimen_pose_chan,
            snde.recdb_path_join(self.model_tree, "meshed"))
        pose_ref.allocate_storage([1])
        # Identity rotation, and whatever translation placed the mesh. The
        # synthesised plane patch is already in world coordinates, so there is
        # nothing to register and the offset stays zero -- this is the slot a
        # real registration transform goes in, and it is load-bearing as soon as
        # a mesh authored somewhere else is placed in the work cell: the SAME
        # offset has to move the toolpath and the projection surface, or the traces
        # land on the wrong part of the image and nothing says so.
        pose_ref.data[0] = np.array(((1.0, 0.0, 0.0, 0.0),
                                     (self.offset[0], self.offset[1], self.offset[2], 1.0)),
                                    dtype=ORIENT_DTYPE)
        pose_ref.rec.mark_data_and_metadata_ready()

        self.probe_pose_chan = trans.define_channel(self.probe_pose_channel, "main")
        self.data_chan = trans.define_channel(self.data_channel, "main")

        # Seed both so the projection can be created immediately and starts empty
        # rather than waiting for the first trace.
        self._probe_pose_in_transaction(trans, snde.snde_invalid_orientation3())
        self._value_in_transaction(trans, np.nan)

        trans.end_transaction().globalrev_wait().wait_complete()

        self.x3d_path = x3d_path
        self.x3d_fingerprint = fingerprint
        self.projection = None
        self.proj_specimen_chan = None
        self._reset_projection_counters()
        self._instantiate_projection()

        # The textured part is what lets the viewer draw the projection on the
        # model. It is also a rendering input, so every projection revision can
        # drag CPU-side normal / vertex_arrays / texvertex_arrays recalculation
        # along with it -- ruinous when projecting once per trace. Turn it off
        # during acquisition and add it afterwards if that is the cost; the
        # projection channel itself is unaffected either way.
        #
        # Deliberately after end_transaction: add_textured_part() opens its own,
        # and only one transaction may be open at a time.
        if self.create_textured_part:
            self.add_textured_part()

    def _instantiate_projection(self, trans=None):
        """(Re)create the projection math function on its own channel.

        Split out so restart() can give a scan a FRESH, EMPTY image without
        rebuilding the object. The projector accumulates in mutable storage --
        that is what makes it work one point at a time -- so a second scan onto a
        reused projector would otherwise draw on top of the first one's picture.

        Pass a transaction to join it rather than open one; restart() does, so
        that the delete and the re-create land together. See restart().
        """
        own = (trans is None)
        if own:
            trans = self.recdb.start_transaction()
        self.projection = snde.project_point_onto_parameterization.instantiate(
            [snde.math_parameter_recording(snde.recdb_path_join(self.model_tree, "meshed")),
             snde.math_parameter_recording(snde.recdb_path_join(self.model_tree, "uv")),
             snde.math_parameter_recording(snde.recdb_path_join(self.model_tree, "trinormals")),
             snde.math_parameter_recording(snde.recdb_path_join(self.model_tree, "boxes3d")),
             snde.math_parameter_recording(snde.recdb_path_join(self.model_tree, "projinfo")),
             snde.math_parameter_recording(snde.recdb_path_join(self.model_tree, "inplanemat")),
             snde.math_parameter_recording(self.specimen_pose_channel),
             snde.math_parameter_recording(self.probe_pose_channel),
             snde.math_parameter_recording(self.data_channel),
             snde.math_parameter_double_const(self.min_dist),
             snde.math_parameter_double_const(self.max_dist),
             snde.math_parameter_double_const(self.radius),
             snde.math_parameter_unsigned_const(self.horizontal_pixels),
             snde.math_parameter_unsigned_const(self.vertical_pixels),
             snde.math_parameter_bool_const(self.use_surface_normal)],
            [snde.shared_string(self.projection_channel)],
            "/",
            True,    # mutable -- REQUIRED. The projector accumulates on top of
                     # its previous revision in mutable storage, so instantiated
                     # immutable it publishes only the current splat and every
                     # earlier point vanishes. That looks like the projection
                     # "not working" when in fact it is working one point at a
                     # time.
            False, False,
            snde.math_definition("scan projection"), [], None)
        trans.add_math_function(self.projection, False)
        if own:
            trans.end_transaction().globalrev_wait().wait_complete()

    def surface_world_bbox(self):
        """Where the LOADED surface is, in the world frame. -> (lo, hi) or None

        The file's own box moved by this projector's `offset`, because that
        offset is what the specimen pose channel holds and therefore where the
        ray tracer thinks the geometry is. Getting that wrong is the other half
        of the same failure the pre-flight guard is for: a mesh placed by an
        offset that was never applied to the toolpath projects nothing, and the
        box is the only place the two can be compared.

        None when the extent could not be read -- an X3D with no Coordinate
        node, or a file that has since gone away.
        """
        fp = getattr(self, "x3d_fingerprint", None)
        box = None if not isinstance(fp, dict) else fp.get("bbox")
        if box is None:
            return None
        lo, hi = box
        return (tuple(lo[i] + self.offset[i] for i in range(3)),
                tuple(hi[i] + self.offset[i] for i in range(3)))

    def _reset_projection_counters(self):
        """Zero what projection_status() reports. Called on build and restart."""
        self.projected = 0            # project() calls that staged a pose
        self.pose_nonfinite = 0       # ... of which carried a NaN or an inf
        self.value_nonfinite = 0
        self._pose_lo = None          # world bbox of every pose projected
        self._pose_hi = None

    def projection_status(self, quiet=False):
        """Did the traces actually LAND on the surface? -> dict

        THE PROJECTOR CANNOT FAIL OUT LOUD. project() stages a pose and a value
        and returns; the splat happens later, inside the
        project_point_onto_parameterization math function, and a pose whose ray
        misses the surface is dropped there silently -- raytrace_sensor_evaluate
        returns inf and the point is simply not accumulated. So a scan can offer
        every one of its traces, raise nothing, print nothing, and still produce
        a completely empty image. That is indistinguishable, from the outside,
        from the projection never having been wired at all.

        This reads the accumulator instead of trusting the call count. `landed`
        counts parameterization cells that have received at least one
        contribution, straight out of the fusion recording's `totals` array, so:

            offered > 0 and landed == 0   the poses are missing the surface --
                                          compare pose_bbox against the surface
                                          extent the mesh was written with
            offered == 0                  nothing ever called project(): the
                                          scan is not projecting, live mode is
                                          off, or pose7 was None
            landed > 0                    points are going onto the part, and an
                                          empty VIEWER is a display fault rather
                                          than a projection one

        Cheap enough to call mid-scan from the dgpy prompt.
        """
        landed = None
        cells = None
        err = None
        try:
            ref = self.recdb.latest.ref[self.projection_channel]
            totals = np.asarray(ref.rec.reference_ndarray("totals").data)
            cells = int(totals.size)
            landed = int(np.count_nonzero(totals > 0))
        except Exception as e:
            err = "%s: %s" % (type(e).__name__, e)

        status = {"offered": self.projected,
                  "landed": landed,
                  "cells": cells,
                  "pose_nonfinite": self.pose_nonfinite,
                  "value_nonfinite": self.value_nonfinite,
                  "pose_bbox": (None if self._pose_lo is None
                                else (tuple(self._pose_lo), tuple(self._pose_hi))),
                  "channel": self.projection_channel,
                  "surface": self.x3d_path,
                  "surface_bbox": self.surface_world_bbox(),
                  "surface_counts": describe_surface_counts(
                      getattr(self, "x3d_fingerprint", None)),
                  "error": err}
        if not quiet:
            print(describe_projection_status(status))
        return status

    def restart(self):
        """Empty the projected image, keeping the loaded surface.

        This is how RESCANNING THE SAME SURFACE gets a clean picture, and it is
        the cheap path: the surface stays loaded, so none of the projection
        geometry -- boxes3d, projinfo, inplanemat -- has to be recomputed, which
        on a CPU-only build is the slowest part of building a projector.

        A different surface needs a new SurfaceProjector instead. That works, but
        it costs a fresh model tree whose channels are never reclaimed, so prefer
        this when the surface has not changed.

        ONE transaction for the delete and the re-create, and that is not
        tidiness. add_textured_part() published a textured_part_recording whose
        image_reference names the projection channel, and that reference is not
        rebuilt here. Split across two transactions, every globalrev in between
        holds a textured part pointing at a channel that does not exist, and the
        compositor throws

            Exception determining display requirements for
            .../projection_specimen: get_recording(): channel
            .../projection not found

        once per frame while globalrev completion backs up behind it. Measured
        with the split version and a free-running 1 kHz digitizer: 800
        globalrevisions defined but not complete, and the recording database
        warning that nothing can be pruned so memory, fds and shm keep growing.
        The window is only a transaction round trip; at 1 kHz that is enough.

        AND THE PROBE POSE IS SEEDED INVALID AGAIN, in the same transaction.
        __init__ does that before the first instantiation for a reason: the pose
        channel is a math-function INPUT, so a freshly instantiated projector
        splats whatever is on it, and after a scan what is on it is that scan's
        LAST pose. project_onto_parameterization's guard only skips an invalid
        orientation, and only one pose can be invalid, so without this the first
        thing a cleared image receives is one stale point from the previous scan
        -- at full value, at a position nothing in the new scan put there. It
        costs one array element and it is the difference between "empty" and
        "empty except for one pixel that means nothing".
        """
        trans = self.recdb.start_transaction()
        if self.projection is not None:
            trans.delete_math_function([self.projection_channel], self.projection)
            self.projection = None
        self._probe_pose_in_transaction(trans, snde.snde_invalid_orientation3())
        self._value_in_transaction(trans, np.nan)
        self._instantiate_projection(trans)
        trans.end_transaction().globalrev_wait().wait_complete()
        # The picture is empty again, so the counts that describe it must be too.
        self._reset_projection_counters()

    def teardown(self):
        """Delete the projection and hand back every channel this took.

        Required before a second projector can be built in the same session:
        define_channel() does not complain about a channel someone still owns, it
        returns a reserved_channel that is no longer current, and the transaction
        fails at end_transaction() naming the channel rather than the object still
        holding it. That is a long way from "the second scan crashed".

        Every channel whose name is FIXED has to go back, which is all of them
        here. The model tree is the exception and is handled the other way round:
        its channels belong to x3d_load_geometry and cannot be released at all,
        so each load gets a fresh tree instead -- see _surface_generation.
        """
        trans = self.recdb.start_transaction()
        if self.projection is not None:
            trans.delete_math_function([self.projection_channel], self.projection)
            self.projection = None
        for attr in ("specimen_pose_chan", "probe_pose_chan", "data_chan",
                     "proj_specimen_chan", "graphics_chan"):
            chan = getattr(self, attr, None)
            if chan is not None:
                trans.release_channel(chan)
                setattr(self, attr, None)
        trans.end_transaction().globalrev_wait().wait_complete()

    def add_textured_part(self):
        """Attach the projection to the model so the viewer can draw it.

        The channel is kept on the instance because teardown() has to hand it
        back: its name does NOT carry the model-tree generation, so a projector
        built after this one would find it still reserved and fail.
        """
        trans = self.recdb.start_transaction()
        self.proj_specimen_chan = trans.define_channel(
            self.projection_specimen_channel, "main")
        snde.create_textured_part_recording(
            trans, self.proj_specimen_chan,
            snde.recdb_path_join(self.model_tree, "meshed"),
            snde.shared_string(snde.recdb_path_join(self.model_tree, "uv")),
            [(0, snde.image_reference(self.projection_channel, 0, 1, []))]
        ).mark_data_and_metadata_ready()
        trans.end_transaction().globalrev_wait().wait_complete()
        self.create_textured_part = True

    # -- publishing -------------------------------------------------------

    def _probe_pose_in_transaction(self, trans, orientation):
        ref = snde.create_pose_channel_ndarray_ref(
            trans, self.probe_pose_chan,
            snde.recdb_path_join(self.model_tree, "meshed"))
        ref.allocate_storage([1])
        rec = snde.pose_channel_recording.from_ndarray_recording(ref.rec)
        rec.set_untransformed_render_channel(self.specimen_pose_channel)
        ref.data[0] = orientation
        ref.rec.mark_metadata_done()
        ref.rec.mark_data_ready()

    def _value_in_transaction(self, trans, value):
        ref = snde.create_ndarray_ref(trans, self.data_chan, snde.SNDE_RTN_FLOAT32)
        ref.rec.mark_metadata_done()
        ref.allocate_storage([])
        ref.assign_double([], float(value))
        ref.rec.mark_data_and_metadata_ready()

    def project(self, pose7, value, wait=True):
        """Splat one scalar at one probe pose.

        pose7 is (qw,qx,qy,qz,x,y,z) -- the same layout TraceAccumulator stores,
        so a scan can hand the projector exactly what it recorded.
        """
        orientation = np.array(((pose7[0], pose7[1], pose7[2], pose7[3]),
                                (pose7[4], pose7[5], pose7[6], 1.0)),
                               dtype=ORIENT_DTYPE)

        # Bookkeeping for projection_status(). A missed splat leaves no trace
        # anywhere, so the count of what was OFFERED has to be kept here -- it is
        # the only half of "offered vs landed" that the projector can see.
        self.projected += 1
        xyz = np.array((pose7[4], pose7[5], pose7[6]), dtype=float)
        if not np.all(np.isfinite(np.asarray(pose7, dtype=float))):
            self.pose_nonfinite += 1
        if not np.isfinite(value):
            self.value_nonfinite += 1
        if np.all(np.isfinite(xyz)):
            if self._pose_lo is None:
                self._pose_lo = xyz.copy()
                self._pose_hi = xyz.copy()
            else:
                np.minimum(self._pose_lo, xyz, out=self._pose_lo)
                np.maximum(self._pose_hi, xyz, out=self._pose_hi)

        trans = self.recdb.start_transaction()
        self._probe_pose_in_transaction(trans, orientation)
        self._value_in_transaction(trans, value)
        gr = trans.end_transaction()
        if wait:
            gr.globalrev_wait().wait_complete()
        return gr
