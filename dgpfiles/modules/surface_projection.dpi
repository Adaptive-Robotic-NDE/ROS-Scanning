# Projecting scan data onto a parameterized surface.
#
# The rectangular c-scan is an array indexed by grid position. That only exists
# for a rectangular grid, and it is fragile even there: a trace out of place
# shifts everything after it. Projection replaces the index with geometry --
# spatialnde2 ray-traces from the probe pose onto a parameterized surface and
# splats the value where it lands. It consumes (pose, value) pairs one at a time
# and has no concept of a path, a line or a grid, so a serpentine over a mesh,
# disconnected regions and ragged edges are all the same to it. A stray trace
# lands where the probe actually was, or misses the surface and contributes
# nothing. It cannot displace its neighbours.
#
# The catch is that projection needs a parameterized surface, and building and
# registering a mesh is exactly the cost the plane scan exists to avoid. So for
# a plane we *synthesise* one: the scan defines a rectangle in space, and a
# rectangle is exactly represented by two triangles with a trivial UV map. No
# reconstruction, no registration -- the geometry is whatever the scan said it
# was, which is correct by construction. Everything downstream is then shared
# with the real-mesh case.

import os
import sys
import numpy as np
import spatialnde2 as snde

# A .dpi is compiled as a function body, so anything the including config
# needs to see has to be declared global before it is assigned.
global ORIENT_DTYPE
global SurfaceProjector
global loadable_projection_surface


ORIENT_DTYPE = [('quat', '<f4', (4,)), ('offset', '<f4', (4,))]


global write_plane_x3d
def write_plane_x3d(path, origin, u_vec, v_vec):
    """Write a UV-parameterized rectangular patch as X3D.

    origin/u_vec/v_vec are world-frame numpy 3-vectors: the patch spans
    origin -> origin+u_vec -> origin+u_vec+v_vec -> origin+v_vec. UV runs 0..1
    along u and v respectively, so parameterization space is the scan's own
    (u, v) coordinates -- which makes the projected image directly comparable
    to the rectangular c-scan.

    Two triangles, because a plane needs no more: projection resolution comes
    from the parameterization pixel count, not from mesh density.
    """
    o = np.asarray(origin, dtype=np.float64)
    u = np.asarray(u_vec, dtype=np.float64)
    v = np.asarray(v_vec, dtype=np.float64)
    verts = [o, o+u, o+u+v, o+v]

    pts = " ".join("%.9g %.9g %.9g" % (p[0], p[1], p[2]) for p in verts)
    uvs = "0.0 0.0 1.0 0.0 1.0 1.0 0.0 1.0"

    with open(path, "w") as f:
        f.write('<?xml version="1.0" encoding="UTF-8"?>\n')
        f.write('<!DOCTYPE X3D PUBLIC "ISO//Web3D//DTD X3D 3.3//EN" '
                '"http://www.web3d.org/specifications/x3d-3.3.dtd">\n')
        f.write('<X3D profile="Interchange" version="3.3">\n  <Scene>\n    <Transform>\n')
        f.write('      <Shape>\n')
        f.write('        <IndexedFaceSet coordIndex="0 1 2 -1 0 2 3 -1" '
                'texCoordIndex="0 1 2 -1 0 2 3 -1" solid="false">\n')
        f.write('          <Coordinate point="%s"/>\n' % pts)
        f.write('          <TextureCoordinate point="%s"/>\n' % uvs)
        f.write('        </IndexedFaceSet>\n')
        f.write('        <Appearance><Material diffuseColor="0.8 0.8 0.8"/></Appearance>\n')
        f.write('      </Shape>\n    </Transform>\n  </Scene>\n</X3D>\n')
    return path


global plane_x3d_from_scanpath
def plane_x3d_from_scanpath(path, uu, vv, ww, margin=0.0):
    """Synthesise the patch that a rectangular plane scan covers.

    Takes the world coordinate grids straight from _plane_grid, so the surface
    is the scan area by definition and lands in the world frame already
    registered. margin extends the patch outward on all sides, which is useful
    because the projection spot has a radius and would otherwise be clipped at
    the edges of the scan.
    """
    o = np.array([uu[0, 0], vv[0, 0], ww[0, 0]], dtype=np.float64)
    umax = np.array([uu[-1, 0], vv[-1, 0], ww[-1, 0]], dtype=np.float64)
    vmax = np.array([uu[0, -1], vv[0, -1], ww[0, -1]], dtype=np.float64)
    u = umax - o
    v = vmax - o

    if margin > 0.0:
        un = u/np.linalg.norm(u)
        vn = v/np.linalg.norm(v)
        o = o - margin*un - margin*vn
        u = u + 2*margin*un
        v = v + 2*margin*vn

    return write_plane_x3d(path, o, u, v), o, u, v


def loadable_projection_surface(x3d_path):
    """The surface to hand to the loader, repaired first if it needs it.

    x3d_load_geometry() sorts the edges around each vertex using the triangle
    winding, and ONE interior edge wound the same way round by both of its
    triangles makes that sort impossible. It does not return an error: it fails an
    assertion, which is SIGABRT for the whole process -- mid-scan, with the probe
    on the part and the recording database lost. So the surface is checked, and
    repaired where it can be, before the loader ever sees it.

    Inconsistent winding is normal here rather than exotic: making each face's
    normal agree with a measured surface is done face by face, and every face
    turned that way disagrees with its neighbours afterwards. The repair reverses
    those faces back, which changes no geometry -- see x3d_winding.py.
    """
    try:
        import x3d_winding
    except ImportError:
        # A live config includes this file before anything adds the module
        # directory to sys.path; the config knows where that is.
        module_dir = globals().get("SCAN_MODULE_DIR")
        if module_dir and module_dir not in sys.path:
            sys.path.insert(0, module_dir)
        import x3d_winding
    return x3d_winding.loadable_x3d(x3d_path)


#: How many surfaces have been loaded under each projection prefix.
#:
#: x3d_load_geometry() reserves the channels of the model tree it loads into --
#: the group itself plus meshed, uv, trinormals, boxes2d, boxes3d, projinfo and
#: inplanemat -- and keeps those reservations to itself. The recording it returns
#: does not expose them, so there is no call that hands them back, and loading a
#: second surface into the same tree fails the whole transaction:
#:
#:     realize_transaction: provided reserved_channel for
#:     /ec/proj/graphics/specimen/ by main is not current
#:
#: So each load gets its OWN tree, numbered from here. Everything the operator
#: and the viewer refer to keeps a fixed name; only the tree moves. The cost is
#: eight channels per surface, held for the life of the process, which is why
#: restart() exists: rescanning the SAME surface reuses one tree and costs
#: nothing.
_surface_generation = {}


class SurfaceProjector(object):
    """Loads a parameterized surface and projects scalar probe data onto it.

    Deliberately the same object whether the surface came from a mesh
    reconstruction or was synthesised for a plane scan, because the only thing
    that differs is where the .x3d came from.
    """

    def __init__(self, recdb, x3d_path, prefix="/proj",
                 texture_scaling=None,
                 min_dist=-0.05, max_dist=0.25, radius=0.003,
                 horizontal_pixels=512, vertical_pixels=512,
                 use_surface_normal=False, create_textured_part=True,
                 offset=(0.0, 0.0, 0.0)):
        self.recdb = recdb
        self.offset = tuple(float(v) for v in offset)
        self.prefix = prefix.rstrip("/")
        # A fresh model tree for this load -- see _surface_generation above.
        # Numbered per prefix so the ultrasound and eddy-current projectors count
        # independently and one does not renumber the other.
        gen = _surface_generation.get(self.prefix, 0)
        _surface_generation[self.prefix] = gen + 1
        self.generation = gen
        self.model_tree = self.prefix + "/graphics/specimen%d/" % gen
        self.specimen_pose_channel = self.prefix + "/specimen_pose"
        self.probe_pose_channel = self.prefix + "/probe_pose"
        self.data_channel = self.prefix + "/probe_value"
        self.projection_channel = self.prefix + "/graphics/projection"
        self.projection_specimen_channel = self.prefix + "/graphics/projection_specimen"

        self.min_dist = min_dist
        self.max_dist = max_dist
        self.radius = radius
        self.horizontal_pixels = horizontal_pixels
        self.vertical_pixels = vertical_pixels
        self.use_surface_normal = use_surface_normal
        self.create_textured_part = create_textured_part

        # Before anything is allocated or reserved: a surface the loader would
        # abort on is either repaired into a sibling file or refused outright.
        load_path = loadable_projection_surface(x3d_path)

        self.graphman = snde.graphics_storage_manager(
            self.prefix + "/graphics/", recdb.lowlevel_alloc,
            recdb.alignment_requirements, recdb.lockmgr, 1e-8, 2000000000)

        trans = recdb.start_transaction()
        self.graphics_chan = trans.define_channel(self.prefix + "/graphics/", "main",
                                                  False, self.graphman)

        # project_onto_parameterization_processing_tags is what builds the
        # boxes3d / projinfo / inplanemat arrays the projector needs; without
        # them the ray tracer has nothing to intersect against.
        #
        # load_path, not x3d_path: an inconsistently wound surface aborts the
        # process inside the loader, so it is repaired first. self.x3d_path stays
        # the surface that was ASKED for, because that is what callers compare
        # against to decide whether they can reuse this projector.
        self.specimen_recording = snde.x3d_load_geometry(
            trans, self.graphman, load_path, 0, "main", self.model_tree,
            texture_scaling,
            ["reindex_vertices", "reindex_tex_vertices"]
            + snde.project_onto_parameterization_processing_tags)

        self.specimen_pose_chan = trans.define_channel(self.specimen_pose_channel, "main")
        pose_ref = snde.create_pose_channel_ndarray_ref(
            trans, self.specimen_pose_chan,
            snde.recdb_path_join(self.model_tree, "meshed"))
        pose_ref.allocate_storage([1])
        # Identity rotation, and whatever translation placed the mesh. The
        # synthesised plane patch is already in world coordinates, so there is
        # nothing to register and the offset stays zero -- this is the slot a
        # real registration transform goes in, and it is load-bearing as soon as
        # a mesh authored somewhere else is placed in the cell: the SAME offset
        # has to move the toolpath and the projection surface, or the traces land
        # on the wrong part of the image and nothing says so.
        pose_ref.data[0] = np.array(((1.0, 0.0, 0.0, 0.0),
                                     (self.offset[0], self.offset[1], self.offset[2], 1.0)),
                                    dtype=ORIENT_DTYPE)
        pose_ref.rec.mark_data_and_metadata_ready()

        self.probe_pose_chan = trans.define_channel(self.probe_pose_channel, "main")
        self.data_chan = trans.define_channel(self.data_channel, "main")

        # Seed both so the projection can be created immediately and starts empty
        # rather than waiting for the first trace.
        self._probe_pose_in_transaction(trans, snde.snde_invalid_orientation3())
        self._value_in_transaction(trans, np.nan)

        trans.end_transaction().globalrev_wait().wait_complete()

        self.x3d_path = x3d_path
        self.projection = None
        self.proj_specimen_chan = None
        self._instantiate_projection()

        # The textured part is what lets the viewer draw the projection on the
        # model. It is also a rendering input, so every projection revision can
        # drag CPU-side normal / vertex_arrays / texvertex_arrays recalculation
        # along with it -- ruinous when projecting once per trace. Turn it off
        # during acquisition and add it afterwards if that is the cost; the
        # projection channel itself is unaffected either way.
        #
        # Deliberately after end_transaction: add_textured_part() opens its own,
        # and only one transaction may be open at a time.
        if self.create_textured_part:
            self.add_textured_part()

    def _instantiate_projection(self, trans=None):
        """(Re)create the projection math function on its own channel.

        Split out so restart() can give a scan a FRESH, EMPTY image without
        rebuilding the object. The projector accumulates in mutable storage --
        that is what makes it work one point at a time -- so a second scan onto a
        reused projector would otherwise draw on top of the first one's picture.

        Pass a transaction to join it rather than open one; restart() does, so
        that the delete and the re-create land together. See restart().
        """
        own = (trans is None)
        if own:
            trans = self.recdb.start_transaction()
        self.projection = snde.project_point_onto_parameterization.instantiate(
            [snde.math_parameter_recording(snde.recdb_path_join(self.model_tree, "meshed")),
             snde.math_parameter_recording(snde.recdb_path_join(self.model_tree, "uv")),
             snde.math_parameter_recording(snde.recdb_path_join(self.model_tree, "trinormals")),
             snde.math_parameter_recording(snde.recdb_path_join(self.model_tree, "boxes3d")),
             snde.math_parameter_recording(snde.recdb_path_join(self.model_tree, "projinfo")),
             snde.math_parameter_recording(snde.recdb_path_join(self.model_tree, "inplanemat")),
             snde.math_parameter_recording(self.specimen_pose_channel),
             snde.math_parameter_recording(self.probe_pose_channel),
             snde.math_parameter_recording(self.data_channel),
             snde.math_parameter_double_const(self.min_dist),
             snde.math_parameter_double_const(self.max_dist),
             snde.math_parameter_double_const(self.radius),
             snde.math_parameter_unsigned_const(self.horizontal_pixels),
             snde.math_parameter_unsigned_const(self.vertical_pixels),
             snde.math_parameter_bool_const(self.use_surface_normal)],
            [snde.shared_string(self.projection_channel)],
            "/",
            True,    # mutable -- REQUIRED. The projector accumulates on top of
                     # its previous revision in mutable storage, so instantiated
                     # immutable it publishes only the current splat and every
                     # earlier point vanishes. That looks like the projection
                     # "not working" when in fact it is working one point at a
                     # time.
            False, False,
            snde.math_definition("scan projection"), [], None)
        trans.add_math_function(self.projection, False)
        if own:
            trans.end_transaction().globalrev_wait().wait_complete()

    def restart(self):
        """Empty the projected image, keeping the loaded surface.

        This is how RESCANNING THE SAME SURFACE gets a clean picture, and it is
        the cheap path: the surface stays loaded, so none of the projection
        geometry -- boxes3d, projinfo, inplanemat -- has to be recomputed, which
        on a CPU-only build is the slowest part of building a projector.

        A different surface needs a new SurfaceProjector instead. That works, but
        it costs a fresh model tree whose channels are never reclaimed, so prefer
        this when the surface has not changed.

        ONE transaction for the delete and the re-create, and that is not
        tidiness. add_textured_part() published a textured_part_recording whose
        image_reference names the projection channel, and that reference is not
        rebuilt here. Split across two transactions, every globalrev in between
        holds a textured part pointing at a channel that does not exist, and the
        compositor throws

            Exception determining display requirements for
            .../projection_specimen: get_recording(): channel
            .../projection not found

        once per frame while globalrev completion backs up behind it. Measured
        with the split version and a free-running 1 kHz digitizer: 800
        globalrevisions defined but not complete, and the recording database
        warning that nothing can be pruned so memory, fds and shm keep growing.
        The window is only a transaction round trip; at 1 kHz that is enough.
        """
        trans = self.recdb.start_transaction()
        if self.projection is not None:
            trans.delete_math_function([self.projection_channel], self.projection)
            self.projection = None
        self._instantiate_projection(trans)
        trans.end_transaction().globalrev_wait().wait_complete()

    def teardown(self):
        """Delete the projection and hand back every channel this took.

        Required before a second projector can be built in the same session:
        define_channel() does not complain about a channel someone still owns, it
        returns a reserved_channel that is no longer current, and the transaction
        fails at end_transaction() naming the channel rather than the object still
        holding it. That is a long way from "the second scan crashed".

        Every channel whose name is FIXED has to go back, which is all of them
        here. The model tree is the exception and is handled the other way round:
        its channels belong to x3d_load_geometry and cannot be released at all,
        so each load gets a fresh tree instead -- see _surface_generation.
        """
        trans = self.recdb.start_transaction()
        if self.projection is not None:
            trans.delete_math_function([self.projection_channel], self.projection)
            self.projection = None
        for attr in ("specimen_pose_chan", "probe_pose_chan", "data_chan",
                     "proj_specimen_chan", "graphics_chan"):
            chan = getattr(self, attr, None)
            if chan is not None:
                trans.release_channel(chan)
                setattr(self, attr, None)
        trans.end_transaction().globalrev_wait().wait_complete()

    def add_textured_part(self):
        """Attach the projection to the model so the viewer can draw it.

        The channel is kept on the instance because teardown() has to hand it
        back: its name does NOT carry the model-tree generation, so a projector
        built after this one would find it still reserved and fail.
        """
        trans = self.recdb.start_transaction()
        self.proj_specimen_chan = trans.define_channel(
            self.projection_specimen_channel, "main")
        snde.create_textured_part_recording(
            trans, self.proj_specimen_chan,
            snde.recdb_path_join(self.model_tree, "meshed"),
            snde.shared_string(snde.recdb_path_join(self.model_tree, "uv")),
            [(0, snde.image_reference(self.projection_channel, 0, 1, []))]
        ).mark_data_and_metadata_ready()
        trans.end_transaction().globalrev_wait().wait_complete()
        self.create_textured_part = True

    # -- publishing -------------------------------------------------------

    def _probe_pose_in_transaction(self, trans, orientation):
        ref = snde.create_pose_channel_ndarray_ref(
            trans, self.probe_pose_chan,
            snde.recdb_path_join(self.model_tree, "meshed"))
        ref.allocate_storage([1])
        rec = snde.pose_channel_recording.from_ndarray_recording(ref.rec)
        rec.set_untransformed_render_channel(self.specimen_pose_channel)
        ref.data[0] = orientation
        ref.rec.mark_metadata_done()
        ref.rec.mark_data_ready()

    def _value_in_transaction(self, trans, value):
        ref = snde.create_ndarray_ref(trans, self.data_chan, snde.SNDE_RTN_FLOAT32)
        ref.rec.mark_metadata_done()
        ref.allocate_storage([])
        ref.assign_double([], float(value))
        ref.rec.mark_data_and_metadata_ready()

    def project(self, pose7, value, wait=True):
        """Splat one scalar at one probe pose.

        pose7 is (qw,qx,qy,qz,x,y,z) -- the same layout TraceAccumulator stores,
        so a scan can hand the projector exactly what it recorded.
        """
        orientation = np.array(((pose7[0], pose7[1], pose7[2], pose7[3]),
                                (pose7[4], pose7[5], pose7[6], 1.0)),
                               dtype=ORIENT_DTYPE)
        trans = self.recdb.start_transaction()
        self._probe_pose_in_transaction(trans, orientation)
        self._value_in_transaction(trans, value)
        gr = trans.end_transaction()
        if wait:
            gr.globalrev_wait().wait_complete()
        return gr
