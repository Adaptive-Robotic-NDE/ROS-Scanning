print(describe_ascan())
print("  volume storage: %s" % (SCAN_STORAGE_DIR if scan_storage_manager is not None else "memory"))
print("  step size %.2f mm, line spacing %.2f mm, velocity %.1f mm/s, projection %s"
      % (SCAN_STEP_SIZE*1e3, SCAN_LINE_SPACING*1e3, SCAN_VELOCITY*1e3,
         PROJECTION_MODE))
print("  show_scan_panel()   the technician panel: step, velocity, gate, projection")
print("  preview_scan_plan() what those settings would cost, without moving")
print("  project_traces()    rebuild the projected image from the trace list")
print("  run_default_scan()  point to point, stops at every point")
print("  run_raster_scan()   continuous, one trajectory per row (needs /execute_raster)")
print("  run_triggered_scan() continuous, one trace per trigger (ASCAN_TRIGGER_MODE 'timestamped' or 'position')")
print("  or Scan2DPlane / Scan2DPlaneRaster / Scan2DPlaneTriggered with your own corners.")
print("  run_mesh_scan()     surface-following scan of a mesh, via Noether")
print("                      plan_mesh_path() then mesh_path_feasibility() first if")
print("                      the specimen is new -- it moves nothing and it is the")
print("                      difference between a scan and an afternoon.")
